{
  "$schema": "./node_modules/knip/schema.json",
  "ignore": ["**/*.d.**.ts"],
  "ignoreIssues": { "**/.next/**/types/routes.d.ts": ["types"] },
  "ignoreWorkspaces": ["packages/e2e!", "packages/testing!"],
  "ignoreBinaries": ["build-and-start", "make", "psql", "turbo!"],
  "ignoreDependencies": [
    "@prisma/client",
    "@tailwindcss/postcss",
    "next",
    "portless",
    "postcss-load-config",
    "tsx"
  ],
  "includeEntryExports": true,
  "tags": ["-lintignore", "-internal", "-public"],
  "workspaces": {
    ".": { "project": ["scripts/**/*.mts"] },
    "apps/android": {
      "entry": [".eloqnt/config.ts", ".eloqnt/android-xml.ts"],
      "project": [".eloqnt/**/*.ts", "scripts/**/*.mts", "!scripts/run-emulator.mts"]
    },
    "apps/apple": {
      "entry": [".eloqnt/config.ts"],
      "ignoreDependencies": ["@eloqnt/format-apple-xcstrings"],
      "project": ["!scripts/run-simulator.mts"]
    },
    "apps/api": {
      "entry": [".eloqnt/config.ts", "scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx}!", "e2e/**/*.ts", "!**/_test-utils/**!"]
    },
    "apps/blog": { "project": ["src/**/*.{ts,tsx,mdx}!"] },
    "apps/evals": { "entry": ["scripts/*.{ts,mts}!"] },
    "apps/mailbox": { "project": ["src/**/*.{ts,tsx,css}!", "!src/server/**!"] },
    "apps/main": {
      "entry": [".eloqnt/config.ts", "src/app/*/privacy/*.mdx", "src/app/*/terms/*.mdx"],
      "project": ["src/**/*.{ts,tsx,mdx,css}!", "e2e/**/*.ts", "!**/_test-utils/**!"]
    },
    "packages/ai": { "project": ["src/**/*.ts!", "!**/_test-utils/**!"] },
    "packages/auth": { "project": ["src/**/*.ts!", "!**/_test-utils/**!"] },
    "packages/core": { "project": ["src/**/*.{ts,tsx}!", "!**/_test-utils/**!"] },
    "packages/db": {
      "entry": ["prisma.config.ts", "src/prisma/sync-content.{ts,mts}!", "src/scripts/*.ts"],
      "ignore": ["src/prisma/seed.ts", "src/prisma/seed/**"],
      "prisma": false
    },
    "packages/learn": { "entry": [".eloqnt/config.ts"], "project": ["src/**/*.{ts,tsx}!"] },
    "packages/player": {
      "entry": [".eloqnt/config.ts", "scripts/base-maps/build-base-maps.ts!"],
      "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.ts!", "!**/_test-utils/**!"]
    },
    "packages/ui": { "includeEntryExports": false }
  }
}
