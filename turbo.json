{
  "$schema": "./node_modules/turbo/schema.json",
  "futureFlags": { "globalConfiguration": true },
  "global": {
    "env": [
      "AI_GATEWAY_API_KEY",
      "ANDROID_*",
      "APPLE_*",
      "AUTH_COOKIE_CACHE_ENABLED",
      "BETTER_AUTH_SECRET",
      "BLOB_*",
      "CRON_SECRET",
      "DATABASE_*",
      "E2E_API_URL",
      "E2E_TESTING",
      "GOOGLE_*",
      "MAILER_API_KEY",
      "MAILBOX_URL",
      "MAIN_APP_URL",
      "NEXT_PUBLIC_API_URL",
      "OPENAI_API_KEY",
      "SENTRY_AUTH_TOKEN",
      "STRIPE_*",
      "VERCEL_*",
      "PORTLESS_*",
      "PRIVATE_BLOB_*",
      "ZOONK_DEV_PROJECT"
    ],
    "ui": "tui",
    "passThroughEnv": [
      "APP_CACHE_SECRET",
      "CODEX_SANDBOX",
      "MAIN_CACHE_BYPASS_SECRET",
      "ZOONK_DEV_LAUNCHER_PID",
      "ZOONK_QUERY_LOG"
    ],
    "cacheMaxAge": "7d",
    "cacheMaxSize": "10GB"
  },
  "tasks": {
    "//#format": {},
    "//#format:fix": { "cache": false },
    "//#lint": { "dependsOn": ["@zoonk/db#db:generate"] },
    "//#lint:fix": { "cache": false, "dependsOn": ["@zoonk/db#db:generate"] },
    "//#quality": { "dependsOn": ["//#lint", "//#format"] },
    "//#quality:fix": { "dependsOn": ["//#lint:fix", "//#format:fix"] },
    "build": {
      "dependsOn": ["db:generate", "^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "next-env.d.ts",
        "messages/**",
        "src/app/.well-known/workflow/**"
      ]
    },
    "build:e2e": {
      "dependsOn": ["db:generate", "^build:e2e"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/db/.env.e2e.local"],
      "outputs": [
        ".next-e2e/**",
        "!.next-e2e/cache/**",
        "!.next-e2e/dev/**",
        "next-env.d.ts",
        "messages/**",
        "src/app/.well-known/workflow/**"
      ]
    },
    "db:generate": {
      "cache": false,
      "dependsOn": ["^db:generate"],
      "outputs": ["src/generated/**"]
    },
    "db:setup:test": { "cache": false, "dependsOn": ["^db:setup:test"] },
    "dev": { "cache": false, "dependsOn": ["db:generate", "^dev"], "persistent": true },
    "dev:direct": {
      "cache": false,
      "dependsOn": ["db:generate", "^dev:direct"],
      "persistent": true
    },
    "e2e": {
      "dependsOn": ["build:e2e"],
      "env": ["CI"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/db/.env.e2e.local"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    },
    "e2e:suite": {
      "dependsOn": ["^transit", "api#transit"],
      "env": ["CI", "MAIN_PERF_GATES"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/db/.env.e2e.local",
        "$TURBO_ROOT$/scripts/dev/process.mts",
        "$TURBO_ROOT$/scripts/e2e/**",
        "$TURBO_ROOT$/scripts/run-test-env.mts"
      ],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    },
    "i18n:lint": {},
    "i18n": { "cache": false },
    "start": { "cache": false, "dependsOn": ["build", "^start"], "persistent": true },
    "test": {
      "dependsOn": ["db:generate", "^db:setup:test", "transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/db/.env.test.local"]
    },
    "test:watch": {
      "cache": false,
      "dependsOn": ["db:generate", "^db:setup:test"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/db/.env.test.local"],
      "persistent": true
    },
    "transit": { "dependsOn": ["^transit"] },
    "typecheck": {
      "dependsOn": ["db:generate", "^typecheck"],
      "outputs": [".next/types/**", "next-env.d.ts"]
    }
  }
}
