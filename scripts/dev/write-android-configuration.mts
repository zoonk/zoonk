import { writeFileSync } from "node:fs";
import { join } from "node:path";

export function writeAndroidDevelopmentConfiguration({
  apiUrl,
  currentDirectory,
}: {
  apiUrl: string;
  currentDirectory: string;
}): void {
  writeFileSync(
    join(currentDirectory, "apps/android/local-development.properties"),
    `# Generated by pnpm dev. Do not edit.\napiBaseUrl=${apiUrl}\n`,
  );
}
