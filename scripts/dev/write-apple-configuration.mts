import { writeFileSync } from "node:fs";
import { join } from "node:path";

/**
 * Converts an HTTP URL to Xcode's configuration syntax. An unescaped `//` starts an xcconfig comment, while an empty build-setting expansion preserves the two URL slashes in the resolved value.
 */
function getXcodeConfigurationURL(apiUrl: string): string {
  return apiUrl.replace("://", ":/$()/");
}

export function writeAppleDevelopmentConfiguration({
  apiUrl,
  currentDirectory,
}: {
  apiUrl: string;
  currentDirectory: string;
}): void {
  const configurationPath = join(currentDirectory, "apps/apple/Configuration/Local.xcconfig");
  const xcodeURL = getXcodeConfigurationURL(apiUrl);

  writeFileSync(
    configurationPath,
    `// Generated by pnpm dev. Do not edit.\nZOONK_DEVELOPMENT_API_BASE_URL = ${xcodeURL}\n`,
  );
}
