{
  "title": "Is the new handoff format really better?",
  "setting": "Training day at Willow Bay Clinic",
  "mission": "As a staff nurse helping review training, decide whether a new handoff format deserves a wider trial. Recommend **what evidence the team needs before changing training**.",
  "deadline": "Training recommendation due to {{education}} at 3 p.m.",
  "panels": [
    {
      "title": "Simulated handoff pilot",
      "metrics": [
        {
          "label": "Current format",
          "value": "12 of 20 complete",
          "note": "60% included every required item."
        },
        {
          "label": "New format",
          "value": "16 of 20 complete",
          "note": "80% included every required item."
        },
        {
          "label": "Difference",
          "value": "20 percentage points",
          "note": "80% minus 60%."
        },
        {
          "label": "Participants",
          "value": "40 nurses",
          "note": "Randomly assigned; one simulation each."
        }
      ],
      "note": "Both groups used the same scenario and scoring rules. No patient care was involved."
    }
  ],
  "team": [
    {
      "id": "quality",
      "role": "Quality improvement nurse",
      "expertise": "Checks whether the evidence supports a change in nursing practice.",
      "ai": false
    },
    {
      "id": "education",
      "role": "Nurse educator",
      "expertise": "Schedules training and wants a usable recommendation today.",
      "ai": false
    },
    {
      "id": "ai",
      "role": "AI assistant",
      "expertise": "Checks calculations and estimates study size; people approve the plan.",
      "ai": true
    }
  ],
  "meters": [
    {
      "id": "evidence",
      "label": "Evidence behind the recommendation",
      "start": 35,
      "goodWhen": "high"
    },
    {
      "id": "capacity",
      "label": "Training capacity left",
      "start": 90,
      "goodWhen": "high"
    }
  ],
  "skills": [
    {
      "id": "chance",
      "name": "Difference or chance?",
      "practice": "For one small comparison, write one reason the observed gap might not reflect a lasting difference."
    },
    {
      "id": "size",
      "name": "Choose a sample size",
      "practice": "Draft a study-size request naming the difference worth detecting, the current completion rate, and the number already tested."
    },
    {
      "id": "explain",
      "name": "Explain a test result",
      "practice": "Explain an uncertain test result in two sentences: what you observed and what you still cannot conclude."
    }
  ],
  "startNodeId": "start",
  "nodes": [
    {
      "id": "start",
      "messages": [
        {
          "from": "education",
          "text": "The new format looks better: 80% versus 60%. I can still update the next training session if we decide today."
        },
        {
          "from": "quality",
          "text": "With only 20 nurses in each group, random assignment could produce an uneven result. Hypothesis testing checks how surprising a gap like this would be if the formats actually worked equally well."
        }
      ],
      "prompt": "What do you do before making your recommendation?",
      "choices": [
        {
          "id": "use-rates",
          "text": "Use the 20-point improvement to draft a recommendation; discuss any uncertainty at the meeting.",
          "quality": "weak",
          "replies": [
            {
              "from": "education",
              "text": "I'll hold a spot for the update. Please make clear whether this is a promising pilot or evidence that the format is better."
            }
          ],
          "effects": [
            {
              "meter": "evidence",
              "change": -10
            }
          ],
          "timeJump": null,
          "notes": [
            {
              "skill": "chance",
              "kind": "improve",
              "text": "The gap describes these nurses, but it does not yet tell you how surprising the result is under equal performance.",
              "example": "Ask for a chance check before calling the new format better."
            }
          ],
          "next": "unchecked"
        },
        {
          "id": "check",
          "text": "Ask {{ai}} to check the counts and chance explanation, then have {{quality}} review the result.",
          "quality": "strong",
          "replies": [
            {
              "from": "ai",
              "text": "The rates are correct. Using Fisher's exact test, which works with small counts, the p-value is about 0.30. If the formats worked equally well, a gap at least this uneven would occur about 30% of the time."
            },
            {
              "from": "quality",
              "text": "That check fits this pilot: nurses were randomly assigned and each contributed one result. It does not establish that the new format is better—or that the formats are equal."
            }
          ],
          "effects": [
            {
              "meter": "evidence",
              "change": 25
            }
          ],
          "timeJump": null,
          "notes": [
            {
              "skill": "chance",
              "kind": "good",
              "text": "You checked the chance explanation instead of treating the observed gap as proof.",
              "example": null
            },
            {
              "skill": "explain",
              "kind": "good",
              "text": "You used AI for a calculation and asked a colleague to check whether the method fit the pilot.",
              "example": null
            }
          ],
          "next": "checked"
        }
      ]
    },
    {
      "id": "checked",
      "messages": [
        {
          "from": "education",
          "text": "So the test didn't settle it. Should I drop the new format, or make room for more testing?"
        },
        {
          "from": "quality",
          "text": "A small pilot can miss a useful difference. We need to separate 'not enough evidence' from 'no difference.'"
        }
      ],
      "prompt": "How do you explain the result to {{education}}?",
      "choices": [
        {
          "id": "uncertain",
          "text": "The pilot favors the new format, but chance remains plausible. Let's size a useful follow-up before booking it.",
          "quality": "strong",
          "replies": [
            {
              "from": "education",
              "text": "I can consider a follow-up, but training time is tight. Tell me how many nurses it would need."
            }
          ],
          "effects": [
            {
              "meter": "evidence",
              "change": 15
            }
          ],
          "timeJump": null,
          "notes": [
            {
              "skill": "explain",
              "kind": "good",
              "text": "You stated both the observed advantage and the uncertainty without claiming the formats are equal.",
              "example": null
            }
          ],
          "next": "plan"
        },
        {
          "id": "close",
          "text": "The test did not confirm an improvement. Let's close the comparison and record that the formats work equally well.",
          "quality": "weak",
          "replies": [
            {
              "from": "quality",
              "text": "We can close the pilot, but I won't record equal performance. This small study did not establish that."
            },
            {
              "from": "education",
              "text": "I'll keep the current training. There won't be a follow-up on this schedule."
            }
          ],
          "effects": [
            {
              "meter": "evidence",
              "change": -20
            }
          ],
          "timeJump": null,
          "notes": [
            {
              "skill": "chance",
              "kind": "improve",
              "text": "A result that does not establish a difference is not proof of equal performance.",
              "example": "\"We haven't established an improvement; this pilot also cannot rule one out.\""
            }
          ],
          "next": "closed"
        }
      ]
    },
    {
      "id": "unchecked",
      "messages": [
        {
          "from": "education",
          "text": "Your draft highlights the 20-point gain. Can I describe the new format as better when I update the training?"
        },
        {
          "from": "quality",
          "text": "We haven't checked how easily random assignment could produce that gap. There's still time for a quick calculation."
        }
      ],
      "prompt": "What do you put in the recommendation?",
      "choices": [
        {
          "id": "recommend",
          "text": "Recommend the new format for training now, describing the 80% result as enough evidence to switch.",
          "quality": "weak",
          "replies": [
            {
              "from": "education",
              "text": "I'll use it in the next simulation session. This changes training materials only, not the patient-care handoff process."
            },
            {
              "from": "quality",
              "text": "I'll flag that the claim rests on just 40 results without a chance check. We may need to revise the materials again."
            }
          ],
          "effects": [
            {
              "meter": "evidence",
              "change": -20
            },
            {
              "meter": "capacity",
              "change": -10
            }
          ],
          "timeJump": null,
          "notes": [
            {
              "skill": "explain",
              "kind": "improve",
              "text": "Your recommendation turned a promising observation into a stronger claim than the evidence supports.",
              "example": "\"The new format led in this pilot, but we haven't checked whether chance could explain the gap.\""
            }
          ],
          "next": "early"
        },
        {
          "id": "recover",
          "text": "Hold the claim while {{ai}} checks chance and {{quality}} reviews it; then consider a larger comparison.",
          "quality": "strong",
          "replies": [
            {
              "from": "ai",
              "text": "Fisher's exact test gives a p-value of about 0.30. If the formats worked equally well, results at least this uneven would occur about 30% of the time."
            },
            {
              "from": "quality",
              "text": "The method fits these randomly assigned, one-result-per-nurse groups. The pilot is promising, but it establishes neither an improvement nor equal performance."
            }
          ],
          "effects": [
            {
              "meter": "evidence",
              "change": 25
            }
          ],
          "timeJump": null,
          "notes": [
            {
              "skill": "chance",
              "kind": "good",
              "text": "You paused an unsupported claim and checked whether chance remained a reasonable explanation.",
              "example": null
            }
          ],
          "next": "plan"
        }
      ]
    },
    {
      "id": "plan",
      "messages": [
        {
          "from": "education",
          "text": "A 20-point improvement would justify changing training. I can reserve 100 nurses per format for a fresh comparison, but it would use two training blocks."
        },
        {
          "from": "ai",
          "text": "Using 60% versus 80% as planning rates, a standard estimate is about 82 nurses per format. That aims for an 80% chance of detecting that difference, with a 5% false-alarm limit when the formats are equal—not a guaranteed answer."
        },
        {
          "from": "quality",
          "text": "I'll review that estimate before enrollment. Rounding to 100 per format gives some room for missing results; we'll set the final count and scoring rules before starting."
        }
      ],
      "prompt": "What plan do you recommend before the deadline?",
      "choices": [
        {
          "id": "switch-now",
          "text": "Avoid using two more training blocks. Recommend switching formats now based on the pilot's 20-point lead.",
          "quality": "weak",
          "replies": [
            {
              "from": "education",
              "text": "I'll change the simulation materials, not the patient-care process. That saves study time, though another revision may be needed."
            },
            {
              "from": "quality",
              "text": "I'll document the uncertainty. The sample-size estimate does not make the original 20 nurses per format enough."
            }
          ],
          "effects": [
            {
              "meter": "evidence",
              "change": -25
            },
            {
              "meter": "capacity",
              "change": -10
            }
          ],
          "timeJump": null,
          "notes": [
            {
              "skill": "size",
              "kind": "improve",
              "text": "Saving training time is a real benefit, but it does not strengthen the small pilot. Use the size estimate to judge whether a reliable comparison is affordable.",
              "example": "If a larger study is not affordable, keep the recommendation tentative rather than claiming an established improvement."
            }
          ],
          "next": "early"
        },
        {
          "id": "reserve",
          "text": "Reserve two blocks for 100 nurses per format, pending review. Keep current training until the comparison is complete.",
          "quality": "strong",
          "replies": [
            {
              "from": "education",
              "text": "I'll reserve the blocks and leave the current materials in place. Today's recommendation will be a study plan, not a claim of improvement."
            },
            {
              "from": "quality",
              "text": "I'll approve the final design and count before recruitment. We'll report the result even if the new format doesn't lead."
            }
          ],
          "effects": [
            {
              "meter": "evidence",
              "change": 20
            },
            {
              "meter": "capacity",
              "change": -35
            }
          ],
          "timeJump": null,
          "notes": [
            {
              "skill": "size",
              "kind": "good",
              "text": "You tied the study size to a worthwhile difference and accepted a clear training-time cost for stronger evidence.",
              "example": null
            },
            {
              "skill": "explain",
              "kind": "good",
              "text": "You made a useful recommendation without promising that a larger study would favor the new format.",
              "example": null
            }
          ],
          "next": "planned"
        }
      ]
    }
  ],
  "endings": [
    {
      "id": "planned",
      "outcome": "Two training blocks are reserved for a fresh comparison of 100 nurses per format, pending design review. The 60% versus 80% pilot remains promising, not proof; current training stays in place."
    },
    {
      "id": "closed",
      "outcome": "The comparison closes and current training remains. {{quality}} prevents an unsupported claim of equal performance, but the team leaves the possible improvement unresolved."
    },
    {
      "id": "early",
      "outcome": "The new format goes into simulation training based on 16 of 20 completions versus 12 of 20. No patient-care process changes, but the team commits to materials it may need to revise because an improvement has not been established."
    }
