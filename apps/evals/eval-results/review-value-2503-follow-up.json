    {
      "caseId": "pt-finalidades-oab-exam-prep-absurd-option",
      "cause": "prompt",
      "finding": "The reviewer objects to second-person feedback about an interpretation attributed to Murilo. The feedback addresses the learner who selected that interpretation; this does not make it contradictory. The flag is on an unchanged screen, not the planted absurd distractor."
    },
    {
      "caseId": "pt-estabilidade-sourced-clean",
      "cause": "case",
      "finding": "The control says every concurso appointment qualifies and starts the clock at posse rather than effective service. Its source requires a permanent post and effective service.",
