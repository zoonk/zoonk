    },
    {
      "caseId": "en-doorways-picture-options-clean",
      "cause": "case",
      "finding": "The hook attributes the whole building structure to doorway arches and treats arch shape as a reliable construction date. These are factual overstatements in a pass control.",
      "source": "https://www.metmuseum.org/fr/essays/gothic-art"
    },
    {
      "caseId": "pt-regra-framed-around-one-exam",
      "cause": "case",
      "finding": "The supposed scope-only control also invents an official-sounding appeal instruction, a notice subsection and an email submission route. This is not a clean control for exam-specific wording; the exact real-world notice was not independently located."
    },
    {
      "caseId": "pt-eletron-formula-in-overview",
