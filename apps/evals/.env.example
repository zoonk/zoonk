# Running evals using Vercel AI Gateway
AI_GATEWAY_API_KEY=

# Generated audio goes to the public Blob store, which signs in with a Vercel OIDC token. Evals has
# no Vercel project of its own, so link it to Main's (`vercel link --project zoonk`) and stay signed
# in to the Vercel CLI. The store id is Main's BLOB_STORE_ID.
BLOB_STORE_ID=
