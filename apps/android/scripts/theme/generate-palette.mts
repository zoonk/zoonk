/**
 * Writes the Android theme's palette from `packages/ui/src/styles/globals.css`: one `ZoonkPalette`
 * per mode as Kotlin constants named after their tokens, and the window's background per mode so
 * the first frame matches Compose. Run it when the web's tokens change, then format:
 * `pnpm --filter android palette && make -C apps/android format`.
 */
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { fileURLToPath } from "node:url";
import {
  type Mode,
  PALETTE_TOKENS,
  TINTS,
  modePalette,
  readModes,
  readTailwindPalette,
} from "./palette.mts";

const androidRoot = fileURLToPath(new URL("../../", import.meta.url));
const repoRoot = fileURLToPath(new URL("../../../../", import.meta.url));
const globalsPath = `${repoRoot}packages/ui/src/styles/globals.css`;

const tailwindTheme = createRequire(`${repoRoot}packages/ui/package.json`).resolve(
  "tailwindcss/theme.css",
);

const resources = `${androidRoot}app/src/main/res`;
const kotlinFile = `${androidRoot}app/src/main/kotlin/com/zoonk/android/ui/theme/ZoonkPalette.kt`;

const header =
  "Generated by scripts/theme/generate-palette.mts from packages/ui/src/styles/globals.css. Don't edit.";

const MODES: { label: string; mode: Mode; name: string }[] = [
  { label: "Light", mode: "light", name: "LightPalette" },
  { label: "Dark", mode: "dark", name: "DarkPalette" },
  {
    label: "Light with `prefers-contrast: more`",
    mode: "lightMoreContrast",
    name: "LightMoreContrastPalette",
  },
  {
    label: "Dark with `prefers-contrast: more`",
    mode: "darkMoreContrast",
    name: "DarkMoreContrastPalette",
  },
];

function camelCase(token: string): string {
  return token.replaceAll(/-(?<letter>\w)/gu, (_match, letter: string) => letter.toUpperCase());
}

const tokens = readModes(readFileSync(globalsPath, "utf8"));
const palette = readTailwindPalette(readFileSync(tailwindTheme, "utf8"));
const names = [...PALETTE_TOKENS, ...Object.keys(TINTS)];

const colors = Object.fromEntries(
  MODES.map(({ mode }) => [mode, modePalette({ palette, tokens: tokens[mode] })]),
);

const fields = names.map((name) => `    val ${camelCase(name)}: Color,`).join("\n");

const instances = MODES.map(({ label, mode, name }) => {
  const values = names.map(
    (token) => `        ${camelCase(token)} = Color(${colors[mode]?.get(token)}),`,
  );

  return `/** ${label}. */\ninternal val ${name} =\n    ZoonkPalette(\n${values.join("\n")}\n    )`;
});

writeFileSync(
  kotlinFile,
  `// ${header}

package com.zoonk.android.ui.theme

import androidx.compose.runtime.Immutable
import androidx.compose.ui.graphics.Color

/**
 * Zoonk's color tokens in one mode as opaque sRGB, each named after its token in \`globals.css\`
 * (\`successTint\` and \`destructiveTint\` are main's \`bg-success/9\` and \`bg-destructive/9\`).
 * See-through tokens are laid on the mode's background. \`ZoonkTheme\` maps them onto Material roles
 * and \`ZoonkColors\`; composables read those, never this.
 */
@Immutable
internal data class ZoonkPalette(
${fields}
)

${instances.join("\n\n")}
`,
);

for (const [folder, mode] of [
  ["values", "light"],
  ["values-night", "dark"],
] as const) {
  mkdirSync(`${resources}/${folder}`, { recursive: true });

  writeFileSync(
    `${resources}/${folder}/window_colors.xml`,
    `<?xml version="1.0" encoding="utf-8"?>
<!-- ${header} -->
<resources>
    <color name="window_background">#${colors[mode]?.get("background")?.slice(2)}</color>
</resources>
`,
  );
}
