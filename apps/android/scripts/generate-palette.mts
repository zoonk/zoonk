import { mkdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { toArgbHex } from "../../../scripts/theme/color.mts";
import { type Mode, PALETTE_TOKENS, TINTS, modePalette } from "../../../scripts/theme/palette.mts";
import { readPalette } from "../../../scripts/theme/read-palette.mts";
import { subjectPalette } from "../../../scripts/theme/subject-palette.mts";

const androidRoot = process.argv[2] ?? fileURLToPath(new URL("../", import.meta.url));

const resources = join(androidRoot, "core/resources/src/main/res");

const kotlinFile = join(
  androidRoot,
  "core/designsystem/src/main/kotlin/com/zoonk/android/ui/theme/ZoonkPalette.kt",
);

const header =
  "Generated by apps/android/scripts/generate-palette.mts from packages/ui/src/styles/globals.css. Don't edit.";

const MODES: { mode: Mode; name: string }[] = [
  { mode: "light", name: "LightPalette" },
  { mode: "dark", name: "DarkPalette" },
  { mode: "lightMoreContrast", name: "LightMoreContrastPalette" },
  { mode: "darkMoreContrast", name: "DarkMoreContrastPalette" },
];

function camelCase(token: string): string {
  return token.replaceAll(/-(?<letter>\w)/gu, (_match, letter: string) => letter.toUpperCase());
}

const { palette, radii, subjects, tokens } = readPalette();
const names = [...PALETTE_TOKENS, ...Object.keys(TINTS)];

const colors = Object.fromEntries(
  MODES.map(({ mode }) => [
    mode,
    new Map(
      [...modePalette({ palette, tokens: tokens[mode] })].map(([name, color]) => [
        name,
        toArgbHex(color),
      ]),
    ),
  ]),
);

const fields = names.map((name) => `    val ${camelCase(name)}: Color,`).join("\n");

function subjectEntries(mode: Mode): string {
  return [...subjects]
    .map(([subject, modes]) => {
      const roles = new Map(
        [...subjectPalette({ palette, subject: modes[mode], tokens: tokens[mode] })].map(
          ([name, color]) => [name, toArgbHex(color)],
        ),
      );

      return `                "${subject}" to SubjectColors(Color(${roles.get("subject")}), Color(${roles.get("subject-text")}), Color(${roles.get("subject-tint")})),`;
    })
    .join("\n");
}

const instances = MODES.map(({ mode, name }) => {
  const values = names.map(
    (token) => `        ${camelCase(token)} = Color(${colors[mode]?.get(token)}),`,
  );

  const subjectMap = `        subjects =\n            mapOf(\n${subjectEntries(mode)}\n            ),`;

  // Feature modules' tests compare drawn colors with the light palette; the others stay in the design system.
  const visibility = name === "LightPalette" ? "" : "internal ";

  return `${visibility}val ${name} =\n    ZoonkPalette(\n${values.join("\n")}\n${subjectMap}\n    )`;
});

mkdirSync(dirname(kotlinFile), { recursive: true });

writeFileSync(
  join(dirname(kotlinFile), "ZoonkRadius.kt"),
  `// ${header}

package com.zoonk.android.ui.theme

import androidx.compose.ui.unit.dp

object ZoonkRadius {
${[...radii].map(([name, value]) => `    val ${name} = ${value}.dp`).join("\n")}
}
`,
);

writeFileSync(
  kotlinFile,
  `// ${header}

package com.zoonk.android.ui.theme

import androidx.compose.runtime.Immutable
import androidx.compose.ui.graphics.Color

/**
 * \`successTint\` and \`destructiveTint\` are main's \`bg-success/9\` and \`bg-destructive/9\`.
 * Composables read Material roles and \`ZoonkColors\`, never this.
 */
@Immutable
data class ZoonkPalette(
${fields}
    /** Main's \`[data-subject]\` roles by subject key, \`general\` included. */
    val subjects: Map<String, SubjectColors>,
)

/** Main's \`--subject\` (marks), \`--subject-text\` and \`--subject-tint\` (its label's words and fill). */
@Immutable
data class SubjectColors(
    val color: Color,
    val text: Color,
    val tint: Color,
)

${instances.join("\n\n")}
`,
);

for (const [folder, mode] of [
  ["values", "light"],
  ["values-night", "dark"],
] as const) {
  mkdirSync(`${resources}/${folder}`, { recursive: true });

  writeFileSync(
    `${resources}/${folder}/window_colors.xml`,
    `<?xml version="1.0" encoding="utf-8"?>
<!-- ${header} -->
<resources>
    <color name="window_background">#${colors[mode]?.get("background")?.slice(2)}</color>
</resources>
`,
  );
}
