import { createHash } from "node:crypto";
import { fileURLToPath } from "node:url";
import { build } from "esbuild";

export const SANDBOX_PAGE_FILE = fileURLToPath(
  new URL("../../app/src/main/assets/sandbox/index.html", import.meta.url),
);

const repoRoot = fileURLToPath(new URL("../../../../", import.meta.url));
const RUNTIME_URL = /https:\/\/cdn\.jsdelivr\.net\/[^"'\\\s]+/gu;

const HEADER =
  "Generated by apps/android/scripts/sandbox/generate-sandbox-page.mts from main's player sandbox. Don't edit.";

/**
 * Main's sandbox (`packages/player/src/activities/_sandbox`) and regex tester, bundled into one page
 * whose policy allows only its own script and the jsDelivr paths that code loads Pyodide and sql.js
 * from. Workers started from `data:` URLs inherit this policy.
 */
export async function sandboxPage(): Promise<string> {
  const { outputFiles } = await build({
    absWorkingDir: repoRoot,
    bundle: true,
    entryPoints: ["apps/android/scripts/sandbox/sandbox-page.mts"],
    format: "iife",
    legalComments: "none",
    write: false,
  });

  const script = outputFiles[0]?.text ?? "";
  const runtimes = [...new Set(script.match(RUNTIME_URL))].toSorted().join(" ");
  const hash = createHash("sha256").update(script).digest("base64");

  const policy = [
    "default-src 'none'",
    `script-src 'sha256-${hash}' 'unsafe-eval' 'wasm-unsafe-eval' ${runtimes}`,
    "worker-src data:",
    `connect-src ${runtimes}`,
  ].join("; ");

  return [
    "<!doctype html>",
    `<!-- ${HEADER} -->`,
    '<meta charset="utf-8" />',
    `<meta http-equiv="Content-Security-Policy" content="${policy}" />`,
    `<script>${script}</script>`,
    "",
  ].join("\n");
}
