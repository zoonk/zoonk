<?xml version="1.0" encoding="utf-8"?>
<!-- Only drafts follow the learner to another device: the session stays on the device that signed in, and the rest describes this device. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="drafts/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="drafts/" />
    </device-transfer>
</data-extraction-rules>
