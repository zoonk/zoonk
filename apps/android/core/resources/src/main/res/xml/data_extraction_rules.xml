<?xml version="1.0" encoding="utf-8"?>
<!-- Only drafts follow the learner to another device as files. The session follows through its restore key in Credential Manager, never as a file, so the new phone gets a session of its own; the rest describes this device. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="drafts/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="drafts/" />
    </device-transfer>
</data-extraction-rules>
