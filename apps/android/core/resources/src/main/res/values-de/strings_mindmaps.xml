<resources>
    <!-- How many of the goal's mind maps are drawn: "3 maps". -->
    <plurals name="mindmaps_count">
        <item quantity="one">%1$s Mindmap</item>
        <item quantity="other">%1$s Mindmaps</item>
    </plurals>
    <!-- Under the Mind maps page's title. -->
    <string name="mindmaps_intro">Das Wichtigste aus einem Kapitel in einem Bild. Für jedes Kapitel, das du abschließt, bekommst du eine Mindmap; für jedes andere Kapitel in deinem Plan kannst du eine erstellen.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_intro_lessons_first_free">Die wichtigsten Gedanken eines Kapitels in einem Bild. Für jedes abgeschlossene Kapitel bekommst du eine Mindmap; für jedes andere Kapitel in deinem Plan kannst du eine erstellen. Fehlen die Lektionen noch, erstellen wir sie zuerst. Sie werden auf deine kostenlosen Lektionen angerechnet.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_intro_lessons_first_plus">Die wichtigsten Gedanken eines Kapitels in einem Bild. Für jedes abgeschlossene Kapitel bekommst du eine Mindmap; für jedes andere Kapitel in deinem Plan kannst du eine erstellen. Fehlen die Lektionen noch, erstellen wir sie zuerst. Deshalb dauert es ein paar Minuten.</string>
    <plurals name="mindmaps_chapter_count">
        <item quantity="one">%d Kapitel</item>
        <item quantity="other">%d Kapitel</item>
    </plurals>
    <!-- A mind map row's line under the chapter's title. -->
    <string name="mindmaps_chapter_number">Kapitel %1$s</string>
    <string name="mindmaps_empty_title">Noch keine Mindmaps</string>
    <string name="mindmaps_empty_description">Die Kapitel deines Plans erscheinen hier, sobald du sie erreichst.</string>
    <string name="mindmaps_keep_studying">Weiterlernen</string>
    <!-- A mind map's description for screen readers when it has no words yet. -->
    <string name="mindmaps_alt_chapter">Mindmap zu %1$s</string>
    <!-- A mind map's description for screen readers: its title, then its central idea. -->
    <string name="mindmaps_alt">Mindmap: %1$s. %2$s</string>
    <!-- The same, for a title that already ends a sentence. -->
    <string name="mindmaps_alt_sentence">Mindmap: %1$s %2$s</string>
    <!-- A map whose picture had mistakes, in its row on the Mind maps page; also the viewer's button that shows the map in words. -->
    <string name="mindmaps_as_text">Als Text</string>
    <!-- The viewer's button that shows the map's picture again after it was shown as text. -->
    <string name="mindmaps_as_picture">Als Bild anzeigen</string>
    <!-- The title of a chapter's mind map row on the chapter's page. -->
    <string name="mindmaps_row_title">Mindmap</string>
    <!-- A mind map that can be made, or that's ready, on the chapter's page. -->
    <string name="mindmaps_row_description">Das Wichtigste aus dem Kapitel in einem Bild</string>
    <!-- A chapter whose lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_lessons_first_free">Wir erstellen zuerst die Lektionen des Kapitels und rechnen sie auf deine kostenlosen Lektionen an.</string>
    <!-- A chapter whose lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_lessons_first_plus">Wir erstellen zuerst die Lektionen des Kapitels, deshalb dauert es ein paar Minuten.</string>
    <!-- A chapter on the Mind maps page whose lessons aren't written yet, after its number: "Chapter 4 · Lessons not written yet". -->
    <string name="mindmaps_lessons_not_written">Noch nicht erstellte Lektionen</string>
    <string name="mindmaps_writing_lessons">Wir erstellen zuerst die Lektionen, dann die Mindmap…</string>
    <string name="mindmaps_writing_lessons_wait">Das dauert ein paar Minuten. Du kannst die Seite verlassen; du findest die Mindmap später hier.</string>
    <string name="mindmaps_drawing">Wir zeichnen die Mindmap…</string>
    <string name="mindmaps_drawing_wait">Etwa eine halbe Minute. Du kannst die Seite verlassen; du findest die Mindmap später hier.</string>
    <!-- A finished chapter's mind map that's ready to open, where the chapter ends. -->
    <string name="mindmaps_ready">Mindmap fertig</string>
    <!-- Where a lesson or a test ends, over the row of the chapter it finished and its mind map. -->
    <string name="mindmaps_chapter_finished">Kapitel abgeschlossen</string>
