<resources>
    <!-- A unit's place and its levels: "Unit 3 · A1–A2". -->
    <string name="language_unit_eyebrow">Einheit %1$s · %2$s</string>
    <plurals name="language_unit_lessons">
        <item quantity="one">%d Lektion</item>
        <item quantity="other">%d Lektionen</item>
    </plurals>
    <!-- How much of the unit is done, the unit being the subject: "33% done". -->
    <string name="language_unit_done_share">%1$s abgeschlossen</string>
    <string name="language_unit_start">Starten</string>
    <string name="language_unit_continue">Weiter</string>
    <string name="language_unit_objectives">Am Ende dieser Einheit</string>
    <string name="language_unit_progress">Fortschritt</string>
    <string name="language_unit_practice">Üben</string>
    <string name="language_unit_mistakes">Deine Fehler</string>
    <!-- Heading over material to look things up in, such as grammar tips and words, rather than lessons to do. -->
    <string name="language_unit_reference">Zum Nachschlagen</string>
    <string name="language_unit_grammar_tips">Grammatiktipps</string>
    <string name="language_unit_words">Wörter in dieser Einheit</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s und %2$s weitere</string>
    <string name="language_unit_summary">Zusammenfassung der Einheit</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">Über diese Einheit</string>
    <string name="language_skill_reading">Lesen</string>
    <string name="language_skill_listening">Hören</string>
    <string name="language_skill_speaking">Sprechen</string>
    <string name="language_skill_words">Wörter</string>
    <string name="language_skill_writing">Schreiben</string>
    <!-- Heads each skill's level (reading, listening, speaking, writing) on the CEFR scale from A1 to C2, estimated from the learner's answers to set how hard practice is. -->
    <string name="language_practice_estimates">Geschätzte Level fürs Üben</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">Ziel: %1$s bis %2$s</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">Ziel: %1$s</string>
    <!-- What TalkBack says for a skill's row. %1$s is a CEFR level, such as "B1". -->
    <string name="language_estimate_reading">Geschätztes Level im Lesen: %1$s</string>
    <string name="language_estimate_listening">Geschätztes Level im Hören: %1$s</string>
    <string name="language_estimate_speaking">Geschätztes Level im Sprechen: %1$s</string>
    <string name="language_estimate_writing">Geschätztes Level im Schreiben: %1$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Estimated reading level: B1, up since the level test". -->
    <string name="language_estimate_trend">%1$s, %2$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">seit dem Einstufungstest gestiegen</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">seit dem Einstufungstest gesunken</string>
    <string name="language_levels_move">Deine Level verändern sich beim Üben. Sie werden jede Woche genauer.</string>
    <!-- Under the skill estimates: they set how hard practice is, while certificates come from finishing the plan's lessons. -->
    <string name="language_estimates_note">Diese Einschätzungen bestimmen, wie schwer die Übungen sind. Für Zertifikate zählen die abgeschlossenen Lektionen in deinem Plan.</string>
    <!-- One skill's estimate rose since the level test. %1$s is a CEFR level, such as "B2". -->
    <string name="language_estimate_rose_reading">Dein geschätztes Level im Lesen ist auf %1$s gestiegen</string>
    <string name="language_estimate_rose_listening">Dein geschätztes Level im Hören ist auf %1$s gestiegen</string>
    <string name="language_estimate_rose_speaking">Dein geschätztes Level im Sprechen ist auf %1$s gestiegen</string>
    <string name="language_estimate_rose_writing">Dein geschätztes Level im Schreiben ist auf %1$s gestiegen</string>
    <!-- The count is how many skills' estimates rose since the level test, always two or more; %1$s lists them: "Speaking and Writing estimates went up". -->
    <plurals name="language_estimates_rose">
        <item quantity="one">Die geschätzten Level für %1$s sind gestiegen</item>
        <item quantity="other">Die geschätzten Level für %1$s sind gestiegen</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">Das kann ich schon…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">Noch nicht</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s, Ziel %2$s</string>
    <string name="language_pattern_noticed">Uns ist ein Muster aufgefallen</string>
    <string name="language_pattern_typos">Nur Tippfehler</string>
    <string name="language_pattern_typos_description">Deine letzten Fehler waren Versehen. Du musst dafür keine Regel lernen.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">Sprich %d Wort noch einmal</item>
        <item quantity="other">Sprich %d Wörter noch einmal</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">Als Erstes in deiner nächsten Lerneinheit · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">Jederzeit üben · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">Ich kann es schon lesen</string>
    <string name="language_alphabet_skip_failed">Das wurde nicht gespeichert. Versuch es noch einmal.</string>
    <!-- Button that opens the words to say aloud again; "them" is those words. -->
    <string name="language_say_them">Sprich sie aus</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Öffnen</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">Uns ist ein Muster aufgefallen: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Übe es</string>
    <string name="language_level">Level</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, Ziel %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Sieh dir deinen Plan an</string>
</resources>
