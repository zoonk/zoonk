<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">Fokustest</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_about">Etwa %1$s</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="focustest_about_left">Noch etwa %1$s</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">Finde deinen Fokus</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">Finde heraus, wo du anfangen solltest</string>
    <string name="focustest_offer_description_focus">Kurze Fragen zu deinen Prüfungsfächern. Dein Plan überspringt, was du schon weißt, damit mehr Zeit für das bleibt, was du am meisten brauchst.</string>
    <string name="focustest_offer_description">Kurze Fragen zu deinen Prüfungsfächern. Dein Plan überspringt, was du schon weißt.</string>
    <string name="focustest_how_it_works">So funktioniert’s</string>
    <string name="focustest_how_weight_title">Was am meisten zählt, kommt zuerst</string>
    <string name="focustest_how_weight">Der Test beginnt mit den Fächern, die in deiner Prüfung am meisten zählen.</string>
    <string name="focustest_how_grade_title">Es gibt keine Note</string>
    <string name="focustest_how_grade">„Ich weiß es noch nicht“ ist völlig in Ordnung.</string>
    <string name="focustest_how_stop_title">Jederzeit aufhören</string>
    <string name="focustest_how_stop">Jede Antwort wird gespeichert.</string>
    <string name="focustest_how_subjects_title">Durch den Fokus wird nie ein Fach gestrichen</string>
    <string name="focustest_how_subjects">Wenn deine Zeit nicht für alles reicht, bekommen die Fächer mehr Zeit, bei denen du sie am meisten brauchst.</string>
    <!-- The learner's first week of study sessions also asks a few of the test's questions. -->
    <string name="focustest_how_sessions_title">Noch ein paar Fragen in deiner ersten Woche</string>
    <string name="focustest_how_sessions">In deinen Lerneinheiten kommen noch ein paar dieser Fragen dazu. Du kannst das pausieren.</string>
    <string name="focustest_start">Test starten</string>
    <string name="focustest_skip_for_now">Vorerst überspringen</string>
    <string name="focustest_skip_note">Du kannst den Test später über deinen Plan machen.</string>
    <string name="focustest_not_now">Jetzt nicht</string>
    <string name="focustest_resume_title">Deinen Test fortsetzen</string>
    <plurals name="focustest_answers_saved_line">
        <item quantity="one">Deine %d Antwort ist gespeichert.</item>
        <item quantity="other">Deine %d Antworten sind gespeichert.</item>
    </plurals>
    <string name="focustest_continue">Weiter</string>
    <string name="focustest_see_my_result">Mein Ergebnis ansehen</string>
    <!-- Over a test question: its number and the count promised when the sitting started. -->
    <string name="focustest_question_number">Frage %1$d von %2$d</string>
    <string name="focustest_stop">Beenden und meine Antworten verwenden</string>
    <!-- Shown after several "I don't know yet" answers in a row. -->
    <string name="focustest_many_unknown">Hast du das meiste davon noch nicht gelernt? Das ist okay. Du kannst hier aufhören und mit dem Lernen anfangen.</string>
    <string name="focustest_answers_saved_title">Deine Antworten sind gespeichert</string>
    <!-- Above the test's result: nothing the learner answered was lost. -->
    <string name="focustest_answers_saved">Antworten gespeichert</string>
    <!-- The test's result: the exam subjects that need the most study time, most needed first. -->
    <string name="focustest_result_title">Darauf solltest du den Fokus legen</string>
    <string name="focustest_result_description">Grundlage sind deine Antworten und das, was in deiner Prüfung am meisten zählt. Durch den Fokus wird nie ein Fach gestrichen.</string>
    <plurals name="focustest_also_skips">
        <item quantity="one">Dein Plan überspringt außerdem %d Lektion, die du schon kennst.</item>
        <item quantity="other">Dein Plan überspringt außerdem %d Lektionen, die du schon kennst.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">Dein Ausgangspunkt steht fest</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="one">Dein Plan überspringt %d Lektion, deren Inhalte du schon kennst.</item>
        <item quantity="other">Dein Plan überspringt %d Lektionen, deren Inhalte du schon kennst.</item>
    </plurals>
    <string name="focustest_from_basics">Dein Plan beginnt in jedem Fach mit den Grundlagen.</string>
    <string name="focustest_result_current">Dein Plan sieht für diese Fächer mehr Zeit vor.</string>
    <string name="focustest_result_hand_picked">Dein Plan behält deinen gewählten Fokus bei. Das empfiehlt der Test.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
    <string name="focustest_result_declined">Du hast deinen Plan so gelassen, wie er ist. Das schlägt der Test vor.</string>
    <string name="focustest_change_focus">Schwerpunkte ändern</string>
    <string name="focustest_see_all_subjects">Alle Fächer ansehen</string>
    <string name="focustest_subjects">Fächer</string>
    <!-- A switch: the learner's study sessions also ask a few of the test's questions. -->
    <string name="focustest_session_questions">In meinen Lerneinheiten noch ein paar Fragen stellen</string>
    <string name="focustest_session_questions_when">In deiner ersten Woche</string>
    <string name="focustest_done">Fertig</string>
    <string name="focustest_answer_more">Weitere Fragen beantworten</string>
    <!-- The test asks before changing a plan the learner already has. -->
    <string name="focustest_proposal_title">Diesen Fächern mehr Zeit geben?</string>
    <string name="focustest_proposal_description">Deine Lernzeit bis zur Prüfung reicht nicht für alles.</string>
    <string name="focustest_update_plan">Meinen Plan anpassen</string>
    <string name="focustest_proposal_applied">Dein Plan sieht jetzt für diese Fächer mehr Zeit vor.</string>
    <string name="focustest_proposal_declined">Dein Plan bleibt, wie er war.</string>
    <string name="focustest_proposal_undone">Rückgängig gemacht. Dein Plan ist wieder wie zuvor.</string>
    <string name="focustest_undo">Rückgängig machen</string>
    <!-- A short fact beside a subject in a list: every answer the learner gave on it was “I don't know yet”. It is not a grade. -->
    <string name="focustest_not_known_yet">Noch nicht bekannt</string>
    <!-- %1$d answers right of %2$d asked on one subject. -->
    <plurals name="focustest_subject_right">
        <item quantity="one">%1$d von %2$d richtig</item>
        <item quantity="other">%1$d von %2$d richtig</item>
    </plurals>
    <!-- A subject the test hasn't asked a question about yet. -->
    <string name="focustest_not_asked_yet">Noch nicht abgefragt</string>
    <!-- Parts of the exam the test's quick questions can't check, such as the essay. -->
    <string name="focustest_written_not_checked">Schreiben: hier nicht geprüft</string>
    <string name="focustest_listening_not_checked">Hören: hier nicht geprüft</string>
    <string name="focustest_speaking_not_checked">Sprechen: hier nicht geprüft</string>
    <string name="focustest_practical_not_checked">Praktischer Teil: hier nicht geprüft</string>
    <!-- The test's state on the plan: the learner started it and left before the end. -->
    <string name="focustest_in_progress">In Bearbeitung</string>
    <string name="focustest_see_your_result">Dein Ergebnis ansehen</string>
    <!-- The test's state on the plan: the learner paused its questions in their study sessions. -->
    <string name="focustest_paused_in_sessions">In deinen Lerneinheiten pausiert</string>
    <string name="focustest_take_test">Fokustest machen</string>
    <!-- Under the daily time while it's short: %1$s lists up to three exam subjects, such as "Logic, Law and Math". -->
    <string name="focustest_schedule_focus">Bei dieser Lernzeit empfehlen wir, dich mehr auf %1$s zu konzentrieren.</string>
    <!-- On the plan reveal: %1$s is a daily study time, such as "4 hr"; %2$s a date, such as "Dec 10"; %3$s lists up to three exam subjects. -->
    <string name="focustest_reveal_trade_off">Bei %1$s am Tag reicht die Zeit bis zum %2$s nicht für alle Themen. Dieser Plan sieht für %3$s mehr Zeit vor.</string>
    <string name="focustest_what_test_changed">Änderungen durch deinen Test ansehen</string>
    <!-- Today's suggestion to take the test, in the goal's first week, when the learner's time can't cover everything. -->
    <string name="focustest_suggestion_line">Der Fokustest zeigt, welche Fächer die meiste Lernzeit brauchen.</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_suggestion_body">Deine Lernzeit bis zur Prüfung reicht nicht für alles. In etwa %1$s zeigt der Fokustest, welche Fächer die meiste Lernzeit brauchen.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">Alles klar. Du kannst den Test über deinen Plan machen.</string>
    <!-- On a session's test question: skips today's test questions; they're asked another day. -->
    <string name="focustest_not_today">Heute nicht</string>
    <string name="focustest_not_today_failed">Das wurde nicht gespeichert. Versuch es noch einmal.</string>
