    <!-- The test's title for an exam goal without a date. -->
    <string name="focustest_invitation_title">Den richtigen Einstieg finden</string>
    <string name="focustest_invitation_description_focus">Kurze Fragen zu deinen Fächern, zuerst zu denen, die am meisten zählen. Mit deinen Antworten kann dein Plan überspringen, was du schon kennst, und dir Schwerpunkte vorschlagen.</string>
