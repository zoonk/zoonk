<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="placementtest_title">Wissen testen</string>
    <string name="placementtest_skip_lessons">Lektion überspringen, die du schon kennst</string>
    <string name="placementtest_level_title">Leveltest</string>
    <string name="placementtest_find_level">Finde dein Level und überspringe, was du schon kennst</string>
    <string name="placementtest_in_progress">In Bearbeitung</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Keine Lektionen ausgelassen</string>
    <!-- The title after a placement test: how many lessons it took out of the plan. -->
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d Lektion ausgelassen</item>
        <item quantity="other">%d Lektionen ausgelassen</item>
    </plurals>
    <!-- A CEFR level range the test found for reading, such as “B1–B2”. -->
    <string name="placementtest_reading_range">Lesen %1$s</string>
    <!-- A CEFR level range the test found for listening, such as “B1–B2”. -->
    <string name="placementtest_listening_range">Hören %1$s</string>
    <string name="placementtest_start_title">Überspringen, was du schon weißt</string>
    <string name="placementtest_choose_description">Ein Test findet heraus, welche Lektionen du überspringen kannst.</string>
    <string name="placementtest_about">Etwa %1$s</string>
    <!-- A short test of one language level, such as “Test out of B2”. -->
    <string name="placementtest_test_out">Mit Test %1$s überspringen</string>
    <string name="placementtest_test_out_description">%1$s überspringen, wenn du es schon kennst</string>
    <string name="placementtest_start">Starten</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Du kennst die Lektion schon. Sie bleibt Teil deiner Wiederholungen.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Du kennst die Lektionen schon. Sie bleiben Teil deiner Wiederholungen.</string>
    <string name="placementtest_retake_tomorrow">Du hast diese heute wieder in den Test aufgenommen. Beantworte sie morgen noch einmal, um sie zu überspringen.</string>
    <string name="placementtest_up_next">Als Nächstes</string>
    <string name="placementtest_done">Fertig</string>
    <string name="placementtest_not_now">Jetzt nicht</string>
    <string name="placementtest_your_level">Dein Level in %1$s</string>
    <string name="placementtest_keeps_adjusting">Deine Lektionen passen sich deinen Antworten an.</string>
    <string name="placementtest_level_stays">%1$s bleibt in deinem Plan</string>
    <string name="placementtest_test_out_unavailable">Für %1$s gibt es noch nicht genug Fragen.</string>
    <string name="placementtest_offer_title">Das sieht leicht für dich aus</string>
    <string name="placementtest_offer_quick">Mit einem kurzen Test kannst du Lektionen überspringen, die du schon kennst.</string>
    <string name="placementtest_offer_level">Mit einem kurzen Test kannst du %1$s überspringen, wenn du es schon kennst.</string>
    <string name="placementtest_where_to_start">Wo möchtest du anfangen?</string>
    <string name="placementtest_first_lesson">Erste Lektion</string>
    <!-- The most questions a test asks. It can end sooner. -->
    <plurals name="placementtest_up_to_questions">
        <item quantity="one">Bis zu %d Frage</item>
        <item quantity="other">Bis zu %d Fragen</item>
    </plurals>
    <string name="placementtest_finish_later">Später abschließen</string>
    <string name="placementtest_start_lesson">Lektion starten</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="one">%d Lektion ausgelassen, die du schon kennst.</item>
        <item quantity="other">%d Lektionen ausgelassen, die du schon kennst.</item>
    </plurals>
    <!-- On a level test's result when listening wasn't tested, such as after the learner said they can't listen now. -->
    <string name="placementtest_take_again_later">Du kannst den Test später noch einmal in deinem Plan machen.</string>
    <string name="placementtest_not_tested">Noch nicht geprüft</string>
    <!-- The name of a course's placement test, on the card that offers it. -->
    <string name="placementtest_test">Einstufungstest</string>
    <!-- Over the name of the chapter a course's placement test starts the learner in. -->
    <string name="placementtest_you_start_here">Hier startest du</string>
    <!-- Under a picture of a course, after a placement test: how many of the course's lessons the test skipped, out of all of them. -->
    <plurals name="placementtest_course_skipped">
        <item quantity="one">%1$d von %2$d Lektionen übersprungen</item>
        <item quantity="other">%1$d von %2$d Lektionen übersprungen</item>
    </plurals>
    <plurals name="placementtest_course_lessons">
        <item quantity="one">%d Lektion</item>
        <item quantity="other">%d Lektionen</item>
    </plurals>
</resources>
