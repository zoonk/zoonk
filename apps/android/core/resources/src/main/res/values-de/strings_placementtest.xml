<resources>
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">Test deines Wissens</string>
    <string name="placementtest_skip_lessons">Überspringe Lektionen, die du schon kennst</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">Einstufungstest</string>
    <string name="placementtest_find_level">Finde dein Level und überspringe, was du schon kennst</string>
    <string name="placementtest_in_progress">In Bearbeitung</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="placementtest_time_left">Noch %1$s</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Keine Lektionen übersprungen</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d Lektion übersprungen</item>
        <item quantity="other">%d Lektionen übersprungen</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">Lesen %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">Hören %1$s</string>
    <string name="placementtest_choose_title">Wie viel möchtest du testen?</string>
    <!-- The short placement test: about four minutes of questions. -->
    <string name="placementtest_quick">Kurz</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">Etwa %1$s</string>
    <!-- The long placement test: it checks every topic still ahead in the course. -->
    <string name="placementtest_whole_course">Ganzer Kurs</string>
    <!-- %1$s is a duration with its unit, such as "30 min". The test is split into parts the learner can take on different days. -->
    <string name="placementtest_about_in_parts">Etwa %1$s, in mehreren Teilen</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_in_parts">In mehreren Teilen</string>
    <string name="placementtest_test_out">Mit Test %1$s überspringen</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">Überspringe %1$s, wenn du es schon kannst</string>
    <string name="placementtest_choose_note">Du kannst jederzeit aufhören. Lektionen, die du schon kennst, werden weiterhin übersprungen.</string>
    <string name="placementtest_start">Starten</string>
    <!-- A whole-course test is split into parts; %1$d is the part's number. -->
    <string name="placementtest_part">Teil %1$d</string>
    <string name="placementtest_continue_title">Deinen Test fortsetzen</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="placementtest_left_saved">Noch etwa %1$s. Deine Antworten sind gespeichert.</string>
    <string name="placementtest_continue_from_plan">Du kannst den Test im Plan abschließen.</string>
    <string name="placementtest_finish_for_today">Für heute beenden</string>
    <string name="placementtest_keep_going">Weiter</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <plurals name="placementtest_known">
        <item quantity="one">Du kennst die Lektion schon. Sie bleibt in deinen Wiederholungen.</item>
        <item quantity="other">Du kennst die Lektionen schon. Sie bleiben in deinen Wiederholungen.</item>
    </plurals>
    <string name="placementtest_plan_stays">Dein Plan bleibt, wie er ist.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">Als Nächstes</string>
    <string name="placementtest_whole_course_skips_more">Mit dem Test für den ganzen Kurs kannst du mehr Lektionen überspringen.</string>
    <string name="placementtest_done">Geschafft</string>
    <string name="placementtest_not_now">Jetzt nicht</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">Dein %1$s-Level</string>
    <!-- %2$s is a list of language levels, such as "A1, A2". The plan no longer has their lessons. -->
    <plurals name="placementtest_levels_skipped">
        <item quantity="one">Wir haben %2$s übersprungen: %1$d Lektion.</item>
        <item quantity="other">Wir haben %2$s übersprungen: %1$d Lektionen.</item>
    </plurals>
    <string name="placementtest_keeps_adjusting">Deine Lektionen passen sich deinen Antworten an.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$s bleibt in deinem Plan</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">Für %1$s gibt es noch nicht genug Fragen.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">Das scheint dir leichtzufallen</string>
    <string name="placementtest_offer_quick">Mit einem kurzen Test kannst du Lektionen überspringen, die du schon kennst.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">Mit einem kurzen Test kannst du %1$s überspringen, wenn du es schon kannst.</string>
    <string name="placementtest_check_my_level">Mein Level prüfen</string>
</resources>
