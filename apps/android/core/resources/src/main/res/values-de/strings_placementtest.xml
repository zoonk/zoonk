<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">Wissen testen</string>
    <string name="placementtest_skip_lessons">Lektion überspringen, die du schon kennst</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">Leveltest</string>
    <string name="placementtest_find_level">Finde dein Level und überspringe, was du schon kennst</string>
    <string name="placementtest_in_progress">In Bearbeitung</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Keine Lektionen ausgelassen</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d Lektion ausgelassen</item>
        <item quantity="other">%d Lektionen ausgelassen</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">Lesen %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">Hören %1$s</string>
    <string name="placementtest_start_title">Überspringen, was du schon weißt</string>
    <string name="placementtest_choose_description">Ein Test findet heraus, welche Lektionen du überspringen kannst.</string>
    <!-- The short test: about six minutes of questions. -->
    <string name="placementtest_quick">Kurzer Test</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">Etwa %1$s</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_test_out">Mit Test %1$s überspringen</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">%1$s überspringen, wenn du es schon kennst</string>
    <string name="placementtest_start">Starten</string>
    <string name="placementtest_continue_title">Deinen Test fortsetzen</string>
    <string name="placementtest_keep_going">Weitermachen</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Du kennst die Lektion schon. Sie bleibt Teil deiner Wiederholungen.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Du kennst die Lektionen schon. Sie bleiben Teil deiner Wiederholungen.</string>
    <string name="placementtest_plan_stays">Dein Plan bleibt, wie er ist.</string>
    <string name="placementtest_retake_tomorrow">Du hast diese heute wieder in den Test aufgenommen. Beantworte sie morgen noch einmal, um sie zu überspringen.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">Als Nächstes</string>
    <string name="placementtest_done">Fertig</string>
    <string name="placementtest_not_now">Jetzt nicht</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">Dein Level in %1$s</string>
    <string name="placementtest_keeps_adjusting">Deine Lektionen passen sich deinen Antworten an.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$s bleibt in deinem Plan</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">Für %1$s gibt es noch nicht genug Fragen.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">Das sieht leicht für dich aus</string>
    <string name="placementtest_offer_quick">Mit einem kurzen Test kannst du Lektionen überspringen, die du schon kennst.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">Mit einem kurzen Test kannst du %1$s überspringen, wenn du es schon kennst.</string>
    <string name="placementtest_where_to_start">Wo möchtest du anfangen?</string>
    <string name="placementtest_first_lesson">Erste Lektion</string>
    <string name="placementtest_first_lesson_line">Beginnt auf dem von dir angegebenen Level</string>
    <!-- The long test: it checks every topic still ahead, in parts. -->
    <string name="placementtest_full_test">Vollständiger Test</string>
    <!-- How many parts the long test has. The learner can take each part on a different day. -->
    <plurals name="placementtest_parts_any_day">
        <item quantity="one">%d Teil, an einem Tag deiner Wahl</item>
        <item quantity="other">%d Teile, an einem Tag deiner Wahl</item>
    </plurals>
    <plurals name="placementtest_questions">
        <item quantity="one">%d Frage</item>
        <item quantity="other">%d Fragen</item>
    </plurals>
    <!-- Where the learner is in a test split into parts, such as “Part 3 of 14”. -->
    <string name="placementtest_part_of">Teil %1$d von %2$d</string>
    <!-- The title after one part of a test split into parts, such as “Part 3 of 14 done”. -->
    <string name="placementtest_part_done" tools:ignore="PluralsCandidate">Teil %1$d von %2$d abgeschlossen</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <string name="placementtest_part_skipped_none">In diesem Teil wurden keine Lektionen übersprungen.</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <plurals name="placementtest_part_skipped">
        <item quantity="one">In diesem Teil wurde %d Lektion übersprungen, die du schon kennst.</item>
        <item quantity="other">In diesem Teil wurden %d Lektionen übersprungen, die du schon kennst.</item>
    </plurals>
    <!-- How many parts of a test the learner still has to take. -->
    <plurals name="placementtest_parts_left">
        <item quantity="one">Noch %d Teil</item>
        <item quantity="other">Noch %d Teile</item>
    </plurals>
    <string name="placementtest_finish_later">Später abschließen</string>
    <!-- Where a learner who stopped a test picks it up: the part of the test and the question in it. -->
    <string name="placementtest_next_time">Nächstes Mal: Teil %1$d von %2$d, Frage %3$d</string>
    <string name="placementtest_start_lesson">Lektion starten</string>
    <!-- Button after the short test: goes on to test the rest of the course, in parts. -->
    <string name="placementtest_test_the_rest">Rest testen</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="one">%d Lektion übersprungen, die du schon kennst.</item>
        <item quantity="other">%d Lektionen übersprungen, die du schon kennst.</item>
    </plurals>
    <string name="placementtest_listening_later">Du kannst das Hörverständnis später in deinem Plan testen.</string>
    <string name="placementtest_not_tested">Noch nicht geprüft</string>
    <string name="placementtest_about_left">Noch etwa %1$s</string>
</resources>
