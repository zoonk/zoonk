<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">Lernerinnerungen</string>
    <!-- Under the channel's name in Android's settings, and under the Reminders page's title. -->
    <string name="reminders_channel_description">Eine Erinnerung an deinen Lerntagen, wenn du noch etwas zu lernen hast.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">Sollen wir dich ans Lernen erinnern?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">An deinen Lerntagen um %1$s, wenn du noch etwas zu lernen hast.</string>
    <string name="reminders_remind_me">Erinnerung aktivieren</string>
    <!-- Declines the offer, which isn't shown again. Portuguese: "Agora não" (ungendered). -->
    <string name="reminders_no_thanks">Nein, danke</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">Erinnerungen sind aktiviert.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">E-Mail-Erinnerungen sind aktiviert.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Benachrichtigungen für Zoonk sind deaktiviert.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">Einstellungen öffnen</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">Stattdessen per E-Mail erinnern lassen</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">Benachrichtigungen erlauben?</string>
    <string name="reminders_permission_body">Zoonk schickt dir an deinen Lerntagen nur dann eine Erinnerung, wenn du noch etwas zu lernen hast.</string>
    <string name="reminders_permission_continue">Weiter</string>
    <string name="reminders_not_now">Jetzt nicht</string>
    <!-- The title of the clock that changes the reminder's time. -->
    <string name="reminders_time_title">Uhrzeit der Erinnerung</string>
    <string name="reminders_save">Speichern</string>
    <string name="reminders_cancel">Abbrechen</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">Erinnerungen</string>
    <!-- The time of day a reminder goes out, not an amount of time. -->
    <string name="reminders_time">Uhrzeit</string>
    <string name="reminders_email">E-Mail</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">Konto erstellen, um E-Mail-Erinnerungen zu erhalten</string>
    <string name="reminders_push">Push-Benachrichtigungen</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">An den Lerntagen aus deinen Plänen</string>
    <string name="reminders_quiet">Pausiert, solange du weg bist. Sobald du wieder lernst, sind die Erinnerungen wieder aktiv.</string>
    <string name="reminders_save_failed">Das wurde nicht gespeichert. Versuch es noch einmal.</string>
    <!-- Push reminders go to another of the learner's devices; this one can take over. -->
    <string name="reminders_use_this_device">Dieses Gerät verwenden</string>
    <!-- After the selected device's name, such as "Pixel 9 · This device", when it's the device in hand. -->
    <string name="reminders_this_device">Dieses Gerät</string>
</resources>
