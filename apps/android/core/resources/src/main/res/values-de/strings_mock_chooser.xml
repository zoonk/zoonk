<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Probeprüfung machen</string>
    <string name="mock_chooser_line">Mit Zeitlimit wie in der echten Prüfung. Dein Ergebnis siehst du am Ende.</string>
    <string name="mock_chooser_start">Starten</string>
    <string name="mock_chooser_one_subject">Ein Fach</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">Die Prüfung</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">Tag %1$d</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">Hälfte von Tag %1$d</string>
    <string name="mock_chooser_full_exam">Die ganze Prüfung</string>
    <string name="mock_chooser_half_exam">Die halbe Prüfung</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">Tag %1$d, ohne %2$s</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">Die ganze Prüfung, ohne %1$s</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">Ohne schriftlichen Teil</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d Frage · %2$s</item>
        <item quantity="other">%1$d Fragen · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">Dafür gibt es noch nicht genug Fragen. Wähl eine andere.</string>
    <string name="mock_chooser_failed">Wir konnten die Probeprüfung nicht starten. Versuch es noch einmal.</string>
    <string name="mock_chooser_short_title">Kürzere Probeprüfung starten?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_day">Diese Probeprüfung hat heute %1$s von %2$s Fragen und dauert etwa %3$s Morgen kannst du die ganze Probeprüfung machen.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">Diese Probeprüfung hat heute %1$s von %2$s Fragen und dauert etwa %3$s Nächsten Monat kannst du die ganze Probeprüfung machen.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">Diese Probeprüfung hat heute %1$s von %2$s Fragen und dauert etwa %3$s</string>
    <string name="mock_chooser_pick_another">Andere Probeprüfung wählen</string>
    <string name="mock_chooser_preparing">Wir bereiten deine Probeprüfung vor…</string>
    <string name="mock_chooser_preparing_detail">Wir erstellen für dich Fragen wie in der Prüfung. Sobald sie bereit sind, beginnt deine Probeprüfung hier.</string>
    <string name="mock_chooser_writing">Wir erstellen deine Probeprüfung</string>
    <string name="mock_chooser_writing_questions">Wir erstellen Fragen wie in der Prüfung</string>
    <string name="mock_chooser_writing_questions_line">Wir wählen die Fragen für jedes Fach aus…</string>
    <!-- The panel beside the options, about the one picked. -->
    <string name="mock_chooser_picked">Die gewählte Probeprüfung</string>
    <string name="mock_chooser_questions">Fragen</string>
    <string name="mock_chooser_time_limit">Zeitlimit</string>
    <string name="mock_chooser_usually_takes">Dauert normalerweise</string>
    <!-- %1$s is a duration, such as "1 hr 20 min". -->
    <string name="mock_chooser_about">Etwa %1$s</string>
    <string name="mock_chooser_subjects">Fächer</string>
    <!-- The exam's sections a mock sits, such as Listening and Reading. -->
    <string name="mock_chooser_parts">Teile</string>
    <!-- Under a part such as "Essay", which the learner writes rather than answers. -->
    <string name="mock_chooser_written_part">Schriftlicher Teil</string>
    <string name="mock_chooser_last_mock">Deine letzte Probeprüfung</string>
    <!-- %1$s is a past exam edition, such as "2024 exam"; %2$s the site that counted its questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_past_edition">Fragen pro Fach in %1$s, gezählt von %2$s.</string>
    <!-- %1$s is the site that counted the questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_latest_exam">Fragen pro Fach in der letzten Prüfung, gezählt von %1$s.</string>
