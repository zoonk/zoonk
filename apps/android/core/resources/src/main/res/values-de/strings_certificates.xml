    <string name="certificates_empty_title">Noch keine Zertifikate</string>
    <string name="certificates_empty_description">Wenn du einen Kurs oder ein Sprachlevel abschließt, findest du hier dein Zertifikat zum kostenlosen Ausdrucken und Teilen. Auch das Ergebnis eines Einstufungstests erscheint hier.</string>
    <string name="certificates_continue_learning">Weiterlernen</string>
    <!-- A section title on the empty page, over the learner's goals and how each one earns a certificate. -->
    <!-- On a finished plan's card: opens the course's certificate. -->
    <string name="certificates_view">Zertifikat ansehen</string>
