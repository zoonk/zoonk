    </plurals>
    <string name="certificates_lead">Du kannst deine Zertifikate jederzeit ausdrucken, herunterladen oder teilen.</string>
    <!-- What a certificate certifies: a finished course or a finished language level. Printed on the certificate itself. -->
    <string name="certificates_kind_completion">Abschlusszertifikat</string>
    <!-- A certificate stating the language level a placement test measured, such as "Spanish B1". -->
    <string name="certificates_kind_placement">Einstufungsergebnis</string>
    <!-- A language certificate's name: %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
