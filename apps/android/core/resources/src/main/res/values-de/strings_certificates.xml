    <string name="certificates_up_next">Als Nächstes</string>
    <string name="certificates_up_next_course">Du bekommst dein Zertifikat, wenn du den Plan abschließt und mindestens die Hälfte seiner Lektionen bearbeitet hast</string>
    <!-- The title of a full screen shown once, right after the learner finishes every lesson of a course. -->
    <string name="certificates_course_complete">Kurs abgeschlossen!</string>
    <string name="certificates_level_complete">%1$s abgeschlossen!</string>
    <!-- The title when the learner earned two or more certificates at once. -->
    <plurals name="certificates_earned">
