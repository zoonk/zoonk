<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">Recordatorios de estudio</string>
    <string name="reminders_channel_description">Un recordatorio en tus días de estudio, si aún te queda algo por estudiar.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">¿Quieres un recordatorio para estudiar?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">A las %1$s en tus días de estudio, si aún te queda algo por estudiar.</string>
    <string name="reminders_remind_me">Recordarme</string>
    <!-- Declines the offer. Keep it neutral and ungendered, like "Not now" (Portuguese: "Agora não"). -->
    <string name="reminders_no_thanks">Ahora no</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">Los recordatorios están activados.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">Los recordatorios por correo están activados.</string>
    <string name="reminders_turn_on_failed">No pudimos activar los recordatorios. Inténtalo de nuevo.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Las notificaciones de Zoonk están desactivadas.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">Abrir Configuración</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">Recibirlos por correo</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">¿Permitir notificaciones?</string>
    <string name="reminders_permission_body">Zoonk envía un recordatorio en tus días de estudio, solo si aún te queda algo por estudiar.</string>
    <string name="reminders_permission_continue">Continuar</string>
    <string name="reminders_not_now">Ahora no</string>
    <!-- The row that shows the reminder's time and opens a clock to change it, and that clock's title. -->
    <string name="reminders_time_title">Hora del recordatorio</string>
    <string name="reminders_save">Guardar</string>
    <string name="reminders_cancel">Cancelar</string>
    <!-- The row in Preferences that opens the reminders page. -->
    <string name="reminders_row">Recordatorios de estudio</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">Recordatorios</string>
    <string name="reminders_description">Un recordatorio al día, solo si aún te queda algo por estudiar.</string>
    <string name="reminders_time">Tiempo</string>
    <!-- %1$s is a time of day and %2$s its time zone, such as "7:00 PM, Brasilia Time". -->
    <string name="reminders_time_in_zone">%1$s, %2$s</string>
    <string name="reminders_email">Correo electrónico</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">Crear una cuenta para recibir recordatorios por correo</string>
    <string name="reminders_push">Notificaciones</string>
    <!-- Push reminders go to another of the learner's phones; this one can take over. -->
    <string name="reminders_use_this_phone">Usar este celular</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">En tus días de estudio, según tus planes</string>
    <string name="reminders_quiet">En pausa mientras te tomas un descanso. Se reactivan cuando vuelves a estudiar.</string>
    <string name="reminders_save_failed">No se pudo guardar. Inténtalo de nuevo.</string>
</resources>
