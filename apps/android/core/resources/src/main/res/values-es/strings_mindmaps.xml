<resources>
    <!-- How many of the goal's mind maps are drawn: "3 maps". -->
    <plurals name="mindmaps_count">
        <item quantity="one">%1$s mapa</item>
        <item quantity="many">%1$s mapas</item>
        <item quantity="other">%1$s mapas</item>
    </plurals>
    <!-- Under the Mind maps page's title. -->
    <string name="mindmaps_intro">Las ideas principales de un capítulo en una imagen. Se crea uno para cada capítulo que completas; puedes crear uno para cualquier otro capítulo de tu plan.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_intro_lessons_first_free">Las ideas principales de un capítulo en una sola imagen. Cada capítulo que completes tendrá su mapa; puedes crear uno para cualquier otro capítulo de tu plan. Para crear el mapa de uno de estos capítulos, primero se preparan sus lecciones, que cuentan para tu límite de lecciones gratis.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_intro_lessons_first_plus">Las ideas principales de un capítulo en una sola imagen. Cada capítulo que completes tendrá su mapa; puedes crear uno para cualquier otro capítulo de tu plan. Crear un mapa para uno de estos capítulos requiere preparar primero sus lecciones, así que tarda unos minutos.</string>
    <plurals name="mindmaps_chapter_count">
        <item quantity="one">%d capítulo</item>
        <item quantity="many">%d capítulos</item>
        <item quantity="other">%d capítulos</item>
    </plurals>
    <!-- A mind map row's line under the chapter's title. -->
    <string name="mindmaps_chapter_number">Capítulo %1$s</string>
    <string name="mindmaps_empty_title">Aún no hay mapas mentales</string>
    <string name="mindmaps_empty_description">Los capítulos de tu plan aparecen aquí cuando llegas a ellos.</string>
    <string name="mindmaps_keep_studying">Seguir estudiando</string>
    <!-- A mind map's description for screen readers when it has no words yet. -->
    <string name="mindmaps_alt_chapter">Mapa mental de %1$s</string>
    <!-- A mind map's description for screen readers: its title, then its central idea. -->
    <string name="mindmaps_alt">Mapa mental: %1$s. %2$s</string>
    <!-- The same, for a title that already ends a sentence. -->
    <string name="mindmaps_alt_sentence">Mapa mental: %1$s %2$s</string>
    <!-- A map whose picture had mistakes, in its row on the Mind maps page; also the viewer's button that shows the map in words. -->
    <string name="mindmaps_as_text">En texto</string>
    <!-- The viewer's button that shows the map's picture again after it was shown as text. -->
    <string name="mindmaps_as_picture">Como imagen</string>
    <!-- The title of a chapter's mind map row on the chapter's page. -->
    <string name="mindmaps_row_title">Mapa mental</string>
    <!-- A mind map that can be made, or that's ready, on the chapter's page. -->
    <string name="mindmaps_row_description">Sus ideas principales en una imagen</string>
    <!-- A chapter whose lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_lessons_first_free">Primero se preparan sus lecciones, que se descuentan de tus lecciones gratis.</string>
    <!-- A chapter whose lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_lessons_first_plus">Primero se preparan sus lecciones, así que tarda unos minutos.</string>
    <!-- A chapter on the Mind maps page whose lessons aren't written yet, after its number: "Chapter 4 · Lessons not written yet". -->
    <string name="mindmaps_lessons_not_written">Lecciones aún sin preparar</string>
    <string name="mindmaps_writing_lessons">Preparando las lecciones y luego el mapa mental…</string>
    <string name="mindmaps_writing_lessons_wait">Esto tarda unos minutos. Puedes salir; lo encontrarás aquí.</string>
    <string name="mindmaps_drawing">Dibujando el mapa mental…</string>
    <string name="mindmaps_drawing_wait">Aproximadamente medio minuto. Puedes salir; lo encontrarás aquí.</string>
    <!-- A finished chapter's mind map that's ready to open, where the chapter ends. -->
    <string name="mindmaps_ready">Mapa mental listo</string>
    <!-- Where a lesson or a test ends, over the row of the chapter it finished and its mind map. -->
    <string name="mindmaps_chapter_finished">Capítulo completado</string>
    <!-- Makes a chapter's mind map. -->
    <string name="mindmaps_create">Crear</string>
    <!-- Opens a chapter's mind map. -->
    <string name="mindmaps_open">Abrir</string>
    <string name="mindmaps_try_again">Intentar de nuevo</string>
    <!-- Opens the Plus plans, on a mind map whose chapter is Plus-only. -->
    <string name="mindmaps_see_plus">Ver Plus</string>
    <!-- What screen readers say for a row's Create, naming its chapter. -->
    <string name="mindmaps_create_spoken">Crear el mapa mental de %1$s</string>
    <!-- What screen readers say for a row's Open, naming its chapter. -->
    <string name="mindmaps_open_spoken">Abrir el mapa mental de %1$s</string>
    <!-- What screen readers say for a row's Try again, naming its chapter. -->
    <string name="mindmaps_try_again_spoken">Volver a intentar crear el mapa mental de %1$s</string>
