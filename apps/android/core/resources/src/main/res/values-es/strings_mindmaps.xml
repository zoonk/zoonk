    <string name="mindmaps_in_short">En resumen:</string>
    <string name="mindmaps_zoom_in">Acercar</string>
    <string name="mindmaps_zoom_out">Alejar</string>
    <string name="mindmaps_fit">Ajustar a la pantalla</string>
