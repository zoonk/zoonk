    <string name="focustest_answer_more">Responder más preguntas</string>
    <!-- Headline, above a short list of exam subjects: asks the learner whether their study plan should give those subjects more time. -->
    <string name="focustest_proposal_title">¿Dedicar más tiempo a estas materias?</string>
    <!-- How the Focus test picked the subjects listed below it: from the learner's answers to its questions and how many of the exam's questions each subject has. -->
