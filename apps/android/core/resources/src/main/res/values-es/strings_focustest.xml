    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_suggestion_body">No te alcanza el tiempo para estudiar todo antes de tu examen. En aproximadamente %1$s, la Prueba de enfoque te muestra qué estudiar más.</string>
