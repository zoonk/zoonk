    </plurals>
    <!-- %1$s is the course's title. -->
    <string name="certificates_course_ready">Tu certificado de %1$s está listo.</string>
    <!-- %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
    <string name="certificates_language_ready">Tu certificado de %1$s %2$s está listo.</string>
