        <item quantity="one">%1$d certificado</item>
        <item quantity="many">%1$d certificados</item>
        <item quantity="other">%1$d certificados</item>
    </plurals>
    <string name="certificates_lead">Un certificado por cada nivel y plan que completes.</string>
    <!-- What a certificate certifies: a finished course or a finished language level. Printed on the certificate itself. -->
    <string name="certificates_kind_completion">Certificado de finalización</string>
    <!-- A language certificate's name: %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
    <string name="certificates_language_level">%1$s %2$s</string>
    <!-- A course level's certificate name, such as "Python · Beginner": the course's title, then the level's name. -->
    <string name="certificates_course_level">%1$s · %2$s</string>
    <string name="certificates_empty_title">Aún no tienes certificados</string>
    <string name="certificates_empty_description">Tus certificados aparecerán aquí cuando completes un nivel o un plan.</string>
    <string name="certificates_continue_learning">Seguir aprendiendo</string>
