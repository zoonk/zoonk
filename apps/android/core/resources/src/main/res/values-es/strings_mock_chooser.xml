<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Hacer un simulacro</string>
    <string name="mock_chooser_line">Con límite de tiempo, como en el examen real. Verás tu resultado al final.</string>
    <string name="mock_chooser_start">Empezar</string>
    <string name="mock_chooser_one_subject">Una materia</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">El examen</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">Día %1$d</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">La mitad del día %1$d</string>
    <string name="mock_chooser_full_exam">El examen completo</string>
    <string name="mock_chooser_half_exam">La mitad del examen</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">Día %1$d, sin %2$s</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">El examen completo, sin %1$s</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">Sin parte escrita</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d pregunta · %2$s</item>
        <item quantity="many">%1$d preguntas · %2$s</item>
        <item quantity="other">%1$d preguntas · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">Aún no hay suficientes preguntas para este simulacro. Elige otro.</string>
    <string name="mock_chooser_failed">No pudimos empezar el simulacro. Inténtalo de nuevo.</string>
    <string name="mock_chooser_short_title">¿Empezar un simulacro más corto?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_day">Hoy este simulacro incluye %1$s de sus %2$s preguntas y dura aproximadamente %3$s. Puedes hacerlo completo mañana.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">Hoy este simulacro incluye %1$s de sus %2$s preguntas y dura aproximadamente %3$s. Puedes hacerlo completo el próximo mes.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">Hoy este simulacro incluye %1$s de sus %2$s preguntas y dura aproximadamente %3$s.</string>
    <string name="mock_chooser_pick_another">Elegir otro</string>
    <string name="mock_chooser_preparing">Preparando tu simulacro…</string>
    <string name="mock_chooser_preparing_detail">Estamos preparando para ti preguntas como las del examen. El simulacro empieza aquí en cuanto estén listas.</string>
    <string name="mock_chooser_writing">Preparando tu simulacro</string>
    <string name="mock_chooser_writing_questions">Preparando preguntas como las del examen</string>
    <string name="mock_chooser_writing_questions_line">Eligiendo qué preguntar en cada materia…</string>
    <!-- The panel beside the options, about the one picked. -->
    <string name="mock_chooser_picked">El simulacro elegido</string>
    <string name="mock_chooser_questions">Preguntas</string>
    <string name="mock_chooser_time_limit">Límite de tiempo</string>
    <string name="mock_chooser_usually_takes">Suele durar</string>
    <!-- %1$s is a duration, such as "1 hr 20 min". -->
    <string name="mock_chooser_about">Aproximadamente %1$s</string>
    <string name="mock_chooser_subjects">Materias</string>
    <!-- The exam's sections a mock sits, such as Listening and Reading. -->
    <string name="mock_chooser_parts">Partes</string>
    <!-- Under a part such as "Essay", which the learner writes rather than answers. -->
    <string name="mock_chooser_written_part">Parte escrita</string>
    <string name="mock_chooser_last_mock">Tu último simulacro de examen</string>
    <!-- %1$s is a past exam edition, such as "2024 exam"; %2$s the site that counted its questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_past_edition">Preguntas por materia en el %1$s, según el conteo de %2$s.</string>
    <!-- %1$s is the site that counted the questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_latest_exam">Preguntas por materia en el examen más reciente, según el conteo de %1$s.</string>
</resources>
