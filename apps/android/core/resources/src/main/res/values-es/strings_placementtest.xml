<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="placementtest_title">Comprobar lo que sabes</string>
    <string name="placementtest_skip_lessons">Saltar las lecciones que ya conoces</string>
    <string name="placementtest_level_title">Prueba de nivel</string>
    <string name="placementtest_find_level">Encontrar tu nivel y saltar lo que ya sabes</string>
    <string name="placementtest_in_progress">En curso</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">No se saltaron lecciones</string>
    <!-- The title after a placement test: how many lessons it took out of the plan. -->
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">Se saltó %d lección</item>
        <item quantity="many">Se saltaron %d lecciones</item>
        <item quantity="other">Se saltaron %d lecciones</item>
    </plurals>
    <!-- A CEFR level range the test found for reading, such as “B1–B2”. -->
    <string name="placementtest_reading_range">Lectura %1$s</string>
    <!-- A CEFR level range the test found for listening, such as “B1–B2”. -->
    <string name="placementtest_listening_range">Escucha %1$s</string>
    <string name="placementtest_start_title">Sáltate lo que ya sabes</string>
    <string name="placementtest_choose_description">Una prueba identifica las lecciones que puedes saltarte.</string>
    <!-- The short test: about six minutes of questions. -->
    <string name="placementtest_quick">Prueba rápida</string>
    <string name="placementtest_about">Aproximadamente %1$s</string>
    <!-- A short test of one language level, such as “Test out of B2”. -->
    <string name="placementtest_test_out">Hacer una prueba de %1$s</string>
    <string name="placementtest_test_out_description">Saltar %1$s si ya lo conoces</string>
    <string name="placementtest_start">Empezar</string>
    <string name="placementtest_continue_title">Continuar tu prueba</string>
    <string name="placementtest_keep_going">Seguir</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Ya conocías la lección. Se queda en tus repasos.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Ya conocías las lecciones. Se quedan en tus repasos.</string>
    <string name="placementtest_plan_stays">Tu plan sigue igual.</string>
    <string name="placementtest_retake_tomorrow">Hoy decidiste volver a hacer estas lecciones. Respóndelas de nuevo mañana para saltártelas.</string>
    <string name="placementtest_up_next">A continuación</string>
    <string name="placementtest_done">Listo</string>
    <string name="placementtest_not_now">Ahora no</string>
    <string name="placementtest_your_level">Tu nivel de %1$s</string>
    <string name="placementtest_keeps_adjusting">Tus lecciones se ajustan a medida que respondes.</string>
    <string name="placementtest_level_stays">%1$s se mantiene en tu plan</string>
    <string name="placementtest_test_out_unavailable">Aún no hay suficientes preguntas para %1$s.</string>
    <string name="placementtest_offer_title">Esto parece fácil para ti</string>
    <string name="placementtest_offer_quick">Una prueba rápida puede saltar las lecciones que ya conoces.</string>
    <string name="placementtest_offer_level">Una prueba corta puede saltar %1$s si ya lo sabes.</string>
    <string name="placementtest_where_to_start">¿Dónde te gustaría empezar?</string>
    <string name="placementtest_first_lesson">Primera lección</string>
    <string name="placementtest_first_lesson_line">Empieza en el nivel que indicaste</string>
    <!-- The long test: it checks every topic still ahead, in parts. -->
    <string name="placementtest_full_test">Prueba completa</string>
    <!-- How many parts the long test has. The learner can take each part on a different day. -->
    <plurals name="placementtest_parts_any_day">
        <item quantity="one">%d parte, el día que quieras</item>
        <item quantity="many">%d partes, el día que quieras</item>
        <item quantity="other">%d partes, el día que quieras</item>
    </plurals>
    <!-- The most questions a test asks. It can end sooner. -->
    <plurals name="placementtest_up_to_questions">
        <item quantity="one">Hasta %d pregunta</item>
        <item quantity="many">Hasta %d preguntas</item>
        <item quantity="other">Hasta %d preguntas</item>
    </plurals>
    <!-- Where the learner is in a test split into parts, such as “Part 3 of 14”. -->
    <string name="placementtest_part_of">Parte %1$d de %2$d</string>
    <!-- The title after one part of a test split into parts, such as “Part 3 of 14 done”. -->
    <string name="placementtest_part_done" tools:ignore="PluralsCandidate">Parte %1$d de %2$d completada</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <string name="placementtest_part_skipped_none">No se saltaron lecciones en esta parte.</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <plurals name="placementtest_part_skipped">
        <item quantity="one">Esta parte marcó como conocida %d lección que ya conocías.</item>
        <item quantity="many">Esta parte marcó como conocidas %d lecciones que ya conocías.</item>
        <item quantity="other">Esta parte marcó como conocidas %d lecciones que ya conocías.</item>
    </plurals>
    <!-- How many parts of a test the learner still has to take. -->
    <plurals name="placementtest_parts_left">
        <item quantity="one">%d parte pendiente</item>
        <item quantity="many">%d partes pendientes</item>
        <item quantity="other">%d partes pendientes</item>
    </plurals>
    <string name="placementtest_finish_later">Terminar después</string>
    <!-- Where a learner who stopped a test picks it up: the part of the test and the question in it. -->
    <string name="placementtest_next_time">Próxima vez: parte %1$d de %2$d, pregunta %3$d</string>
    <string name="placementtest_start_lesson">Empezar lección</string>
    <!-- Button after the short test: goes on to test the rest of the course, in parts. -->
    <string name="placementtest_test_the_rest">Hacer la prueba del resto</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="one">Se saltó %d lección que ya conoces.</item>
        <item quantity="many">Se saltaron %d lecciones que ya conoces.</item>
        <item quantity="other">Se saltaron %d lecciones que ya conoces.</item>
    </plurals>
    <!-- On a level test's result when listening wasn't tested, such as after the learner said they can't listen now. -->
    <string name="placementtest_take_again_later">Puedes volver a hacer la prueba más adelante desde tu plan.</string>
    <string name="placementtest_not_tested">Aún no se evaluó</string>
    <string name="placementtest_about_left">Quedan aproximadamente %1$s</string>
</resources>
