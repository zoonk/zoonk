<resources>
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">Comprobar lo que sabes</string>
    <string name="placementtest_skip_lessons">Saltar las lecciones que ya conoces</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">Prueba de nivel</string>
    <string name="placementtest_find_level">Encontrar tu nivel y saltar lo que ya sabes</string>
    <string name="placementtest_in_progress">En curso</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="placementtest_time_left">Tiempo restante: %1$s</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">No se saltaron lecciones</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">Se saltó %d lección</item>
        <item quantity="many">Se saltaron %d lecciones</item>
        <item quantity="other">Se saltaron %d lecciones</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">Lectura %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">Escucha %1$s</string>
    <string name="placementtest_start_title">Sáltate lo que ya sabes</string>
    <string name="placementtest_choose_description">Una prueba identifica las lecciones que puedes saltarte.</string>
    <string name="placementtest_quick_only_description">Una prueba rápida identifica las lecciones que puedes saltarte. Dura aproximadamente %1$s.</string>
    <string name="placementtest_choose_title">¿Qué tanto quieres comprobar?</string>
    <!-- The short placement test: about four minutes of questions. -->
    <string name="placementtest_quick">Rápida</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">Aproximadamente %1$s</string>
    <!-- The long placement test: it checks every topic still ahead in the course. -->
    <string name="placementtest_whole_course">Curso completo</string>
    <!-- %1$s is a duration with its unit, such as "30 min". The test is split into parts the learner can take on different days. -->
    <string name="placementtest_about_in_parts">Aproximadamente %1$s, en partes</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_test_out">Hacer una prueba de %1$s</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">Saltar %1$s si ya lo conoces</string>
    <string name="placementtest_start">Empezar</string>
    <!-- A whole-course test is split into parts; %1$d is the part's number. -->
    <string name="placementtest_part">Parte %1$d</string>
    <string name="placementtest_continue_title">Continuar tu prueba</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="placementtest_left_saved">Queda aproximadamente %1$s. Tus respuestas están guardadas.</string>
    <string name="placementtest_continue_from_plan">Puedes terminar la prueba desde Plan.</string>
    <string name="placementtest_finish_for_today">Terminar por hoy</string>
    <string name="placementtest_keep_going">Seguir</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Ya conocías la lección. Se queda en tus repasos.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Ya conocías las lecciones. Se quedan en tus repasos.</string>
    <string name="placementtest_plan_stays">Tu plan sigue igual.</string>
    <string name="placementtest_retake_tomorrow">Hoy decidiste volver a hacer estas lecciones. Respóndelas de nuevo mañana para saltártelas.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">A continuación</string>
    <string name="placementtest_whole_course_skips_more">La prueba del curso completo puede saltar más.</string>
    <string name="placementtest_done">Listo</string>
    <string name="placementtest_not_now">Ahora no</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">Tu nivel de %1$s</string>
    <!-- %2$s is a list of language levels, such as "A1, A2". The plan no longer has their lessons. -->
    <plurals name="placementtest_levels_skipped">
        <item quantity="one">Saltamos %2$s: %1$d lección.</item>
        <item quantity="many">Saltamos %2$s: %1$d lecciones.</item>
        <item quantity="other">Saltamos %2$s: %1$d lecciones.</item>
    </plurals>
    <string name="placementtest_keeps_adjusting">Tus lecciones se ajustan a medida que respondes.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$s se mantiene en tu plan</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">Aún no hay suficientes preguntas para %1$s.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">Esto parece fácil para ti</string>
    <string name="placementtest_offer_quick">Una prueba rápida puede saltar las lecciones que ya conoces.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">Una prueba corta puede saltar %1$s si ya lo sabes.</string>
</resources>
