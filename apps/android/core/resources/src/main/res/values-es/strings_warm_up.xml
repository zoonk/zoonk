<resources>
    <!-- Heading of a card of quick guessing questions about the learner's subject, shown while their plan or lesson is being written. -->
    <string name="warm_up_title">Adivina mientras esperas</string>
    <!-- Button under a guessed question's answer: shows the next question. -->
    <string name="warm_up_next">Seguir adivinando</string>
    <!-- Under the last question's answer: there are no more questions to guess. -->
    <string name="warm_up_deck_end">Eso es todo por ahora.</string>
    <!-- Under a warm-up question: a guess never counts -->
    <string name="warm_up_guess_hint">Equivocarte ahora te ayuda a recordar después.</string>
    <!-- Title of the plan's wait once the plan is ready and the learner is still guessing. -->
    <string name="warm_up_plan_ready">Tu plan está listo</string>
    <!-- Under "Your plan is ready" on the daily study time question, which comes before the plan shows. -->
    <string name="warm_up_plan_ready_one_question">Una última pregunta y podrás verlo.</string>
    <!-- Under "Your plan is ready" on the step that shows the plan. -->
    <string name="warm_up_plan_ready_whenever">Puedes verlo cuando quieras.</string>
    <!-- Title of the wait for a short level test's questions once they're ready and the learner is still guessing. -->
    <string name="warm_up_questions_ready">Tus preguntas están listas</string>
    <!-- Under "Your questions are ready", above the button that starts the short level test. -->
    <string name="warm_up_questions_ready_description">Empieza cuando quieras.</string>
    <!-- Replaces the note under a lesson's writing progress once it's written and the learner is still guessing. -->
    <string name="warm_up_lesson_ready">Tu lección está lista. Empieza cuando quieras.</string>
