<resources>
    <!-- A unit's place and its levels: "Unit 3 · A1–A2". -->
    <string name="language_unit_eyebrow">Unidad %1$s · %2$s</string>
    <plurals name="language_unit_lessons">
        <item quantity="one">%d lección</item>
        <item quantity="many">%d lecciones</item>
        <item quantity="other">%d lecciones</item>
    </plurals>
    <!-- How much of the unit is done, the unit being the subject: "33% done". -->
    <string name="language_unit_done_share">%1$s completada</string>
    <string name="language_unit_start">Empezar</string>
    <string name="language_unit_continue">Continuar</string>
    <string name="language_unit_objectives">Al terminar esta unidad</string>
    <string name="language_unit_progress">Progreso</string>
    <string name="language_unit_practice">Práctica</string>
    <string name="language_unit_mistakes">Tus errores</string>
    <!-- Heading over material to look things up in, such as grammar tips and words, rather than lessons to do. -->
    <string name="language_unit_reference">Para consultar</string>
    <string name="language_unit_grammar_tips">Consejos de gramática</string>
    <string name="language_unit_words">Palabras de esta unidad</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s y %2$s más</string>
    <string name="language_unit_summary">Resumen de la unidad</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">Sobre esta unidad</string>
    <string name="language_skill_reading">Lectura</string>
    <string name="language_skill_listening">Escucha</string>
    <string name="language_skill_speaking">Expresión oral</string>
    <string name="language_skill_words">Vocabulario</string>
    <string name="language_skill_writing">Expresión escrita</string>
    <!-- Heads the learner's level in each skill (reading, listening, speaking, writing), on the CEFR scale from A1 to C2. -->
    <string name="language_level_by_skill">Nivel por habilidad</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">Objetivo %1$s para %2$s</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">Objetivo %1$s</string>
    <!-- What TalkBack says for a skill's row: "Reading, B1". -->
    <string name="language_skill_level">%1$s, %2$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Reading, B1, up since the level test". -->
    <string name="language_skill_level_trend">%1$s, %2$s, %3$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">subió desde la prueba de nivel</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">bajó desde la prueba de nivel</string>
    <string name="language_levels_move">Los niveles cambian a medida que practicas. Cada semana son más precisos.</string>
    <!-- One skill rose: "Speaking went up to B1 since the level test." -->
    <string name="language_level_rose">%1$s subió a %2$s desde la prueba de nivel.</string>
    <!-- The count is how many skills rose, always two or more; %1$s lists them: "Speaking and Writing went up since the level test." -->
    <plurals name="language_levels_rose">
        <item quantity="one">%1$s subieron desde la prueba de nivel.</item>
        <item quantity="many">%1$s subieron desde la prueba de nivel.</item>
        <item quantity="other">%1$s subieron desde la prueba de nivel.</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">Ya puedo…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">Aún no</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s, objetivo %2$s</string>
    <string name="language_pattern_noticed">Notamos un patrón</string>
    <string name="language_pattern_typos">Solo errores al teclear</string>
    <string name="language_pattern_typos_description">Tus errores recientes fueron descuidos; no necesitas aprender una regla.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">Volver a decir %d palabra</item>
        <item quantity="many">Volver a decir %d palabras</item>
        <item quantity="other">Volver a decir %d palabras</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">Al inicio de tu próxima sesión · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">Practicar cuando quieras · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">Ya sé leerlo</string>
    <string name="language_alphabet_skip_failed">No se pudo guardar. Inténtalo de nuevo.</string>
    <!-- Button that opens the words to say aloud again; "them" is those words. -->
    <string name="language_say_them">Decirlas</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Abrir</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">Notamos un patrón: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Practicarlo</string>
    <string name="language_level">Nivel</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, objetivo %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Ver tu plan</string>
</resources>
