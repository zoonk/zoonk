<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Passer un examen blanc</string>
    <string name="mock_chooser_line">Chronométré comme l’examen officiel. Tu verras ton résultat à la fin.</string>
    <string name="mock_chooser_start">Commencer</string>
    <string name="mock_chooser_one_subject">Une matière</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">L’examen</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">Jour %1$d</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">La moitié du jour %1$d</string>
    <string name="mock_chooser_full_exam">L’examen complet</string>
    <string name="mock_chooser_half_exam">La moitié de l’examen</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">Jour %1$d, sans %2$s</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">L’examen complet, sans %1$s</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">Sans la partie écrite</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d question · %2$s</item>
        <item quantity="many">%1$d questions · %2$s</item>
        <item quantity="other">%1$d questions · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">Pas encore assez de questions pour cet examen blanc. Choisis-en un autre.</string>
    <string name="mock_chooser_failed">Impossible de lancer l’examen blanc. Réessaie.</string>
    <string name="mock_chooser_short_title">Commencer un examen blanc plus court ?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_day">Aujourd’hui, cet examen blanc compte %1$s questions sur %2$s, soit environ %3$s. Tu pourras le faire en entier demain.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">Aujourd’hui, cet examen blanc compte %1$s questions sur %2$s, soit environ %3$s. Tu pourras le faire en entier le mois prochain.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">Aujourd’hui, cet examen blanc compte %1$s questions sur %2$s, soit environ %3$s.</string>
    <string name="mock_chooser_pick_another">En choisir un autre</string>
    <string name="mock_chooser_preparing">Préparation de ton examen blanc…</string>
    <string name="mock_chooser_preparing_detail">Nous préparons des questions semblables à celles de l’examen. Ton examen blanc commencera ici dès qu’elles seront prêtes.</string>
    <string name="mock_chooser_writing">Préparation de ton examen blanc</string>
    <string name="mock_chooser_writing_questions">Préparation de questions semblables à celles de l’examen</string>
    <string name="mock_chooser_writing_questions_line">Choix des questions pour chaque matière…</string>
    <!-- The panel beside the options, about the one picked. -->
    <string name="mock_chooser_picked">L’examen blanc choisi</string>
    <string name="mock_chooser_questions">Questions</string>
    <string name="mock_chooser_time_limit">Durée limitée</string>
    <string name="mock_chooser_usually_takes">Durée habituelle</string>
    <!-- %1$s is a duration, such as "1 hr 20 min". -->
    <string name="mock_chooser_about">Environ %1$s</string>
    <string name="mock_chooser_subjects">Matières</string>
    <!-- The exam's sections a mock sits, such as Listening and Reading. -->
    <string name="mock_chooser_parts">Parties</string>
    <!-- Under a part such as "Essay", which the learner writes rather than answers. -->
    <string name="mock_chooser_written_part">Épreuve écrite</string>
    <string name="mock_chooser_last_mock">Ton dernier examen blanc</string>
    <!-- %1$s is a past exam edition, such as "2024 exam"; %2$s the site that counted its questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_past_edition">Nombre de questions par matière dans %1$s, selon le décompte de %2$s.</string>
    <!-- %1$s is the site that counted the questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_latest_exam">Nombre de questions par matière dans le dernier examen, selon le décompte de %1$s.</string>
</resources>
