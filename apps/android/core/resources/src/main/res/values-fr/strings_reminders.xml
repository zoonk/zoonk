<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">Rappels pour étudier</string>
    <string name="reminders_channel_description">Un rappel les jours prévus pour étudier, s’il te reste des choses à apprendre.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">Tu veux un rappel pour étudier ?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">À %1$s les jours prévus pour étudier, s’il te reste des choses à apprendre.</string>
    <string name="reminders_remind_me">Recevoir un rappel</string>
    <!-- Declines the offer. Keep it neutral and ungendered, like "Not now" (Portuguese: "Agora não"). -->
    <string name="reminders_no_thanks">Non merci</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">Les rappels sont activés.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">Les rappels par e-mail sont activés.</string>
    <string name="reminders_turn_on_failed">Impossible d’activer les rappels. Réessaie.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Les notifications sont désactivées pour Zoonk.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">Ouvrir les paramètres</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">Recevoir plutôt les rappels par e-mail</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">Autoriser les notifications ?</string>
    <string name="reminders_permission_body">Zoonk envoie un rappel les jours prévus pour étudier, seulement s’il te reste des choses à apprendre.</string>
    <string name="reminders_permission_continue">Continuer</string>
    <string name="reminders_not_now">Pas maintenant</string>
    <!-- The row that shows the reminder's time and opens a clock to change it, and that clock's title. -->
    <string name="reminders_time_title">Heure du rappel</string>
    <string name="reminders_save">Enregistrer</string>
    <string name="reminders_cancel">Annuler</string>
    <!-- The row in Preferences that opens the reminders page. -->
    <string name="reminders_row">Rappels pour étudier</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">Rappels</string>
    <string name="reminders_description">Un rappel par jour, seulement s’il te reste des choses à apprendre.</string>
    <!-- The time of day a reminder goes out, not an amount of time. -->
    <string name="reminders_time">Heure</string>
    <!-- %1$s is a time of day and %2$s its time zone, such as "7:00 PM, Brasilia Time". -->
    <string name="reminders_time_in_zone">%1$s, %2$s</string>
    <string name="reminders_email">Adresse e-mail</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">Crée un compte pour recevoir des rappels par e-mail</string>
    <string name="reminders_push">Notifications push</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">Les jours d’étude définis dans tes plans</string>
    <string name="reminders_quiet">En pause pendant ton absence. Ils reprennent quand tu te remets à étudier.</string>
    <string name="reminders_save_failed">L’enregistrement a échoué. Réessaie.</string>
    <!-- Push reminders go to another of the learner's devices; this one can take over. -->
    <string name="reminders_use_this_device">Utiliser cet appareil</string>
    <!-- After the selected device's name, such as "Pixel 9 · This device", when it's the device in hand. -->
    <string name="reminders_this_device">Cet appareil</string>
</resources>
