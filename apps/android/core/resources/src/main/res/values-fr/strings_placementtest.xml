<resources>
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">Tester tes connaissances</string>
    <string name="placementtest_skip_lessons">Sauter les leçons que tu connais déjà</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">Test de niveau</string>
    <string name="placementtest_find_level">Trouver ton niveau et sauter ce que tu connais</string>
    <string name="placementtest_in_progress">En cours</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="placementtest_time_left">Il reste %1$s</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Aucune leçon sautée</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d leçon sautée</item>
        <item quantity="many">%d leçons sautées</item>
        <item quantity="other">%d leçons sautées</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">Lecture %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">Écoute %1$s</string>
    <string name="placementtest_start_title">Saute ce que tu connais déjà</string>
    <string name="placementtest_choose_description">Un test trouve les leçons que tu peux sauter.</string>
    <string name="placementtest_quick_only_description">Un test rapide trouve les leçons que tu peux sauter. Il dure environ %1$s.</string>
    <string name="placementtest_choose_title">Choisis un test</string>
    <!-- The short placement test: about four minutes of questions. -->
    <string name="placementtest_quick">Test rapide</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">Environ %1$s</string>
    <!-- The long placement test: it checks every topic still ahead in the course. -->
    <string name="placementtest_whole_course">Tout le cours</string>
    <!-- %1$s is a duration with its unit, such as "30 min". The test is split into parts the learner can take on different days. -->
    <string name="placementtest_about_in_parts">Environ %1$s, en plusieurs parties</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_test_out">Tester le niveau %1$s</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">Sauter le niveau %1$s si tu le connais déjà</string>
    <string name="placementtest_start">Commencer</string>
    <!-- A whole-course test is split into parts; %1$d is the part's number. -->
    <string name="placementtest_part">Partie %1$d</string>
    <string name="placementtest_continue_title">Continuer ton test</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="placementtest_left_saved">Il te reste environ %1$s. Tes réponses sont enregistrées.</string>
    <string name="placementtest_continue_from_plan">Tu peux terminer le test depuis Plan.</string>
    <string name="placementtest_finish_for_today">Terminer pour aujourd’hui</string>
    <string name="placementtest_keep_going">Continuer</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Tu la connais déjà. Elle reste dans tes révisions.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Tu les connais déjà. Elles restent dans tes révisions.</string>
    <string name="placementtest_plan_stays">Ton plan reste tel qu’il est.</string>
    <string name="placementtest_retake_tomorrow">Tu as annulé ces sauts aujourd’hui. Réponds à nouveau demain pour les sauter.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">À suivre</string>
    <string name="placementtest_done">Terminé</string>
    <string name="placementtest_not_now">Pas maintenant</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">Ton niveau en %1$s</string>
    <!-- %2$s is a list of language levels, such as "A1, A2". The plan no longer has their lessons. -->
    <plurals name="placementtest_levels_skipped">
        <item quantity="one">On a sauté %2$s : %1$d leçon.</item>
        <item quantity="many">On a sauté %2$s : %1$d leçons.</item>
        <item quantity="other">On a sauté %2$s : %1$d leçons.</item>
    </plurals>
    <string name="placementtest_keeps_adjusting">Tes leçons s’adaptent au fur et à mesure de tes réponses.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">Le niveau %1$s reste dans ton plan</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">Il n’y a pas encore assez de questions pour le niveau %1$s.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">Ça a l’air facile pour toi</string>
    <string name="placementtest_offer_quick">Un petit test peut te faire sauter les leçons que tu connais déjà.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">Un petit test peut te faire sauter le niveau %1$s si tu le connais déjà.</string>
</resources>
