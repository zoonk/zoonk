    <string name="certificates_name_on_certificate">Nom sur le certificat</string>
    <string name="certificates_link_note">Toute personne qui a le lien peut voir ce certificat. Sa page n’apparaît pas dans les résultats de recherche.</string>
    <!-- A short message after the certificate's picture was saved to the phone's Pictures. -->
    <string name="certificates_downloaded">Enregistré dans Images</string>
    <string name="certificates_picture_failed">Le certificat ne s’est pas chargé. Réessaie.</string>
    <string name="certificates_not_found">Nous n’avons pas trouvé ce certificat</string>
    <!-- TalkBack reads the certificate's picture. %1$s is the learner's name and %2$s the course's title. -->
    <string name="certificates_alt_course">%1$s a terminé %2$s</string>
    <!-- TalkBack reads the certificate's picture. %1$s is the learner's name, %2$s the CEFR level, such as "B1", and %3$s the language, such as "Spanish". -->
    <string name="certificates_alt_level">%1$s a terminé le niveau %2$s en %3$s</string>
