    <string name="certificates_up_next_language">Tu le reçois quand toutes les compétences que tu travailles atteignent le niveau suivant</string>
    <!-- The title of a full screen shown once, right after the learner finishes every lesson of a course. -->
    <string name="certificates_course_complete">Cours terminé !</string>
    <!-- The title of a full screen shown once, right after the learner finishes a language level. %1$s is the CEFR level, such as "B1". -->
