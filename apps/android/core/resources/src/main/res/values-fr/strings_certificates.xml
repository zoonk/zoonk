<resources>
    <!-- A place name, like "Completed lessons": the page listing the learner's completion certificates, to print, download or share. -->
    <string name="certificates_title">Certificats</string>
    <!-- Above the page title, counting the learner's certificates. -->
    <plurals name="certificates_count">
        <item quantity="one">%1$d certificat</item>
        <item quantity="many">%1$d certificats</item>
        <item quantity="other">%1$d certificats</item>
    </plurals>
    <string name="certificates_lead">Un certificat pour chaque niveau et chaque plan que tu termines.</string>
    <!-- What a certificate certifies: a finished course or a finished language level. Printed on the certificate itself. -->
    <string name="certificates_kind_completion">Certificat de fin de formation</string>
    <!-- A language certificate's name: %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
    <string name="certificates_language_level">%1$s %2$s</string>
    <!-- A course level's certificate name, such as "Python · Beginner": the course's title, then the level's name. -->
    <string name="certificates_course_level">%1$s · %2$s</string>
    <string name="certificates_empty_title">Pas encore de certificats</string>
    <string name="certificates_empty_description">Tes certificats apparaissent ici quand tu termines un niveau ou un plan.</string>
    <string name="certificates_continue_learning">Continuer à apprendre</string>
    <!-- On a finished plan's card: opens the plan's one certificate. -->
    <string name="certificates_view">Voir le certificat</string>
    <string name="certificates_view_several">Voir les certificats</string>
    <!-- On a finished plan's card: issues the course's certificate, which wasn't issued yet. -->
    <string name="certificates_get">Obtenir ton certificat</string>
    <string name="certificates_up_next">À suivre</string>
    <string name="certificates_up_next_course">Tu obtiens ton certificat quand tu termines le plan</string>
    <!-- Under a language goal: its certificate comes once every skill the learner practices (reading, listening, speaking, writing) reaches the next CEFR level. -->
    <string name="certificates_up_next_language">Tu l’obtiens quand chaque compétence que tu travailles atteint le niveau suivant</string>
    <!-- The title of a full screen shown once, right after the learner finishes every lesson of a course. -->
    <string name="certificates_course_complete">Cours terminé !</string>
    <string name="certificates_level_complete">Niveau %1$s terminé !</string>
    <!-- The title when the learner earned two or more certificates at once. -->
    <plurals name="certificates_earned">
        <item quantity="one">%1$d certificat obtenu</item>
        <item quantity="many">%1$d certificats obtenus</item>
        <item quantity="other">%1$d certificats obtenus</item>
    </plurals>
    <!-- %1$s is the course's title. -->
    <string name="certificates_course_ready">Ton certificat pour %1$s est prêt.</string>
    <!-- %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
    <string name="certificates_language_ready">Ton certificat %1$s %2$s est prêt.</string>
    <!-- %1$s lists the certificates' names, such as "Spanish A2 and B1" or "Python and Spanish B1". -->
    <string name="certificates_several_ready">Tes certificats %1$s sont prêts.</string>
    <!-- %1$s is the learner's name, as printed on their certificate. -->
    <string name="certificates_on_your_certificate">Sur ton certificat : %1$s</string>
    <!-- A short button beside the learner's name, to edit the name printed on their certificates. -->
    <string name="certificates_change">Modifier</string>
    <!-- TalkBack's name for the Change button beside the learner's name. -->
    <string name="certificates_change_name">Modifier le nom sur tes certificats</string>
    <!-- The label of a field where a learner without a name types it for the first time. -->
    <string name="certificates_name_label_new">Ton nom, tel qu’il doit apparaître</string>
    <!-- The label of the field with the learner's current name, when they change it. -->
    <string name="certificates_name_label">Nom sur tes certificats</string>
    <string name="certificates_name_placeholder">Ton nom complet</string>
    <string name="certificates_name_hint_new">Ce nom figure sur tes certificats et ton compagnon l’utilise. Tu peux le modifier à tout moment.</string>
    <string name="certificates_name_hint">Ce nom figure sur tes certificats et ton compagnon l’utilise.</string>
    <string name="certificates_save">Enregistrer</string>
    <string name="certificates_cancel">Annuler</string>
    <string name="certificates_name_save_failed">L’enregistrement a échoué. Réessaie.</string>
    <string name="certificates_share">Partager</string>
    <!-- Opens a sheet that helps the learner add the certificate to their LinkedIn profile. -->
    <string name="certificates_add_to_linkedin">Ajouter à LinkedIn</string>
    <!-- "Certificates" is the place name. -->
    <string name="certificates_saved_one">Il est enregistré dans Certificats.</string>
    <!-- "Certificates" is the place name. -->
    <string name="certificates_saved_several">Ils sont enregistrés dans Certificats.</string>
    <string name="certificates_continue">Continuer</string>
    <string name="certificates_locked">Verrouillé</string>
