    <string name="certificates_empty_title">Pas encore de certificats</string>
    <string name="certificates_empty_description">Termine un cours ou un niveau de langue et retrouve ton certificat ici, à imprimer et à partager gratuitement. Le résultat d’un test de niveau apparaît aussi ici.</string>
    <string name="certificates_continue_learning">Continuer à apprendre</string>
    <!-- A section title on the empty page, over the learner's goals and how each one earns a certificate. -->
    <!-- On a finished plan's card: opens the course's certificate. -->
    <string name="certificates_view">Voir le certificat</string>
