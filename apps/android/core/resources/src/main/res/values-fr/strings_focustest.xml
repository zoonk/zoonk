<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">Test de priorités</string>
    <!-- {time} is a duration with its unit, such as “9 min”. -->
    <string name="focustest_time_left">Il reste %1$s</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">Découvre les matières à travailler en priorité</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">Tu connais déjà une partie du contenu ?</string>
    <string name="focustest_offer_line_focus">Ce test repère ce que tu connais déjà pour que tu consacres plus de temps à ce que tu dois travailler en priorité. Il ne supprime jamais de matière.</string>
    <string name="focustest_offer_line">Ce test repère ce que tu connais déjà pour que ton plan puisse le sauter.</string>
    <string name="focustest_start">Commencer le test</string>
    <string name="focustest_skip_note">Tu peux faire le test plus tard, depuis ton plan.</string>
    <string name="focustest_not_now">Pas maintenant</string>
    <string name="focustest_resume_title">Continuer ton test</string>
    <plurals name="focustest_answers_saved_line">
        <item quantity="one">Tu as %d réponse enregistrée.</item>
        <item quantity="many">Tu as %d réponses enregistrées.</item>
        <item quantity="other">Tu as %d réponses enregistrées.</item>
    </plurals>
    <string name="focustest_continue">Continuer</string>
    <string name="focustest_see_my_result">Voir mon résultat</string>
    <!-- Over a test question: its number and the count promised when the sitting started. -->
    <string name="focustest_question_number">Question %1$d sur %2$d</string>
    <string name="focustest_stop">Arrêter et utiliser mes réponses</string>
    <!-- Shown after several "I don't know yet" answers in a row. -->
    <string name="focustest_many_unknown">Tu n’as pas encore étudié la plupart de ces notions ? Ce n’est pas grave. Tu peux t’arrêter ici et commencer à apprendre.</string>
    <string name="focustest_answers_saved_title">Tes réponses sont enregistrées</string>
    <!-- The test's result: the exam subjects that need the most study time, most needed first. -->
    <string name="focustest_result_title">Voici tes priorités</string>
    <string name="focustest_result_description">D’après tes réponses et ce qui compte le plus à ton examen. Définir des priorités ne supprime aucune matière.</string>
    <plurals name="focustest_also_skips">
        <item quantity="one">Ton plan saute aussi %d leçon que tu connais déjà.</item>
        <item quantity="many">Ton plan saute aussi %d leçons que tu connais déjà.</item>
        <item quantity="other">Ton plan saute aussi %d leçons que tu connais déjà.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">Ton point de départ est défini</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="one">Ton plan saute %d leçon que tu connais déjà.</item>
        <item quantity="many">Ton plan saute %d leçons que tu connais déjà.</item>
        <item quantity="other">Ton plan saute %d leçons que tu connais déjà.</item>
    </plurals>
    <string name="focustest_from_basics">Dans ton plan, chaque matière commence par les bases.</string>
    <string name="focustest_result_current">Ton plan accorde plus de temps à ces matières.</string>
    <string name="focustest_result_hand_picked">Ton plan garde les priorités que tu as choisies. Voici ce que le test te propose.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
    <string name="focustest_result_declined">Tu as gardé ton plan tel quel. Voici ce que le test te propose.</string>
    <string name="focustest_change_focus">Changer les priorités</string>
    <string name="focustest_see_all_subjects">Voir toutes les matières</string>
    <string name="focustest_subjects">Matières</string>
    <!-- A switch: the learner's study sessions also ask a few of the test's questions. -->
    <string name="focustest_session_questions">Poser quelques questions de plus pendant que j’étudie</string>
    <string name="focustest_session_questions_when">Pendant ta première semaine</string>
    <string name="focustest_done">Terminé</string>
    <string name="focustest_answer_more">Répondre à d’autres questions</string>
    <!-- The test asks before changing a plan the learner already has. -->
    <string name="focustest_proposal_title">Accorder plus de temps à ces matières ?</string>
    <!-- How the Focus test picked the subjects listed below it: from the learner's answers to its questions and how many of the exam's questions each subject has. -->
    <string name="focustest_proposal_picked">Sélectionnées selon tes réponses et le poids de chaque matière à l’examen.</string>
    <string name="focustest_update_plan">Mettre à jour mon plan</string>
    <string name="focustest_proposal_applied">Ton plan accorde maintenant plus de temps à ces matières.</string>
    <string name="focustest_proposal_declined">Ton plan reste inchangé.</string>
    <string name="focustest_proposal_undone">Modification annulée. Ton plan est revenu à son état initial.</string>
    <string name="focustest_undo">Annuler</string>
    <!-- A short fact beside a subject in a list: every answer the learner gave on it was “I don't know yet”. It is not a grade. -->
    <string name="focustest_not_known_yet">Encore à découvrir</string>
    <!-- %1$d answers right of %2$d asked on one subject. -->
    <plurals name="focustest_subject_right">
        <item quantity="one">%1$d bonne réponse sur %2$d</item>
        <item quantity="many">%1$d bonnes réponses sur %2$d</item>
        <item quantity="other">%1$d bonnes réponses sur %2$d</item>
    </plurals>
    <!-- Parts of the exam the Focus test's questions can't ask about, such as the essay. -->
    <string name="focustest_written_not_checked">Expression écrite : non évaluée dans ce test</string>
    <string name="focustest_listening_not_checked">Écoute : non évaluée dans ce test</string>
    <string name="focustest_speaking_not_checked">Expression orale : non évaluée dans ce test</string>
    <string name="focustest_practical_not_checked">Partie pratique : non évaluée dans ce test</string>
    <!-- The test's state on the plan: the learner started it and left before the end. -->
    <string name="focustest_in_progress">En cours</string>
    <string name="focustest_see_your_result">Voir ton résultat</string>
    <string name="focustest_take_test">Passer le Test de priorités</string>
    <!-- Today's suggestion to take the test, in the goal's first week, when the learner's time can't cover everything. -->
    <string name="focustest_suggestion_line">Le Test de priorités t’indique quoi étudier en priorité.</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="focustest_suggestion_body">Un test de %1$s montre ce que tu sais déjà, pour consacrer plus de temps à ce dont tu as le plus besoin. Il ne supprime jamais de matière.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">C’est noté. Tu peux faire le test depuis ton plan.</string>
    <!-- On a session's test question: skips today's test questions; they're asked another day. -->
    <string name="focustest_not_today">Pas aujourd’hui</string>
    <string name="focustest_not_today_failed">L’enregistrement a échoué. Réessaie.</string>
</resources>
