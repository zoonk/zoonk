<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">Test de priorités</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_about">Environ %1$s</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="focustest_about_left">Encore environ %1$s</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">Découvre tes priorités</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">Découvre par où commencer</string>
    <string name="focustest_offer_description_focus">Des questions rapides sur les matières de ton examen. Ton plan saute ce que tu connais déjà pour te laisser plus de temps là où tu en as le plus besoin.</string>
    <string name="focustest_offer_description">Des questions rapides sur les matières de ton examen. Ton plan saute ce que tu connais déjà.</string>
    <string name="focustest_how_it_works">Comment ça marche</string>
    <string name="focustest_how_weight_title">Ce qui compte le plus passe en premier</string>
    <string name="focustest_how_weight">Le test commence par les matières qui comptent le plus à ton examen.</string>
    <string name="focustest_how_grade_title">Pas de note</string>
    <string name="focustest_how_grade">Tu peux répondre « Je ne sais pas encore ».</string>
    <string name="focustest_how_stop_title">Arrête quand tu veux</string>
    <string name="focustest_how_stop">Chaque réponse est enregistrée.</string>
    <string name="focustest_how_subjects_title">Définir des priorités ne supprime aucune matière</string>
    <string name="focustest_how_subjects">Si tu manques de temps pour tout étudier, ton plan en réserve plus aux matières dont tu as le plus besoin.</string>
    <!-- The learner's first week of study sessions also asks a few of the test's questions. -->
    <string name="focustest_how_sessions_title">Quelques questions de plus pendant ta première semaine</string>
    <string name="focustest_how_sessions">Tes séances te proposent quelques autres questions du test. Tu peux les mettre en pause.</string>
