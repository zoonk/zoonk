    <string name="focustest_see_your_result">Voir ton résultat</string>
    <!-- The test's state on the plan: the learner paused its questions in their study sessions. -->
    <string name="focustest_paused_in_sessions">En pause dans tes séances</string>
    <string name="focustest_take_test">Passer le Test de priorités</string>
    <!-- Under the daily time while it's short: %1$s lists up to three exam subjects, such as "Logic, Law and Math". -->
    <string name="focustest_schedule_focus">Vu le temps disponible, nous te conseillons de privilégier %1$s.</string>
    <!-- On the plan reveal: %1$s is a daily study time, such as "4 hr"; %2$s a date, such as "Dec 10"; %3$s lists up to three exam subjects. -->
    <string name="focustest_reveal_trade_off">Avec %1$s par jour, tu n’auras pas le temps d’étudier tous les sujets avant le %2$s. Ce plan accorde plus de temps à %3$s.</string>
    <string name="focustest_what_test_changed">Ce que ton test a changé</string>
    <!-- Today's suggestion to take the test, in the goal's first week, when the learner's time can't cover everything. -->
    <string name="focustest_suggestion_line">Le Test de priorités t’indique quoi étudier en priorité.</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_suggestion_body">Tu n’as pas le temps de tout étudier avant ton examen. En %1$s environ, le Test de priorités t’indique quoi étudier en priorité.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">C’est noté. Tu peux faire le test depuis ton plan.</string>
    <!-- On a session's test question: skips today's test questions; they're asked another day. -->
    <string name="focustest_not_today">Pas aujourd’hui</string>
    <string name="focustest_not_today_failed">L’enregistrement a échoué. Réessaie.</string>
