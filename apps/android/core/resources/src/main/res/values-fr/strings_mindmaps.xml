    <string name="mindmaps_unreachable">Impossible de joindre le serveur. Vérifie ta connexion.</string>
    <string name="mindmaps_as_text_note">L’image contenait des erreurs, voici donc la carte mentale en texte.</string>
    <!-- Saves the mind map's picture. -->
    <string name="mindmaps_download">Télécharger</string>
    <string name="mindmaps_saved">Carte mentale enregistrée</string>
    <string name="mindmaps_save_failed">La carte mentale n’a pas été enregistrée. Réessaie.</string>
