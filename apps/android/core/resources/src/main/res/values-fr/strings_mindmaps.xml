<resources>
    <!-- How many of the goal's mind maps are drawn: "3 maps". -->
    <plurals name="mindmaps_count">
        <item quantity="one">%1$s carte</item>
        <item quantity="many">%1$s cartes</item>
        <item quantity="other">%1$s cartes</item>
    </plurals>
    <!-- Under the Mind maps page's title. -->
    <string name="mindmaps_intro">Les idées principales d’un chapitre en une image. Chaque chapitre terminé a sa carte mentale ; tu peux en créer une pour tout autre chapitre de ton plan.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_intro_lessons_first_free">Les idées principales d’un chapitre en une image. Chaque chapitre que tu termines a sa carte mentale ; tu peux en créer une pour n’importe quel autre chapitre de ton plan. Dans ce cas, ses leçons sont d’abord préparées et décomptées de tes leçons gratuites.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_intro_lessons_first_plus">Les idées principales d’un chapitre en une image. Chaque chapitre que tu termines a sa carte mentale ; tu peux en créer une pour n’importe quel autre chapitre de ton plan. Dans ce cas, ses leçons sont d’abord préparées, ce qui prend quelques minutes.</string>
    <plurals name="mindmaps_chapter_count">
        <item quantity="one">%d chapitre</item>
        <item quantity="many">%d chapitres</item>
        <item quantity="other">%d chapitres</item>
    </plurals>
    <!-- A mind map row's line under the chapter's title. -->
    <string name="mindmaps_chapter_number">Chapitre %1$s</string>
    <string name="mindmaps_empty_title">Pas encore de carte mentale</string>
    <string name="mindmaps_empty_description">Les chapitres de ton plan apparaissent ici au fur et à mesure que tu les abordes.</string>
    <string name="mindmaps_keep_studying">Continuer à étudier</string>
    <!-- A mind map's description for screen readers when it has no words yet. -->
    <string name="mindmaps_alt_chapter">Carte mentale de %1$s</string>
    <!-- A mind map's description for screen readers: its title, then its central idea. -->
    <string name="mindmaps_alt">Carte mentale : %1$s. %2$s</string>
    <!-- The same, for a title that already ends a sentence. -->
    <string name="mindmaps_alt_sentence">Carte mentale : %1$s %2$s</string>
    <!-- A map whose picture had mistakes, in its row on the Mind maps page; also the viewer's button that shows the map in words. -->
    <string name="mindmaps_as_text">En texte</string>
    <!-- The viewer's button that shows the map's picture again after it was shown as text. -->
    <string name="mindmaps_as_picture">En image</string>
    <!-- The title of a chapter's mind map row on the chapter's page. -->
    <string name="mindmaps_row_title">Carte mentale</string>
    <!-- A mind map that can be made, or that's ready, on the chapter's page. -->
    <string name="mindmaps_row_description">Ses idées principales en une image</string>
    <!-- A chapter whose lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_lessons_first_free">Ses leçons sont d’abord préparées et comptent dans ton quota de leçons gratuites.</string>
    <!-- A chapter whose lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_lessons_first_plus">Ses leçons sont d’abord préparées, ce qui prend quelques minutes.</string>
    <!-- A chapter on the Mind maps page whose lessons aren't written yet, after its number: "Chapter 4 · Lessons not written yet". -->
    <string name="mindmaps_lessons_not_written">Leçons pas encore préparées</string>
    <string name="mindmaps_writing_lessons">Préparation des leçons, puis de la carte mentale…</string>
    <string name="mindmaps_writing_lessons_wait">Cela prend quelques minutes. Tu peux quitter cet écran ; la carte t’attendra ici.</string>
    <string name="mindmaps_drawing">Création de la carte mentale…</string>
    <string name="mindmaps_drawing_wait">Environ une demi-minute. Tu peux quitter cet écran ; la carte t’attendra ici.</string>
    <!-- A finished chapter's mind map that's ready to open, where the chapter ends. -->
    <string name="mindmaps_ready">Carte mentale prête</string>
    <!-- Where a lesson or a test ends, over the row of the chapter it finished and its mind map. -->
    <string name="mindmaps_chapter_finished">Chapitre terminé</string>
    <!-- Makes a chapter's mind map. -->
    <string name="mindmaps_create">Créer</string>
    <!-- Opens a chapter's mind map. -->
    <string name="mindmaps_open">Ouvrir</string>
    <string name="mindmaps_try_again">Réessayer</string>
    <!-- Opens the Plus plans, on a mind map whose chapter is Plus-only. -->
    <string name="mindmaps_see_plus">Voir Plus</string>
    <!-- What screen readers say for a row's Create, naming its chapter. -->
    <string name="mindmaps_create_spoken">Créer la carte mentale de %1$s</string>
    <!-- What screen readers say for a row's Open, naming its chapter. -->
    <string name="mindmaps_open_spoken">Ouvrir la carte mentale du chapitre %1$s</string>
    <!-- What screen readers say for a row's Try again, naming its chapter. -->
    <string name="mindmaps_try_again_spoken">Réessayer de créer la carte mentale de %1$s</string>
