    <string name="mindmaps_in_short">En bref :</string>
    <string name="mindmaps_zoom_in">Zoom avant</string>
    <string name="mindmaps_zoom_out">Zoom arrière</string>
    <string name="mindmaps_fit">Ajuster à l’écran</string>
    <string name="mindmaps_viewer_hint">Pince, fais défiler ou utilise + et - pour zoomer ; fais glisser ou utilise les flèches pour te déplacer.</string>
