<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="placementtest_title">Verifica ciò che sai</string>
    <string name="placementtest_skip_lessons">Salta le lezioni che conosci già</string>
    <string name="placementtest_level_title">Test di livello</string>
    <string name="placementtest_find_level">Trova il tuo livello e salta ciò che sai già</string>
    <string name="placementtest_in_progress">In corso</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Nessuna lezione saltata</string>
    <!-- The title after a placement test: how many lessons it took out of the plan. -->
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d lezione saltata</item>
        <item quantity="many">%d lezioni saltate</item>
        <item quantity="other">%d lezioni saltate</item>
    </plurals>
    <!-- A CEFR level range the test found for reading, such as “B1–B2”. -->
    <string name="placementtest_reading_range">Lettura %1$s</string>
    <!-- A CEFR level range the test found for listening, such as “B1–B2”. -->
    <string name="placementtest_listening_range">Ascolto %1$s</string>
    <string name="placementtest_start_title">Salta ciò che sai già</string>
    <string name="placementtest_choose_description">Un test individua le lezioni che puoi saltare.</string>
    <string name="placementtest_about">Circa %1$s</string>
    <!-- A short test of one language level, such as “Test out of B2”. -->
    <string name="placementtest_test_out">Fai il test di %1$s</string>
    <string name="placementtest_test_out_description">Salta %1$s se lo conosci già</string>
    <string name="placementtest_start">Inizia</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">La conosci già. Resta nei tuoi ripassi.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Le conosci già. Restano nei tuoi ripassi.</string>
    <string name="placementtest_retake_tomorrow">Oggi hai annullato queste lezioni. Rispondi di nuovo domani per saltarle.</string>
    <string name="placementtest_up_next">A seguire</string>
    <string name="placementtest_done">Fatto</string>
    <string name="placementtest_not_now">Non ora</string>
    <string name="placementtest_your_level">Il tuo livello di %1$s</string>
    <string name="placementtest_keeps_adjusting">Le tue lezioni si adattano man mano che rispondi.</string>
    <string name="placementtest_level_stays">%1$s resta nel tuo piano</string>
    <string name="placementtest_test_out_unavailable">Per %1$s non ci sono ancora abbastanza domande.</string>
    <string name="placementtest_offer_title">Sembra facile per te</string>
    <string name="placementtest_offer_quick">Con un breve test puoi saltare le lezioni che conosci già.</string>
    <string name="placementtest_offer_level">Con un breve test puoi saltare %1$s se lo conosci già.</string>
    <string name="placementtest_where_to_start">Da dove vuoi iniziare?</string>
    <string name="placementtest_first_lesson">Prima lezione</string>
    <!-- The most questions a test asks. It can end sooner. -->
    <plurals name="placementtest_up_to_questions">
        <item quantity="one">Fino a %d domanda</item>
        <item quantity="many">Fino a %d domande</item>
        <item quantity="other">Fino a %d domande</item>
    </plurals>
    <string name="placementtest_finish_later">Completa più tardi</string>
    <string name="placementtest_start_lesson">Inizia la lezione</string>
    <!-- On a level test's result when listening wasn't tested, such as after the learner said they can't listen now. -->
    <string name="placementtest_take_again_later">Puoi ripetere il test più tardi, dal tuo piano.</string>
    <string name="placementtest_not_tested">Non ancora valutato</string>
    <!-- The name of a course's placement test, on the card that offers it. -->
    <string name="placementtest_test">Test</string>
    <!-- Over the name of the chapter a course's placement test starts the learner in. -->
    <string name="placementtest_you_start_here">Inizi da qui</string>
    <!-- A quiet action on the result of a placement test opened again from the plan: it offers a new test. -->
    <string name="placementtest_take_test_again">Ripeti il test</string>
</resources>
