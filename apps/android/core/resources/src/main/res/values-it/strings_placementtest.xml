<resources>
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">Verifica di ciò che sai</string>
    <string name="placementtest_skip_lessons">Salta le lezioni che conosci già</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">Test di livello</string>
    <string name="placementtest_find_level">Scopri il tuo livello e salta ciò che sai già</string>
    <string name="placementtest_in_progress">In corso</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="placementtest_time_left">Ti restano %1$s</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Nessuna lezione saltata</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d lezione saltata</item>
        <item quantity="many">%d lezioni saltate</item>
        <item quantity="other">%d lezioni saltate</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">Lettura %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">Ascolto %1$s</string>
    <string name="placementtest_choose_title">Quanto vuoi verificare?</string>
    <!-- The short placement test: about four minutes of questions. -->
    <string name="placementtest_quick">Veloce</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">Circa %1$s</string>
    <!-- The long placement test: it checks every topic still ahead in the course. -->
    <string name="placementtest_whole_course">Intero corso</string>
    <!-- %1$s is a duration with its unit, such as "30 min". The test is split into parts the learner can take on different days. -->
    <string name="placementtest_about_in_parts">Circa %1$s, in più parti</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_in_parts">In più parti</string>
    <string name="placementtest_test_out">Fai il test di %1$s</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">Salta %1$s se lo sai già</string>
    <string name="placementtest_choose_note">Puoi fermarti quando vuoi. Le lezioni che conosci già restano saltate.</string>
    <string name="placementtest_start">Inizia</string>
    <!-- A whole-course test is split into parts; %1$d is the part's number. -->
    <string name="placementtest_part">Parte %1$d</string>
    <string name="placementtest_continue_title">Continua il test</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="placementtest_left_saved">Ti restano circa %1$s. Le tue risposte sono salvate.</string>
    <string name="placementtest_continue_from_plan">Puoi completare il test dal Piano.</string>
    <string name="placementtest_finish_for_today">Concludi per oggi</string>
    <string name="placementtest_keep_going">Continua</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <plurals name="placementtest_known">
        <item quantity="one">La conoscevi già. Resta nel tuo ripasso.</item>
        <item quantity="many">Le conoscevi già. Restano nel tuo ripasso.</item>
        <item quantity="other">Le conoscevi già. Restano nel tuo ripasso.</item>
    </plurals>
    <string name="placementtest_plan_stays">Il tuo piano resta com’è.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">Prossimo argomento</string>
    <string name="placementtest_whole_course_skips_more">Il test sull’intero corso può saltare più lezioni.</string>
    <string name="placementtest_done">Raggiunto</string>
    <string name="placementtest_not_now">Non ora</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">Il tuo livello di %1$s</string>
    <!-- %2$s is a list of language levels, such as "A1, A2". The plan no longer has their lessons. -->
    <plurals name="placementtest_levels_skipped">
        <item quantity="one">Abbiamo saltato %2$s: %1$d lezione.</item>
        <item quantity="many">Abbiamo saltato %2$s: %1$d lezioni.</item>
        <item quantity="other">Abbiamo saltato %2$s: %1$d lezioni.</item>
    </plurals>
    <string name="placementtest_keeps_adjusting">Le tue lezioni si adattano man mano che rispondi.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$s resta nel tuo piano</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">Per ora non ci sono abbastanza domande per %1$s.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">Questo ti sembra facile</string>
    <string name="placementtest_offer_quick">Con un breve test puoi saltare le lezioni che conosci già.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">Un breve test può saltare %1$s se lo sai già.</string>
    <string name="placementtest_check_my_level">Controlla il mio livello</string>
</resources>
