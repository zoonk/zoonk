<resources>
    <!-- A unit's place and its levels: "Unit 3 · A1–A2". -->
    <string name="language_unit_eyebrow">Unità %1$s · %2$s</string>
    <plurals name="language_unit_lessons">
        <item quantity="one">%d lezione</item>
        <item quantity="many">%d lezioni</item>
        <item quantity="other">%d lezioni</item>
    </plurals>
    <!-- How much of the unit is done, the unit being the subject: "33% done". -->
    <string name="language_unit_done_share">Completata al %1$s</string>
    <string name="language_unit_start">Inizia</string>
    <string name="language_unit_continue">Continua</string>
    <string name="language_unit_objectives">Alla fine di questa unità</string>
    <string name="language_unit_progress">Progressi</string>
    <string name="language_unit_practice">Esercitazione</string>
    <string name="language_unit_mistakes">I tuoi errori</string>
    <!-- Heading over material to look things up in, such as grammar tips and words, rather than lessons to do. -->
    <string name="language_unit_reference">Da consultare</string>
    <string name="language_unit_grammar_tips">Consigli di grammatica</string>
    <string name="language_unit_words">Parole di questa unità</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s e altre %2$s</string>
    <string name="language_unit_summary">Riepilogo dell’unità</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">Informazioni su questa unità</string>
    <string name="language_skill_reading">Lettura</string>
    <string name="language_skill_listening">Ascolto</string>
    <string name="language_skill_speaking">Parlato</string>
    <string name="language_skill_words">Lessico</string>
    <string name="language_skill_writing">Scrittura</string>
    <!-- Heads the learner's level in each skill (reading, listening, speaking, writing), on the CEFR scale from A1 to C2. -->
    <string name="language_level_by_skill">Livello per abilità</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">Obiettivo %1$s entro %2$s</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">Obiettivo %1$s</string>
    <!-- What TalkBack says for a skill's row: "Reading, B1". -->
    <string name="language_skill_level">%1$s, %2$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Reading, B1, up since the level test". -->
    <string name="language_skill_level_trend">%1$s, %2$s, %3$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">più alto rispetto al test di livello</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">più basso rispetto al test di livello</string>
    <string name="language_levels_move">I livelli cambiano con la pratica. Diventano più precisi ogni settimana.</string>
    <!-- One skill rose: "Speaking went up to B1 since the level test." -->
    <string name="language_level_rose">Il tuo livello in %1$s è salito a %2$s rispetto al test di livello.</string>
    <!-- The count is how many skills rose, always two or more; %1$s lists them: "Speaking and Writing went up since the level test." -->
    <plurals name="language_levels_rose">
        <item quantity="one">Il tuo livello in %1$s è salito rispetto al test di livello.</item>
        <item quantity="many">Il tuo livello in %1$s è salito rispetto al test di livello.</item>
        <item quantity="other">Il tuo livello in %1$s è salito rispetto al test di livello.</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">So già…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">Non ancora</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s, obiettivo %2$s</string>
    <string name="language_pattern_noticed">Abbiamo notato un errore ricorrente</string>
    <string name="language_pattern_typos">Solo errori di battitura</string>
    <string name="language_pattern_typos_description">I tuoi ultimi errori erano solo sviste: non c’è una regola da imparare.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">Di’ di nuovo %d parola</item>
        <item quantity="many">Di’ di nuovo %d parole</item>
        <item quantity="other">Di’ di nuovo %d parole</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">All’inizio della prossima sessione · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">Esercitati quando vuoi · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">So già leggerlo</string>
    <string name="language_alphabet_skip_failed">Il salvataggio non è riuscito. Riprova.</string>
    <!-- Button that opens the words to say aloud again; "them" is those words. -->
    <string name="language_say_them">Dille</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Apri</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">Abbiamo notato un errore ricorrente: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Esercitati</string>
    <string name="language_level">Livello</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, obiettivo %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Vedi il tuo piano</string>
</resources>
