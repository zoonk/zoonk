    <string name="mindmaps_ready">Mappa mentale pronta</string>
    <!-- Where a lesson or a test ends, over the row of the chapter it finished and its mind map. -->
    <string name="mindmaps_chapter_finished">Capitolo completato</string>
    <!-- Makes a chapter's mind map. -->
    <string name="mindmaps_create">Crea</string>
    <!-- Opens a chapter's mind map. -->
    <string name="mindmaps_open">Apri</string>
    <string name="mindmaps_try_again">Riprova</string>
