<resources>
    <!-- How many of the goal's mind maps are drawn: "3 maps". -->
    <plurals name="mindmaps_count">
        <item quantity="one">%1$s mappa</item>
        <item quantity="many">%1$s mappe</item>
        <item quantity="other">%1$s mappe</item>
    </plurals>
    <!-- Under the Mind maps page's title. -->
    <string name="mindmaps_intro">Le idee principali di un capitolo in un’immagine. Ogni capitolo che completi ha la sua mappa; puoi crearne una per qualsiasi altro capitolo del tuo piano.</string>
    <plurals name="mindmaps_chapter_count">
        <item quantity="one">%d capitolo</item>
        <item quantity="many">%d capitoli</item>
        <item quantity="other">%d capitoli</item>
    </plurals>
    <!-- A mind map row's line under the chapter's title. -->
    <string name="mindmaps_chapter_number">Capitolo %1$s</string>
    <string name="mindmaps_empty_title">Ancora nessuna mappa mentale</string>
    <string name="mindmaps_empty_description">I capitoli del tuo piano compaiono qui man mano che li raggiungi.</string>
    <string name="mindmaps_keep_studying">Continua a studiare</string>
    <!-- A mind map's description for screen readers when it has no words yet. -->
    <string name="mindmaps_alt_chapter">Mappa mentale di %1$s</string>
    <!-- A mind map's description for screen readers: its title, then its central idea. -->
    <string name="mindmaps_alt">Mappa mentale: %1$s. %2$s</string>
    <!-- The same, for a title that already ends a sentence. -->
    <string name="mindmaps_alt_sentence">Mappa mentale: %1$s %2$s</string>
    <!-- A map whose picture had mistakes, in its row on the Mind maps page; also the viewer's button that shows the map in words. -->
    <string name="mindmaps_as_text">In formato testo</string>
    <!-- The viewer's button that shows the map's picture again after it was shown as text. -->
    <string name="mindmaps_as_picture">Mostra l’immagine</string>
    <!-- The title of a chapter's mind map row on the chapter's page. -->
    <string name="mindmaps_row_title">Mappa mentale</string>
    <!-- A mind map that can be made, or that's ready, on the chapter's page. -->
    <string name="mindmaps_row_description">Le idee principali in un’immagine</string>
    <!-- A chapter whose lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_lessons_first_free">Prima prepariamo le lezioni del capitolo, che vengono scalate dal totale delle tue lezioni gratuite.</string>
    <!-- A chapter whose lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_lessons_first_plus">Prima prepariamo le lezioni del capitolo, quindi ci vuole qualche minuto.</string>
