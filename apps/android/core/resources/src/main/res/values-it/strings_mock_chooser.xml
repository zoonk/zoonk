<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Fai una simulazione</string>
    <string name="mock_chooser_line">Con gli stessi tempi dell’esame vero. Vedrai il risultato alla fine.</string>
    <string name="mock_chooser_start">Inizia</string>
    <string name="mock_chooser_one_subject">Una materia</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">L’esame</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">Giornata %1$d</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">Metà della giornata %1$d</string>
    <string name="mock_chooser_full_exam">L’esame completo</string>
    <string name="mock_chooser_half_exam">Metà dell’esame</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">Giornata %1$d, senza %2$s</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">L’esame completo, senza %1$s</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">Senza la parte scritta</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d domanda · %2$s</item>
        <item quantity="many">%1$d domande · %2$s</item>
        <item quantity="other">%1$d domande · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">Non ci sono ancora abbastanza domande per questa simulazione. Scegline un’altra.</string>
    <string name="mock_chooser_failed">Non siamo riusciti ad avviare la simulazione. Riprova.</string>
    <string name="mock_chooser_short_title">Vuoi iniziare una simulazione più breve?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_day">Oggi questa simulazione ha %1$s domande su %2$s e dura circa %3$s. Potrai fare quella completa domani.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">Oggi questa simulazione ha %1$s domande su %2$s e dura circa %3$s. Potrai fare quella completa il mese prossimo.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">Oggi questa simulazione ha %1$s domande su %2$s e dura circa %3$s.</string>
    <string name="mock_chooser_pick_another">Scegline un’altra</string>
    <string name="mock_chooser_preparing">Stiamo preparando la tua simulazione…</string>
    <string name="mock_chooser_preparing_detail">Stiamo preparando per te domande simili a quelle dell’esame. La simulazione inizia qui appena sono pronte.</string>
    <string name="mock_chooser_writing">Stiamo preparando la tua simulazione</string>
    <string name="mock_chooser_writing_questions">Stiamo preparando domande simili a quelle dell’esame</string>
    <string name="mock_chooser_writing_questions_line">Stiamo scegliendo cosa chiedere per ogni materia…</string>
    <!-- The panel beside the options, about the one picked. -->
    <string name="mock_chooser_picked">La simulazione d’esame scelta</string>
    <string name="mock_chooser_questions">Domande</string>
    <string name="mock_chooser_time_limit">Tempo limite</string>
    <string name="mock_chooser_usually_takes">Di solito richiede</string>
    <!-- %1$s is a duration, such as "1 hr 20 min". -->
    <string name="mock_chooser_about">Circa %1$s</string>
    <string name="mock_chooser_subjects">Materie</string>
    <!-- The exam's sections a mock sits, such as Listening and Reading. -->
    <string name="mock_chooser_parts">Parti</string>
    <!-- Under a part such as "Essay", which the learner writes rather than answers. -->
    <string name="mock_chooser_written_part">Parte scritta</string>
    <string name="mock_chooser_last_mock">La tua ultima simulazione d’esame</string>
    <!-- %1$s is a past exam edition, such as "2024 exam"; %2$s the site that counted its questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_past_edition">Domande per materia (%1$s), secondo il conteggio di %2$s.</string>
    <!-- %1$s is the site that counted the questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_latest_exam">Domande per materia nell’ultimo esame, secondo il conteggio di %1$s.</string>
