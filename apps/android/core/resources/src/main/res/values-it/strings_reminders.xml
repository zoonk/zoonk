<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">Promemoria di studio</string>
    <string name="reminders_channel_description">Un promemoria nei tuoi giorni di studio, quando hai ancora qualcosa da studiare.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">Vuoi un promemoria per studiare?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">Alle %1$s nei tuoi giorni di studio, quando hai ancora qualcosa da studiare.</string>
    <string name="reminders_remind_me">Ricordamelo</string>
    <!-- Declines the offer. Keep it neutral and ungendered, like "Not now" (Portuguese: "Agora não"). -->
    <string name="reminders_no_thanks">No, grazie</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">I promemoria sono attivi.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">I promemoria via email sono attivi.</string>
    <string name="reminders_turn_on_failed">Non siamo riusciti ad attivare i promemoria. Riprova.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Le notifiche per Zoonk sono disattivate.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">Apri le impostazioni</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">Ricordamelo via email</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">Vuoi consentire le notifiche?</string>
    <string name="reminders_permission_body">Zoonk invia un promemoria nei tuoi giorni di studio, solo se hai ancora qualcosa da studiare.</string>
    <string name="reminders_permission_continue">Continua</string>
    <string name="reminders_not_now">Non ora</string>
    <!-- The row that shows the reminder's time and opens a clock to change it, and that clock's title. -->
    <string name="reminders_time_title">Orario del promemoria</string>
    <string name="reminders_save">Salva</string>
    <string name="reminders_cancel">Annulla</string>
    <!-- The row in Preferences that opens the reminders page. -->
    <string name="reminders_row">Promemoria di studio</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">Promemoria</string>
    <string name="reminders_description">Un promemoria al giorno, solo se hai ancora qualcosa da studiare.</string>
    <!-- The time of day a reminder goes out, not an amount of time. -->
    <string name="reminders_time">Orario</string>
    <!-- %1$s is a time of day and %2$s its time zone, such as "7:00 PM, Brasilia Time". -->
    <string name="reminders_time_in_zone">%1$s, %2$s</string>
    <string name="reminders_email">Email</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">Crea un account per ricevere i promemoria via email</string>
    <string name="reminders_push">Notifiche push</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">Nei giorni di studio previsti dai tuoi piani</string>
    <string name="reminders_quiet">In pausa mentre non ci sei. Riprendono quando torni a studiare.</string>
    <string name="reminders_save_failed">Il salvataggio non è riuscito. Riprova.</string>
    <!-- Push reminders go to another of the learner's devices; this one can take over. -->
    <string name="reminders_use_this_device">Usa questo dispositivo</string>
    <!-- After the selected device's name, such as "Pixel 9 · This device", when it's the device in hand. -->
    <string name="reminders_this_device">Questo dispositivo</string>
</resources>
