    <string name="activities_math_sampling_summary">%1$s campioni da %2$s estratti da %3$s. Il valore reale è %4$s; il 95%% dei campioni è rientrato tra %5$s e %6$s.</string>
    <!-- Under the chart, where the middle 95% of the samples landed, like "45% to 55%". -->
    <string name="activities_math_sampling_range">Da %1$s a %2$s</string>
    <!-- Above a dashed line on the chart at the population's real value, like "True value: 50%". -->
    <string name="activities_math_sampling_truth">Valore reale: %1$s</string>
    <!-- What the sample size slider says to TalkBack: the size, then the margin it gives, like "400. 95% of samples within ±4.9 points." -->
    <string name="activities_math_sampling_slider_value">%1$s. Il 95%% dei campioni rientra entro %2$s.</string>
