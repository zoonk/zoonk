    <string name="certificates_meaning_title">Cosa attesta questo certificato</string>
    <string name="certificates_meaning_language">Zoonk rilascia questo certificato a chi completa tutte le lezioni del livello di un corso di lingua, studiandone almeno la metà su Zoonk e superando i test per le altre.</string>
