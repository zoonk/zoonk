<resources>
    <!-- A place name, like "Completed lessons": the page listing the learner's completion certificates, to print, download or share. -->
    <string name="certificates_title">Certificati</string>
    <!-- Above the page title, counting the learner's certificates. -->
    <plurals name="certificates_count">
        <item quantity="one">%1$d certificato</item>
        <item quantity="many">%1$d certificati</item>
        <item quantity="other">%1$d certificati</item>
    </plurals>
    <string name="certificates_lead">Stampa, scarica o condividi i tuoi certificati quando vuoi.</string>
    <!-- What a certificate certifies: a finished course or a finished language level. Printed on the certificate itself. -->
    <string name="certificates_kind_completion">Certificato di completamento</string>
    <!-- A certificate stating the language level a placement test measured, such as "Spanish B1". -->
    <string name="certificates_kind_placement">Risultato del test di livello</string>
    <!-- A language certificate's name: %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
    <string name="certificates_language_level">%1$s %2$s</string>
    <string name="certificates_empty_title">Ancora nessun certificato</string>
    <string name="certificates_empty_description">Quando completi un corso o un livello in una lingua, il certificato compare qui e puoi stamparlo e condividerlo gratis. Qui trovi anche il risultato del test di livello.</string>
    <string name="certificates_continue_learning">Continua a imparare</string>
    <!-- A section title on the empty page, over the learner's goals and how each one earns a certificate. -->
    <!-- On a finished plan's card: opens the course's certificate. -->
    <string name="certificates_view">Visualizza il certificato</string>
    <!-- On a finished plan's card: issues the course's certificate, which wasn't issued yet. -->
    <string name="certificates_get">Ottieni il tuo certificato</string>
    <string name="certificates_up_next">Prossima lezione</string>
    <string name="certificates_up_next_course">Il tuo certificato arriva quando completi il piano</string>
    <!-- Under a language goal: its certificate comes once every skill the learner practices (reading, listening, speaking, writing) reaches the next CEFR level. -->
    <string name="certificates_up_next_language">Arriva quando raggiungi il livello successivo in tutte le abilità che alleni</string>
    <!-- The title of a full screen shown once, right after the learner finishes every lesson of a course. -->
    <string name="certificates_course_complete">Corso completato!</string>
    <!-- The title of a full screen shown once, right after the learner finishes a language level. %1$s is the CEFR level, such as "B1". -->
