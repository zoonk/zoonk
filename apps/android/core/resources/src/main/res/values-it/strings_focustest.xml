    <string name="focustest_see_your_result">Vedi il tuo risultato</string>
    <!-- The test's state on the plan: the learner paused its questions in their study sessions. -->
    <string name="focustest_paused_in_sessions">In pausa nelle tue sessioni</string>
    <string name="focustest_take_test">Fai il Test delle priorità</string>
    <!-- Under the daily time while it's short: %1$s lists up to three exam subjects, such as "Logic, Law and Math". -->
    <string name="focustest_schedule_focus">Con questo tempo a disposizione, ti suggeriamo di dedicare più attenzione a %1$s.</string>
    <!-- On the plan reveal: %1$s is a daily study time, such as "4 hr"; %2$s a date, such as "Dec 10"; %3$s lists up to three exam subjects. -->
    <string name="focustest_reveal_trade_off">Con %1$s al giorno, non c’è tempo per tutti gli argomenti prima del %2$s. Questo piano dedica più tempo a %3$s.</string>
    <string name="focustest_what_test_changed">Scopri cosa ha cambiato il test</string>
    <!-- Today's suggestion to take the test, in the goal's first week, when the learner's time can't cover everything. -->
    <string name="focustest_suggestion_line">Il Test delle priorità ti mostra cosa studiare di più.</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_suggestion_body">Il tempo che hai prima dell’esame non basta per tutto. In circa %1$s, il Test delle priorità ti mostra cosa studiare di più.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">Va bene. Puoi fare il test dal tuo piano.</string>
    <!-- On a session's test question: skips today's test questions; they're asked another day. -->
    <string name="focustest_not_today">Non oggi</string>
    <string name="focustest_not_today_failed">Il salvataggio non è riuscito. Riprova.</string>
