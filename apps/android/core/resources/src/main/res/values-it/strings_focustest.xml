<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">Test delle priorità</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_about">Circa %1$s</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="focustest_about_left">Ancora circa %1$s</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">Scopri a cosa dare priorità</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">Scopri da dove iniziare</string>
    <string name="focustest_offer_description_focus">Domande rapide sulle materie del tuo esame. Il tuo piano salta ciò che sai già, così dedichi il tempo a ciò che ti serve di più.</string>
    <string name="focustest_offer_description">Domande rapide sulle materie del tuo esame. Il tuo piano salta ciò che sai già.</string>
    <string name="focustest_how_it_works">Come funziona</string>
    <string name="focustest_how_weight_title">Prima ciò che conta di più</string>
    <string name="focustest_how_weight">Il test parte dalle materie che contano di più nel tuo esame.</string>
    <string name="focustest_how_grade_title">Non ci sono voti</string>
    <string name="focustest_how_grade">“Non lo so ancora” va benissimo come risposta.</string>
    <string name="focustest_how_stop_title">Puoi fermarti quando vuoi</string>
    <string name="focustest_how_stop">Ogni risposta viene salvata.</string>
    <string name="focustest_how_subjects_title">Dare priorità non esclude nessuna materia</string>
    <string name="focustest_how_subjects">Quando il tempo non basta per tutto, il piano ne dedica di più alle materie su cui hai più bisogno di lavorare.</string>
    <!-- The learner's first week of study sessions also asks a few of the test's questions. -->
    <string name="focustest_how_sessions_title">Qualche domanda in più nella prima settimana</string>
    <string name="focustest_how_sessions">Durante le sessioni di studio ti proponiamo poche altre domande del test. Puoi metterle in pausa.</string>
    <string name="focustest_start">Inizia il test</string>
    <string name="focustest_skip_for_now">Salta per ora</string>
    <string name="focustest_skip_note">Puoi fare il test più avanti, dal tuo piano.</string>
    <string name="focustest_not_now">Non ora</string>
    <string name="focustest_resume_title">Continua il test</string>
    <plurals name="focustest_answers_saved_line">
        <item quantity="one">Abbiamo salvato %d risposta.</item>
        <item quantity="many">Abbiamo salvato %d risposte.</item>
        <item quantity="other">Abbiamo salvato %d risposte.</item>
    </plurals>
    <string name="focustest_continue">Continua</string>
    <string name="focustest_see_my_result">Vedi il risultato</string>
