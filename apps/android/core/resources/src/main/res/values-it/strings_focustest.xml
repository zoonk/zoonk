    <string name="focustest_see_all_subjects">Vedi tutte le materie</string>
    <string name="focustest_subjects">Materie</string>
    <!-- Label of an on/off switch on the Focus test's result: the test's questions keep coming, a few at a time, in the learner's lessons. -->
    <string name="focustest_session_questions">Fammi altre domande mentre studio</string>
    <string name="focustest_session_questions_when">Durante la tua prima settimana</string>
    <string name="focustest_done">Fatto</string>
    <!-- Button on the Focus test's result: continues the test with more questions. -->
    <string name="focustest_answer_more">Rispondi ad altre domande</string>
    <!-- Headline, above a short list of exam subjects: asks the learner whether their study plan should give those subjects more time. -->
    <string name="focustest_proposal_title">Vuoi dedicare più tempo a queste materie?</string>
    <!-- How the Focus test picked the subjects listed below it: from the learner's answers to its questions and how many of the exam's questions each subject has. -->
    <string name="focustest_proposal_picked">Scelti in base alle tue risposte e a quanto contano nel tuo esame.</string>
    <string name="focustest_update_plan">Aggiorna il mio piano</string>
