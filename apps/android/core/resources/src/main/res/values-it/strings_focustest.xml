    <string name="focustest_question_number">Domanda %1$d di %2$d</string>
    <string name="focustest_stop">Interrompi e usa le mie risposte</string>
    <!-- Shown after several "I don't know yet" answers in a row. -->
    <string name="focustest_many_unknown">Non hai ancora studiato buona parte di questi argomenti? Va bene così. Puoi fermarti qui e iniziare a imparare.</string>
    <string name="focustest_answers_saved_title">Abbiamo salvato le tue risposte</string>
