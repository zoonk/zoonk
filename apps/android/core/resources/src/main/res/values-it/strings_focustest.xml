        <item quantity="other">Il tuo piano salta anche %d lezioni su ciò che sai già.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">Abbiamo definito il tuo punto di partenza</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="one">Il tuo piano salta %d lezione su argomenti che conosci già.</item>
        <item quantity="many">Il tuo piano salta %d lezioni su argomenti che conosci già.</item>
        <item quantity="other">Il tuo piano salta %d lezioni su argomenti che conosci già.</item>
    </plurals>
    <string name="focustest_from_basics">Il tuo piano parte dalle basi in ogni materia.</string>
    <string name="focustest_result_current">Il tuo piano dedica più tempo a queste materie.</string>
    <string name="focustest_result_hand_picked">Il tuo piano mantiene le priorità che hai scelto. Ecco cosa suggerisce il test.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
