    <string name="focustest_session_questions_when">Durante la tua prima settimana</string>
    <string name="focustest_done">Fatto</string>
    <string name="focustest_answer_more">Rispondi ad altre domande</string>
    <!-- The test asks before changing a plan the learner already has. -->
    <string name="focustest_proposal_title">Vuoi dedicare più tempo a queste materie?</string>
    <string name="focustest_proposal_description">Il tempo che hai prima dell’esame non basta per tutto.</string>
