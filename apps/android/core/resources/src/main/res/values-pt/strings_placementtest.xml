<resources>
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">Teste o que você já sabe</string>
    <string name="placementtest_skip_lessons">Pule aulas que você já conhece</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">Teste de nível</string>
    <string name="placementtest_find_level">Descubra seu nível e pule o que já sabe</string>
    <string name="placementtest_in_progress">Em andamento</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="placementtest_time_left">Restam %1$s</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Nenhuma aula pulada</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d aula pulada</item>
        <item quantity="many">%d aulas puladas</item>
        <item quantity="other">%d aulas puladas</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">Leitura %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">Escuta %1$s</string>
    <string name="placementtest_start_title">Pule o que você já sabe</string>
    <string name="placementtest_choose_description">Um teste identifica as aulas que você pode pular.</string>
    <string name="placementtest_quick_only_description">Um teste rápido identifica as aulas que você pode pular. Leva cerca de %1$s.</string>
    <string name="placementtest_choose_title">O que você quer avaliar?</string>
    <!-- The short placement test: about four minutes of questions. -->
    <string name="placementtest_quick">Rápido</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">Cerca de %1$s</string>
    <!-- The long placement test: it checks every topic still ahead in the course. -->
    <string name="placementtest_whole_course">Curso inteiro</string>
    <!-- %1$s is a duration with its unit, such as "30 min". The test is split into parts the learner can take on different days. -->
    <string name="placementtest_about_in_parts">Cerca de %1$s, dividido em partes</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_test_out">Pular %1$s com um teste</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">Pule %1$s se você já souber esse conteúdo</string>
    <string name="placementtest_start">Começar</string>
    <!-- A whole-course test is split into parts; %1$d is the part's number. -->
    <string name="placementtest_part">Parte %1$d</string>
    <string name="placementtest_continue_title">Continue seu teste</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="placementtest_left_saved">Falta cerca de %1$s. Suas respostas estão salvas.</string>
    <string name="placementtest_continue_from_plan">Você pode terminar o teste em Plano.</string>
    <string name="placementtest_finish_for_today">Concluir por hoje</string>
    <string name="placementtest_keep_going">Continuar</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Você já sabia dessa aula. Ela continua na sua prática.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Você já sabia dessas aulas. Elas continuam na sua prática.</string>
    <string name="placementtest_plan_stays">Seu plano continua como está.</string>
    <string name="placementtest_retake_tomorrow">Você desfez isso hoje. Responda de novo amanhã para pular essas aulas.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">A seguir</string>
    <string name="placementtest_whole_course_skips_more">O teste do curso inteiro pode pular mais aulas.</string>
    <string name="placementtest_done">Concluído</string>
    <string name="placementtest_not_now">Agora não</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">Seu nível de %1$s</string>
    <!-- %2$s is a list of language levels, such as "A1, A2". The plan no longer has their lessons. -->
    <plurals name="placementtest_levels_skipped">
        <item quantity="one">Pulamos %2$s: %1$d aula.</item>
        <item quantity="many">Pulamos %2$s: %1$d aulas.</item>
        <item quantity="other">Pulamos %2$s: %1$d aulas.</item>
    </plurals>
    <string name="placementtest_keeps_adjusting">Suas aulas vão se ajustando conforme você responde.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$s continua no seu plano</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">Ainda não há perguntas suficientes para %1$s.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">Isso parece fácil para você</string>
    <string name="placementtest_offer_quick">Um teste rápido pode pular aulas que você já conhece.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">Um teste rápido pode pular %1$s se você já souber esse conteúdo.</string>
</resources>
