<resources>
    <!-- A unit's place and its levels: "Unit 3 · A1–A2". -->
    <string name="language_unit_eyebrow">Unidade %1$s · %2$s</string>
    <plurals name="language_unit_lessons">
        <item quantity="one">%d aula</item>
        <item quantity="many">%d aulas</item>
        <item quantity="other">%d aulas</item>
    </plurals>
    <!-- How much of the unit is done, the unit being the subject: "33% done". -->
    <string name="language_unit_done_share">%1$s concluído</string>
    <string name="language_unit_start">Começar</string>
    <string name="language_unit_continue">Continuar</string>
    <string name="language_unit_objectives">Ao final desta unidade</string>
    <string name="language_unit_progress">Progresso</string>
    <string name="language_unit_practice">Prática</string>
    <string name="language_unit_mistakes">Seus erros</string>
    <!-- Heading over material to look things up in, such as grammar tips and words, rather than lessons to do. -->
    <string name="language_unit_reference">Para consulta</string>
    <string name="language_unit_grammar_tips">Dicas de gramática</string>
    <string name="language_unit_words">Palavras desta unidade</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s e mais %2$s</string>
    <string name="language_unit_summary">Resumo da unidade</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">Sobre esta unidade</string>
    <string name="language_skill_reading">Leitura</string>
    <string name="language_skill_listening">Escuta</string>
    <string name="language_skill_speaking">Conversação</string>
    <string name="language_skill_words">Palavras</string>
    <string name="language_skill_writing">Escrita</string>
    <!-- Heads each skill's level (reading, listening, speaking, writing) on the CEFR scale from A1 to C2, estimated from the learner's answers to set how hard practice is. -->
    <string name="language_practice_estimates">Níveis estimados para a prática</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">Objetivo %1$s até %2$s</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">Objetivo %1$s</string>
    <!-- What TalkBack says for a skill's row. %1$s is a CEFR level, such as "B1". -->
    <string name="language_estimate_reading">Nível estimado de leitura: %1$s</string>
    <string name="language_estimate_listening">Nível estimado de escuta: %1$s</string>
    <string name="language_estimate_speaking">Nível estimado de conversação: %1$s</string>
    <string name="language_estimate_writing">Nível estimado de escrita: %1$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Estimated reading level: B1, up since the level test". -->
    <string name="language_estimate_trend">%1$s, %2$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">subiu desde o teste de nível</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">caiu desde o teste de nível</string>
    <string name="language_levels_move">Os níveis mudam conforme você pratica. Eles ficam mais precisos a cada semana.</string>
    <!-- Under the skill estimates: they set how hard practice is, while certificates come from finishing the plan's lessons. -->
    <string name="language_estimates_note">Essas estimativas ajudam a definir a dificuldade da prática. Os certificados dependem das aulas concluídas no seu plano.</string>
    <!-- One skill's estimate rose since the level test. %1$s is a CEFR level, such as "B2". -->
    <string name="language_estimate_rose_reading">Seu nível estimado de leitura subiu para %1$s</string>
    <string name="language_estimate_rose_listening">Seu nível estimado de escuta subiu para %1$s</string>
    <string name="language_estimate_rose_speaking">Seu nível estimado de conversação subiu para %1$s</string>
    <string name="language_estimate_rose_writing">Seu nível estimado de escrita subiu para %1$s</string>
    <!-- The count is how many skills' estimates rose since the level test, always two or more; %1$s lists them: "Speaking and Writing estimates went up". -->
    <plurals name="language_estimates_rose">
        <item quantity="one">Os níveis estimados de %1$s subiram</item>
        <item quantity="many">Os níveis estimados de %1$s subiram</item>
        <item quantity="other">Os níveis estimados de %1$s subiram</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">Eu já consigo…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">Ainda não</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s, objetivo %2$s</string>
    <string name="language_pattern_noticed">A gente percebeu um padrão</string>
    <string name="language_pattern_typos">Só erros de digitação</string>
    <string name="language_pattern_typos_description">Seus erros recentes foram de digitação, não de alguma regra que você precisa aprender.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">Repita %d palavra</item>
        <item quantity="many">Repita %d palavras</item>
        <item quantity="other">Repita %d palavras</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">No início da sua próxima sessão · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">Pratique quando quiser · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">Já consigo ler</string>
    <string name="language_alphabet_skip_failed">Não foi possível salvar. Tente de novo.</string>
    <!-- Button that opens the words to say aloud again; "them" is those words. -->
    <string name="language_say_them">Repetir as palavras</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Abrir</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">A gente percebeu um padrão: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Praticar</string>
    <string name="language_level">Nível</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, objetivo %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Ver seu plano</string>
</resources>
