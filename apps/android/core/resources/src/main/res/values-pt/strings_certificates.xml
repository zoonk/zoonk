<resources>
    <!-- A place name, like "Completed lessons": the page listing the learner's completion certificates, to print, download or share. -->
    <string name="certificates_title">Certificados</string>
    <!-- Above the page title, counting the learner's certificates. -->
    <plurals name="certificates_count">
        <item quantity="one">%1$d certificado</item>
        <item quantity="many">%1$d certificados</item>
        <item quantity="other">%1$d certificados</item>
    </plurals>
    <string name="certificates_lead">Imprima, baixe ou compartilhe seus certificados quando quiser.</string>
    <!-- What a certificate certifies: a finished course or a finished language level. Printed on the certificate itself. -->
    <string name="certificates_kind_completion">Certificado de conclusão</string>
    <!-- A certificate stating the language level a placement test measured, such as "Spanish B1". -->
    <string name="certificates_kind_placement">Resultado do teste de nível</string>
    <!-- A language certificate's name: %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
    <string name="certificates_language_level">%1$s %2$s</string>
    <string name="certificates_empty_title">Ainda não há certificados</string>
    <string name="certificates_empty_description">Ao concluir um curso ou um nível em um idioma, seu certificado aparece aqui para você imprimir e compartilhar de graça. O resultado do teste de nível também aparece aqui.</string>
    <string name="certificates_continue_learning">Continuar aprendendo</string>
    <!-- A section title on the empty page, over the learner's goals and how each one earns a certificate. -->
    <!-- On a finished plan's card: opens the course's certificate. -->
    <string name="certificates_view">Ver certificado</string>
    <!-- On a finished plan's card: issues the course's certificate, which wasn't issued yet. -->
    <string name="certificates_get">Emitir seu certificado</string>
    <string name="certificates_up_next">A seguir</string>
    <string name="certificates_up_next_course">Seu certificado fica pronto quando você conclui o plano</string>
    <!-- Under a language goal: its certificate comes once every skill the learner practices (reading, listening, speaking, writing) reaches the next CEFR level. -->
    <string name="certificates_up_next_language">Fica pronto quando todas as habilidades que você pratica chegam ao próximo nível</string>
    <!-- The title of a full screen shown once, right after the learner finishes every lesson of a course. -->
    <string name="certificates_course_complete">Curso concluído!</string>
    <!-- The title of a full screen shown once, right after the learner finishes a language level. %1$s is the CEFR level, such as "B1". -->
    <string name="certificates_level_complete">Nível %1$s concluído!</string>
    <!-- The title when the learner earned two or more certificates at once. -->
    <plurals name="certificates_earned">
        <item quantity="one">%1$d certificado conquistado</item>
        <item quantity="many">%1$d certificados conquistados</item>
        <item quantity="other">%1$d certificados conquistados</item>
    </plurals>
    <!-- %1$s is the course's title. -->
    <string name="certificates_course_ready">Seu certificado de %1$s está pronto.</string>
    <!-- %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
    <string name="certificates_language_ready">Seu certificado de %1$s %2$s está pronto.</string>
    <!-- %1$s lists the certificates' names, such as "Spanish A2 and B1" or "Python and Spanish B1". -->
    <string name="certificates_several_ready">Seus certificados de %1$s estão prontos.</string>
    <string name="certificates_guest_line">Crie uma conta grátis para salvar seu certificado e colocar seu nome nele.</string>
    <string name="certificates_create_account">Crie uma conta grátis</string>
    <!-- %1$s is the learner's name, as printed on their certificate. -->
    <string name="certificates_on_your_certificate">No seu certificado: %1$s</string>
    <!-- A short button beside the learner's name, to edit the name printed on their certificates. -->
