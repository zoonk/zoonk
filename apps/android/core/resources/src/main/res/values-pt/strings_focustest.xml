<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">Teste de foco</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">Descubra o que precisa estudar mais</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">Já sabe um pouco disso?</string>
    <string name="focustest_offer_sentence">Um teste mostra o que você já sabe, para você dedicar mais tempo ao que mais precisa.</string>
    <string name="focustest_offer_line">Esse teste mostra o que você já sabe para seu plano poder pular essa parte.</string>
    <string name="focustest_start">Começar o teste</string>
    <string name="focustest_skip_note">Você pode fazer o teste depois, pelo seu plano.</string>
    <string name="focustest_not_now">Agora não</string>
    <string name="focustest_continue">Continuar</string>
    <string name="focustest_see_my_result">Ver meu resultado</string>
    <string name="focustest_stop">Parar e usar minhas respostas</string>
    <!-- Shown after several "I don't know yet" answers in a row. -->
    <string name="focustest_many_unknown">Ainda não estudou a maior parte disso? Tudo bem. Você pode parar por aqui e começar a aprender.</string>
    <string name="focustest_answers_saved_title">Suas respostas estão salvas</string>
    <!-- The test's result: the exam subjects that need the most study time, most needed first. -->
    <string name="focustest_result_title">Veja onde focar</string>
    <string name="focustest_result_description">Com base nas suas respostas e no que tem mais peso na sua prova. Focar nunca tira uma matéria do plano.</string>
    <plurals name="focustest_also_skips">
        <item quantity="one">Seu plano também pula %d aula com conteúdo que você já conhece.</item>
        <item quantity="many">Seu plano também pula %d aulas com conteúdo que você já conhece.</item>
        <item quantity="other">Seu plano também pula %d aulas com conteúdo que você já conhece.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">Seu ponto de partida está definido</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="one">Seu plano pula %d aula com conteúdo que você já conhece.</item>
        <item quantity="many">Seu plano pula %d aulas com conteúdo que você já conhece.</item>
        <item quantity="other">Seu plano pula %d aulas com conteúdo que você já conhece.</item>
    </plurals>
    <string name="focustest_from_basics">Seu plano começa cada matéria pelo básico.</string>
    <string name="focustest_result_current">Seu plano dedica mais tempo a essas matérias.</string>
    <string name="focustest_result_hand_picked">Seu plano mantém o foco que você escolheu. Esta é a sugestão do teste.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
    <string name="focustest_result_declined">Você deixou seu plano como está. Esta é a sugestão do teste.</string>
    <string name="focustest_change_focus">Mudar o foco</string>
    <string name="focustest_see_all_subjects">Ver todas as matérias</string>
    <string name="focustest_subjects">Matérias</string>
    <!-- A switch: the learner's study sessions also ask a few of the test's questions. -->
    <string name="focustest_session_questions">Receber mais algumas perguntas enquanto estudo</string>
    <string name="focustest_session_questions_when">Durante sua primeira semana</string>
    <string name="focustest_done">Concluído</string>
    <string name="focustest_answer_more">Responder mais perguntas</string>
    <!-- The test asks before changing a plan the learner already has. -->
    <string name="focustest_proposal_title">Dedicar mais tempo a essas matérias?</string>
    <!-- How the Focus test picked the subjects listed below it: from the learner's answers to its questions and how many of the exam's questions each subject has. -->
    <string name="focustest_proposal_picked">Com base nas suas respostas e no quanto cada matéria é cobrada na prova.</string>
    <string name="focustest_update_plan">Atualizar meu plano</string>
    <string name="focustest_proposal_applied">Seu plano agora dedica mais tempo a essas matérias.</string>
    <string name="focustest_proposal_declined">Seu plano continua como estava.</string>
    <string name="focustest_proposal_undone">Desfeito. Seu plano voltou a ser como era antes.</string>
    <string name="focustest_undo">Desfazer</string>
    <!-- A short fact beside a subject in a list: every answer the learner gave on it was “I don't know yet”. It is not a grade. -->
    <string name="focustest_not_known_yet">Ainda não sabe</string>
    <!-- %1$d answers right of %2$d asked on one subject. -->
    <plurals name="focustest_subject_right">
        <item quantity="one">Você acertou %1$d de %2$d</item>
        <item quantity="many">Você acertou %1$d de %2$d</item>
        <item quantity="other">Você acertou %1$d de %2$d</item>
    </plurals>
    <!-- Parts of the exam the Focus test's questions can't ask about, such as the essay. -->
    <string name="focustest_written_not_checked">Escrita: fora deste teste</string>
    <string name="focustest_listening_not_checked">Escuta: fora deste teste</string>
    <string name="focustest_speaking_not_checked">Conversação: fora deste teste</string>
    <string name="focustest_practical_not_checked">Parte prática: fora deste teste</string>
    <!-- The test's state on the plan: the learner started it and left before the end. -->
    <string name="focustest_in_progress">Em andamento</string>
    <string name="focustest_see_your_result">Ver seu resultado</string>
    <string name="focustest_take_test">Fazer o Teste de foco</string>
    <!-- Today's suggestion to take the test, in the goal's first week, when the learner's time can't cover everything. -->
    <string name="focustest_suggestion_line">O Teste de foco mostra o que você mais precisa estudar.</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="focustest_suggestion_body">Um teste de foco de %1$s mostra o que você já sabe, para que mais tempo seja dedicado ao que você mais precisa. Ele nunca remove uma matéria.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">Tudo bem. Você pode fazer o teste pelo seu plano.</string>
    <!-- On a session's test question: skips today's test questions; they're asked another day. -->
    <string name="focustest_not_today">Hoje não</string>
    <string name="focustest_not_today_failed">Não foi possível salvar. Tente de novo.</string>
</resources>
