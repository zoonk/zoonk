<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">Lembretes de estudo</string>
    <string name="reminders_channel_description">Um lembrete nos seus dias de estudo, quando ainda tiver algo para estudar.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">Quer um lembrete de estudo?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">Às %1$s nos seus dias de estudo, quando ainda tiver algo para estudar.</string>
    <string name="reminders_remind_me">Me lembrar</string>
    <!-- Declines the offer. Keep it neutral and ungendered, like "Not now" (Portuguese: "Agora não"). -->
    <string name="reminders_no_thanks">Agora não</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">Lembretes ativados.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">Lembretes por e-mail ativados.</string>
    <string name="reminders_turn_on_failed">Não deu para ativar os lembretes. Tente de novo.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">As notificações do Zoonk estão desativadas.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">Abrir Configurações</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">Receber por e-mail</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">Permitir notificações?</string>
    <string name="reminders_permission_body">O Zoonk envia um lembrete nos seus dias de estudo, só quando ainda tiver algo para estudar.</string>
    <string name="reminders_permission_continue">Continuar</string>
    <string name="reminders_not_now">Agora não</string>
    <!-- The row that shows the reminder's time and opens a clock to change it, and that clock's title. -->
    <string name="reminders_time_title">Horário do lembrete</string>
    <string name="reminders_save">Salvar</string>
    <string name="reminders_cancel">Cancelar</string>
    <!-- The row in Preferences that opens the reminders page. -->
    <string name="reminders_row">Lembretes de estudo</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">Lembretes</string>
    <string name="reminders_description">Um lembrete por dia, só quando ainda tiver algo para estudar.</string>
    <string name="reminders_time">Horário</string>
    <!-- %1$s is a time of day and %2$s its time zone, such as "7:00 PM, Brasilia Time". -->
    <string name="reminders_time_in_zone">%1$s, %2$s</string>
    <string name="reminders_email">E-mail</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">Crie uma conta para receber lembretes por e-mail</string>
    <string name="reminders_push">Notificações</string>
    <!-- Push reminders go to another of the learner's phones; this one can take over. -->
    <string name="reminders_use_this_phone">Usar este celular</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">Nos seus dias de estudo, conforme seus planos</string>
    <string name="reminders_quiet">Pausados enquanto você dá um tempo nos estudos. Voltam quando você estudar.</string>
    <string name="reminders_save_failed">Não foi possível salvar. Tente de novo.</string>
</resources>
