<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Fazer um simulado</string>
    <string name="mock_chooser_line">Com tempo marcado, como na prova. Você vê seu resultado no final.</string>
    <string name="mock_chooser_start">Começar</string>
    <string name="mock_chooser_one_subject">Uma matéria</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">A prova</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">Dia %1$d</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">Metade do dia %1$d</string>
    <string name="mock_chooser_full_exam">A prova inteira</string>
    <string name="mock_chooser_half_exam">Metade da prova</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">Dia %1$d, sem %2$s</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">A prova inteira, sem %1$s</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">Sem a parte escrita</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d questão · %2$s</item>
        <item quantity="many">%1$d questões · %2$s</item>
        <item quantity="other">%1$d questões · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">Ainda faltam questões para esse simulado. Escolha outro.</string>
    <string name="mock_chooser_failed">Não deu para começar o simulado. Tente de novo.</string>
    <string name="mock_chooser_short_title">Começar um simulado mais curto?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_day">Hoje, esse simulado tem %1$s das %2$s questões e leva cerca de %3$s. Você pode fazer o completo amanhã.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">Hoje, esse simulado tem %1$s das %2$s questões e leva cerca de %3$s. Você pode fazer o completo no mês que vem.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">Hoje, esse simulado tem %1$s das %2$s questões e leva cerca de %3$s.</string>
    <string name="mock_chooser_pick_another">Escolher outro</string>
    <string name="mock_chooser_preparing">Preparando seu simulado…</string>
    <string name="mock_chooser_preparing_detail">A gente está criando perguntas parecidas com as da prova para você. O simulado começa aqui assim que elas estiverem prontas.</string>
    <string name="mock_chooser_writing">Criando seu simulado</string>
    <string name="mock_chooser_writing_questions">Criando perguntas parecidas com as da prova</string>
    <string name="mock_chooser_writing_questions_line">Escolhendo o que perguntar em cada matéria…</string>
    <!-- The panel beside the options, about the one picked. -->
    <string name="mock_chooser_picked">O simulado escolhido</string>
    <string name="mock_chooser_questions">Perguntas</string>
    <string name="mock_chooser_time_limit">Tempo limite</string>
    <string name="mock_chooser_usually_takes">Tempo estimado</string>
    <!-- %1$s is a duration, such as "1 hr 20 min". -->
    <string name="mock_chooser_about">Cerca de %1$s</string>
    <string name="mock_chooser_subjects">Matérias</string>
    <!-- The exam's sections a mock sits, such as Listening and Reading. -->
    <string name="mock_chooser_parts">Partes</string>
    <!-- Under a part such as "Essay", which the learner writes rather than answers. -->
    <string name="mock_chooser_written_part">Parte escrita</string>
    <string name="mock_chooser_last_mock">Seu último simulado</string>
    <!-- %1$s is a past exam edition, such as "2024 exam"; %2$s the site that counted its questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_past_edition">Perguntas por matéria em %1$s, conforme a contagem de %2$s.</string>
    <!-- %1$s is the site that counted the questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_latest_exam">Perguntas por matéria na prova mais recente, conforme a contagem de %1$s.</string>
</resources>
