<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Fazer um simulado</string>
    <string name="mock_chooser_line">Cronometrado, como na prova de verdade. Você vê seu resultado no final.</string>
    <string name="mock_chooser_start">Começar</string>
    <string name="mock_chooser_one_subject">Uma matéria</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">A prova</string>
    <string name="mock_chooser_objective_only">Mais curta, só com questões objetivas</string>
    <!-- The option that takes both tests of an exam of two tests. -->
    <string name="mock_chooser_both_tests">As duas provas</string>
    <string name="mock_chooser_writing_written">Criando suas questões…</string>
    <string name="mock_chooser_writing_written_detail">Questões como as da sua prova. Seu simulado começa quando elas estiverem prontas.</string>
    <string name="mock_chooser_writing_written_failed">Não foi possível criar suas questões</string>
    <!-- The option that takes every test of an exam of several tests. %1$d is how many. -->
    <plurals name="mock_chooser_all_tests">
        <item quantity="one">Todas as %1$d provas</item>
        <item quantity="many">Todas as %1$d provas</item>
        <item quantity="other">Todas as %1$d provas</item>
    </plurals>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">Dia %1$d</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">Metade do dia %1$d</string>
    <string name="mock_chooser_full_exam">A prova inteira</string>
    <string name="mock_chooser_half_exam">Metade da prova</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">Dia %1$d, sem %2$s</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">A prova inteira, sem %1$s</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">Sem a parte escrita</string>
    <!-- A mock exam's size: its number of questions, then its time limit. -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d questão · %2$s</item>
        <item quantity="many">%1$d questões · %2$s</item>
        <item quantity="other">%1$d questões · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">Ainda não tem questões suficientes para este simulado. Escolha outro.</string>
    <string name="mock_chooser_failed">Não deu para começar o simulado. Tente de novo.</string>
    <string name="mock_chooser_short_title">Começar um simulado mais curto?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_day">Hoje, este simulado tem %1$s das %2$s questões e leva cerca de %3$s. Você pode fazer a versão completa amanhã.</string>
    <!-- In a dialog before a mock exam starts shorter than the one picked, because the learner used the questions they can have written for now. -->
    <string name="mock_chooser_short_later_today">Hoje, este simulado tem %1$s das %2$s questões e leva cerca de %3$s. Você pode fazer a versão completa mais tarde, ainda hoje.</string>
    <!-- In a dialog before a mock exam starts shorter than the one picked, because the learner used the questions they can have written for now. {date} is a day and its month, such as "November 22" in English. -->
    <string name="mock_chooser_short_on">Hoje, este simulado tem %1$s das %2$s questões e leva cerca de %3$s. Você pode fazer a versão completa em %4$s.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">Hoje, este simulado tem %1$s das %2$s questões e leva cerca de %3$s.</string>
    <string name="mock_chooser_pick_another">Escolher outro</string>
    <string name="mock_chooser_preparing">Preparando seu simulado</string>
    <string name="mock_chooser_preparing_detail">A gente está criando perguntas parecidas com as da prova para você. O simulado começa aqui assim que elas estiverem prontas.</string>
    <string name="mock_chooser_writing">Criando seu simulado</string>
    <string name="mock_chooser_writing_questions">Criando perguntas parecidas com as da prova</string>
    <string name="mock_chooser_writing_questions_line">Escolhendo o que perguntar em cada matéria…</string>
    <!-- After a mock exam's size and time limit: about how long learners usually take. -->
    <string name="mock_chooser_usually">geralmente %1$s</string>
    <string name="mock_chooser_last_mock">Seu último simulado</string>
    <!-- Over the options of an exam made of several tests, such as an objective test in the morning and a written one in the afternoon. -->
    <plurals name="mock_chooser_exam_tests">
        <item quantity="one">Sua prova tem %d prova</item>
        <item quantity="many">Sua prova tem %d provas</item>
        <item quantity="other">Sua prova tem %d provas</item>
    </plurals>
</resources>
