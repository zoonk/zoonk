    <string name="mindmaps_row_description">As principais ideias do capítulo em uma imagem</string>
    <!-- A chapter whose lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_lessons_first_free">As aulas do capítulo são criadas primeiro e contam para o seu limite de aulas grátis.</string>
    <!-- A chapter whose lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_lessons_first_plus">As aulas do capítulo são criadas primeiro, então leva alguns minutos.</string>
