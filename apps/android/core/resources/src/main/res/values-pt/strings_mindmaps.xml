<resources>
    <!-- How many of the goal's mind maps are drawn: "3 maps". -->
    <plurals name="mindmaps_count">
        <item quantity="one">%1$s mapa</item>
        <item quantity="many">%1$s mapas</item>
        <item quantity="other">%1$s mapas</item>
    </plurals>
    <!-- Under the Mind maps page's title. -->
    <string name="mindmaps_intro">As principais ideias de um capítulo em uma imagem. Cada capítulo que você conclui ganha um mapa mental; você pode criar um para qualquer outro capítulo do seu plano.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_intro_lessons_first_free">As principais ideias de um capítulo em uma imagem. Você ganha um mapa para cada capítulo que conclui e pode criar um para qualquer outro capítulo do seu plano. Ao criar um mapa de um desses capítulos, as aulas dele são criadas primeiro e contam para o seu limite de aulas grátis.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_intro_lessons_first_plus">As principais ideias de um capítulo em uma imagem. Você ganha um mapa para cada capítulo que conclui e pode criar um para qualquer outro capítulo do seu plano. Ao criar um mapa de um desses capítulos, as aulas dele são criadas primeiro, então o mapa leva alguns minutos para ficar pronto.</string>
    <plurals name="mindmaps_chapter_count">
        <item quantity="one">%d capítulo</item>
        <item quantity="many">%d capítulos</item>
        <item quantity="other">%d capítulos</item>
    </plurals>
    <!-- A mind map row's line under the chapter's title. -->
    <string name="mindmaps_chapter_number">Capítulo %1$s</string>
    <string name="mindmaps_empty_title">Nenhum mapa mental ainda</string>
    <string name="mindmaps_empty_description">Os capítulos do seu plano vão aparecendo aqui conforme você avança.</string>
    <string name="mindmaps_keep_studying">Continuar estudando</string>
    <!-- A mind map's description for screen readers when it has no words yet. -->
    <string name="mindmaps_alt_chapter">Mapa mental de %1$s</string>
    <!-- A mind map's description for screen readers: its title, then its central idea. -->
    <string name="mindmaps_alt">Mapa mental: %1$s. %2$s</string>
    <!-- The same, for a title that already ends a sentence. -->
    <string name="mindmaps_alt_sentence">Mapa mental: %1$s %2$s</string>
