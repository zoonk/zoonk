    <string name="mock_chooser_failed">模試を始められませんでした。もう一度試してください。</string>
    <string name="mock_chooser_short_title">短めの模試を始めますか？</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
