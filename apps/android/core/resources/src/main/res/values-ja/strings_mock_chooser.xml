    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">今日は%1$s問（全%2$s問中）で、所要時間は約%3$sです。来月は全問に取り組めます。</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">今日は%1$s問（全%2$s問中）で、所要時間は約%3$sです。</string>
