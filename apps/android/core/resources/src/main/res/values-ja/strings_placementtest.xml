<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">知っている内容をテストする</string>
    <string name="placementtest_skip_lessons">すでに知っているレッスンをスキップする</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">レベル診断テスト</string>
    <string name="placementtest_find_level">レベルを診断して、知っている内容をスキップする</string>
    <string name="placementtest_in_progress">進行中</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">スキップしたレッスンはありません</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="other">%dレッスンをスキップ</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">リーディング %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">リスニング %1$s</string>
    <string name="placementtest_start_title">すでに知っている内容をスキップする</string>
    <string name="placementtest_choose_description">テストで、スキップできるレッスンがわかります。</string>
    <!-- The short test: about six minutes of questions. -->
    <string name="placementtest_quick">簡単なテスト</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">約%1$s</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_test_out">「%1$s」のレベル診断を受ける</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">すでに知っている%1$sをスキップする</string>
    <string name="placementtest_start">始める</string>
    <string name="placementtest_continue_title">テストを続ける</string>
    <string name="placementtest_keep_going">続ける</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">どれもすでに知っている内容です。練習でも引き続き復習できます。</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">どれもすでに知っている内容です。練習でも引き続き復習できます。</string>
    <string name="placementtest_plan_stays">学習計画はそのままです。</string>
    <string name="placementtest_retake_tomorrow">今日スキップを取り消したレッスンは、明日もう一度答えるとスキップできます。</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">次の学習</string>
    <string name="placementtest_done">完了</string>
    <string name="placementtest_not_now">今はしない</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">%1$sのレベル</string>
    <string name="placementtest_keeps_adjusting">答えに合わせて、レッスンが調整されていきます。</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$sは学習計画に残ります</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">%1$sの問題はまだ十分にありません。</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">簡単そうですね</string>
    <string name="placementtest_offer_quick">すでに知っているレッスンを、簡単なテストでスキップできます。</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">すでに知っていれば、短いテストで%1$sをスキップできます。</string>
    <string name="placementtest_where_to_start">どこから始めますか？</string>
    <string name="placementtest_first_lesson">最初のレッスン</string>
    <string name="placementtest_first_lesson_line">申告したレベルから始める</string>
    <!-- The long test: it checks every topic still ahead, in parts. -->
    <string name="placementtest_full_test">全範囲テスト</string>
    <!-- How many parts the long test has. The learner can take each part on a different day. -->
    <plurals name="placementtest_parts_any_day">
        <item quantity="other">%dパート、好きな日に受けられます</item>
    </plurals>
    <plurals name="placementtest_questions">
        <item quantity="other">%d問</item>
    </plurals>
    <!-- Where the learner is in a test split into parts, such as “Part 3 of 14”. -->
    <string name="placementtest_part_of">%2$dパート中%1$dパート目</string>
    <!-- The title after one part of a test split into parts, such as “Part 3 of 14 done”. -->
    <string name="placementtest_part_done" tools:ignore="PluralsCandidate">%2$dパート中%1$dパート目が完了</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <string name="placementtest_part_skipped_none">このパートではレッスンはスキップされませんでした。</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <plurals name="placementtest_part_skipped">
        <item quantity="other">このパートでは、すでに知っていたレッスンを%dレッスンスキップしました。</item>
    </plurals>
    <!-- How many parts of a test the learner still has to take. -->
    <plurals name="placementtest_parts_left">
        <item quantity="other">残り%dパート</item>
    </plurals>
    <string name="placementtest_finish_later">あとで続ける</string>
    <!-- Where a learner who stopped a test picks it up: the part of the test and the question in it. -->
    <string name="placementtest_next_time">次回は%2$dパート中%1$dパート目の%3$d問目から</string>
    <string name="placementtest_start_lesson">レッスンを始める</string>
    <!-- Button after the short test: goes on to test the rest of the course, in parts. -->
    <string name="placementtest_test_the_rest">残りをテストする</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="other">すでに知っていたレッスンを%dレッスンスキップしました。</item>
    </plurals>
    <string name="placementtest_listening_later">リスニングはあとで学習計画からテストできます。</string>
    <string name="placementtest_not_tested">未受験</string>
    <string name="placementtest_about_left">残り約%1$s</string>
</resources>
