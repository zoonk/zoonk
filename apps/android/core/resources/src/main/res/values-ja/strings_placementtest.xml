<resources>
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">知っていることを診断</string>
    <string name="placementtest_skip_lessons">すでに知っているレッスンをスキップ</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">レベル診断テスト</string>
    <string name="placementtest_find_level">レベルを診断して、知っている内容をスキップ</string>
    <string name="placementtest_in_progress">学習中</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="placementtest_time_left">残り%1$s</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">スキップしたレッスンはありません</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="other">%dレッスンをスキップしました</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">リーディング %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">リスニング %1$s</string>
    <string name="placementtest_choose_title">どこまで診断しますか？</string>
    <!-- The short placement test: about four minutes of questions. -->
    <string name="placementtest_quick">クイック</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">約%1$s</string>
    <!-- The long placement test: it checks every topic still ahead in the course. -->
    <string name="placementtest_whole_course">コース全体</string>
    <!-- %1$s is a duration with its unit, such as "30 min". The test is split into parts the learner can take on different days. -->
    <string name="placementtest_about_in_parts">約%1$s、複数回に分けて</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_in_parts">複数回に分けて</string>
    <string name="placementtest_test_out">「%1$s」のレベル診断を受ける</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">すでに知っている場合は%1$sをスキップ</string>
    <string name="placementtest_choose_note">いつでも中断できます。すでに知っているレッスンはスキップされたままです。</string>
    <string name="placementtest_start">始める</string>
    <!-- A whole-course test is split into parts; %1$d is the part's number. -->
    <string name="placementtest_part">第%1$dパート</string>
    <string name="placementtest_continue_title">テストを続ける</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="placementtest_left_saved">残り約%1$sです。回答は保存されています。</string>
    <string name="placementtest_continue_from_plan">学習計画からテストを完了できます。</string>
    <string name="placementtest_finish_for_today">今日はここまで</string>
    <string name="placementtest_keep_going">続ける</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <plurals name="placementtest_known">
        <item quantity="other">すでに知っている内容です。復習に残ります。</item>
    </plurals>
    <string name="placementtest_plan_stays">学習計画はそのままです。</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">次のトピック</string>
    <string name="placementtest_whole_course_skips_more">コース全体のテストなら、さらに多くのレッスンをスキップできます。</string>
    <string name="placementtest_done">達成</string>
    <string name="placementtest_not_now">今はしない</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">%1$sのレベル</string>
    <!-- %2$s is a list of language levels, such as "A1, A2". The plan no longer has their lessons. -->
    <plurals name="placementtest_levels_skipped">
        <item quantity="other">%2$sをスキップしました：%1$dレッスン。</item>
    </plurals>
    <string name="placementtest_keeps_adjusting">答えに合わせて、レッスンが調整されていきます。</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$sは学習計画に残ります</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">%1$sを診断するには、まだ問題が足りません。</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">簡単に感じるようですね</string>
    <string name="placementtest_offer_quick">すでに知っているレッスンを、簡単なテストでスキップできます。</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">すでに知っている場合は、短いテストで%1$sをスキップできます。</string>
    <string name="placementtest_check_my_level">レベルを診断する</string>
</resources>
