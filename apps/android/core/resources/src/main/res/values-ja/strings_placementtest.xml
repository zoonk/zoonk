    <plurals name="placementtest_course_skipped">
        <item quantity="other">全%2$dレッスンのうち%1$dレッスンをスキップ</item>
    </plurals>
    <plurals name="placementtest_course_lessons">
        <item quantity="other">%dレッスン</item>
