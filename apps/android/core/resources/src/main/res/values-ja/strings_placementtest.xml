    <plurals name="placementtest_up_to_questions">
        <item quantity="other">最大%d問</item>
    </plurals>
    <string name="placementtest_finish_later">あとで続ける</string>
    <string name="placementtest_start_lesson">レッスンを始める</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="other">すでに知っている%dレッスンをスキップしました。</item>
    </plurals>
    <!-- On a level test's result when listening wasn't tested, such as after the learner said they can't listen now. -->
