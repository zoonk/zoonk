<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">学習リマインダー</string>
    <!-- Under the channel's name in Android's settings, and under the Reminders page's title. -->
    <string name="reminders_channel_description">学習日にまだ学習が残っていれば、1回お知らせします。</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">学習リマインダーを受け取りますか？</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">学習する日の%1$sに、まだ学習が残っていればお知らせします。</string>
    <string name="reminders_remind_me">リマインダーを設定する</string>
    <!-- Declines the offer, which isn't shown again. Portuguese: "Agora não" (ungendered). -->
    <string name="reminders_no_thanks">見送る</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">リマインダーをオンにしました。</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">メールでのリマインダーはオンです。</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Zoonkの通知がオフになっています。</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">設定を開く</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">代わりにメールで受け取る</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">通知を許可しますか？</string>
    <string name="reminders_permission_body">Zoonkは学習日に、その日の学習が残っているときだけ1回お知らせします。</string>
    <string name="reminders_permission_continue">続ける</string>
    <string name="reminders_not_now">今はしない</string>
    <!-- The title of the clock that changes the reminder's time. -->
    <string name="reminders_time_title">リマインダーの時刻</string>
    <string name="reminders_save">保存する</string>
    <string name="reminders_cancel">キャンセル</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">リマインダー</string>
    <!-- The time of day a reminder goes out, not an amount of time. -->
    <string name="reminders_time">時刻</string>
    <string name="reminders_email">メールアドレス</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">アカウントを作成してメールでリマインダーを受け取る</string>
    <string name="reminders_push">プッシュ通知</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">学習計画で設定した学習日に</string>
    <string name="reminders_quiet">学習をお休みしている間は一時停止しています。学習を再開すると、リマインダーも再開します。</string>
    <string name="reminders_save_failed">保存できませんでした。もう一度お試しください。</string>
    <!-- Push reminders go to another of the learner's devices; this one can take over. -->
    <string name="reminders_use_this_device">このデバイスで受け取る</string>
    <!-- After the selected device's name, such as "Pixel 9 · This device", when it's the device in hand. -->
    <string name="reminders_this_device">このデバイス</string>
</resources>
