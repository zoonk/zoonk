<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">Odak testi</string>
    <!-- {time} is a duration with its unit, such as “9 min”. -->
    <string name="focustest_time_left">%1$s kaldı</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">En çok neye çalışman gerektiğini bul</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">Bunların bir kısmını zaten biliyor musun?</string>
    <string name="focustest_offer_line_focus">Bu test zaten bildiklerini gösterir, böylece en çok çalışman gereken konulara daha fazla zaman ayırırsın. Hiçbir branşı planından çıkarmaz.</string>
    <string name="focustest_offer_line">Bu test zaten bildiklerini gösterir, böylece planın bunları atlayabilir.</string>
    <string name="focustest_start">Testi başlat</string>
    <string name="focustest_skip_note">Testi daha sonra planından çözebilirsin.</string>
    <string name="focustest_not_now">Sonraya bırak</string>
    <string name="focustest_resume_title">Testine devam et</string>
    <plurals name="focustest_answers_saved_line">
        <item quantity="one">%d cevabın kaydedildi.</item>
        <item quantity="other">%d cevabın kaydedildi.</item>
    </plurals>
    <string name="focustest_continue">Devam et</string>
    <string name="focustest_see_my_result">Sonucumu gör</string>
    <!-- Over a test question: its number and the count promised when the sitting started. -->
    <string name="focustest_question_number">Soru %1$d / %2$d</string>
    <string name="focustest_stop">Durdur ve cevaplarımı kullan</string>
    <!-- Shown after several "I don't know yet" answers in a row. -->
    <string name="focustest_many_unknown">Bu konuların çoğuna henüz çalışmadın mı? Sorun değil. Burada durup öğrenmeye başlayabilirsin.</string>
    <string name="focustest_answers_saved_title">Cevapların kaydedildi</string>
    <!-- The test's result: the exam subjects that need the most study time, most needed first. -->
    <string name="focustest_result_title">İşte odaklanman gereken branşlar</string>
    <string name="focustest_result_description">Cevaplarına ve branşların sınavındaki ağırlığına göre belirlendi. Odaklanmak hiçbir branşı plandan çıkarmaz.</string>
    <plurals name="focustest_also_skips">
        <item quantity="one">Planın ayrıca zaten bildiğin %d dersi atlar.</item>
        <item quantity="other">Planın ayrıca zaten bildiğin %d dersi atlar.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">Başlangıç noktan belirlendi</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="one">Planın zaten bildiğin %d dersi atlıyor.</item>
        <item quantity="other">Planın zaten bildiğin %d dersi atlıyor.</item>
    </plurals>
    <string name="focustest_from_basics">Planında her branş temelden başlar.</string>
    <string name="focustest_result_current">Planın bu branşlara daha fazla zaman ayırıyor.</string>
    <string name="focustest_result_hand_picked">Planın seçtiğin branşlara odaklanmaya devam ediyor. Testin önerdiği branşlar bunlar.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
    <string name="focustest_result_declined">Planını olduğu gibi bıraktın. Testin önerdiği branşlar bunlar.</string>
    <string name="focustest_change_focus">Odağını değiştir</string>
    <string name="focustest_see_all_subjects">Tüm branşları gör</string>
    <string name="focustest_subjects">Branşlar</string>
    <!-- A switch: the learner's study sessions also ask a few of the test's questions. -->
    <string name="focustest_session_questions">Çalışırken birkaç soru daha sor</string>
    <string name="focustest_session_questions_when">İlk haftan boyunca</string>
    <string name="focustest_done">Tamamlandı</string>
    <string name="focustest_answer_more">Daha fazla soru cevapla</string>
    <!-- The test asks before changing a plan the learner already has. -->
    <string name="focustest_proposal_title">Bu branşlara daha fazla zaman ayıralım mı?</string>
    <!-- How the Focus test picked the subjects listed below it: from the learner's answers to its questions and how many of the exam's questions each subject has. -->
    <string name="focustest_proposal_picked">Bu seçim, verdiğin cevaplara ve sınavında her branştan kaç soru çıktığına dayanıyor.</string>
    <string name="focustest_update_plan">Planımı güncelle</string>
    <string name="focustest_proposal_applied">Planın artık bu branşlara daha fazla zaman ayırıyor.</string>
    <string name="focustest_proposal_declined">Planın olduğu gibi kalıyor.</string>
    <string name="focustest_proposal_undone">Geri alındı. Planın önceki hâline döndü.</string>
    <string name="focustest_undo">Geri al</string>
    <!-- A short fact beside a subject in a list: every answer the learner gave on it was “I don't know yet”. It is not a grade. -->
    <string name="focustest_not_known_yet">Henüz bilinmiyor</string>
    <!-- %1$d answers right of %2$d asked on one subject. -->
    <plurals name="focustest_subject_right">
        <item quantity="one">%1$d / %2$d doğru</item>
        <item quantity="other">%1$d / %2$d doğru</item>
    </plurals>
    <!-- Parts of the exam the Focus test's questions can't ask about, such as the essay. -->
    <string name="focustest_written_not_checked">Yazma: bu testte yok</string>
    <string name="focustest_listening_not_checked">Dinleme: bu testte yok</string>
    <string name="focustest_speaking_not_checked">Konuşma: bu testte yok</string>
    <string name="focustest_practical_not_checked">Uygulamalı bölüm: bu testte yok</string>
    <!-- The test's state on the plan: the learner started it and left before the end. -->
    <string name="focustest_in_progress">Devam ediliyor</string>
    <string name="focustest_see_your_result">Sonucunu gör</string>
    <string name="focustest_take_test">Odak testini çöz</string>
    <!-- Today's suggestion to take the test, in the goal's first week, when the learner's time can't cover everything. -->
    <string name="focustest_suggestion_line">Odak testi en çok neye çalışman gerektiğini gösterir.</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="focustest_suggestion_body">%1$s süren bir seviye tespit testi, zaten bildiklerini gösterir; böylece zamanının daha fazlasını en çok ihtiyacın olan konulara ayırırsın. Hiçbir konuyu plandan çıkarmaz.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">Tamam. Testi planından çözebilirsin.</string>
    <!-- On a session's test question: skips today's test questions; they're asked another day. -->
    <string name="focustest_not_today">Bugünlük atla</string>
    <string name="focustest_not_today_failed">Kaydedilemedi. Tekrar dene.</string>
</resources>
