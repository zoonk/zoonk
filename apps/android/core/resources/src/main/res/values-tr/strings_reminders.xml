<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">Çalışma hatırlatmaları</string>
    <string name="reminders_channel_description">Çalışma günlerinde, çalışman kaldıysa bir hatırlatma.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">Çalışma hatırlatması ister misin?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">Çalışma günlerinde, çalışman kaldıysa saat %1$s.</string>
    <string name="reminders_remind_me">Bana hatırlat</string>
    <!-- Declines the offer. Keep it neutral and ungendered, like "Not now" (Portuguese: "Agora não"). -->
    <string name="reminders_no_thanks">Şimdi değil</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">Hatırlatmalar açık.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">E-posta hatırlatmaları açık.</string>
    <string name="reminders_turn_on_failed">Hatırlatmaları açamadık. Tekrar dene.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Zoonk bildirimleri kapalı.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">Ayarları aç</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">Bunun yerine e-posta gönder</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">Bildirimlere izin verilsin mi?</string>
    <string name="reminders_permission_body">Zoonk çalışma günlerinde, yalnızca çalışman kaldıysa bir hatırlatma gönderir.</string>
    <string name="reminders_permission_continue">Devam et</string>
    <string name="reminders_not_now">Sonraya bırak</string>
    <!-- The row that shows the reminder's time and opens a clock to change it, and that clock's title. -->
    <string name="reminders_time_title">Hatırlatma saati</string>
    <string name="reminders_save">Kaydet</string>
    <string name="reminders_cancel">Vazgeç</string>
    <!-- The row in Preferences that opens the reminders page. -->
    <string name="reminders_row">Çalışma hatırlatmaları</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">Hatırlatmalar</string>
    <string name="reminders_description">Günde bir hatırlatma, yalnızca çalışman kaldıysa.</string>
    <string name="reminders_time">Süre</string>
    <!-- %1$s is a time of day and %2$s its time zone, such as "7:00 PM, Brasilia Time". -->
    <string name="reminders_time_in_zone">%1$s, %2$s</string>
    <string name="reminders_email">E-posta</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">E-posta hatırlatmaları almak için hesap oluştur</string>
    <string name="reminders_push">Bildirimler</string>
    <!-- Push reminders go to another of the learner's phones; this one can take over. -->
    <string name="reminders_use_this_phone">Bu telefonu kullan</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">Planlarındaki çalışma günlerinde</string>
    <string name="reminders_quiet">Ara verdiğinde duraklatılır. Çalışmaya başlayınca yeniden açılır.</string>
    <string name="reminders_save_failed">Kaydedilemedi. Tekrar dene.</string>
</resources>
