<resources>
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">Bildiklerini test et</string>
    <string name="placementtest_skip_lessons">Zaten bildiğin dersleri atla</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">Seviye tespit testi</string>
    <string name="placementtest_find_level">Seviyeni bul ve bildiklerini atla</string>
    <string name="placementtest_in_progress">Devam ediyor</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="placementtest_time_left">%1$s kaldı</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Hiç ders atlanmadı</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d ders atlandı</item>
        <item quantity="other">Toplam %d ders atlandı</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">Okuma %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">Dinleme %1$s</string>
    <string name="placementtest_choose_title">Ne kadarını kontrol etmek istiyorsun?</string>
    <!-- The short placement test: about four minutes of questions. -->
    <string name="placementtest_quick">Kısa</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">Yaklaşık %1$s</string>
    <!-- The long placement test: it checks every topic still ahead in the course. -->
    <string name="placementtest_whole_course">Tüm kurs</string>
    <!-- %1$s is a duration with its unit, such as "30 min". The test is split into parts the learner can take on different days. -->
    <string name="placementtest_about_in_parts">Yaklaşık %1$s, parçalara bölünmüş</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_in_parts">Parçalar halinde</string>
    <string name="placementtest_test_out">%1$s düzeyini atlamak için teste gir</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">Zaten biliyorsan %1$s seviyesini atla</string>
    <string name="placementtest_choose_note">İstediğin zaman testi durdurabilirsin. Zaten bildiğin dersler atlanmış olarak kalır.</string>
    <string name="placementtest_start">Başla</string>
    <!-- A whole-course test is split into parts; %1$d is the part's number. -->
    <string name="placementtest_part">%1$d. bölüm</string>
    <string name="placementtest_continue_title">Testine devam et</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="placementtest_left_saved">Yaklaşık %1$s kaldı. Cevapların kaydedildi.</string>
    <string name="placementtest_continue_from_plan">Testi Plan bölümünden bitirebilirsin.</string>
    <string name="placementtest_finish_for_today">Bugünlük bitir</string>
    <string name="placementtest_keep_going">Devam et</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <plurals name="placementtest_known">
        <item quantity="one">Bunu zaten biliyorsun. Tekrar çalışmalarında kalacak.</item>
        <item quantity="other">Bunları zaten biliyorsun. Tekrar çalışmalarında kalacaklar.</item>
    </plurals>
    <string name="placementtest_plan_stays">Planın olduğu gibi kalıyor.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">Sırada</string>
    <string name="placementtest_whole_course_skips_more">Tüm kurs testi daha fazla dersi atlayabilir.</string>
    <string name="placementtest_done">Tamamlandı</string>
    <string name="placementtest_not_now">Sonraya bırak</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">%1$s seviyen</string>
    <!-- %2$s is a list of language levels, such as "A1, A2". The plan no longer has their lessons. -->
    <plurals name="placementtest_levels_skipped">
        <item quantity="one">%2$s atlandı: %1$d ders.</item>
        <item quantity="other">%2$s atlandı: toplam %1$d ders.</item>
    </plurals>
    <string name="placementtest_keeps_adjusting">Cevap verdikçe derslerin ayarlanmaya devam ediyor.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$s seviyesindeki dersler planında kalıyor</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">%1$s seviyesi için henüz yeterli soru yok.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">Bu sana kolay geliyor</string>
    <string name="placementtest_offer_quick">Kısa bir testle zaten bildiğin dersleri atlayabilirsin.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">Zaten biliyorsan kısa bir test %1$s seviyesini atlamanı sağlayabilir.</string>
    <string name="placementtest_check_my_level">Seviyemi kontrol et</string>
</resources>
