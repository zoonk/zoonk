<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="placementtest_title">Bildiklerini test et</string>
    <string name="placementtest_skip_lessons">Zaten bildiğin dersleri atla</string>
    <string name="placementtest_level_title">Seviye tespit testi</string>
    <string name="placementtest_find_level">Seviyeni öğren ve bildiklerini atla</string>
    <string name="placementtest_in_progress">Devam ediliyor</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Atlanan ders yok</string>
    <!-- The title after a placement test: how many lessons it took out of the plan. -->
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d ders atlandı</item>
        <item quantity="other">%d ders atlandı</item>
    </plurals>
    <!-- A CEFR level range the test found for reading, such as “B1–B2”. -->
    <string name="placementtest_reading_range">Okuma %1$s</string>
    <!-- A CEFR level range the test found for listening, such as “B1–B2”. -->
    <string name="placementtest_listening_range">Dinleme %1$s</string>
    <string name="placementtest_start_title">Zaten bildiklerini atla</string>
    <string name="placementtest_choose_description">Seviye tespit testi, atlayabileceğin dersleri bulur.</string>
    <!-- The short test: about six minutes of questions. -->
    <string name="placementtest_quick">Kısa test</string>
    <string name="placementtest_about">Yaklaşık %1$s</string>
    <!-- A short test of one language level, such as “Test out of B2”. -->
    <string name="placementtest_test_out">%1$s düzeyini atlamak için teste gir</string>
    <string name="placementtest_test_out_description">Zaten biliyorsan %1$s düzeyini atla</string>
    <string name="placementtest_start">Başla</string>
    <string name="placementtest_continue_title">Testine devam et</string>
    <string name="placementtest_keep_going">Devam et</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Bunu zaten biliyorsun. Tekrar çalışmalarında kalmaya devam eder.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Bunları zaten biliyorsun. Tekrar çalışmalarında kalmaya devam eder.</string>
    <string name="placementtest_plan_stays">Planın olduğu gibi kalıyor.</string>
    <string name="placementtest_retake_tomorrow">Bugün bunları geri aldın. Atlamak için yarın yeniden cevapla.</string>
    <string name="placementtest_up_next">Sıradaki</string>
    <string name="placementtest_done">Tamamlandı</string>
    <string name="placementtest_not_now">Sonraya bırak</string>
    <string name="placementtest_your_level">%1$s seviyen</string>
    <string name="placementtest_keeps_adjusting">Cevap verdikçe derslerin ayarlanmaya devam ediyor.</string>
    <string name="placementtest_level_stays">%1$s planında kalıyor</string>
    <string name="placementtest_test_out_unavailable">Henüz %1$s düzeyi için yeterli soru yok.</string>
    <string name="placementtest_offer_title">Bu sana kolay görünüyor</string>
    <string name="placementtest_offer_quick">Kısa bir testle zaten bildiğin dersleri atlayabilirsin.</string>
    <string name="placementtest_offer_level">Zaten biliyorsan kısa bir testle %1$s düzeyini atlayabilirsin.</string>
    <string name="placementtest_where_to_start">Nereden başlamak istersin?</string>
    <string name="placementtest_first_lesson">İlk ders</string>
    <string name="placementtest_first_lesson_line">Belirttiğin seviyeden başlar</string>
    <!-- The long test: it checks every topic still ahead, in parts. -->
    <string name="placementtest_full_test">Kapsamlı test</string>
    <!-- How many parts the long test has. The learner can take each part on a different day. -->
    <plurals name="placementtest_parts_any_day">
        <item quantity="one">%d bölüm, istediğin gün</item>
        <item quantity="other">%d bölüm, istediğin gün</item>
    </plurals>
    <!-- The most questions a test asks. It can end sooner. -->
    <plurals name="placementtest_up_to_questions">
        <item quantity="one">En fazla %d soru</item>
        <item quantity="other">En fazla %d soru</item>
    </plurals>
    <!-- Where the learner is in a test split into parts, such as “Part 3 of 14”. -->
    <string name="placementtest_part_of">%2$d bölümün %1$d. bölümü</string>
    <!-- The title after one part of a test split into parts, such as “Part 3 of 14 done”. -->
    <string name="placementtest_part_done" tools:ignore="PluralsCandidate">%1$d / %2$d bölüm tamamlandı</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <string name="placementtest_part_skipped_none">Bu bölümde plandan çıkarılan ders yok.</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <plurals name="placementtest_part_skipped">
        <item quantity="one">Bu bölümde zaten bildiğin %d ders plandan çıkarıldı.</item>
        <item quantity="other">Bu bölümde zaten bildiğin %d ders plandan çıkarıldı.</item>
    </plurals>
    <!-- How many parts of a test the learner still has to take. -->
    <plurals name="placementtest_parts_left">
        <item quantity="one">%d bölüm kaldı</item>
        <item quantity="other">%d bölüm kaldı</item>
    </plurals>
    <string name="placementtest_finish_later">Sonra tamamla</string>
    <!-- Where a learner who stopped a test picks it up: the part of the test and the question in it. -->
    <string name="placementtest_next_time">Bir dahaki sefere: %2$d bölümün %1$d. bölümü, %3$d. soru</string>
    <string name="placementtest_start_lesson">Derse başla</string>
    <!-- Button after the short test: goes on to test the rest of the course, in parts. -->
    <string name="placementtest_test_the_rest">Kalanını test et</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="one">Zaten bildiğin %d ders atlandı.</item>
        <item quantity="other">Zaten bildiğin %d ders atlandı.</item>
    </plurals>
    <!-- On a level test's result when listening wasn't tested, such as after the learner said they can't listen now. -->
    <string name="placementtest_take_again_later">Planındaki testi daha sonra tekrar çözebilirsin.</string>
    <string name="placementtest_not_tested">Henüz test edilmedi</string>
    <string name="placementtest_about_left">Yaklaşık %1$s kaldı</string>
</resources>
