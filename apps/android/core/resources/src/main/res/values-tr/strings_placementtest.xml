    <string name="placementtest_test">Seviye tespit testi</string>
    <!-- Over the name of the chapter a course's placement test starts the learner in. -->
    <string name="placementtest_you_start_here">Buradan başlıyorsun</string>
    <!-- Under a picture of a course, after a placement test: how many of the course's lessons the test skipped, out of all of them. -->
    <plurals name="placementtest_course_skipped">
        <item quantity="one">%1$d / %2$d ders atlandı</item>
        <item quantity="other">%1$d / %2$d ders atlandı</item>
    </plurals>
