<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Deneme sınavına gir</string>
    <string name="mock_chooser_line">Gerçek sınavdaki gibi süre tutulur. Sonucunu sınavın sonunda görürsün.</string>
    <string name="mock_chooser_start">Başla</string>
    <string name="mock_chooser_one_subject">Tek branş</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">Sınav</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">%1$d. gün</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">%1$d. günün yarısı</string>
    <string name="mock_chooser_full_exam">Sınavın tamamı</string>
    <string name="mock_chooser_half_exam">Sınavın yarısı</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">%1$d. gün, %2$s hariç</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">Sınavın tamamı, %1$s hariç</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">Yazılı bölüm yok</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d soru · %2$s</item>
        <item quantity="other">%1$d soru · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
