<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">Study reminders</string>
    <!-- Under the channel's name in Android's settings, and under the Reminders page's title. -->
    <string name="reminders_channel_description">One reminder on your study days, when you still have learning left.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">Want a study reminder?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">At %1$s on your study days, when you still have learning left.</string>
    <string name="reminders_remind_me">Remind me</string>
    <!-- Declines the offer, which isn't shown again. Portuguese: "Agora não" (ungendered). -->
    <string name="reminders_no_thanks">No thanks</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">Reminders are on.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">Email reminders are on.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Notifications are off for Zoonk.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">Open Settings</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">Email me instead</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">Allow notifications?</string>
    <string name="reminders_permission_body">Zoonk sends one reminder on your study days, only when you still have learning left.</string>
    <string name="reminders_permission_continue">Continue</string>
    <string name="reminders_not_now">Not now</string>
    <!-- The title of the clock that changes the reminder's time. -->
    <string name="reminders_time_title">Reminder time</string>
    <string name="reminders_save">Save</string>
    <string name="reminders_cancel">Cancel</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">Reminders</string>
    <!-- The time of day a reminder goes out, not an amount of time. -->
    <string name="reminders_time">Time</string>
    <string name="reminders_email">Email</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">Create an account to get email reminders</string>
    <string name="reminders_push">Push notifications</string>
    <!-- After the selected device's name, such as "Pixel 9 · This device", when it's the device in hand. -->
    <string name="reminders_this_device">This device</string>
    <!-- Push reminders go to another of the learner's devices; this one can take over. -->
    <string name="reminders_use_this_device">Use this device</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">On your study days, from your plans</string>
    <string name="reminders_quiet">Paused while you\'re away. Studying turns them back on.</string>
    <string name="reminders_save_failed">That didn\'t save. Try again.</string>
</resources>
