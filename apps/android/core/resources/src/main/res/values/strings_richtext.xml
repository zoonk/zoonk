<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Screen reader words for a formula, said after its base: "x squared". -->
    <string name="richtext_math_squared">squared</string>
    <!-- Screen reader words for a formula, said after its base: "x cubed". -->
    <string name="richtext_math_cubed">cubed</string>
    <!-- Screen reader words for an exponent, said after its base: "2 to the power of 10". -->
    <string name="richtext_math_power">to the power of %1$s</string>
    <!-- Screen reader words for an index, said after its base: "x sub 1". -->
    <string name="richtext_math_subscript">sub %1$s</string>
    <!-- Screen reader words for a fraction: "1 over 4". -->
    <string name="richtext_math_fraction">%1$s over %2$s</string>
    <!-- Screen reader words for a square root: "square root of 2". -->
    <string name="richtext_math_root">square root of %1$s</string>
    <!-- Screen reader words for a cube root: "cube root of 8". -->
    <string name="richtext_math_cube_root">cube root of %1$s</string>
    <!-- Screen reader words for a root with an index other than 2 or 3; {index} is a number such as 4 or a letter such as n: "4th root of 16", "nth root of x". -->
    <string name="richtext_math_nth_root">%1$sth root of %2$s</string>
    <!-- Screen reader words for a letter with a bar over it, such as a mean: "x bar". -->
    <string name="richtext_math_bar">%1$s bar</string>
    <!-- Screen reader words for a letter with a dot over it, a rate of change in physics: "x dot". -->
    <string name="richtext_math_dot">%1$s dot</string>
    <!-- Screen reader words for a letter with a hat over it, such as an estimate: "p hat". -->
    <string name="richtext_math_hat">%1$s hat</string>
    <!-- Screen reader words for a letter with a tilde over it: "x tilde". -->
    <string name="richtext_math_tilde">%1$s tilde</string>
    <!-- Screen reader words for a letter with an arrow over it, a vector: "vector v". -->
    <string name="richtext_math_vector">vector %1$s</string>
</resources>
