    <string name="gate_start_goal">New goal</string>
    <!-- Read by TalkBack for a goal whose language has a chosen country: %1$s is the goal's title, %2$s the language as that country speaks it, such as "Spanish (Argentina)". -->
    <string name="goal_with_variety">%1$s, %2$s</string>
