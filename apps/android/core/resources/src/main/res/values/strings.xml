    <string name="answer_tag_your_guess">Your guess</string>
    <string name="load_failed_title">This page didn\'t load</string>
    <string name="load_failed_description">Check your connection and try again.</string>
    <string name="load_failed_try_again">Try again</string>
    <string name="suggestion_view">View</string>
    <string name="suggestion_save_failed">That didn\'t save. Try again.</string>
    <string name="suggestion_other_options">Other options</string>
    <!-- Above the options of an exam's choice when each candidate takes several of them, such as two of a course's modules. %1$d is how many, at least 2. -->
    <string name="exam_choice_pick_up_to">Pick up to %1$d.</string>
    <!-- Switch to study a different amount of time a day on weekends, not at a different time of day. -->
    <string name="weekend_time_differs">Different time on weekends</string>
    <string name="weekend_time_label">Weekend time</string>
    <!-- Under a question asking which option of an exam the learner will take, such as its foreign language. Until they pick, their plan has none of the options. -->
    <string name="exam_choice_left_out">Pick one so your plan includes it.</string>
    <string name="disclosure_expanded">Expanded</string>
    <string name="disclosure_collapsed">Collapsed</string>
    <!-- TalkBack reads one line of a before-and-after list: which side it's on, then its words, such as "Now: Plan ends June 3" or "Better: Un café, por favor". -->
    <string name="diff_line_spoken">%1$s: %2$s</string>
    <string name="lessons_title">Lessons</string>
    <!-- Lessons done of the total: "2 of 6". -->
    <string name="lessons_done_count">%1$s of %2$s</string>
    <!-- A lesson's number in its list: "3." -->
    <string name="lessons_position">%1$s.</string>
    <!-- TalkBack names each lesson's mark. Done: finished. Up next: the one lesson to do now. Coming up: the lessons after it, for later. The three must read as clearly different states. -->
    <string name="lessons_done">Done</string>
    <string name="lessons_up_next">Up next</string>
    <string name="lessons_coming_up">Coming up</string>
    <!-- Heads the key ideas of each lesson in a chapter's or unit's summary. -->
    <string name="lesson_summaries_title">Summaries</string>
    <string name="test_out_title">Already know this?</string>
    <string name="test_out_skip_chapter">Take the test and skip the chapter</string>
    <string name="test_out_skip_unit">Take the test and skip the unit</string>
    <string name="not_found_title">We couldn\'t find this page</string>
    <string name="not_found_description">The link may be old or mistyped.</string>
    <string name="not_found_go_home">Today</string>
    <!-- TalkBack reads a row's state, then whether it's open: "Studied, Expanded". -->
    <string name="list_row_states">%1$s, %2$s</string>
    <!-- A toast, at most two short lines: a link did nothing because no app on the phone can open web pages. Same meaning as Android's own "No app can perform this action". -->
    <string name="web_page_unavailable">No app can open this page.</string>
    <!-- Replaces Compose's own string of this name, whose Portuguese and German read as closing a spreadsheet. TalkBack's label for the dimmed area behind a bottom sheet, which closes the sheet. "Sheet" means a panel that slides up from the bottom of the screen, not a spreadsheet or a sheet of paper. -->
    <string name="close_sheet" tools:override="true" tools:ignore="UnusedResources">Close sheet</string>
    <string name="daily_time_suggested">%1$s (suggested)</string>
    <!-- When the sources were last checked: %1$s is a month and year, like "Oct 2026", never a day. -->
    <string name="citation_sources_chip">Sources · Checked %1$s</string>
    <string name="citation_checked_by">%1$s · Checked %2$s</string>
    <string name="citation_checked">Checked %1$s</string>
    <string name="citation_open_source">Open the source</string>
    <!-- %1$s is a document\'s title, %2$s a page number. -->
    <string name="citation_page">%1$s, page %2$s</string>
    <string name="citation_slide">%1$s, slide %2$s</string>
    <string name="player_not_saved">Not saved yet</string>
    <string name="player_not_saved_description">Some answers aren\'t saved yet. We\'ll keep trying while this lesson is open.</string>
    <!-- Labels a scale's numbers with what they count or measure; {unit} is the activity's own unit text, such as days, km/h or times. -->
    <string name="activities_guess_in_unit">Unit: %1$s</string>
</resources>
