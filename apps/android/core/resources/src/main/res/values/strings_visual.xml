<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="visual_source">Source: %1$s</string>
    <!-- A chart read aloud: what it measures (%1$s) by what (%2$s), then each category with its values (%3$s). -->
    <string name="visual_chart_summary">%1$s by %2$s. %3$s</string>
    <!-- One category of a chart read aloud: the category (%1$s) and its value or values (%2$s). -->
    <string name="visual_chart_point">%1$s: %2$s</string>
    <!-- One series' value in a category of a chart read aloud: the series' name (%1$s) and its value (%2$s). -->
    <string name="visual_chart_series_value">%1$s %2$s</string>
    <!-- A plot read aloud: the horizontal axis's name (%1$s) and the lowest (%2$s) and highest (%3$s) values it shows. -->
    <string name="visual_plot_horizontal_axis">Horizontal axis: %1$s, from %2$s to %3$s</string>
    <!-- A plot read aloud: the vertical axis's name (%1$s) and the lowest (%2$s) and highest (%3$s) values it shows. -->
    <string name="visual_plot_vertical_axis">Vertical axis: %1$s, from %2$s to %3$s</string>
    <!-- One point of a plot read aloud: the horizontal axis's name (%1$s) and the point's value on it (%2$s), then the vertical axis's name (%3$s) and its value there (%4$s). -->
    <string name="visual_plot_point">%1$s %2$s, %3$s %4$s</string>
    <!-- A plot's dashed reference lines read aloud, such as a target or a limit: each line's name with its value (%1$s). -->
    <string name="visual_plot_references">Reference lines: %1$s</string>
</resources>
