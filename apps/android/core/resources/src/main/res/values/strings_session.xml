    <plurals name="session_caught_up_today">
        <item quantity="one">%1$s caught up today</item>
        <item quantity="other">%1$s caught up today</item>
    </plurals>
    <!-- After "2 caught up today ·": %1$s lessons earlier days left are still to do. -->
    <plurals name="session_catch_up_to_go">
        <item quantity="one">%1$s to go</item>
        <item quantity="other">%1$s to go</item>
    </plurals>
    <!-- At a finished block's end, once every lesson earlier days left is done. -->
    <string name="session_no_catch_up_left">No lessons left to catch up.</string>
    <!-- At a finished block's end. %1$s is the lesson count; %2$s is the learner's daily time, such as "4 h". Lessons moved to a later day, not lost. -->
    <plurals name="session_lessons_deferred">
        <item quantity="one">%1$s lesson moved to another day to fit your %2$s today.</item>
        <item quantity="other">%1$s lessons moved to another day to fit your %2$s today.</item>
