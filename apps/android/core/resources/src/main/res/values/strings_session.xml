    <!-- A finished block's line about today's session. %1$s is how many of the day's blocks are done, shown larger; %2$s is how many the session has. A block can be a lesson, a review or practice, so no noun. -->
    <plurals name="session_day_done">
        <item quantity="one">%1$s of %2$s done today</item>
        <item quantity="other">%1$s of %2$s done today</item>
    </plurals>
    <!-- A finished block's line about today's session, past its midpoint. %1$s is how many of the day's blocks are left, shown larger. -->
    <plurals name="session_day_left">
        <item quantity="one">%1$s left today</item>
        <item quantity="other">%1$s left today</item>
    </plurals>
    <!-- Under "3 left today": %1$s of the session's %2$s blocks are done. -->
    <plurals name="session_day_done_caption">
        <item quantity="one">%1$s of %2$s done</item>
        <item quantity="other">%1$s of %2$s done</item>
    </plurals>
    <!-- A finished block's line about today's session while the day still holds time for lessons not on the list yet, so it has no total. %1$s is how many blocks are done, shown larger. -->
    <plurals name="session_day_open">
        <item quantity="one">%1$s done today</item>
        <item quantity="other">%1$s done today</item>
    </plurals>
    <!-- Under "3 done today": more lessons are being written and join today's session on their own. -->
    <string name="session_day_more_coming">More as you go</string>
