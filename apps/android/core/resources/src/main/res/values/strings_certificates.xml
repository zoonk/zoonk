<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A place name, like "Completed lessons": the page listing the learner's completion certificates, to print, download or share. -->
    <string name="certificates_title">Certificates</string>
    <!-- Above the page title, counting the learner's certificates. -->
    <plurals name="certificates_count">
        <item quantity="one">%1$d certificate</item>
        <item quantity="other">%1$d certificates</item>
    </plurals>
    <string name="certificates_lead">A certificate for every level and plan you finish.</string>
    <!-- What a certificate certifies: a finished course level or plan. Printed on the certificate itself. -->
    <string name="certificates_kind_completion">Certificate of completion</string>
    <!-- A language course level and its CEFR range, such as Intermediate (B1–B2). -->
    <string name="certificates_level_range">%1$s (%2$s)</string>
    <!-- A course level's certificate name, such as "Python · Beginner": the course's title, then the level's name. -->
    <string name="certificates_course_level">%1$s · %2$s</string>
    <string name="certificates_empty_title">No certificates yet</string>
    <string name="certificates_empty_description">Your certificates show up here when you finish a level or a plan, studying at least half its lessons.</string>
    <string name="certificates_continue_learning">Continue learning</string>
    <!-- On a finished plan's card: opens the plan's one certificate. -->
    <string name="certificates_view">View certificate</string>
    <string name="certificates_view_several">View certificates</string>
    <!-- On a finished plan's card: issues the course's certificate, which wasn't issued yet. -->
    <string name="certificates_get">Get your certificate</string>
    <string name="certificates_up_next">Up next</string>
    <string name="certificates_up_next_course">Your certificate comes when you finish the plan, studying at least half its lessons</string>

    <!-- The title of a full screen shown once, right after the learner finishes every lesson of a course. -->
    <string name="certificates_course_complete">Course complete!</string>
    <string name="certificates_level_complete">%1$s complete!</string>
    <!-- The title when the learner earned two or more certificates at once. -->
    <plurals name="certificates_earned">
        <item quantity="one">%1$d certificate earned</item>
        <item quantity="other">%1$d certificates earned</item>
    </plurals>
    <!-- %1$s is the course's title. -->
    <string name="certificates_course_ready">Your certificate for %1$s is ready.</string>
    <!-- %1$s lists the certificates' names, such as "Italian · Intermediate (B1–B2) and Python". -->
    <string name="certificates_several_ready">Your %1$s certificates are ready.</string>
    <!-- %1$s is the learner's name, as printed on their certificate. -->
    <string name="certificates_on_your_certificate">On your certificate: %1$s</string>
    <!-- A short button beside the learner's name, to edit the name printed on their certificates. -->
    <string name="certificates_change">Change</string>
    <!-- TalkBack's name for the Change button beside the learner's name. -->
    <string name="certificates_change_name">Change the name on your certificates</string>
    <!-- The label of a field where a learner without a name types it for the first time. -->
    <string name="certificates_name_label_new">Your name, as it should appear</string>
    <!-- The label of the field with the learner's current name, when they change it. -->
    <string name="certificates_name_label">Name on your certificates</string>
    <string name="certificates_name_placeholder">Your full name</string>
    <string name="certificates_name_hint_new">Your certificates and your buddy use this name. You can change it anytime.</string>
    <string name="certificates_name_hint">Your certificates and your buddy use this name.</string>
    <string name="certificates_save">Save</string>
    <string name="certificates_cancel">Cancel</string>
    <string name="certificates_name_save_failed">That didn\'t save. Try again.</string>
    <string name="certificates_share">Share</string>
    <!-- Opens a sheet that helps the learner add the certificate to their LinkedIn profile. -->
    <string name="certificates_add_to_linkedin">Add to LinkedIn</string>
    <!-- "Certificates" is the place name. -->
    <string name="certificates_saved_one">It\'s saved in Certificates.</string>
    <!-- "Certificates" is the place name. -->
    <string name="certificates_saved_several">They\'re saved in Certificates.</string>
    <string name="certificates_continue">Continue</string>
    <string name="certificates_locked">Locked</string>
    <string name="certificates_plus_title">Get your certificate with Plus</string>
    <string name="certificates_plus_description">Plus gives you a certificate for every level you finish, to print and share. Certificates you get stay yours if Plus ends.</string>
    <string name="certificates_plus_list_title">Certificates come with Plus</string>

    <!-- The title of the screen showing one certificate. -->
    <string name="certificates_certificate">Certificate</string>
    <!-- Prints the certificate, or saves it as a PDF from the printing screen. -->
    <string name="certificates_print">Print</string>
    <!-- Saves the certificate's picture to the phone's Pictures. -->
    <string name="certificates_download">Download</string>
    <string name="certificates_link_copied">Link copied</string>
    <string name="certificates_link_note">Anyone with the link can see this certificate. Its page doesn\'t show up in search.</string>
    <!-- A short message after the certificate's picture was saved to the phone's Pictures. -->
    <string name="certificates_downloaded">Saved to Pictures</string>
    <string name="certificates_picture_failed">The certificate didn\'t load. Try again.</string>
    <string name="certificates_not_found">We couldn\'t find this certificate</string>
    <!-- A certificate page's headline, which TalkBack also reads for its picture. %1$s is the learner's name and %2$s the certificate's name, such as "Python · Beginner". -->
    <string name="certificates_alt_course">%1$s completed %2$s</string>
    <!-- A certificate page's headline before the learner gave a name. %1$s is the certificate's name, such as "Python · Beginner". -->
    <string name="certificates_course_on_zoonk">%1$s, completed on Zoonk</string>
    <!-- Above a certificate's headline on its page, beside a check mark. -->
    <string name="certificates_verified">Verified certificate · issued by Zoonk</string>
    <!-- Under a certificate's headline on its page. %1$s is the day it was issued, such as "October 28, 2026". -->
    <string name="certificates_issued_on">Certificate of completion, issued on %1$s.</string>
    <!-- The heading over a certificate's facts on its page. -->
    <string name="certificates_details">Details</string>
    <!-- Labels the learner's full name, as their certificates print it. -->
    <string name="certificates_recipient_name">Name</string>
    <!-- Labels the course level a certificate is for, such as "Beginner". -->
    <string name="certificates_detail_level">Level</string>
    <!-- Labels the day a certificate was earned. -->
    <string name="certificates_detail_completed">Completed</string>
    <string name="certificates_detail_lessons_studied">Lessons studied</string>
    <!-- Labels how many of a certificate's lessons the learner skipped by passing their test. -->
    <string name="certificates_detail_passed_by_test">Passed by test</string>
    <string name="certificates_detail_study_time">Study time</string>
    <string name="certificates_detail_id">Certificate ID</string>
    <!-- Labels the address of a certificate's public page. -->
    <string name="certificates_detail_link">Link</string>
    <!-- An approximate study time. %1$s is a duration, such as "41 hr". -->
    <string name="certificates_about_duration">about %1$s</string>
    <string name="certificates_meaning_title">What this certificate means</string>
    <string name="certificates_meaning_language">Zoonk issues this certificate when a learner finishes every lesson of a language course\'s level, studying at least half of them on Zoonk and passing any others by test.</string>
    <string name="certificates_meaning_level">Zoonk issues this certificate when a learner finishes every lesson of a course\'s level, studying at least half of them on Zoonk and passing any others by test, and wins every challenge in it.</string>
    <string name="certificates_meaning_plan">Zoonk issues this certificate when a learner finishes every lesson of a course\'s plan, studying at least half of them on Zoonk and passing any others by test, and wins every challenge in it.</string>
    <string name="certificates_meaning_record">It\'s a record of completion on Zoonk, not academic credit.</string>
    <string name="certificates_meaning_cefr">Levels are aligned with the CEFR, the Common European Framework of Reference for Languages. This is not an official exam result.</string>
    <string name="certificates_meaning_name">The name is the one the learner gave their Zoonk account; Zoonk doesn\'t check IDs.</string>
    <!-- Heading over the chapters a course certificate covers -->
    <string name="certificates_topics_covered">Topics covered</string>
    <!-- TalkBack reads the certificate's picture: what it certifies, then the day it was earned, such as "Ana Souza completed Python, November 3, 2026". -->
    <string name="certificates_alt_dated">%1$s, %2$s</string>

    <!-- Text the learner can post with their certificate. %1$s is the course's title and %2$s the lessons they studied, such as "148 lessons". -->
    <string name="certificates_caption_course">I just finished %1$s on Zoonk: %2$s.</string>
    <!-- Text the learner can post with a course certificate whose lessons were all passed by test. %1$s is the course's title. -->
    <string name="certificates_caption_course_tested_out">I just finished %1$s on Zoonk.</string>
    <!-- Text the learner can post with their certificate. %1$s is the course's title, %2$s the lessons they studied, such as "148 lessons", and %3$d about how many hours they studied. -->
    <plurals name="certificates_caption_course_hours">
        <item quantity="one">I just finished %1$s on Zoonk: %2$s and about %3$d hour of study.</item>
        <item quantity="other">I just finished %1$s on Zoonk: %2$s and about %3$d hours of study.</item>
    </plurals>
    <!-- Text the learner can post with their certificate. %1$s is the course's title, %2$s the lessons they studied, such as "12 lessons", and %3$d about how many minutes they studied, under an hour. -->
    <plurals name="certificates_caption_course_minutes">
        <item quantity="one">I just finished %1$s on Zoonk: %2$s and about %3$d minute of study.</item>
        <item quantity="other">I just finished %1$s on Zoonk: %2$s and about %3$d minutes of study.</item>
    </plurals>
    <!-- Part of the text the learner posts: how many lessons they studied. %1$s is the number. -->
    <plurals name="certificates_lessons">
        <item quantity="one">%1$s lesson</item>
        <item quantity="other">%1$s lessons</item>
    </plurals>

    <string name="certificates_linkedin_title">Add to your LinkedIn profile</string>
    <string name="certificates_linkedin_description">LinkedIn opens its form to add a license or certification. Copy each field into it.</string>
    <!-- The fields of LinkedIn's "Add license or certification" form, named as LinkedIn names them. -->
    <string name="certificates_linkedin_name">Name</string>
    <string name="certificates_linkedin_organization">Issuing organization</string>
    <string name="certificates_linkedin_issue_date">Issue date</string>
    <string name="certificates_linkedin_credential_id">Credential ID</string>
    <string name="certificates_linkedin_credential_url">Credential URL</string>
    <string name="certificates_linkedin_open">Open LinkedIn</string>
    <string name="certificates_copy">Copy</string>
    <!-- TalkBack's name for a Copy button. %1$s is the field it copies, such as "Credential ID". -->
    <string name="certificates_copy_field">Copy %1$s</string>
    <string name="certificates_copied">Copied</string>
</resources>
