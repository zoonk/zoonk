<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="placementtest_title">Test what you know</string>
    <string name="placementtest_skip_lessons">Skip lessons you already know</string>
    <string name="placementtest_level_title">Level test</string>
    <string name="placementtest_find_level">Find your level and skip what you know</string>
    <string name="placementtest_in_progress">In progress</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">No lessons skipped</string>
    <!-- The title after a placement test: how many lessons it took out of the plan. -->
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">%d lesson skipped</item>
        <item quantity="other">%d lessons skipped</item>
    </plurals>
    <!-- A CEFR level range the test found for reading, such as “B1–B2”. -->
    <string name="placementtest_reading_range">Reading %1$s</string>
    <!-- A CEFR level range the test found for listening, such as “B1–B2”. -->
    <string name="placementtest_listening_range">Listening %1$s</string>
    <!-- A level range, such as "B1–B2": the lowest and the highest level a skill's answers place it between. -->
    <string name="placementtest_level_range" translatable="false">%1$s–%2$s</string>
    <string name="placementtest_start_title">Skip what you already know</string>
    <string name="placementtest_choose_description">A test finds the lessons you can skip.</string>
    <string name="placementtest_about">About %1$s</string>
    <!-- A short test of one language level, such as “Test out of B2”. -->
    <string name="placementtest_test_out">Test out of %1$s</string>
    <string name="placementtest_test_out_description">Skip %1$s if you already know it</string>
    <string name="placementtest_start">Start</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">You already know it. It stays in your practice.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">You already know them. They stay in your practice.</string>
    <string name="placementtest_retake_tomorrow">You undid these today. Answer again tomorrow to skip them.</string>
    <string name="placementtest_up_next">Up next</string>
    <string name="placementtest_done">Done</string>
    <string name="placementtest_not_now">Not now</string>
    <string name="placementtest_your_level">Your %1$s level</string>
    <string name="placementtest_keeps_adjusting">Your lessons keep adjusting as you answer.</string>
    <string name="placementtest_level_stays">%1$s stays in your plan</string>
    <string name="placementtest_test_out_unavailable">There aren\'t enough questions for %1$s yet.</string>
    <string name="placementtest_offer_title">This looks easy for you</string>
    <string name="placementtest_offer_quick">A quick test can skip lessons you already know.</string>
    <string name="placementtest_offer_level">A short test can skip %1$s if you already know it.</string>
    <string name="placementtest_where_to_start">Where would you like to start?</string>
    <string name="placementtest_first_lesson">First lesson</string>
    <!-- The most questions a test asks. It can end sooner. -->
    <plurals name="placementtest_up_to_questions">
        <item quantity="one">Up to %d question</item>
        <item quantity="other">Up to %d questions</item>
    </plurals>
    <string name="placementtest_finish_later">Finish later</string>
    <string name="placementtest_start_lesson">Start lesson</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="one">Skipped %d lesson you already know.</item>
        <item quantity="other">Skipped %d lessons you already know.</item>
    </plurals>
    <!-- On a level test's result when listening wasn't tested, such as after the learner said they can't listen now. -->
    <string name="placementtest_take_again_later">You can take the test again later, from your plan.</string>
    <string name="placementtest_not_tested">Not tested yet</string>
    <!-- The name of a course's placement test, on the card that offers it. -->
    <string name="placementtest_test">Test</string>
    <!-- The chip over the chapter's name after a course's placement test: where the learner's lessons start. -->
    <string name="placementtest_you_start_here">You start here</string>
    <!-- Under a picture of a course, after a placement test: how many of the course's lessons the learner starts past. %1$d is how many were skipped, %2$d how many the course has. -->
    <plurals name="placementtest_course_skipped">
        <item quantity="one">%1$d of %2$d lessons skipped</item>
        <item quantity="other">%1$d of %2$d lessons skipped</item>
    </plurals>
    <!-- Under a picture of a course, after a placement test that skipped nothing: how many lessons the course has. -->
    <plurals name="placementtest_course_lessons">
        <item quantity="one">%d lesson</item>
        <item quantity="other">%d lessons</item>
    </plurals>
</resources>
