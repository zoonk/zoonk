<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- How many of the goal's mind maps are drawn: "3 maps". -->
    <plurals name="mindmaps_count">
        <item quantity="one">%1$s map</item>
        <item quantity="other">%1$s maps</item>
    </plurals>
    <!-- Under the Mind maps page's title. -->
    <string name="mindmaps_intro">A chapter\'s main ideas in one picture. Every chapter you finish gets one; you can make one for any other chapter in your plan.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_intro_lessons_first_free">A chapter\'s main ideas in one picture. Every chapter you finish gets one; you can make one for any other chapter in your plan. Making a map for one of these writes its lessons first, which counts toward your free lessons.</string>
    <!-- The same intro while some chapters' lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_intro_lessons_first_plus">A chapter\'s main ideas in one picture. Every chapter you finish gets one; you can make one for any other chapter in your plan. Making a map for one of these writes its lessons first, so it takes a few minutes.</string>
    <plurals name="mindmaps_chapter_count">
        <item quantity="one">%d chapter</item>
        <item quantity="other">%d chapters</item>
    </plurals>
    <!-- A mind map row's line under the chapter's title. -->
    <string name="mindmaps_chapter_number">Chapter %1$s</string>
    <string name="mindmaps_empty_title">No mind maps yet</string>
    <string name="mindmaps_empty_description">Your plan\'s chapters show up here as you get to them.</string>
    <string name="mindmaps_keep_studying">Keep studying</string>
    <!-- A mind map's description for screen readers when it has no words yet. -->
    <string name="mindmaps_alt_chapter">Mind map of %1$s</string>
    <!-- A mind map's description for screen readers: its title, then its central idea. -->
    <string name="mindmaps_alt">Mind map: %1$s. %2$s</string>
    <!-- The same, for a title that already ends a sentence. -->
    <string name="mindmaps_alt_sentence">Mind map: %1$s %2$s</string>
    <!-- A map whose picture had mistakes, in its row on the Mind maps page; also the viewer's button that shows the map in words. -->
    <string name="mindmaps_as_text">As text</string>
    <!-- The viewer's button that shows the map's picture again after it was shown as text. -->
    <string name="mindmaps_as_picture">As picture</string>
    <!-- The title of a chapter's mind map row on the chapter's page. -->
    <string name="mindmaps_row_title">Mind map</string>
    <!-- A mind map that can be made, or that's ready, on the chapter's page. -->
    <string name="mindmaps_row_description">Its main ideas in one picture</string>
    <!-- A chapter whose lessons aren't written yet, for a free learner or a guest. -->
    <string name="mindmaps_lessons_first_free">Its lessons get written first and count toward your free lessons.</string>
    <!-- A chapter whose lessons aren't written yet, for a Plus learner. -->
    <string name="mindmaps_lessons_first_plus">Its lessons get written first, so it takes a few minutes.</string>
    <!-- A chapter on the Mind maps page whose lessons aren't written yet, after its number: "Chapter 4 · Lessons not written yet". -->
    <string name="mindmaps_lessons_not_written">Lessons not written yet</string>
    <string name="mindmaps_writing_lessons">Writing the lessons, then the mind map…</string>
    <string name="mindmaps_writing_lessons_wait">This takes a few minutes. You can leave; it\'ll be here.</string>
    <string name="mindmaps_drawing">Drawing the mind map…</string>
    <string name="mindmaps_drawing_wait">About half a minute. You can leave; it\'ll be here.</string>
    <!-- A finished chapter's mind map that's ready to open, where the chapter ends. -->
    <string name="mindmaps_ready">Mind map ready</string>
    <!-- Where a lesson or a test ends, over the row of the chapter it finished and its mind map. -->
    <string name="mindmaps_chapter_finished">Chapter finished</string>
    <!-- Makes a chapter's mind map. -->
    <string name="mindmaps_create">Create</string>
    <!-- Opens a chapter's mind map. -->
    <string name="mindmaps_open">Open</string>
    <string name="mindmaps_try_again">Try again</string>
    <!-- What screen readers say for a row's Create, naming its chapter. -->
    <string name="mindmaps_create_spoken">Create the mind map of %1$s</string>
    <!-- What screen readers say for a row's Open, naming its chapter. -->
    <string name="mindmaps_open_spoken">Open the mind map of %1$s</string>
    <!-- What screen readers say for a row's Try again, naming its chapter. -->
    <string name="mindmaps_try_again_spoken">Try the mind map of %1$s again</string>
    <string name="mindmaps_failed">It couldn\'t be made this time.</string>
    <string name="mindmaps_unreachable">We couldn\'t reach the server. Check your connection.</string>
    <string name="mindmaps_as_text_note">Its picture had mistakes, so here\'s the mind map as text.</string>
    <!-- Saves the mind map's picture. -->
    <string name="mindmaps_download">Download</string>
    <string name="mindmaps_saved">Mind map saved</string>
    <string name="mindmaps_save_failed">The mind map didn\'t save. Try again.</string>
    <!-- Starts the one-line gist at the end of a mind map in words. -->
    <string name="mindmaps_in_short">In short:</string>
    <string name="mindmaps_zoom_in">Zoom in</string>
    <string name="mindmaps_zoom_out">Zoom out</string>
    <string name="mindmaps_fit">Fit to screen</string>
    <string name="mindmaps_viewer_hint">Pinch, scroll or use + and - to zoom; drag or use the arrows to move.</string>
</resources>
