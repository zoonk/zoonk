<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Take a mock exam</string>
    <string name="mock_chooser_line">Timed like the real exam. You see your result at the end.</string>
    <string name="mock_chooser_start">Start</string>
    <string name="mock_chooser_one_subject">One subject</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">The exam</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">Day %1$d</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">Half of day %1$d</string>
    <string name="mock_chooser_full_exam">The full exam</string>
    <string name="mock_chooser_half_exam">Half the exam</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">Day %1$d, without %2$s</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">The full exam, without %1$s</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">No written part</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d question · %2$s</item>
        <item quantity="other">%1$d questions · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">Not enough questions for this one yet. Pick another.</string>
    <string name="mock_chooser_failed">We couldn\'t start the mock exam. Try again.</string>
    <string name="mock_chooser_short_title">Start a shorter mock exam?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_day">Today this one has %1$s of its %2$s questions, about %3$s. You can take the full one tomorrow.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">Today this one has %1$s of its %2$s questions, about %3$s. You can take the full one next month.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">Today this one has %1$s of its %2$s questions, about %3$s.</string>
    <string name="mock_chooser_pick_another">Pick another</string>
    <string name="mock_chooser_preparing">Getting your mock exam ready…</string>
    <string name="mock_chooser_preparing_detail">We\'re writing questions like the exam\'s for you. It starts here as soon as they\'re ready.</string>
    <string name="mock_chooser_writing">Writing your mock exam</string>
    <string name="mock_chooser_writing_questions">Writing questions like the exam\'s</string>
    <string name="mock_chooser_writing_questions_line">Picking what to ask in each subject…</string>
    <!-- The panel beside the options, about the one picked. -->
    <string name="mock_chooser_picked">The picked mock exam</string>
    <string name="mock_chooser_questions">Questions</string>
    <string name="mock_chooser_time_limit">Time limit</string>
    <string name="mock_chooser_usually_takes">Usually takes</string>
    <!-- %1$s is a duration, such as "1 hr 20 min". -->
    <string name="mock_chooser_about">About %1$s</string>
    <string name="mock_chooser_subjects">Subjects</string>
    <!-- The exam's sections a mock sits, such as Listening and Reading. -->
    <string name="mock_chooser_parts">Parts</string>
    <!-- Under a part such as "Essay", which the learner writes rather than answers. -->
    <string name="mock_chooser_written_part">Written part</string>
    <string name="mock_chooser_last_mock">Your last mock exam</string>
    <!-- %1$s is a past exam edition, such as "2024 exam"; %2$s the site that counted its questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_past_edition">Questions per subject in the %1$s, as counted by %2$s.</string>
    <!-- %1$s is the site that counted the questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_latest_exam">Questions per subject in the latest exam, as counted by %1$s.</string>
</resources>
