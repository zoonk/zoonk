<resources>
    <string name="goal_switcher_start_goal">Start a goal</string>
    <!-- Read by TalkBack on the top bar's goal button; %1$s is the goal's title. -->
    <string name="goal_switcher_current_goal">%1$s, current goal. Switch goal</string>
    <string name="goal_switcher_your_goals">Your goals</string>
    <string name="goal_switcher_quick_explanations">Quick explanations</string>
    <string name="goal_switcher_new_goal">Start a new goal</string>
    <string name="goal_switcher_explore_courses">Explore courses</string>
    <!-- %1$s is a duration, such as "30 min". -->
    <string name="goal_switcher_daily">%1$s a day</string>
    <string name="goal_switcher_finished">Finished</string>
    <string name="goal_switcher_paused">Paused</string>
    <string name="goal_switcher_failed">We couldn\'t switch goals. Try again.</string>
    <!-- Under a goal the learner typed with their goals that their plan didn't start, because the free plan follows only so many goals at the same time (not a cap on new goals per day or month). Plus is the name of Zoonk's paid plan, not the word "more". -->
    <string name="goal_switcher_starts_with_plus">Starts with Plus</string>
    <!-- Status under a goal a guest typed with their goals that they can't start yet, read like "Starts with Plus" under an account's waiting goal: a short status, not a button or a command. Without an account a learner follows one goal at a time; a "free account" (signed up, on the free plan, not the paid plan) follows more goals at once. This counts goals followed at the same time, not new goals started per day or month. The goal comes with them when they create the account. Tapping the row opens sign-up. -->
    <string name="goal_switcher_starts_with_free_account">Starts with a free account</string>
    <!-- Under a goal the learner typed with their goals that they can start now with a tap. -->
    <string name="goal_switcher_ready_to_start">Ready to start</string>
    <string name="goal_switcher_start_failed">We couldn\'t start this goal. Try again.</string>
</resources>
