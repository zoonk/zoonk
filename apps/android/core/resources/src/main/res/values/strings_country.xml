<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The search field at the top of the country picker. -->
    <string name="country_search">Search countries</string>
    <!-- A heading in the country picker over a few countries picked for the learner: earlier answers, where they live, the countries of their language. -->
    <string name="country_suggested">Suggested</string>
    <!-- A heading in the country picker over every country, A to Z. -->
    <string name="country_all">All countries</string>
    <!-- Shown in the country picker when the search matches no country. -->
    <string name="country_no_match">No country found</string>
    <!-- Read by TalkBack as the country picker's search changes: how many countries match. -->
    <plurals name="country_result_count">
        <item quantity="one">%1$d country</item>
        <item quantity="other">%1$d countries</item>
    </plurals>
    <!-- Shown in the country picker when the full list of countries didn't load; a Try again button follows. -->
    <string name="country_load_failed">Couldn\'t load the list.</string>
    <!-- Read by TalkBack for the country the learner said they live in; %1$s is the country's name. -->
    <string name="country_home_label">%1$s, where you live</string>
    <!-- A label in the plan: the country a course's content is about, such as its laws or taxes. The country's name follows it as a value. -->
    <string name="country_content_label">Content country</string>
    <!-- %1$s is a country's name in the reader's language; it always follows the colon, so it never needs an article or a case. -->
    <string name="country_content_value">Content country: %1$s</string>
    <!-- A label in the plan: the country of an exam from another country. The country's name follows it as a value. -->
    <string name="country_exam_label">Exam country</string>
    <!-- A label in the plan: the language lessons use, such as "Portuguese (Brazil)", shown when the content's country speaks the language another way. -->
    <string name="country_lesson_language_label">Lesson language</string>
    <!-- %1$s is a language with its country, such as "Portuguese (Brazil)"; it always follows the colon, so it never needs an article or a case. -->
    <string name="country_lesson_language_value">Lesson language: %1$s</string>
    <!-- A label in the plan: the country whose examples a general course uses, which is where the learner lives. The country's name follows it as a value. -->
    <string name="country_lesson_examples_label">Lesson examples</string>
    <!-- The title of a dialog confirming a new content country for a started plan. -->
    <string name="country_change_title">Change the content country?</string>
    <!-- The body of that dialog; %1$s is the new country's name in the reader's language, after the colon so it needs no article or case. -->
    <string name="country_change_body">New country: %1$s. Your plan will be rebuilt for it. The lessons you\'ve finished stay done, and you can keep studying your current plan until the new one is ready.</string>
    <!-- The dialog's button that saves the new country and rebuilds the plan for it. -->
    <string name="country_change_confirm">Rebuild plan</string>
    <!-- A notice at the top of the plan while a new plan is prepared for the new content country. -->
    <string name="country_rebuild_title">Preparing your new plan</string>
    <!-- Under that notice's title. -->
    <string name="country_rebuild_body">Keep studying: this plan stays until the new one is ready, and the lessons you\'ve finished stay done.</string>
    <!-- Replaces that notice once the new plan is saved and shown. -->
    <string name="country_rebuild_ready">Your new plan is ready.</string>
    <!-- A notice at the top of the plan when the new plan for the new content country couldn't be prepared; a Try again button follows. -->
    <string name="country_rebuild_failed_title">Your new plan couldn\'t be prepared</string>
    <!-- Under that notice's title. -->
    <string name="country_rebuild_failed_body">Your plan still has the lessons it had before.</string>
</resources>
