    <string name="focustest_many_unknown">Haven\'t studied most of this yet? That\'s fine. You can stop here and start learning.</string>
    <string name="focustest_answers_saved_title">Your answers are saved</string>
    <!-- Above the test's result: nothing the learner answered was lost. -->
    <string name="focustest_answers_saved">Answers saved</string>
    <!-- The test's result: the exam subjects that need the most study time, most needed first. -->
    <string name="focustest_result_title">Here\'s where to focus</string>
    <string name="focustest_result_description">Based on your answers and what counts most in your exam. Focusing never removes a subject.</string>
    <plurals name="focustest_also_skips">
        <item quantity="one">Your plan also skips %d lesson you already know.</item>
        <item quantity="other">Your plan also skips %d lessons you already know.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">Your starting point is set</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="one">Your plan skips %d lesson you already know.</item>
        <item quantity="other">Your plan skips %d lessons you already know.</item>
    </plurals>
    <string name="focustest_from_basics">Your plan starts each subject from the basics.</string>
