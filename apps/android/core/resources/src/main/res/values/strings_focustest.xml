<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">Focus test</string>
    <string name="focustest_invitation_title_dated">Let\'s find where your study time should go</string>
    <!-- The test's title for an exam goal without a date. -->
    <string name="focustest_invitation_title">Find where to start</string>
    <string name="focustest_invitation_description_focus">Quick questions on your subjects, the ones that count most first. Your answers help your plan skip what you already know and suggest where to focus.</string>
    <string name="focustest_invitation_description">Quick questions on your subjects, the ones that count most first. Your answers help your plan skip what you already know.</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_about">About %1$s</string>
    <!-- The test is optional: the learner can skip it. -->
    <string name="focustest_optional">Optional</string>
    <plurals name="focustest_up_to_questions">
        <item quantity="one">Up to %d question</item>
        <item quantity="other">Up to %d questions</item>
    </plurals>
