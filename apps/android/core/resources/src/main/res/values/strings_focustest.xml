<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="focustest_title">Focus test</string>
    <string name="focustest_find_focus">Find what to study most</string>
    <string name="focustest_find_start">Already know some of this?</string>
    <string name="focustest_offer_sentence">A test shows what you already know, so more of your time goes to what you need most.</string>
    <string name="focustest_offer_line">This test shows what you already know, so your plan can skip it.</string>
    <string name="focustest_start">Start the test</string>
    <string name="focustest_skip_note">You can take the test later, from your plan.</string>
    <string name="focustest_not_now">Not now</string>
    <string name="focustest_continue">Continue</string>
    <!-- Button that ends the Focus test with the answers given so far and shows its result. -->
    <string name="focustest_see_my_result">See my result</string>
    <string name="focustest_stop">Stop and use my answers</string>
    <string name="focustest_many_unknown">Haven\'t studied most of this yet? That\'s fine. You can stop here and start learning.</string>
    <string name="focustest_answers_saved_title">Your answers are saved</string>
    <!-- The test's result: the exam subjects that need the most study time, most needed first. -->
    <string name="focustest_result_title">Here\'s where to focus</string>
    <string name="focustest_result_description">Based on your answers and what counts most in your exam. Focusing never removes a subject.</string>
    <plurals name="focustest_also_skips">
        <item quantity="one">Your plan also skips %d lesson you already know.</item>
        <item quantity="other">Your plan also skips %d lessons you already know.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">Your starting point is set</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="one">Your plan skips %d lesson you already know.</item>
        <item quantity="other">Your plan skips %d lessons you already know.</item>
    </plurals>
    <string name="focustest_from_basics">Your plan starts each subject from the basics.</string>
    <string name="focustest_result_current">Your plan gives these subjects more time.</string>
    <string name="focustest_result_hand_picked">Your plan keeps the focus you chose. This is what the test suggests.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
    <string name="focustest_result_declined">You kept your plan as it is. This is what the test suggests.</string>
    <string name="focustest_change_focus">Change focus</string>
    <!-- Opens the list of every exam subject with how its Focus test questions went. -->
    <string name="focustest_see_all_subjects">See all subjects</string>
    <string name="focustest_subjects">Subjects</string>
    <!-- Label of an on/off switch on the Focus test's result: the test's questions keep coming, a few at a time, in the learner's lessons. -->
    <string name="focustest_session_questions">Ask a few more questions as I study</string>
    <string name="focustest_session_questions_when">During your first week</string>
    <string name="focustest_done">Done</string>
    <!-- Button on the Focus test's result: continues the test with more questions. -->
    <string name="focustest_answer_more">Answer more questions</string>
    <!-- Headline, above a short list of exam subjects: asks the learner whether their study plan should give those subjects more time. -->
    <string name="focustest_proposal_title">Give these subjects more time?</string>
    <!-- How the Focus test picked the subjects listed below it: from the learner's answers to its questions and how many of the exam's questions each subject has. -->
    <string name="focustest_proposal_picked">Picked from your answers and how much your exam asks about each.</string>
    <string name="focustest_update_plan">Update my plan</string>
    <string name="focustest_proposal_applied">Your plan now gives these subjects more time.</string>
    <string name="focustest_proposal_declined">Your plan stays as it was.</string>
    <string name="focustest_proposal_undone">Undone. Your plan is back as it was.</string>
    <string name="focustest_undo">Undo</string>
    <!-- A short fact beside a subject in a list: every answer the learner gave on it was “I don't know yet”. It is not a grade. -->
    <string name="focustest_not_known_yet">Not known yet</string>
    <!-- %1$d answers right of %2$d asked on one subject. -->
    <plurals name="focustest_subject_right">
        <item quantity="one">%1$d of %2$d right</item>
        <item quantity="other">%1$d of %2$d right</item>
    </plurals>
    <!-- Parts of the exam the Focus test's questions can't ask about, such as the essay. -->
    <string name="focustest_written_not_checked">Writing: not in this test</string>
    <string name="focustest_listening_not_checked">Listening: not in this test</string>
    <string name="focustest_speaking_not_checked">Speaking: not in this test</string>
    <string name="focustest_practical_not_checked">Practical part: not in this test</string>
    <string name="focustest_in_progress">In progress</string>
    <string name="focustest_see_your_result">See your result</string>
    <!-- Link that opens the Focus test, for a learner who has not taken it. -->
    <string name="focustest_take_test">Take the Focus test</string>
    <string name="focustest_suggestion_line">The Focus test shows what to study most.</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="focustest_suggestion_body">A %1$s test shows what you already know, so more of your time goes to what you need most. It never removes a subject.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">Noted. You can take the test from your plan.</string>
    <string name="focustest_not_today">Not today</string>
    <string name="focustest_not_today_failed">That didn\'t save. Try again.</string>
</resources>
