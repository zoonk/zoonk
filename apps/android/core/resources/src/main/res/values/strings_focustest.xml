    <string name="focustest_result_hand_picked">Your plan keeps the focus you chose. This is what the test suggests.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
    <string name="focustest_result_declined">You kept your plan as it is. This is what the test suggests.</string>
    <string name="focustest_change_focus">Change focus</string>
    <string name="focustest_see_all_subjects">See all subjects</string>
