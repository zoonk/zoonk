        <item quantity="one">%d subject</item>
        <item quantity="other">%d subjects</item>
    </plurals>
    <string name="focustest_no_grade">There\'s no grade. “I don\'t know yet” is a useful answer.</string>
    <string name="focustest_stop_any_time">Stop whenever you need to. We save each answer.</string>
    <!-- Said when the exam has more subjects than one sitting can ask about; the next sentence says how many questions the sitting has. “This sitting” is one go at the Focus test, answered in one stretch. It is not a study session, which is a different thing in the app: use another word, or say “this test” or “this time”. -->
    <plurals name="focustest_past_ceiling_subjects">
        <item quantity="one">Your plan considers its %d subject.</item>
        <item quantity="other">Your plan considers all %d subjects.</item>
    </plurals>
