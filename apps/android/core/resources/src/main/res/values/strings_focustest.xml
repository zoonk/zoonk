    <string name="focustest_how_sessions_title">A few more in your first week</string>
    <string name="focustest_how_sessions">Your study sessions ask a few more of these questions. You can pause that.</string>
    <string name="focustest_start">Start the test</string>
    <string name="focustest_skip_for_now">Skip for now</string>
    <string name="focustest_skip_note">You can take the test later, from your plan.</string>
