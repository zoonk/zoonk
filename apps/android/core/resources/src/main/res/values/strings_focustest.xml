<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">Focus test</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_about">About %1$s</string>
    <!-- What's left of a test the learner started; %1$s is a duration, such as "13 min". -->
    <string name="focustest_about_left">About %1$s left</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">Find out where to focus</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">Find out where to start</string>
    <string name="focustest_offer_description_focus">Quick questions on your exam\'s subjects. Your plan skips what you already know, so your time goes where you need it most.</string>
    <string name="focustest_offer_description">Quick questions on your exam\'s subjects. Your plan skips what you already know.</string>
    <string name="focustest_how_it_works">How it works</string>
    <string name="focustest_how_weight_title">What counts most comes first</string>
    <string name="focustest_how_weight">The test starts with the subjects that weigh most in your exam.</string>
    <string name="focustest_how_grade_title">There\'s no grade</string>
    <string name="focustest_how_grade">“I don\'t know yet” is a fine answer.</string>
    <string name="focustest_how_stop_title">Stop anytime</string>
    <string name="focustest_how_stop">Each answer is saved.</string>
    <string name="focustest_how_subjects_title">Focusing never removes a subject</string>
    <string name="focustest_how_subjects">The ones you need most get more time when your time can\'t cover everything.</string>
