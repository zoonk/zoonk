    <string name="focustest_update_plan">Update my plan</string>
    <string name="focustest_proposal_applied">Your plan now gives these subjects more time.</string>
    <string name="focustest_proposal_declined">Your plan stays as it was.</string>
    <string name="focustest_proposal_undone">Undone. Your plan is back as it was.</string>
    <string name="focustest_undo">Undo</string>
    <!-- A short fact beside a subject in a list: every answer the learner gave on it was “I don't know yet”. It is not a grade. -->
    <string name="focustest_not_known_yet">Not known yet</string>
    <!-- %1$d answers right of %2$d asked on one subject. -->
    <plurals name="focustest_subject_right">
        <item quantity="one">%1$d of %2$d right</item>
        <item quantity="other">%1$d of %2$d right</item>
    </plurals>
    <!-- A subject the test hasn't asked a question about yet. -->
    <string name="focustest_not_asked_yet">Not asked yet</string>
    <!-- Parts of the exam the test's quick questions can't check, such as the essay. -->
    <string name="focustest_written_not_checked">Writing: not checked here</string>
    <string name="focustest_listening_not_checked">Listening: not checked here</string>
    <string name="focustest_speaking_not_checked">Speaking: not checked here</string>
    <string name="focustest_practical_not_checked">Practical part: not checked here</string>
    <!-- The test's state on the plan: the learner started it and left before the end. -->
    <string name="focustest_in_progress">In progress</string>
    <string name="focustest_see_your_result">See your result</string>
    <!-- The test's state on the plan: the learner paused its questions in their study sessions. -->
    <string name="focustest_paused_in_sessions">Paused in your sessions</string>
    <string name="focustest_take_test">Take the Focus test</string>
    <!-- Under the daily time while it's short: %1$s lists up to three exam subjects, such as "Logic, Law and Math". -->
    <string name="focustest_schedule_focus">With this time, we suggest giving %1$s more attention.</string>
    <!-- On the plan reveal: %1$s is a daily study time, such as "4 hr"; %2$s a date, such as "Dec 10"; %3$s lists up to three exam subjects. -->
    <string name="focustest_reveal_trade_off">At %1$s a day, some topics won\'t fit before %2$s. This plan gives %3$s more time.</string>
    <string name="focustest_what_test_changed">What your test changed</string>
    <!-- Today's suggestion to take the test, in the goal's first week, when the learner's time can't cover everything. -->
    <string name="focustest_suggestion_line">The Focus test shows what to study most.</string>
    <!-- %1$s is a duration, such as "15 min". -->
    <string name="focustest_suggestion_body">Your time can\'t cover everything before your exam. In about %1$s, the Focus test shows what to study most.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">Noted. You can take the test from your plan.</string>
    <!-- On a session's test question: skips today's test questions; they're asked another day. -->
    <string name="focustest_not_today">Not today</string>
    <string name="focustest_not_today_failed">That didn\'t save. Try again.</string>
</resources>
