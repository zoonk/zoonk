    <plurals name="focustest_past_ceiling_questions">
        <item quantity="one">This sitting has up to %d question, so some subjects may not be checked.</item>
        <item quantity="other">This sitting has up to %d questions, so some subjects may not be checked.</item>
    </plurals>
