    <string name="certificates_kind_completion">수료 인증서</string>
    <!-- A language certificate's name: %1$s is the language, such as "Spanish", and %2$s its CEFR level, such as "B1". -->
    <string name="certificates_language_level">%1$s %2$s</string>
    <!-- A course level's certificate name, such as "Python · Beginner": the course's title, then the level's name. -->
