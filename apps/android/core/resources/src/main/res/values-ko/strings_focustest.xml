    <string name="focustest_about_left">약 %1$s 남음</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">집중할 과목을 알아보세요</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">어디부터 시작할지 알아보세요</string>
    <string name="focustest_offer_description_focus">시험 과목별로 간단한 문제를 풀어요. 이미 아는 내용은 계획에서 건너뛰어 가장 필요한 공부에 시간을 쓸 수 있어요.</string>
    <string name="focustest_offer_description">시험 과목별로 간단한 문제를 풀어요. 이미 아는 내용은 계획에서 건너뛰어요.</string>
    <string name="focustest_how_it_works">이용 방법</string>
    <string name="focustest_how_weight_title">비중이 큰 과목부터</string>
    <string name="focustest_how_weight">시험에서 비중이 가장 큰 과목부터 시작해요.</string>
    <string name="focustest_how_grade_title">점수를 매기지 않아요</string>
    <string name="focustest_how_grade">“아직 모르겠어요”라고 답해도 괜찮아요.</string>
    <string name="focustest_how_stop_title">언제든 멈출 수 있어요</string>
    <string name="focustest_how_stop">답할 때마다 바로 저장돼요.</string>
    <string name="focustest_how_subjects_title">집중을 이유로 과목을 제외하지 않아요</string>
    <string name="focustest_how_subjects">시험 전까지 모든 내용을 공부할 시간이 부족하면 가장 필요한 과목에 시간을 더 써요.</string>
    <!-- The learner's first week of study sessions also asks a few of the test's questions. -->
    <string name="focustest_how_sessions_title">첫 주에는 몇 문제 더 풀어요</string>
