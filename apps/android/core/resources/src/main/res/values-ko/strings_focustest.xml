<resources>
    <!-- The optional test of an exam goal: quick questions that find where the learner starts and where their study time should go. -->
    <string name="focustest_title">집중 진단</string>
    <!-- {time} is a duration with its unit, such as “9 min”. -->
    <string name="focustest_time_left">%1$s 남음</string>
    <!-- The test's headline for an exam with a date and several subjects: it shows which subjects need the most study time. -->
    <string name="focustest_find_focus">집중해서 공부할 과목 찾기</string>
    <!-- The test's headline for an exam without a date, or with one subject: it shows where the learner's level starts. -->
    <string name="focustest_find_start">이미 아는 내용이 있나요?</string>
    <string name="focustest_offer_line_focus">이 진단으로 이미 아는 내용을 확인하고, 가장 필요한 내용에 시간을 더 쓸 수 있어요. 과목은 제외하지 않아요.</string>
    <string name="focustest_offer_line">이 진단으로 이미 아는 내용을 확인해서 계획에서 건너뛸 수 있어요.</string>
    <string name="focustest_start">테스트 시작하기</string>
    <string name="focustest_skip_note">나중에 계획에서 테스트를 볼 수 있어요.</string>
    <string name="focustest_not_now">나중에</string>
    <string name="focustest_resume_title">테스트 이어서 풀기</string>
    <plurals name="focustest_answers_saved_line">
        <item quantity="other">답변 %d개가 저장되어 있어요.</item>
    </plurals>
    <string name="focustest_continue">계속하기</string>
    <string name="focustest_see_my_result">내 결과 보기</string>
    <!-- Over a test question: its number and the count promised when the sitting started. -->
    <string name="focustest_question_number">%1$d번 문제 / 총 %2$d문제</string>
    <string name="focustest_stop">그만 풀고 내 답변 반영하기</string>
    <!-- Shown after several "I don't know yet" answers in a row. -->
    <string name="focustest_many_unknown">아직 공부하지 않은 내용이 대부분인가요? 괜찮아요. 여기서 멈추고 학습을 시작해도 돼요.</string>
    <string name="focustest_answers_saved_title">답변이 저장됐어요</string>
    <!-- The test's result: the exam subjects that need the most study time, most needed first. -->
    <string name="focustest_result_title">이 과목에 집중해 보세요</string>
    <string name="focustest_result_description">답변과 시험에서 비중이 큰 부분을 바탕으로 추천했어요. 집중을 이유로 과목을 제외하지 않아요.</string>
    <plurals name="focustest_also_skips">
        <item quantity="other">계획에서 이미 아는 레슨 %d개도 건너뛰어요.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">학습 시작점이 정해졌어요</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="other">이미 아는 레슨 %d개는 계획에서 건너뛰어요.</item>
    </plurals>
    <string name="focustest_from_basics">계획에서는 모든 과목을 기초부터 시작해요.</string>
    <string name="focustest_result_current">계획에서 이 과목들에 시간을 더 배정해요.</string>
    <string name="focustest_result_hand_picked">계획의 집중 과목은 선택한 그대로예요. 아래는 진단에서 추천하는 과목이에요.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
    <string name="focustest_result_declined">계획은 그대로 두었어요. 아래는 진단에서 추천하는 과목이에요.</string>
    <string name="focustest_change_focus">집중 과목 바꾸기</string>
    <string name="focustest_see_all_subjects">전체 과목 보기</string>
    <string name="focustest_subjects">과목</string>
    <!-- A switch: the learner's study sessions also ask a few of the test's questions. -->
    <string name="focustest_session_questions">공부하면서 문제를 몇 개 더 풀기</string>
    <string name="focustest_session_questions_when">첫 주 동안만</string>
    <string name="focustest_done">완료</string>
    <string name="focustest_answer_more">문제 더 풀기</string>
    <!-- The test asks before changing a plan the learner already has. -->
    <string name="focustest_proposal_title">이 과목들에 시간을 더 쓸까요?</string>
    <!-- How the Focus test picked the subjects listed below it: from the learner's answers to its questions and how many of the exam's questions each subject has. -->
    <string name="focustest_proposal_picked">내 답변과 시험에서 각 과목이 얼마나 다뤄지는지를 바탕으로 선정했어요.</string>
    <string name="focustest_update_plan">내 계획 바꾸기</string>
    <string name="focustest_proposal_applied">계획에서 이 과목들에 시간을 더 배정했어요.</string>
    <string name="focustest_proposal_declined">계획은 그대로예요.</string>
    <string name="focustest_proposal_undone">변경을 취소했어요. 계획이 원래대로 돌아갔어요.</string>
    <string name="focustest_undo">실행 취소</string>
    <!-- A short fact beside a subject in a list: every answer the learner gave on it was “I don't know yet”. It is not a grade. -->
    <string name="focustest_not_known_yet">아직 모름</string>
    <!-- %1$d answers right of %2$d asked on one subject. -->
    <plurals name="focustest_subject_right">
        <item quantity="other">정답 %1$d개 / 총 %2$d문제</item>
    </plurals>
    <!-- Parts of the exam the Focus test's questions can't ask about, such as the essay. -->
    <string name="focustest_written_not_checked">서술형: 이 진단에 포함되지 않음</string>
    <string name="focustest_listening_not_checked">듣기: 이 진단에 포함되지 않음</string>
    <string name="focustest_speaking_not_checked">말하기: 이 진단에 포함되지 않음</string>
    <string name="focustest_practical_not_checked">실기: 이 진단에 포함되지 않음</string>
    <!-- The test's state on the plan: the learner started it and left before the end. -->
    <string name="focustest_in_progress">진행 중</string>
    <string name="focustest_see_your_result">결과 보기</string>
    <!-- The test's state on the plan: the learner paused its questions in their study sessions. -->
    <string name="focustest_paused_in_sessions">학습 중 추가 문제 일시 중지됨</string>
    <string name="focustest_take_test">집중 진단 받기</string>
    <!-- Today's suggestion to take the test, in the goal's first week, when the learner's time can't cover everything. -->
    <string name="focustest_suggestion_line">집중 진단으로 공부가 가장 필요한 과목을 알 수 있어요.</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="focustest_suggestion_body">%1$s 동안 집중 진단을 하면 이미 아는 내용을 확인할 수 있어, 가장 필요한 부분에 더 많은 시간을 쓸 수 있어요. 과목이 빠지는 일은 없어요.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">알겠어요. 계획에서 테스트를 볼 수 있어요.</string>
    <!-- On a session's test question: skips today's test questions; they're asked another day. -->
    <string name="focustest_not_today">오늘은 건너뛰기</string>
    <string name="focustest_not_today_failed">저장하지 못했어요. 다시 시도해 보세요.</string>
</resources>
