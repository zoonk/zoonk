<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">모의고사 보기</string>
    <string name="mock_chooser_line">실제 시험처럼 제한 시간이 있어요. 결과는 마지막에 확인할 수 있어요.</string>
    <string name="mock_chooser_start">시작하기</string>
    <string name="mock_chooser_one_subject">한 과목</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">시험</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">%1$d일 차</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">%1$d일 차의 절반</string>
    <string name="mock_chooser_full_exam">전체 시험</string>
    <string name="mock_chooser_half_exam">시험의 절반</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">%1$d일 차, %2$s 제외</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">전체 시험, %1$s 제외</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">서술형 제외</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="other">%1$d문제 · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">아직 문제가 부족해요. 다른 모의고사를 골라 보세요.</string>
    <string name="mock_chooser_failed">모의고사를 시작하지 못했어요. 다시 시도해 보세요.</string>
    <string name="mock_chooser_short_title">더 짧은 모의고사를 시작할까요?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_day">오늘은 %1$s문제(전체 %2$s문제)를 풀 수 있고, 약 %3$s 걸려요. 전체 모의고사는 내일 볼 수 있어요.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">오늘은 %1$s문제(전체 %2$s문제)를 풀 수 있고, 약 %3$s 걸려요. 전체 모의고사는 다음 달에 볼 수 있어요.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">오늘은 %1$s문제(전체 %2$s문제)를 풀 수 있고, 약 %3$s 걸려요.</string>
    <string name="mock_chooser_pick_another">다른 모의고사 고르기</string>
    <string name="mock_chooser_preparing">모의고사를 준비하고 있어요…</string>
    <string name="mock_chooser_preparing_detail">실제 시험과 비슷한 문제를 만들고 있어요. 준비가 끝나면 여기서 바로 시작돼요.</string>
    <string name="mock_chooser_writing">모의고사를 만들고 있어요</string>
    <string name="mock_chooser_writing_questions">실제 시험과 비슷한 문제를 만들고 있어요</string>
    <string name="mock_chooser_writing_questions_line">과목마다 무엇을 물어볼지 고르고 있어요…</string>
    <!-- The panel beside the options, about the one picked. -->
    <string name="mock_chooser_picked">선택한 모의고사</string>
    <string name="mock_chooser_questions">문제</string>
    <string name="mock_chooser_time_limit">제한 시간</string>
    <string name="mock_chooser_usually_takes">보통 걸리는 시간</string>
    <!-- %1$s is a duration, such as "1 hr 20 min". -->
    <string name="mock_chooser_about">약 %1$s</string>
    <string name="mock_chooser_subjects">과목</string>
    <!-- The exam's sections a mock sits, such as Listening and Reading. -->
    <string name="mock_chooser_parts">파트</string>
    <!-- Under a part such as "Essay", which the learner writes rather than answers. -->
    <string name="mock_chooser_written_part">글쓰기 파트</string>
    <string name="mock_chooser_last_mock">최근 모의고사</string>
    <!-- %1$s is a past exam edition, such as "2024 exam"; %2$s the site that counted its questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_past_edition">%1$s의 과목별 문제 수예요. %2$s에서 집계했어요.</string>
    <!-- %1$s is the site that counted the questions, such as "inep.gov.br". -->
    <string name="mock_chooser_size_latest_exam">가장 최근 시험의 과목별 문제 수예요. %1$s에서 집계했어요.</string>
</resources>
