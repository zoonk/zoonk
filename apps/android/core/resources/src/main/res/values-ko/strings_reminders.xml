<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">학습 알림</string>
    <!-- Under the channel's name in Android's settings, and under the Reminders page's title. -->
    <string name="reminders_channel_description">학습일에 할 공부가 남아 있으면 한 번 알려 드려요.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">학습 알림을 받아 보실래요?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">공부하기로 한 날에 할 공부가 남아 있으면 %1$s에 알려 드려요.</string>
    <string name="reminders_remind_me">알림 받기</string>
    <!-- Declines the offer, which isn't shown again. Portuguese: "Agora não" (ungendered). -->
    <string name="reminders_no_thanks">아니요, 괜찮아요</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">학습 알림을 켰어요.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">이메일 알림이 켜져 있어요.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Zoonk 알림이 꺼져 있어요.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">설정 열기</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">대신 이메일로 받기</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">알림을 허용할까요?</string>
    <string name="reminders_permission_body">Zoonk가 학습일에 공부할 내용이 남아 있을 때만 한 번 알려 드려요.</string>
    <string name="reminders_permission_continue">계속하기</string>
    <string name="reminders_not_now">나중에</string>
    <!-- The title of the clock that changes the reminder's time. -->
    <string name="reminders_time_title">알림 시간</string>
    <string name="reminders_save">저장</string>
    <string name="reminders_cancel">취소</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">알림</string>
    <!-- The time of day a reminder goes out, not an amount of time. -->
    <string name="reminders_time">시간</string>
    <string name="reminders_email">이메일</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">계정을 만들고 이메일 알림 받기</string>
    <string name="reminders_push">푸시 알림</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">계획에서 정한 학습일에</string>
    <string name="reminders_quiet">쉬는 동안 알림을 일시 중지했어요. 다시 공부하면 켜져요.</string>
    <string name="reminders_save_failed">저장하지 못했어요. 다시 시도해 보세요.</string>
    <!-- Push reminders go to another of the learner's devices; this one can take over. -->
    <string name="reminders_use_this_device">이 기기로 받기</string>
    <!-- After the selected device's name, such as "Pixel 9 · This device", when it's the device in hand. -->
    <string name="reminders_this_device">이 기기</string>
</resources>
