    <string name="language_unit_summary">단원 요약</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">단원 정보</string>
    <string name="language_skill_reading">읽기</string>
    <string name="language_skill_listening">듣기</string>
    <string name="language_skill_speaking">말하기</string>
    <string name="language_skill_words">어휘</string>
    <string name="language_skill_writing">쓰기</string>
    <!-- Heads the learner's level in each skill (reading, listening, speaking, writing), on the CEFR scale from A1 to C2. -->
    <string name="language_level_by_skill">스킬별 레벨</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">목표 %1$s · %2$s까지</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">목표 %1$s</string>
    <!-- What TalkBack says for a skill's row: "Reading, B1". -->
    <string name="language_skill_level">%1$s, %2$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Reading, B1, up since the level test". -->
    <string name="language_skill_level_trend">%1$s, %2$s, %3$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">레벨 테스트 때보다 올랐어요</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">레벨 테스트 때보다 내려갔어요</string>
    <string name="language_levels_move">연습하면서 레벨이 바뀌어요. 매주 더 정확해져요.</string>
    <!-- One skill rose: "Speaking went up to B1 since the level test." -->
    <string name="language_level_rose">레벨 테스트 이후 %1$s 레벨이 %2$s까지 올랐어요.</string>
    <!-- The count is how many skills rose, always two or more; %1$s lists them: "Speaking and Writing went up since the level test." -->
    <plurals name="language_levels_rose">
        <item quantity="other">레벨 테스트 이후 %1$s 레벨이 올랐어요.</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">이제 할 수 있어요…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">아직 못 해요</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s, 목표 %2$s</string>
    <string name="language_pattern_noticed">실수 패턴을 발견했어요</string>
    <string name="language_pattern_typos">단순한 오타</string>
    <string name="language_pattern_typos_description">최근에 틀린 건 규칙을 몰라서가 아니라 단순한 실수였어요.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="other">단어 %d개 다시 소리 내어 말하기</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">다음 학습에서 가장 먼저 · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">언제든 연습하기 · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">이미 읽을 수 있어요</string>
    <string name="language_alphabet_skip_failed">저장하지 못했어요. 다시 시도해 보세요.</string>
    <!-- Button that opens the words to say aloud again; "them" is those words. -->
    <string name="language_say_them">소리 내어 말하기</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">열기</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">이런 실수 패턴을 발견했어요: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">연습하기</string>
    <string name="language_level">레벨</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, 목표 %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">내 계획 보기</string>
</resources>
