    <string name="speaking_last_near">지난 시도: %1$s/%2$s개 항목에서 %3$s에 가까움</string>
    <string name="speaking_last_below">지난 시도: %1$s 미만</string>
    <!-- Preparation time shared by several tasks, such as "20 min to prepare tasks 1 and 2". -->
    <string name="speaking_prep_shared">%1$s 동안 과제 %2$s 준비</string>
    <string name="speaking_prep">%1$s 동안 준비</string>
    <!-- The criteria the exam rates, listed, such as "Rated on fluency, vocabulary and grammar." -->
    <string name="speaking_rated_on">%1$s 항목을 평가해요.</string>
    <!-- A row into the speaking paper's practice: the exam and level, such as "DELE B2 tasks on a call". -->
    <string name="speaking_row">대화로 %1$s 과제 연습하기</string>
    <!-- A band is the exam's score for each criterion. -->
    <string name="speaking_mock_ielts">면접관과 짧은 말하기 시험을 봐요. 시험 후에는 평가 항목별 예상 밴드를 확인할 수 있어요.</string>
    <!-- A band is the exam's score for each criterion. -->
    <string name="speaking_mock_toefl">문장을 따라 말한 뒤 면접관과 짧은 면접을 봐요. 시험 후에는 평가 항목별 예상 밴드(1~6)를 확인할 수 있어요.</string>
    <string name="speaking_mock_start">모의고사 시작하기</string>
    <string name="speaking_mock_opens">모의고사가 준비되면 바로 열려요.</string>
    <string name="speaking_mock_failed">모의고사가 시작되지 않았어요. 잠시 후에 다시 시도해 보세요.</string>
    <string name="speaking_writing_mock">모의고사를 만들고 있어요</string>
    <string name="speaking_writing_mock_phase">면접관의 대본을 만들고 있어요</string>
    <string name="speaking_writing_mock_line_1">면접관을 고르고 있어요…</string>
    <string name="speaking_writing_mock_line_2">면접관이 할 질문을 만들고 있어요…</string>
    <string name="speaking_writing_mock_line_3">전체 파트를 약 5분 분량으로 맞추고 있어요…</string>
    <string name="speaking_writing_mock_line_4">도움이 될 표현을 더하고 있어요…</string>
