<resources>
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">이미 아는 내용 확인</string>
    <string name="placementtest_skip_lessons">이미 아는 레슨은 건너뛰기</string>
