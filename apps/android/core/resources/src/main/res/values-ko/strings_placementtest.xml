        <item quantity="other">%2$s 건너뜀: 레슨 %1$d개.</item>
    </plurals>
    <string name="placementtest_keeps_adjusting">답변에 따라 레슨이 계속 조정돼요.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$s 레벨이 계획에 계속 포함돼요</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">아직 %1$s 레벨을 확인할 문제가 충분하지 않아요.</string>
