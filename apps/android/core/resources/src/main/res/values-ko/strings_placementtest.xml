    <string name="placementtest_done">완료</string>
    <string name="placementtest_not_now">나중에</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">%1$s 레벨</string>
    <!-- %2$s is a list of language levels, such as "A1, A2". The plan no longer has their lessons. -->
