    <string name="placementtest_part">파트 %1$d</string>
    <string name="placementtest_continue_title">테스트 이어서 풀기</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="placementtest_left_saved">약 %1$s 남음. 답변은 저장돼요.</string>
    <string name="placementtest_continue_from_plan">계획에서 테스트를 마칠 수 있어요.</string>
    <string name="placementtest_finish_for_today">오늘은 여기까지</string>
    <string name="placementtest_keep_going">계속하기</string>
