    <plurals name="placementtest_lessons_skipped">
        <item quantity="other">건너뛴 레슨 %d개</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">읽기 %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">듣기 %1$s</string>
    <string name="placementtest_start_title">이미 아는 내용 건너뛰기</string>
    <string name="placementtest_choose_description">테스트로 건너뛸 수 있는 레슨을 찾아요.</string>
    <!-- The short test: about six minutes of questions. -->
    <string name="placementtest_quick">간단한 테스트</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">약 %1$s</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_test_out">%1$s 건너뛰기 테스트</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">이미 아는 %1$s 건너뛰기</string>
    <string name="placementtest_start">시작하기</string>
    <string name="placementtest_continue_title">테스트 이어서 풀기</string>
    <string name="placementtest_keep_going">계속하기</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">이미 알고 있는 레슨들이에요. 계속 복습에 포함돼요.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">이미 알고 있는 레슨들이에요. 계속 복습에 포함돼요.</string>
    <string name="placementtest_plan_stays">계획은 그대로 유지돼요.</string>
    <string name="placementtest_retake_tomorrow">오늘 이 레슨들의 건너뛰기를 취소했어요. 내일 다시 답하면 건너뛸 수 있어요.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">다음</string>
    <string name="placementtest_done">완료</string>
    <string name="placementtest_not_now">나중에</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">내 %1$s 레벨</string>
    <string name="placementtest_keeps_adjusting">답변에 따라 레슨이 계속 조정돼요.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">%1$s은 계획에 남아요</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">아직 %1$s 문제는 충분하지 않아요.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">쉬워 보이네요</string>
    <string name="placementtest_offer_quick">간단한 테스트로 이미 아는 레슨을 건너뛸 수 있어요.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">이미 아는 %1$s은 짧은 테스트로 건너뛸 수 있어요.</string>
    <string name="placementtest_where_to_start">어디서 시작할까요?</string>
    <string name="placementtest_first_lesson">첫 레슨</string>
    <string name="placementtest_first_lesson_line">입력한 레벨부터 시작</string>
    <!-- The long test: it checks every topic still ahead, in parts. -->
    <string name="placementtest_full_test">전체 테스트</string>
    <!-- How many parts the long test has. The learner can take each part on a different day. -->
    <plurals name="placementtest_parts_any_day">
        <item quantity="other">%d개 파트, 원하는 날에 응시</item>
    </plurals>
    <plurals name="placementtest_questions">
        <item quantity="other">문제 %d개</item>
    </plurals>
    <!-- Where the learner is in a test split into parts, such as “Part 3 of 14”. -->
    <string name="placementtest_part_of">%2$d개 중 %1$d번째 파트</string>
    <!-- The title after one part of a test split into parts, such as “Part 3 of 14 done”. -->
    <string name="placementtest_part_done" tools:ignore="PluralsCandidate">%2$d개 중 %1$d번째 파트 완료</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <string name="placementtest_part_skipped_none">이 파트에서 건너뛴 레슨이 없어요.</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <plurals name="placementtest_part_skipped">
        <item quantity="other">이 파트에서 이미 알고 있던 레슨 %d개를 건너뛰었어요.</item>
    </plurals>
    <!-- How many parts of a test the learner still has to take. -->
    <plurals name="placementtest_parts_left">
        <item quantity="other">남은 파트 %d개</item>
    </plurals>
    <string name="placementtest_finish_later">나중에 마무리하기</string>
    <!-- Where a learner who stopped a test picks it up: the part of the test and the question in it. -->
    <string name="placementtest_next_time">다음에 이어서 할 곳: %2$d개 중 %1$d번째 파트의 문제 %3$d번</string>
    <string name="placementtest_start_lesson">레슨 시작하기</string>
    <!-- Button after the short test: goes on to test the rest of the course, in parts. -->
    <string name="placementtest_test_the_rest">나머지 테스트하기</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="other">이미 알고 있던 레슨 %d개를 건너뛰었어요.</item>
    </plurals>
    <string name="placementtest_listening_later">계획에서 나중에 듣기 테스트를 볼 수 있어요.</string>
    <string name="placementtest_not_tested">아직 테스트 전</string>
    <string name="placementtest_about_left">약 %1$s 남음</string>
</resources>
