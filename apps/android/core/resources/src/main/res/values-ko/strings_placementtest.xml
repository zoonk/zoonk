    <plurals name="placementtest_known">
        <item quantity="other">이미 아는 내용이에요. 복습에 계속 포함돼요.</item>
    </plurals>
    <string name="placementtest_plan_stays">계획은 그대로 유지돼요.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">다음 주제</string>
