    <string name="placementtest_offer_title">이 정도는 쉬우신가 봐요</string>
    <string name="placementtest_offer_quick">간단한 테스트로 이미 아는 레슨을 건너뛸 수 있어요.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">이미 아는 %1$s 레벨은 짧은 테스트로 건너뛸 수 있어요.</string>
