<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">아는 내용 확인하기</string>
    <string name="placementtest_skip_lessons">이미 아는 레슨 건너뛰기</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">레벨 테스트</string>
    <string name="placementtest_find_level">레벨을 확인하고 아는 내용 건너뛰기</string>
    <string name="placementtest_in_progress">진행 중</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
