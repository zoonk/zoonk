    <!-- Under the Mind maps page's title. -->
    <string name="mindmaps_intro">챕터의 핵심 내용을 그림 한 장으로 정리해요. 챕터를 끝낼 때마다 하나씩 만들어지고, 계획에 있는 다른 챕터의 마인드맵도 만들 수 있어요.</string>
