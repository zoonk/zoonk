    <plurals name="activities_music_rhythm_rounds">
        <item quantity="one">%1$d bpm · %2$d runda</item>
        <item quantity="few">%1$d bpm · %2$d rundy</item>
        <item quantity="many">%1$d bpm · %2$d rund</item>
        <item quantity="other">%1$d bpm · %2$d rundy</item>
    </plurals>
    <!-- For TalkBack: the rhythm in words, like "A rhythm of 16 steps with a beat every 4. Tap on steps 1, 4, 7, 11, 13, over a click on every beat." -->
    <plurals name="activities_music_rhythm_description">
        <item quantity="one">Rytm ma %1$d krok, po %2$d na każde uderzenie pulsu. Stukaj, gdy wypadają kroki %3$s. W tle słychać kliknięcia wyznaczające puls.</item>
        <item quantity="few">Rytm ma %1$d kroki, po %2$d na każde uderzenie pulsu. Stukaj, gdy wypadają kroki %3$s. W tle słychać kliknięcia wyznaczające puls.</item>
        <item quantity="many">Rytm ma %1$d kroków, po %2$d na każde uderzenie pulsu. Stukaj, gdy wypadają kroki %3$s. W tle słychać kliknięcia wyznaczające puls.</item>
        <item quantity="other">Rytm ma %1$d kroku, po %2$d na każde uderzenie pulsu. Stukaj, gdy wypadają kroki %3$s. W tle słychać kliknięcia wyznaczające puls.</item>
    </plurals>
