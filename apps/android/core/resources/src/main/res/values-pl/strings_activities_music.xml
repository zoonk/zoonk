<resources>
    <string name="activities_music_badge_play_it">Zagraj</string>
    <!-- Training the ear to recognize notes and chords by their sound. -->
    <string name="activities_music_badge_ear_training">Ćwiczenie słuchu</string>
    <!-- Reading music while it plays. -->
    <string name="activities_music_badge_read_listen">Czytaj i słuchaj</string>
    <!-- Tapping a rhythm in time with the beat. -->
    <string name="activities_music_badge_tap_along">Stukaj w rytm</string>
    <!-- A note name read aloud, like "F sharp". -->
    <string name="activities_music_note_sharp">%1$s z krzyżykiem</string>
    <!-- A note name read aloud, like "E flat". -->
    <string name="activities_music_note_flat">%1$s z bemolem</string>
    <!-- A chord's name: its root note, then the chord's kind, like "C major". -->
    <string name="activities_music_chord_major">%1$s-dur</string>
    <string name="activities_music_chord_minor">%1$s molowy</string>
    <string name="activities_music_chord_augmented">%1$s zwiększony</string>
    <string name="activities_music_chord_diminished">%1$s zmniejszony</string>
    <string name="activities_music_chord_dominant7">%1$s septymowy dominantowy</string>
    <string name="activities_music_chord_major7">%1$s durowy z septymą wielką</string>
    <string name="activities_music_chord_minor7">%1$s molowy z septymą małą</string>
    <!-- The title while the notes to find are only heard, not named. -->
    <string name="activities_music_by_ear">Ze słuchu</string>
    <!-- How many notes the target has, like "2 notes". -->
    <plurals name="activities_music_note_count">
        <item quantity="one">%d dźwięk</item>
        <item quantity="few">%d dźwięki</item>
        <item quantity="many">%d dźwięków</item>
        <item quantity="other">%d dźwięku</item>
    </plurals>
    <!-- Nothing is pressed on the instrument. -->
    <string name="activities_music_no_notes">Nie wybrano jeszcze dźwięków</string>
    <!-- For TalkBack: the notes the instrument plays now, like "On the keys: C, E flat, G". -->
    <string name="activities_music_on_the_keys">Na klawiszach: %1$s</string>
    <!-- Plays the chord or notes to find by ear. -->
    <string name="activities_music_play_sound">Odtwórz dźwięk</string>
    <!-- Plays the notes on the keys. -->
    <string name="activities_music_hear_it">Posłuchaj</string>
    <!-- On a screen to find a sound by ear: shows the sound's notes as text instead, for the rest of the day. -->
    <string name="activities_music_cant_listen_now">Pokaż nazwy dźwięków</string>
    <!-- After "I can't listen now": goes back to finding sounds by ear. -->
    <string name="activities_music_can_listen_now">Wróć do ćwiczeń ze słuchu</string>
    <!-- The notes the sound plays, as text, like "The sound plays: C, G". -->
    <string name="activities_music_sound_notes">Odtwarzane dźwięki: %1$s</string>
    <!-- Under an instrument when the device couldn't play sound. -->
    <string name="activities_music_sound_unavailable">Nie udało się odtworzyć dźwięku. Nadal możesz zobaczyć wszystkie nuty.</string>
    <!-- For TalkBack: the piano keyboard's name. -->
    <string name="activities_music_piano_keys">Klawisze pianina</string>
    <!-- For TalkBack: the checked piano keyboard, its lowest and highest notes, then the notes the learner pressed, like "A piano keyboard from C to B. Pressed: C, E flat, G." -->
    <string name="activities_music_piano_pressed">Klawiatura pianina od %1$s do %2$s. Naciśnięte klawisze: %3$s.</string>
    <!-- For TalkBack: the checked piano keyboard, its lowest and highest notes, when the learner pressed no key, like "A piano keyboard from C to B. Nothing pressed." -->
    <string name="activities_music_piano_nothing_pressed">Klawiatura pianina od %1$s do %2$s. Nie naciśnięto żadnego klawisza.</string>
    <!-- For TalkBack: the guitar neck's name. -->
    <string name="activities_music_guitar_strings">Struny gitary</string>
    <!-- Above a guitar shape that plays the chord on the keys. -->
    <string name="activities_music_same_chord_guitar">Ten sam akord na gitarze</string>
    <!-- Above a guitar shape that plays the notes on the keys. -->
    <string name="activities_music_same_notes_guitar">Te same dźwięki na gitarze</string>
    <!-- Above a guitar shape that plays the right notes, after the check. -->
    <string name="activities_music_answer_on_guitar">Tak można zagrać poprawne dźwięki</string>
    <!-- Under the piano when the pressed notes can't be played as one guitar shape. -->
    <string name="activities_music_no_hand_shape">Tych dźwięków nie da się zagrać na gitarze jednym chwytem.</string>
    <!-- Moves the guitar neck's window toward the nut. -->
    <string name="activities_music_lower_frets">Pokaż niższe progi</string>
    <!-- Moves the guitar neck's window up the neck. -->
    <string name="activities_music_higher_frets">Pokaż wyższe progi</string>
    <!-- Which frets of the guitar neck show, like "Frets 1 to 4". -->
    <string name="activities_music_frets">Progi od %1$d do %2$d</string>
    <!-- The thickest guitar string, read aloud. -->
    <string name="activities_music_string_low_e">Basowa struna E</string>
    <!-- The thinnest guitar string, read aloud. -->
    <string name="activities_music_string_high_e">Wiolinowa struna E</string>
    <!-- A guitar string named by its open note, like "A string". -->
    <string name="activities_music_string">Struna %1$s</string>
    <!-- A guitar string left silent (muted). -->
    <string name="activities_music_not_played">Wyciszona</string>
    <!-- A guitar string played open, with the note it sounds, like "Open, D". -->
    <string name="activities_music_open_string">Pusta, %1$s</string>
    <!-- A fret on a guitar string, with the note it sounds, like "Fret 3, G". -->
    <string name="activities_music_fret">Próg %1$d, %2$s</string>
    <!-- For TalkBack: one string of a guitar shape, like "A string: Fret 3, C". -->
    <string name="activities_music_string_position">%1$s: %2$s</string>
    <!-- The title of a melody that has none. -->
    <string name="activities_music_melody">Melodia</string>
    <!-- For TalkBack: the choice between showing the music as a staff or as guitar tab. -->
    <string name="activities_music_show_as">Wybierz sposób zapisu muzyki</string>
    <!-- Music written on the five-line staff. -->
    <string name="activities_music_staff">Pięciolinia</string>
    <!-- Guitar tablature: music written as fret numbers on the guitar's strings. -->
    <string name="activities_music_tab">Tabulatura</string>
    <string name="activities_music_play_melody">Odtwórz melodię</string>
    <!-- Stops the melody playing. -->
    <string name="activities_music_stop">Zatrzymaj</string>
    <!-- Which bar of the melody is playing, like "Bar 2 of 4". -->
    <string name="activities_music_bar_of">Takt %1$d z %2$d</string>
    <!-- How many bars the melody has, like "4 bars". -->
    <plurals name="activities_music_bars">
        <item quantity="one">%d takt</item>
        <item quantity="few">%d takty</item>
        <item quantity="many">%d taktów</item>
        <item quantity="other">%d taktu</item>
    </plurals>
    <!-- For TalkBack: the tempo menu with its choice, like "Tempo: 80 bpm". -->
    <string name="activities_music_tempo">Tempo: %1$s</string>
    <!-- Beats per minute, like "80 bpm". -->
    <string name="activities_music_bpm">%1$d bpm</string>
    <!-- For TalkBack: one bar of the melody and its notes, like "Bar 1: E, E, F, G." -->
    <string name="activities_music_bar_notes">Takt %1$d: %2$s.</string>
    <!-- The rhythm's tempo while one round plays, like "90 bpm · Round 1 of 2". -->
    <string name="activities_music_rhythm_round">%1$d bpm · Runda %2$d z %3$d</string>
