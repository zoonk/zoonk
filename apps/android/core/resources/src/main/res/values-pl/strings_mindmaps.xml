        <item quantity="one">%d rozdział</item>
        <item quantity="few">%d rozdziały</item>
        <item quantity="many">%d rozdziałów</item>
        <item quantity="other">%d rozdziałów</item>
    </plurals>
    <!-- A mind map tile's caption over the chapter's title. -->
    <string name="mindmaps_chapter_number">Rozdział %1$s</string>
    <string name="mindmaps_empty_title">Nie masz jeszcze map myśli</string>
    <string name="mindmaps_empty_description">Ukończ rozdział, by powstała jego mapa myśli: najważniejsze treści na jednym obrazku.</string>
