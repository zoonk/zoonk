<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="mock_chooser_title">Podejdź do egzaminu próbnego</string>
    <string name="mock_chooser_line">Limit czasu jak na prawdziwym egzaminie. Wynik zobaczysz na końcu.</string>
    <string name="mock_chooser_start">Zacznij</string>
    <string name="mock_chooser_one_subject">Jeden przedmiot</string>
    <!-- The group of options that take all or part of the exam, above mock_chooser_one_subject. -->
    <string name="mock_chooser_the_exam">Egzamin</string>
    <!-- An option for one exam day, on an exam held over several days. -->
    <string name="mock_chooser_day">Dzień %1$d</string>
    <!-- An option for half of one exam day, on an exam held over several days. -->
    <string name="mock_chooser_half_day">Połowa dnia %1$d</string>
    <string name="mock_chooser_full_exam">Cały egzamin</string>
    <string name="mock_chooser_half_exam">Połowa egzaminu</string>
    <!-- An exam day's option that leaves out tests the learner hasn't picked an option for yet. %1$d is the day's number; %2$s lists the tests, such as "Foreign language". -->
    <string name="mock_chooser_day_without">Dzień %1$d, bez: %2$s</string>
    <!-- The whole exam's option that leaves out tests the learner hasn't picked an option for yet. %1$s lists them, such as "Specialty knowledge (P3)". -->
    <string name="mock_chooser_full_exam_without">Cały egzamin, bez: %1$s</string>
    <!-- Under an option: the mock exam leaves out the exam's written part. -->
    <string name="mock_chooser_no_written_part">Bez części pisemnej</string>
    <!-- A mock exam's size in a row: %1$d questions; %2$s is a duration, such as "4 hr 42 min". -->
    <plurals name="mock_chooser_option_size">
        <item quantity="one">%1$d pytanie · %2$s</item>
        <item quantity="few">%1$d pytania · %2$s</item>
        <item quantity="many">%1$d pytań · %2$s</item>
        <item quantity="other">%1$d pytań · %2$s</item>
    </plurals>
    <!-- PluralsCandidate: %1$d names which exam day it is, not a count. -->
    <string name="mock_chooser_not_enough">Nie ma jeszcze dość pytań na ten egzamin. Wybierz inny.</string>
    <string name="mock_chooser_failed">Nie udało nam się rozpocząć egzaminu próbnego. Spróbuj ponownie.</string>
    <string name="mock_chooser_short_title">Rozpocząć krótszy egzamin próbny?</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
