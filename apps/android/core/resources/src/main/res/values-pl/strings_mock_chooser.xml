    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_month">Ten egzamin ma dziś %1$s z %2$s pytań, czyli około %3$s na rozwiązanie. Pełną wersję możesz rozwiązać w przyszłym miesiącu.</string>
    <!-- %1$s and %2$s are numbers of questions; %3$s is a duration, such as "40 min". -->
    <string name="mock_chooser_short_line">Ten egzamin ma dziś %1$s z %2$s pytań, czyli około %3$s na rozwiązanie.</string>
    <string name="mock_chooser_pick_another">Wybierz inny</string>
    <string name="mock_chooser_preparing">Przygotowujemy twój egzamin próbny…</string>
    <string name="mock_chooser_preparing_detail">Przygotowujemy dla ciebie pytania podobne do tych na egzaminie. Egzamin próbny rozpocznie się tutaj, gdy tylko będą gotowe.</string>
    <string name="mock_chooser_writing">Przygotowujemy twój egzamin próbny</string>
    <string name="mock_chooser_writing_questions">Przygotowujemy pytania takie jak na egzaminie</string>
    <string name="mock_chooser_writing_questions_line">Wybieramy tematy pytań z każdego przedmiotu…</string>
