<resources>
    <!-- The name of the app's notification channel in Android's settings. -->
    <string name="reminders_channel_name">Przypomnienia o nauce</string>
    <string name="reminders_channel_description">Jedno przypomnienie w dni nauki, jeśli zostało ci jeszcze coś do nauki.</string>
    <!-- A card under a finished lesson's result, offering a daily study reminder on the phone. -->
    <string name="reminders_offer_title">Przypomnieć ci o nauce?</string>
    <!-- %1$s is a time of day, such as "7:00 PM". -->
    <string name="reminders_offer_body">O %1$s w dni nauki, jeśli zostało ci jeszcze coś do nauki.</string>
    <string name="reminders_remind_me">Przypomnij mi</string>
    <!-- Declines the offer. Keep it neutral and ungendered, like "Not now" (Portuguese: "Agora não"). -->
    <string name="reminders_no_thanks">Nie, dziękuję</string>
    <!-- After the learner said yes to reminders on the phone. -->
    <string name="reminders_on">Przypomnienia są włączone.</string>
    <!-- After the learner chose email reminders instead. -->
    <string name="reminders_email_on">Przypomnienia e-mail są włączone.</string>
    <string name="reminders_turn_on_failed">Nie udało się włączyć przypomnień. Spróbuj ponownie.</string>
    <!-- Android blocks Zoonk's notifications, so the phone can't show reminders. -->
    <string name="reminders_notifications_off">Powiadomienia Zoonka są wyłączone.</string>
    <!-- Opens Android's notification settings for Zoonk. -->
    <string name="reminders_open_settings">Otwórz ustawienia</string>
    <!-- Turns on email reminders when the phone's notifications are off. -->
    <string name="reminders_email_instead">Przypominaj mi e-mailem</string>
    <!-- Before Android asks to allow notifications again, after the learner said no once. -->
    <string name="reminders_permission_title">Zezwolić na powiadomienia?</string>
    <string name="reminders_permission_body">Zoonk wysyła jedno przypomnienie w dni nauki, tylko jeśli zostało ci jeszcze coś do nauki.</string>
    <string name="reminders_permission_continue">Kontynuuj</string>
    <string name="reminders_not_now">Nie teraz</string>
    <!-- The row that shows the reminder's time and opens a clock to change it, and that clock's title. -->
    <string name="reminders_time_title">Godzina przypomnienia</string>
    <string name="reminders_save">Zapisz</string>
    <string name="reminders_cancel">Anuluj</string>
    <!-- The row in Preferences that opens the reminders page. -->
    <string name="reminders_row">Przypomnienia o nauce</string>
    <!-- The reminders page in Settings. -->
    <string name="reminders_title">Przypomnienia</string>
    <string name="reminders_description">Jedno przypomnienie dziennie, tylko jeśli zostało ci jeszcze coś do nauki.</string>
    <string name="reminders_time">Czas</string>
    <!-- %1$s is a time of day and %2$s its time zone, such as "7:00 PM, Brasilia Time". -->
    <string name="reminders_time_in_zone">%1$s, %2$s</string>
    <string name="reminders_email">E-mail</string>
    <!-- Guests have no email address yet. -->
    <string name="reminders_email_needs_account">Utwórz konto, aby dostawać przypomnienia e-mail</string>
    <string name="reminders_push">Powiadomienia</string>
    <!-- Push reminders go to another of the learner's phones; this one can take over. -->
    <string name="reminders_use_this_phone">Użyj tego telefonu</string>
    <!-- Under the settings; "your plans" opens the plan, which sets the study days. -->
    <string name="reminders_study_days">W dni nauki ustalone w twoich planach</string>
    <string name="reminders_quiet">Wstrzymane na czas twojej przerwy. Wrócą, gdy znów zaczniesz się uczyć.</string>
    <string name="reminders_save_failed">Nie udało się zapisać. Spróbuj ponownie.</string>
</resources>
