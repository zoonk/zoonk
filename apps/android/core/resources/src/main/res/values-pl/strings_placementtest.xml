<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="placementtest_title">Sprawdź swoją wiedzę</string>
    <string name="placementtest_skip_lessons">Pomiń lekcje, które już znasz</string>
    <string name="placementtest_level_title">Test poziomujący</string>
    <string name="placementtest_find_level">Sprawdź swój poziom i pomiń to, co już znasz</string>
    <string name="placementtest_in_progress">W trakcie</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Nie pominięto żadnej lekcji</string>
    <!-- The title after a placement test: how many lessons it took out of the plan. -->
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">Pominięto %d lekcję</item>
        <item quantity="few">Pominięto %d lekcje</item>
        <item quantity="many">Pominięto %d lekcji</item>
        <item quantity="other">Pominięto %d lekcji</item>
    </plurals>
    <!-- A CEFR level range the test found for reading, such as “B1–B2”. -->
    <string name="placementtest_reading_range">Czytanie %1$s</string>
    <!-- A CEFR level range the test found for listening, such as “B1–B2”. -->
    <string name="placementtest_listening_range">Słuchanie %1$s</string>
    <string name="placementtest_start_title">Pomiń to, co już znasz</string>
    <string name="placementtest_choose_description">Test wskaże lekcje, które możesz pominąć.</string>
    <string name="placementtest_about">Około %1$s</string>
    <!-- A short test of one language level, such as “Test out of B2”. -->
    <string name="placementtest_test_out">Sprawdź, czy możesz pominąć %1$s</string>
    <string name="placementtest_test_out_description">Pomiń %1$s, jeśli już go znasz</string>
    <string name="placementtest_start">Zacznij</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Już to znasz. Nadal będzie w twoich powtórkach.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Już je znasz. Nadal będą w twoich powtórkach.</string>
    <string name="placementtest_retake_tomorrow">Dziś cofnięto te odpowiedzi. Odpowiedz na nie ponownie jutro, żeby pominąć te lekcje.</string>
    <string name="placementtest_up_next">Następne</string>
    <string name="placementtest_done">Gotowe</string>
    <string name="placementtest_not_now">Nie teraz</string>
    <string name="placementtest_your_level">Twój poziom: %1$s</string>
    <string name="placementtest_keeps_adjusting">Lekcje na bieżąco dostosowują się do twoich odpowiedzi.</string>
    <string name="placementtest_level_stays">Poziom %1$s zostaje w twoim planie</string>
    <string name="placementtest_test_out_unavailable">Na razie nie ma wystarczającej liczby pytań dla poziomu %1$s.</string>
    <string name="placementtest_offer_title">Wygląda na to, że to dla ciebie łatwe</string>
    <string name="placementtest_offer_quick">Szybki test pozwoli pominąć lekcje, które już znasz.</string>
    <string name="placementtest_offer_level">Krótki test pozwoli pominąć %1$s, jeśli już go znasz.</string>
    <string name="placementtest_where_to_start">Od czego chcesz zacząć?</string>
    <string name="placementtest_first_lesson">Pierwsza lekcja</string>
    <!-- The most questions a test asks. It can end sooner. -->
    <plurals name="placementtest_up_to_questions">
        <item quantity="one">Maksymalnie %d pytanie</item>
        <item quantity="few">Maksymalnie %d pytania</item>
        <item quantity="many">Maksymalnie %d pytań</item>
        <item quantity="other">Maksymalnie %d pytania</item>
    </plurals>
    <string name="placementtest_finish_later">Dokończ później</string>
    <string name="placementtest_start_lesson">Zacznij lekcję</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="one">Pominięto %d lekcję, którą już znasz.</item>
        <item quantity="few">Pominięto %d lekcje, które już znasz.</item>
        <item quantity="many">Pominięto %d lekcji, które już znasz.</item>
        <item quantity="other">Pominięto %d lekcji, które już znasz.</item>
    </plurals>
    <!-- On a level test's result when listening wasn't tested, such as after the learner said they can't listen now. -->
    <string name="placementtest_take_again_later">Możesz później ponownie podejść do testu z poziomu planu.</string>
    <string name="placementtest_not_tested">Jeszcze nie sprawdzono</string>
    <!-- The name of a course's placement test, on the card that offers it. -->
    <string name="placementtest_test">Test</string>
    <!-- Over the name of the chapter a course's placement test starts the learner in. -->
    <string name="placementtest_you_start_here">Zaczynasz tutaj</string>
    <!-- Under a picture of a course, after a placement test: how many of the course's lessons the test skipped, out of all of them. -->
    <plurals name="placementtest_course_skipped">
        <item quantity="one">Pominięto %1$d z %2$d lekcji</item>
        <item quantity="few">Pominięto %1$d z %2$d lekcji</item>
        <item quantity="many">Pominięto %1$d z %2$d lekcji</item>
        <item quantity="other">Pominięto %1$d z %2$d lekcji</item>
    </plurals>
    <plurals name="placementtest_course_lessons">
        <item quantity="one">%d lekcja</item>
        <item quantity="few">%d lekcje</item>
        <item quantity="many">%d lekcji</item>
        <item quantity="other">%d lekcji</item>
    </plurals>
</resources>
