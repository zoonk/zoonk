<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The plan's row and the screen's name for the test of what the learner already knows in a course. -->
    <string name="placementtest_title">Sprawdź swoją wiedzę</string>
    <string name="placementtest_skip_lessons">Pomiń lekcje, które już znasz</string>
    <!-- The plan's row and the screen's name for a language course's test. -->
    <string name="placementtest_level_title">Test poziomujący</string>
    <string name="placementtest_find_level">Sprawdź swój poziom i pomiń to, co już znasz</string>
    <string name="placementtest_in_progress">W trakcie</string>
    <!-- A fact on the plan's test row, and the title after a test: how many lessons it took out of the plan. -->
    <string name="placementtest_no_lessons_skipped">Nie pominięto żadnej lekcji</string>
    <plurals name="placementtest_lessons_skipped">
        <item quantity="one">Pominięto %d lekcję</item>
        <item quantity="few">Pominięto %d lekcje</item>
        <item quantity="many">Pominięto %d lekcji</item>
        <item quantity="other">Pominięto %d lekcji</item>
    </plurals>
    <!-- A CEFR level range the test found for reading; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_reading_range">Czytanie %1$s</string>
    <!-- A CEFR level range the test found for listening; %1$s is a range such as "B1–B2". -->
    <string name="placementtest_listening_range">Słuchanie %1$s</string>
    <string name="placementtest_start_title">Pomiń to, co już znasz</string>
    <string name="placementtest_choose_description">Test wskaże lekcje, które możesz pominąć.</string>
    <!-- The short test: about six minutes of questions. -->
    <string name="placementtest_quick">Szybki test</string>
    <!-- %1$s is a duration with its unit, such as "4 min". -->
    <string name="placementtest_about">Około %1$s</string>
    <!-- A short test of one language level, such as "Test out of B2". -->
    <string name="placementtest_test_out">Sprawdź, czy możesz pominąć %1$s</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_description">Pomiń %1$s, jeśli już go znasz</string>
    <string name="placementtest_start">Zacznij</string>
    <string name="placementtest_continue_title">Kontynuuj test</string>
    <string name="placementtest_keep_going">Kontynuuj</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_one">Już to znasz. Nadal będzie w twoich powtórkach.</string>
    <!-- After a test: "it" or "them" is the lessons the test skipped. They stay in the learner's practice reviews. -->
    <string name="placementtest_known_other">Już je znasz. Nadal będą w twoich powtórkach.</string>
    <string name="placementtest_plan_stays">Twój plan pozostaje bez zmian.</string>
    <string name="placementtest_retake_tomorrow">Dziś cofnięto te odpowiedzi. Odpowiedz na nie ponownie jutro, żeby pominąć te lekcje.</string>
    <!-- Over the topic the plan goes on with after the test. -->
    <string name="placementtest_up_next">Następne</string>
    <string name="placementtest_done">Gotowe</string>
    <string name="placementtest_not_now">Nie teraz</string>
    <!-- %1$s is a language's name, such as "Italian". -->
    <string name="placementtest_your_level">Twój poziom: %1$s</string>
    <string name="placementtest_keeps_adjusting">Lekcje na bieżąco dostosowują się do twoich odpowiedzi.</string>
    <!-- After a level test-out that skipped nothing; %1$s is a language level, such as "B2". -->
    <string name="placementtest_level_stays">Poziom %1$s zostaje w twoim planie</string>
    <!-- A level test-out whose level has too few questions to test yet; %1$s is a language level, such as "B2". -->
    <string name="placementtest_test_out_unavailable">Na razie nie ma wystarczającej liczby pytań dla poziomu %1$s.</string>
    <!-- A lesson's end, after a run of easy lessons. -->
    <string name="placementtest_offer_title">Wygląda na to, że to dla ciebie łatwe</string>
    <string name="placementtest_offer_quick">Szybki test pozwoli pominąć lekcje, które już znasz.</string>
    <!-- %1$s is a language level, such as "B2". -->
    <string name="placementtest_offer_level">Krótki test pozwoli pominąć %1$s, jeśli już go znasz.</string>
    <string name="placementtest_where_to_start">Od czego chcesz zacząć?</string>
    <string name="placementtest_first_lesson">Pierwsza lekcja</string>
    <string name="placementtest_first_lesson_line">Zaczyna od podanego przez ciebie poziomu</string>
    <!-- The long test: it checks every topic still ahead, in parts. -->
    <string name="placementtest_full_test">Pełny test</string>
    <!-- How many parts the long test has. The learner can take each part on a different day. -->
    <plurals name="placementtest_parts_any_day">
        <item quantity="one">%d część, w dowolnie wybranym dniu</item>
        <item quantity="few">%d części, w dowolnie wybranym dniu</item>
        <item quantity="many">%d części, w dowolnie wybranym dniu</item>
        <item quantity="other">%d części, w dowolnie wybranym dniu</item>
    </plurals>
    <plurals name="placementtest_questions">
        <item quantity="one">%d pytanie</item>
        <item quantity="few">%d pytania</item>
        <item quantity="many">%d pytań</item>
        <item quantity="other">%d pytania</item>
    </plurals>
    <!-- Where the learner is in a test split into parts, such as “Part 3 of 14”. -->
    <string name="placementtest_part_of">Część %1$d z %2$d</string>
    <!-- The title after one part of a test split into parts, such as “Part 3 of 14 done”. -->
    <string name="placementtest_part_done" tools:ignore="PluralsCandidate">Ukończono część %1$d z %2$d</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <string name="placementtest_part_skipped_none">W tej części nie pominięto żadnych lekcji.</string>
    <!-- After one part of a test: how many lessons that part took out of the learner's plan. -->
    <plurals name="placementtest_part_skipped">
        <item quantity="one">W tej części pominięto %d lekcję, którą już znasz.</item>
        <item quantity="few">W tej części pominięto %d lekcje, które już znasz.</item>
        <item quantity="many">W tej części pominięto %d lekcji, które już znasz.</item>
        <item quantity="other">W tej części pominięto %d lekcji, które już znasz.</item>
    </plurals>
    <!-- How many parts of a test the learner still has to take. -->
    <plurals name="placementtest_parts_left">
        <item quantity="one">%d część do zrobienia</item>
        <item quantity="few">%d części do zrobienia</item>
        <item quantity="many">%d części do zrobienia</item>
        <item quantity="other">%d części do zrobienia</item>
    </plurals>
    <string name="placementtest_finish_later">Dokończ później</string>
    <!-- Where a learner who stopped a test picks it up: the part of the test and the question in it. -->
    <string name="placementtest_next_time">Następnym razem: część %1$d z %2$d, pytanie %3$d</string>
    <string name="placementtest_start_lesson">Zacznij lekcję</string>
    <!-- Button after the short test: goes on to test the rest of the course, in parts. -->
    <string name="placementtest_test_the_rest">Przetestuj resztę</string>
    <plurals name="placementtest_lessons_you_know">
        <item quantity="one">Pominięto %d lekcję, którą już znasz.</item>
        <item quantity="few">Pominięto %d lekcje, które już znasz.</item>
        <item quantity="many">Pominięto %d lekcji, które już znasz.</item>
        <item quantity="other">Pominięto %d lekcji, które już znasz.</item>
    </plurals>
    <string name="placementtest_listening_later">Słuchanie możesz sprawdzić później, w swoim planie.</string>
    <string name="placementtest_not_tested">Jeszcze nie sprawdzono</string>
    <string name="placementtest_about_left">Około %1$s do końca</string>
</resources>
