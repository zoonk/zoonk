    <string name="focustest_many_unknown">Większość tego materiału jest dla ciebie nowa? To w porządku. Możesz tu przerwać i zacząć naukę.</string>
    <string name="focustest_answers_saved_title">Twoje odpowiedzi są zapisane</string>
    <!-- The test's result: the exam subjects that need the most study time, most needed first. -->
    <string name="focustest_result_title">Oto twoje priorytety</string>
    <string name="focustest_result_description">Na podstawie twoich odpowiedzi i tego, co najbardziej liczy się na egzaminie. Priorytety nie wykluczają żadnego przedmiotu z planu.</string>
