    <string name="focustest_find_start">Sprawdź, od czego zacząć</string>
    <string name="focustest_offer_description_focus">Krótkie pytania z przedmiotów egzaminacyjnych. Twój plan pomija to, co już znasz, więc czas nauki poświęcasz temu, czego najbardziej potrzebujesz.</string>
    <string name="focustest_offer_description">Krótkie pytania z przedmiotów egzaminacyjnych. Twój plan pomija to, co już znasz.</string>
    <string name="focustest_how_it_works">Jak to działa</string>
    <string name="focustest_how_weight_title">Najpierw to, co liczy się najbardziej</string>
    <string name="focustest_how_weight">Test zaczyna się od przedmiotów, które mają największy wpływ na twój wynik egzaminu.</string>
    <string name="focustest_how_grade_title">Bez ocen</string>
    <string name="focustest_how_grade">„Jeszcze nie wiem” to dobra odpowiedź.</string>
    <string name="focustest_how_stop_title">Możesz przerwać w każdej chwili</string>
    <string name="focustest_how_stop">Zapisujemy każdą odpowiedź.</string>
