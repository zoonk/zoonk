        <item quantity="many">Twój plan pomija też %d lekcji o tym, co już znasz.</item>
        <item quantity="other">Twój plan pomija też %d lekcji o tym, co już znasz.</item>
    </plurals>
    <!-- The test's result when it suggests no subjects to focus on: where the plan starts. -->
    <string name="focustest_starting_point_title">Twój punkt wyjścia jest ustalony</string>
    <plurals name="focustest_lessons_skipped">
        <item quantity="one">Twój plan pomija %d lekcję, którą już znasz.</item>
        <item quantity="few">Twój plan pomija %d lekcje, które już znasz.</item>
        <item quantity="many">Twój plan pomija %d lekcji, które już znasz.</item>
        <item quantity="other">Twój plan pomija %d lekcji, które już znasz.</item>
    </plurals>
    <string name="focustest_from_basics">W twoim planie każdy przedmiot zaczyna się od podstaw.</string>
    <string name="focustest_result_current">Twój plan przeznacza więcej czasu na te przedmioty.</string>
    <string name="focustest_result_hand_picked">Twój plan zachowuje wybrane przez ciebie priorytety. Oto, co proponuje test.</string>
    <!-- The learner answered “Not now” to giving these subjects more time, or undid it. -->
    <string name="focustest_result_declined">Twój plan pozostał bez zmian. Oto, co proponuje test.</string>
    <string name="focustest_change_focus">Zmień priorytety</string>
    <!-- Opens the list of every exam subject with how its Focus test questions went. -->
    <string name="focustest_see_all_subjects">Zobacz wszystkie przedmioty</string>
    <string name="focustest_subjects">Przedmioty</string>
    <!-- Label of an on/off switch on the Focus test's result: the test's questions keep coming, a few at a time, in the learner's lessons. -->
    <string name="focustest_session_questions">Zadawaj mi kilka dodatkowych pytań podczas nauki</string>
    <string name="focustest_session_questions_when">W pierwszym tygodniu nauki</string>
    <string name="focustest_done">Gotowe</string>
    <!-- Button on the Focus test's result: continues the test with more questions. -->
    <string name="focustest_answer_more">Odpowiedz na więcej pytań</string>
    <!-- Headline, above a short list of exam subjects: asks the learner whether their study plan should give those subjects more time. -->
    <string name="focustest_proposal_title">Przeznaczyć więcej czasu na te przedmioty?</string>
    <!-- How the Focus test picked the subjects listed below it: from the learner's answers to its questions and how many of the exam's questions each subject has. -->
    <string name="focustest_proposal_picked">Wybrane na podstawie twoich odpowiedzi i tego, ile pytań z każdego przedmiotu jest na egzaminie.</string>
    <string name="focustest_update_plan">Zaktualizuj mój plan</string>
    <string name="focustest_proposal_applied">Twój plan przeznacza teraz więcej czasu na te przedmioty.</string>
    <string name="focustest_proposal_declined">Twój plan pozostaje bez zmian.</string>
    <string name="focustest_proposal_undone">Cofnięto. Twój plan jest znów taki jak wcześniej.</string>
    <string name="focustest_undo">Cofnij</string>
    <!-- A short fact beside a subject in a list: every answer the learner gave on it was “I don't know yet”. It is not a grade. -->
    <string name="focustest_not_known_yet">Jeszcze nieznane</string>
    <!-- %1$d answers right of %2$d asked on one subject. -->
    <plurals name="focustest_subject_right">
        <item quantity="one">%1$d z %2$d poprawnie</item>
        <item quantity="few">%1$d z %2$d poprawnie</item>
        <item quantity="many">%1$d z %2$d poprawnie</item>
        <item quantity="other">%1$d z %2$d poprawnie</item>
    </plurals>
