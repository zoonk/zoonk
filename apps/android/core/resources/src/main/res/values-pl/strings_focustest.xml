    <string name="focustest_listening_not_checked">Słuchanie: poza zakresem tego testu</string>
    <string name="focustest_speaking_not_checked">Mówienie: poza zakresem tego testu</string>
    <string name="focustest_practical_not_checked">Część praktyczna: poza zakresem tego testu</string>
    <string name="focustest_in_progress">W trakcie</string>
    <string name="focustest_see_your_result">Zobacz swój wynik</string>
    <!-- Link that opens the Focus test, for a learner who has not taken it. -->
    <string name="focustest_take_test">Rozwiąż Test priorytetów</string>
    <string name="focustest_suggestion_line">Test priorytetów pokazuje, którym przedmiotom poświęcić najwięcej czasu.</string>
    <!-- %1$s is a duration with its unit, such as "15 min". -->
    <string name="focustest_suggestion_body">Test priorytetów trwający %1$s pokazuje, co już wiesz, dzięki czemu więcej czasu poświęcasz temu, czego najbardziej potrzebujesz. Żaden przedmiot nie zostaje usunięty z planu.</string>
    <!-- After "Not now" on Today's suggestion: it won't be suggested again. -->
    <string name="focustest_suggestion_dismissed">Jasne. Możesz rozwiązać test w swoim planie.</string>
    <string name="focustest_not_today">Pomiń na dziś</string>
    <string name="focustest_not_today_failed">Nie udało się zapisać. Spróbuj ponownie.</string>
