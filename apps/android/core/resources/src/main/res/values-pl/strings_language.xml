<resources>
    <!-- A unit's place and its levels: "Unit 3 · A1–A2". -->
    <string name="language_unit_eyebrow">Dział %1$s · %2$s</string>
    <plurals name="language_unit_lessons">
        <item quantity="one">%d lekcja</item>
        <item quantity="few">%d lekcje</item>
        <item quantity="many">%d lekcji</item>
        <item quantity="other">%d lekcji</item>
    </plurals>
    <!-- How much of the unit is done, the unit being the subject: "33% done". -->
    <string name="language_unit_done_share">Ukończono %1$s</string>
    <string name="language_unit_start">Zacznij</string>
    <string name="language_unit_continue">Kontynuuj</string>
    <string name="language_unit_objectives">Po ukończeniu tego działu</string>
    <string name="language_unit_progress">Postępy</string>
    <string name="language_unit_practice">Ćwicz</string>
    <string name="language_unit_mistakes">Twoje błędy</string>
    <!-- Heading over material to look things up in, such as grammar tips and words, rather than lessons to do. -->
    <string name="language_unit_reference">Materiały pomocnicze</string>
    <string name="language_unit_grammar_tips">Wskazówki gramatyczne</string>
    <string name="language_unit_words">Słowa z tego działu</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s i jeszcze %2$s</string>
    <string name="language_unit_summary">Podsumowanie działu</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">O tym dziale</string>
    <string name="language_skill_reading">Czytanie</string>
    <string name="language_skill_listening">Słuchanie</string>
    <string name="language_skill_speaking">Mówienie</string>
    <string name="language_skill_words">Słownictwo</string>
    <string name="language_skill_writing">Pisanie</string>
    <!-- Heads the learner's level in each skill (reading, listening, speaking, writing), on the CEFR scale from A1 to C2. -->
    <string name="language_level_by_skill">Poziomy umiejętności</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">Cel: %1$s na %2$s</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">Cel: %1$s</string>
    <!-- What TalkBack says for a skill's row: "Reading, B1". -->
    <string name="language_skill_level">%1$s, %2$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Reading, B1, up since the level test". -->
    <string name="language_skill_level_trend">%1$s, %2$s, %3$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">wyżej niż w teście poziomującym</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">niżej niż w teście poziomującym</string>
    <string name="language_levels_move">Gdy ćwiczysz, poziomy się zmieniają. Co tydzień lepiej oddają twoje umiejętności.</string>
    <!-- One skill rose: "Speaking went up to B1 since the level test." -->
    <string name="language_level_rose">%1$s: od testu poziomującego poziom wzrósł do %2$s.</string>
    <!-- The count is how many skills rose, always two or more; %1$s lists them: "Speaking and Writing went up since the level test." -->
    <plurals name="language_levels_rose">
        <item quantity="one">Od testu poziomującego wzrósł poziom tych umiejętności: %1$s.</item>
        <item quantity="few">Od testu poziomującego wzrósł poziom tych umiejętności: %1$s.</item>
        <item quantity="many">Od testu poziomującego wzrósł poziom tych umiejętności: %1$s.</item>
        <item quantity="other">Od testu poziomującego wzrósł poziom tych umiejętności: %1$s.</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">Potrafię już…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">Jeszcze nie</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s, cel: %2$s</string>
    <string name="language_pattern_noticed">Zauważyliśmy powtarzający się błąd</string>
    <string name="language_pattern_typos">To tylko literówki</string>
    <string name="language_pattern_typos_description">Twoje ostatnie błędy to drobne pomyłki, a nie braki w znajomości zasad.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">Powiedz ponownie %d słowo</item>
        <item quantity="few">Powiedz ponownie %d słowa</item>
        <item quantity="many">Powiedz ponownie %d słów</item>
        <item quantity="other">Powiedz ponownie %d słów</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">Na początek następnej nauki · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">Ćwicz, kiedy chcesz · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">Pomiń, jeśli umiesz już to czytać</string>
    <string name="language_alphabet_skip_failed">Nie udało się zapisać. Spróbuj ponownie.</string>
    <!-- Button that opens the words to say aloud again; "them" is those words. -->
    <string name="language_say_them">Powiedz je</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Otwórz</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">Zauważyliśmy powtarzający się błąd: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Poćwicz</string>
    <string name="language_level">Poziom</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, cel: %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Zobacz swój plan</string>
</resources>
