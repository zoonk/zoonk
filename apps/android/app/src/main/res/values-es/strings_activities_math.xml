    <string name="activities_math_formula_from_start">%1$s desde el principio</string>
    <!-- What a model shows, for TalkBack: the result it charts and the slider across its axis, like "Sliders and a chart of Value after 20 years across Rate per year." -->
    <string name="activities_math_formula_description">Deslizadores y un gráfico de %1$s a lo largo de %2$s.</string>
