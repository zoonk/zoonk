        <item quantity="one">%1$d de %2$d casilla: %3$s</item>
        <item quantity="many">%1$d de %2$d casillas: %3$s</item>
        <item quantity="other">%1$d de %2$d casillas: %3$s</item>
    </plurals>
    <!-- After the check, like "3 of 4 squares right". -->
    <plurals name="activities_reasoning_grid_right">
        <item quantity="one">%1$d de %2$d casilla correcta</item>
        <item quantity="many">%1$d de %2$d casillas correctas</item>
        <item quantity="other">%1$d de %2$d casillas correctas</item>
    </plurals>
