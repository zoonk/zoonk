<resources>
    <!-- How many of the goal's mind maps are drawn: "3 maps". -->
    <plurals name="mindmaps_count">
        <item quantity="one">%1$s mapa</item>
        <item quantity="many">%1$s mapas</item>
        <item quantity="other">%1$s mapas</item>
    </plurals>
    <!-- The group of mind maps when the goal's chapters have no subjects. -->
    <string name="mindmaps_chapters_finished">Capítulos que has completado</string>
    <plurals name="mindmaps_chapter_count">
        <item quantity="one">%d capítulo</item>
        <item quantity="many">%d capítulos</item>
        <item quantity="other">%d capítulos</item>
    </plurals>
    <!-- A mind map tile's caption over the chapter's title. -->
    <string name="mindmaps_chapter_number">Capítulo %1$s</string>
    <string name="mindmaps_empty_title">Aún no hay mapas mentales</string>
    <string name="mindmaps_empty_description">Completa un capítulo para crear su mapa mental: sus ideas principales en una sola imagen.</string>
    <!-- %1$s is the chapter the learner is in, %2$d the lessons left in it. -->
    <plurals name="mindmaps_first_after">
        <item quantity="one">Tu primer mapa llegará al terminar %1$s: queda %2$d lección.</item>
        <item quantity="many">Tu primer mapa llegará al terminar %1$s: quedan %2$d lecciones.</item>
        <item quantity="other">Tu primer mapa llegará al terminar %1$s: quedan %2$d lecciones.</item>
    </plurals>
    <!-- Opens the chapter whose map comes next. -->
    <string name="mindmaps_continue">Continuar</string>
    <string name="mindmaps_keep_studying">Seguir estudiando</string>
    <!-- A mind map's description for screen readers when it has no words yet. -->
    <string name="mindmaps_alt_chapter">Mapa mental de %1$s</string>
    <!-- A mind map's description for screen readers: its title, then its central idea. -->
    <string name="mindmaps_alt">Mapa mental: %1$s. %2$s</string>
    <!-- The same, for a title that already ends a sentence. -->
    <string name="mindmaps_alt_sentence">Mapa mental: %1$s %2$s</string>
    <!-- A tile for a map whose picture had mistakes, shown in words instead. -->
    <string name="mindmaps_as_text">Como texto</string>
    <string name="mindmaps_drawing">Dibujando…</string>
    <!-- Makes a chapter's mind map. -->
    <string name="mindmaps_create">Crear</string>
    <string name="mindmaps_try_again">Volver a intentarlo</string>
