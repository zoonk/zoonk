    <string name="language_unit_start">Empezar</string>
    <string name="language_unit_continue">Continuar</string>
    <string name="language_unit_objectives">Al terminar esta unidad</string>
    <!-- Heads a finished unit's list of things the learner is now able to do in the language. -->
    <string name="language_unit_can_already">Ya puedo…</string>
    <string name="language_unit_progress">Progreso</string>
    <string name="language_unit_practice">Práctica</string>
    <string name="language_unit_mistakes">Tus errores</string>
    <string name="language_unit_reference">Como referencia</string>
    <string name="language_unit_grammar_tips">Consejos de gramática</string>
    <string name="language_unit_words">Palabras de esta unidad</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s y %2$s más</string>
    <string name="language_unit_summary">Resumen de la unidad</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">Sobre esta unidad</string>
    <string name="language_skill_listening">Escucha</string>
    <string name="language_skill_speaking">Expresión oral</string>
    <string name="language_skill_words">Vocabulario</string>
    <string name="language_skill_writing">Expresión escrita</string>
    <string name="language_pattern_noticed">Hemos detectado un patrón</string>
    <string name="language_pattern_typos">Solo erratas</string>
    <string name="language_pattern_typos_description">Tus errores recientes han sido despistes, no una regla que tengas que aprender.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">Di %d palabra otra vez</item>
        <item quantity="many">Di %d palabras otra vez</item>
        <item quantity="other">Di %d palabras otra vez</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">Primero en tu próxima sesión · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">Practica cuando quieras · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">Ya sé leerlo</string>
    <string name="language_alphabet_skip_failed">No se ha guardado. Inténtalo de nuevo.</string>
    <!-- Opens the words to say again. -->
    <string name="language_say_them">Dilos</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Abrir</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">Hemos detectado un patrón: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Practícalo</string>
    <string name="language_level">Nivel</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, objetivo %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Ver tu plan</string>
