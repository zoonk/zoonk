<resources>
    <string name="activities_music_badge_play_it">Tócalo</string>
    <!-- Training the ear to recognize notes and chords by their sound. -->
    <string name="activities_music_badge_ear_training">Entrenamiento auditivo</string>
    <!-- Reading music while it plays. -->
    <string name="activities_music_badge_read_listen">Leer y escuchar</string>
    <!-- Tapping a rhythm in time with the beat. -->
    <string name="activities_music_badge_tap_along">Marcar el ritmo</string>
    <!-- A note name read aloud, like "F sharp". -->
    <string name="activities_music_note_sharp">%1$s sostenido</string>
    <!-- A note name read aloud, like "E flat". -->
    <string name="activities_music_note_flat">%1$s bemol</string>
    <!-- A chord's name: its root note, then the chord's kind, like "C major". -->
    <string name="activities_music_chord_major">%1$s mayor</string>
    <string name="activities_music_chord_minor">%1$s menor</string>
    <string name="activities_music_chord_augmented">%1$s aumentado</string>
    <string name="activities_music_chord_diminished">%1$s disminuido</string>
    <string name="activities_music_chord_dominant7">%1$s con séptima de dominante</string>
    <string name="activities_music_chord_major7">%1$s con séptima mayor</string>
    <string name="activities_music_chord_minor7">%1$s menor con séptima</string>
    <!-- The title while the notes to find are only heard, not named. -->
    <string name="activities_music_by_ear">De oído</string>
    <!-- How many notes the target has, like "2 notes". -->
    <plurals name="activities_music_note_count">
        <item quantity="one">%d nota</item>
        <item quantity="many">%d notas</item>
        <item quantity="other">%d notas</item>
    </plurals>
    <!-- Nothing is pressed on the instrument. -->
    <string name="activities_music_no_notes">Aún no hay notas</string>
    <!-- For TalkBack: the notes the instrument plays now, like "On the keys: C, E flat, G". -->
    <string name="activities_music_on_the_keys">En las teclas: %1$s</string>
    <!-- Plays the chord or notes to find by ear. -->
    <string name="activities_music_play_sound">Reproducir el sonido</string>
    <!-- Plays the notes on the keys. -->
    <string name="activities_music_hear_it">Escuchar</string>
    <!-- On a screen to find a sound by ear: shows the sound's notes as text instead, for the rest of the day. -->
    <string name="activities_music_cant_listen_now">Seguir sin sonido</string>
    <!-- After "I can't listen now": goes back to finding sounds by ear. -->
    <string name="activities_music_can_listen_now">Volver a escuchar</string>
    <!-- The notes the sound plays, as text, like "The sound plays: C, G". -->
    <string name="activities_music_sound_notes">Notas del sonido: %1$s</string>
    <!-- Under an instrument when the device couldn't play sound. -->
    <string name="activities_music_sound_unavailable">No se pudo reproducir el sonido. Aún puedes ver todas las notas.</string>
    <!-- For TalkBack: the piano keyboard's name. -->
    <string name="activities_music_piano_keys">Teclas del piano</string>
    <!-- For TalkBack: the checked piano keyboard, its lowest and highest notes, then the notes the learner pressed, like "A piano keyboard from C to B. Pressed: C, E flat, G." -->
    <string name="activities_music_piano_pressed">Un teclado de piano de %1$s a %2$s. Teclas presionadas: %3$s.</string>
    <!-- For TalkBack: the checked piano keyboard, its lowest and highest notes, when the learner pressed no key, like "A piano keyboard from C to B. Nothing pressed." -->
    <string name="activities_music_piano_nothing_pressed">Un teclado de piano de %1$s a %2$s. Ninguna tecla presionada.</string>
    <!-- For TalkBack: the guitar neck's name. -->
    <string name="activities_music_guitar_strings">Cuerdas de la guitarra</string>
    <!-- Above a guitar shape that plays the chord on the keys. -->
    <string name="activities_music_same_chord_guitar">Mismo acorde en guitarra</string>
    <!-- Above a guitar shape that plays the notes on the keys. -->
    <string name="activities_music_same_notes_guitar">Mismas notas en guitarra</string>
    <!-- Above a guitar shape that plays the right notes, after the check. -->
    <string name="activities_music_answer_on_guitar">Una forma de tocar las notas correctas</string>
    <!-- Under the piano when the pressed notes can't be played as one guitar shape. -->
    <string name="activities_music_no_hand_shape">Estas notas no se pueden tocar con una sola posición de la mano en la guitarra.</string>
    <!-- Moves the guitar neck's window toward the nut. -->
    <string name="activities_music_lower_frets">Ver trastes más bajos</string>
    <!-- Moves the guitar neck's window up the neck. -->
    <string name="activities_music_higher_frets">Ver trastes más altos</string>
    <!-- Which frets of the guitar neck show, like "Frets 1 to 4". -->
    <string name="activities_music_frets">Trastes del %1$d al %2$d</string>
    <!-- The thickest guitar string, read aloud. -->
    <string name="activities_music_string_low_e">Cuerda de mi grave</string>
    <!-- The thinnest guitar string, read aloud. -->
    <string name="activities_music_string_high_e">Cuerda de mi agudo</string>
    <!-- A guitar string named by its open note, like "A string". -->
    <string name="activities_music_string">Cuerda de %1$s</string>
    <!-- A guitar string left silent (muted). -->
    <string name="activities_music_not_played">No se toca</string>
    <!-- A guitar string played open, with the note it sounds, like "Open, D". -->
    <string name="activities_music_open_string">Al aire, %1$s</string>
    <!-- A fret on a guitar string, with the note it sounds, like "Fret 3, G". -->
    <string name="activities_music_fret">Traste %1$d, %2$s</string>
    <!-- For TalkBack: one string of a guitar shape, like "A string: Fret 3, C". -->
    <string name="activities_music_string_position">%1$s: %2$s</string>
    <!-- The title of a melody that has none. -->
    <string name="activities_music_melody">Melodía</string>
    <!-- For TalkBack: the choice between showing the music as a staff or as guitar tab. -->
    <string name="activities_music_show_as">Mostrar la música como</string>
    <!-- Music written on the five-line staff. -->
    <string name="activities_music_staff">Pentagrama</string>
    <!-- Guitar tablature: music written as fret numbers on the guitar's strings. -->
    <string name="activities_music_tab">Tablatura</string>
    <string name="activities_music_play_melody">Reproducir la melodía</string>
    <!-- Stops the melody playing. -->
    <string name="activities_music_stop">Detener</string>
    <!-- Which bar of the melody is playing, like "Bar 2 of 4". -->
    <string name="activities_music_bar_of">Compás %1$d de %2$d</string>
    <!-- How many bars the melody has, like "4 bars". -->
    <plurals name="activities_music_bars">
        <item quantity="one">%d compás</item>
        <item quantity="many">%d compases</item>
        <item quantity="other">%d compases</item>
    </plurals>
    <!-- For TalkBack: the tempo menu with its choice, like "Tempo: 80 bpm". -->
    <string name="activities_music_tempo">Tempo: %1$s</string>
    <!-- Beats per minute, like "80 bpm". -->
    <string name="activities_music_bpm">%1$d bpm</string>
    <!-- For TalkBack: one bar of the melody and its notes, like "Bar 1: E, E, F, G." -->
    <string name="activities_music_bar_notes">Compás %1$d: %2$s.</string>
    <!-- The rhythm's tempo while one round plays, like "90 bpm · Round 1 of 2". -->
    <string name="activities_music_rhythm_round">%1$d bpm · Ronda %2$d de %3$d</string>
    <!-- The rhythm's tempo and how many times it repeats, like "90 bpm · 2 rounds". -->
    <plurals name="activities_music_rhythm_rounds">
        <item quantity="one">%1$d bpm · %2$d ronda</item>
        <item quantity="many">%1$d bpm · %2$d rondas</item>
        <item quantity="other">%1$d bpm · %2$d rondas</item>
    </plurals>
    <!-- For TalkBack: the rhythm in words, like "A rhythm of 16 steps with a beat every 4. Tap on steps 1, 4, 7, 11, 13, over a click on every beat." -->
    <plurals name="activities_music_rhythm_description">
        <item quantity="one">Un ritmo de %1$d paso con un pulso cada %2$d. Toca en los pasos %3$s mientras suena un clic en cada pulso.</item>
        <item quantity="many">Un ritmo de %1$d pasos con un pulso cada %2$d. Toca en los pasos %3$s mientras suena un clic en cada pulso.</item>
        <item quantity="other">Un ritmo de %1$d pasos con un pulso cada %2$d. Toca en los pasos %3$s mientras suena un clic en cada pulso.</item>
    </plurals>
    <!-- The legend for the rhythm's steps to tap. -->
    <string name="activities_music_rhythm_hits">Toques del ritmo</string>
    <!-- The legend for a tap that came on time. -->
    <string name="activities_music_on_time">A tiempo</string>
    <!-- The legend for a tap that came too early or too late. -->
    <string name="activities_music_early_or_late">Adelantado o atrasado</string>
    <!-- On the tap pad while the count-in clicks play. -->
    <string name="activities_music_get_ready">Prepárate…</string>
    <!-- The tap pad's label. -->
    <string name="activities_music_tap_here">Tocar aquí</string>
