        <item quantity="one">%1$d de %2$d toque a tiempo.</item>
        <item quantity="many">%1$d de %2$d toques a tiempo.</item>
        <item quantity="other">%1$d de %2$d toques a tiempo.</item>
    </plurals>
    <!-- The tap furthest off, like "Tap 3 came 40 ms early". The first value is which tap, counted from 1. -->
    <string name="activities_music_tap_early">El toque %1$s se adelantó %2$d ms.</string>
    <!-- The tap furthest off, like "Tap 3 came 40 ms late". The first value is which tap, counted from 1. -->
    <string name="activities_music_tap_late">El toque %1$s se retrasó %2$d ms.</string>
    <!-- Which tap was missed, counted from 1, like "Tap 3 was missed." -->
    <string name="activities_music_tap_missed">Faltó el toque %1$s.</string>
