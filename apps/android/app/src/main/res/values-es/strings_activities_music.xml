    <plurals name="activities_music_rhythm_rounds">
        <item quantity="one">%1$d bpm · %2$d ronda</item>
        <item quantity="many">%1$d bpm · %2$d rondas</item>
        <item quantity="other">%1$d bpm · %2$d rondas</item>
    </plurals>
