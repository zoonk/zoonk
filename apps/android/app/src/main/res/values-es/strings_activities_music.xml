    <plurals name="activities_music_rhythm_description">
        <item quantity="one">Un ritmo de %1$d paso, con un pulso cada %2$d. Toca los pasos %3$s al ritmo del clic de cada pulso.</item>
        <item quantity="many">Un ritmo de %1$d pasos, con un pulso cada %2$d. Toca los pasos %3$s al ritmo del clic de cada pulso.</item>
        <item quantity="other">Un ritmo de %1$d pasos, con un pulso cada %2$d. Toca los pasos %3$s al ritmo del clic de cada pulso.</item>
    </plurals>
