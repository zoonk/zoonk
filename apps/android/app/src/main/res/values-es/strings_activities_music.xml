<resources>
    <string name="activities_music_badge_play_it">Tócala</string>
    <!-- Training the ear to recognize notes and chords by their sound. -->
    <string name="activities_music_badge_ear_training">Entrenamiento auditivo</string>
    <!-- A note name read aloud, like "F sharp". -->
    <string name="activities_music_note_sharp">%1$s sostenido</string>
    <!-- A note name read aloud, like "E flat". -->
    <string name="activities_music_note_flat">%1$s bemol</string>
    <!-- A chord's name: its root note, then the chord's kind, like "C major". -->
    <string name="activities_music_chord_major">%1$s mayor</string>
    <string name="activities_music_chord_minor">%1$s menor</string>
    <string name="activities_music_chord_augmented">%1$s aumentado</string>
    <string name="activities_music_chord_diminished">%1$s disminuido</string>
    <string name="activities_music_chord_dominant7">%1$s de séptima dominante</string>
    <string name="activities_music_chord_major7">%1$s de séptima mayor</string>
    <string name="activities_music_chord_minor7">%1$s de séptima menor</string>
    <!-- The title while the notes to find are only heard, not named. -->
    <string name="activities_music_by_ear">De oído</string>
    <!-- How many notes the target has, like "2 notes". -->
    <plurals name="activities_music_note_count">
        <item quantity="one">%d nota</item>
        <item quantity="many">%d notas</item>
        <item quantity="other">%d notas</item>
    </plurals>
    <!-- Nothing is pressed on the instrument. -->
    <string name="activities_music_no_notes">Todavía no hay notas</string>
    <!-- For TalkBack: the notes the instrument plays now, like "On the keys: C, E flat, G". -->
    <string name="activities_music_on_the_keys">En las teclas: %1$s</string>
    <!-- Plays the chord or notes to find by ear. -->
    <string name="activities_music_play_sound">Reproducir el sonido</string>
    <!-- Plays the notes on the keys. -->
    <string name="activities_music_hear_it">Escúchalo</string>
    <!-- For a learner who can't play sound: shows the notes to find by ear as text. -->
    <string name="activities_music_show_notes">¿No puedes escucharlo? Muestra las notas</string>
    <!-- The notes the sound plays, as text, like "The sound plays: C, G". -->
    <string name="activities_music_sound_notes">El sonido reproduce: %1$s</string>
    <!-- Under an instrument when the device couldn't play sound. -->
    <string name="activities_music_sound_unavailable">No se ha podido reproducir el sonido. Aun así, puedes ver todas las notas.</string>
    <!-- For TalkBack: the piano keyboard's name. -->
    <string name="activities_music_piano_keys">Teclas del piano</string>
    <!-- For TalkBack: the guitar neck's name. -->
    <string name="activities_music_guitar_strings">Cuerdas de la guitarra</string>
    <!-- Above a guitar shape that plays the chord on the keys. -->
    <string name="activities_music_same_chord_guitar">El mismo acorde en la guitarra</string>
    <!-- Above a guitar shape that plays the notes on the keys. -->
    <string name="activities_music_same_notes_guitar">Las mismas notas en la guitarra</string>
    <!-- Above a guitar shape that plays the right notes, after the check. -->
    <string name="activities_music_answer_on_guitar">Una forma de tocar la respuesta</string>
    <!-- Under the piano when the pressed notes can't be played as one guitar shape. -->
    <string name="activities_music_no_hand_shape">Estas notas no caben en una sola posición de la mano en la guitarra.</string>
    <!-- Moves the guitar neck's window toward the nut. -->
    <string name="activities_music_lower_frets">Trastes inferiores</string>
    <!-- Moves the guitar neck's window up the neck. -->
    <string name="activities_music_higher_frets">Trastes superiores</string>
    <!-- Which frets of the guitar neck show, like "Frets 1 to 4". -->
    <string name="activities_music_frets">Trastes del %1$d al %2$d</string>
    <!-- The thickest guitar string, read aloud. -->
    <string name="activities_music_string_low_e">Cuerda Mi grave</string>
    <!-- The thinnest guitar string, read aloud. -->
    <string name="activities_music_string_high_e">Cuerda Mi aguda</string>
    <!-- A guitar string named by its open note, like "A string". -->
    <string name="activities_music_string">Cuerda %1$s</string>
    <!-- A guitar string left silent (muted). -->
    <string name="activities_music_not_played">Sin tocar</string>
    <!-- A guitar string played open, with the note it sounds, like "Open, D". -->
    <string name="activities_music_open_string">Al aire, %1$s</string>
    <!-- A fret on a guitar string, with the note it sounds, like "Fret 3, G". -->
    <string name="activities_music_fret">Traste %1$d, %2$s</string>
    <!-- For TalkBack: one string of a guitar shape, like "A string: Fret 3, C". -->
    <string name="activities_music_string_position">%1$s: %2$s</string>
</resources>
