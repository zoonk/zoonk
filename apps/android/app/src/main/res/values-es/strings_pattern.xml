<resources>
    <!-- A rule the learner keeps getting wrong, found in their recent answers. -->
    <string name="pattern_title">Error recurrente</string>
    <string name="pattern_noticed">Hemos detectado un patrón</string>
    <string name="pattern_seen">Ha aparecido en tus respuestas recientes.</string>
    <!-- %d is how many times the mistake came up. Every form shows the number as %d; English says “once” only because it reads better. -->
    <plurals name="pattern_seen_times">
        <item quantity="one">Ha aparecido %d vez en tus respuestas recientes.</item>
        <item quantity="many">Ha aparecido %d veces en tus respuestas recientes.</item>
        <item quantity="other">Ha aparecido %d veces en tus respuestas recientes.</item>
    </plurals>
    <!-- Starts a short practice of the rule. %1$s is how long it takes, like "3 min". -->
    <string name="pattern_practice">Practicar · %1$s</string>
    <!-- Heads the learner's other sentences that show the same mistake. -->
    <string name="pattern_also_came_up">También ha aparecido en</string>
    <!-- A sentence the learner said or wrote, in quotation marks. -->
    <string name="pattern_quoted">«%1$s»</string>
    <string name="pattern_rule">La regla</string>
    <!-- Read aloud before the learner's own wrong sentence. -->
    <string name="pattern_you_said">Has dicho</string>
    <!-- Read aloud before the corrected sentence. -->
    <string name="pattern_correct_version">Versión correcta</string>
    <!-- Heads the learner's own wrong sentence beside its corrected version. -->
    <string name="pattern_where_you_slipped">Dónde te has equivocado</string>
    <string name="pattern_see_rule">Ver la regla</string>
    <!-- After the practice's last question, opens its result. -->
    <string name="pattern_see_how_you_did">Ver cómo te ha ido</string>
    <string name="pattern_got_it">Ya dominas esta regla.</string>
    <string name="pattern_keep_going">Conocer la regla es el primer paso. Cada vez que la uses te resultará más fácil.</string>
    <!-- The button that closes the practice result or the typos note and leaves the screen. -->
    <string name="pattern_done">Terminar</string>
    <string name="pattern_just_typos">Solo errores al escribir</string>
    <string name="pattern_typos_detail">Tus errores recientes fueron despistes al escribir, no una regla que desconozcas. No hay nada que practicar.</string>
