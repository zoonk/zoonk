<resources>
    <!-- A unit's place and its levels: "Unit 3 · A1–A2". -->
    <string name="language_unit_eyebrow">Unité %1$s · %2$s</string>
    <plurals name="language_unit_lessons">
        <item quantity="one">%d leçon</item>
        <item quantity="many">%d leçons</item>
        <item quantity="other">%d leçons</item>
    </plurals>
    <!-- How much of the unit is done, the unit being the subject: "33% done". -->
    <string name="language_unit_done_share">%1$s terminé</string>
    <string name="language_unit_start">Commencer</string>
    <string name="language_unit_continue">Continuer</string>
    <string name="language_unit_objectives">À la fin de cette unité</string>
    <!-- Heads a finished unit's list of things the learner is now able to do in the language. -->
    <string name="language_unit_can_already">Je peux déjà…</string>
    <string name="language_unit_progress">Progrès</string>
    <string name="language_unit_practice">S’entraîner</string>
    <string name="language_unit_mistakes">Tes erreurs</string>
    <string name="language_unit_reference">Pour référence</string>
    <string name="language_unit_grammar_tips">Conseils de grammaire</string>
    <string name="language_unit_words">Les mots de cette unité</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s et %2$s de plus</string>
    <string name="language_unit_summary">Résumé de l’unité</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">À propos de cette unité</string>
    <string name="language_skill_reading">Lecture</string>
    <string name="language_skill_listening">Écoute</string>
    <string name="language_skill_speaking">Expression orale</string>
    <string name="language_skill_words">Vocabulaire</string>
    <string name="language_skill_writing">Écriture</string>
    <!-- Heads the learner's level in each skill (reading, listening, speaking, writing), on the CEFR scale from A1 to C2. -->
    <string name="language_level_by_skill">Niveau par compétence</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">Objectif %1$s d’ici %2$s</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">Objectif %1$s</string>
    <!-- What TalkBack says for a skill's row: "Reading, B1". -->
    <string name="language_skill_level">%1$s, %2$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Reading, B1, up since the level test". -->
    <string name="language_skill_level_trend">%1$s, %2$s, %3$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">en hausse depuis le test de niveau</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">en baisse depuis le test de niveau</string>
    <string name="language_levels_move">Les niveaux évoluent avec l’entraînement. Ils deviennent plus précis chaque semaine.</string>
    <!-- One skill rose: "Speaking went up to B1 since the level test." -->
    <string name="language_level_rose">%1$s a augmenté jusqu’à %2$s depuis le test de niveau.</string>
    <!-- The count is how many skills rose, always two or more; %1$s lists them: "Speaking and Writing went up since the level test." -->
    <plurals name="language_levels_rose">
        <item quantity="one">%1$s a progressé depuis le test de niveau.</item>
        <item quantity="many">%1$s ont progressé depuis le test de niveau.</item>
        <item quantity="other">%1$s ont progressé depuis le test de niveau.</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">Je sais déjà…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">Pas encore</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s, objectif %2$s</string>
    <string name="language_pattern_noticed">On a repéré une régularité</string>
    <string name="language_pattern_typos">De simples fautes de frappe</string>
    <string name="language_pattern_typos_description">Tes erreurs récentes étaient des fautes d’inattention, pas une règle à apprendre.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">Répète %d mot</item>
        <item quantity="many">Répète %d mots</item>
        <item quantity="other">Répète %d mots</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">En premier lors de ta prochaine séance · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">Entraîne-toi quand tu veux · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">Je sais déjà le lire</string>
    <string name="language_alphabet_skip_failed">Ça n’a pas été enregistré. Réessaie.</string>
    <!-- Opens the words to say again. -->
    <string name="language_say_them">Dis-les</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Ouvrir</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">On a remarqué un motif : %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Entraîne-toi</string>
    <string name="language_level">Niveau</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, objectif %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Voir ton plan</string>
</resources>
