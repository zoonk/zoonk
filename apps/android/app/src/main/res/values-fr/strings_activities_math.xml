    <string name="activities_math_area_total">Ensemble, ces parties donnent %1$s.</string>
    <!-- A handle that moves where the rectangle's width is split, for TalkBack. -->
    <string name="activities_math_area_split_width">Découpage sur la largeur</string>
    <!-- A handle that moves where the rectangle's height is split, for TalkBack. -->
    <string name="activities_math_area_split_height">Découpage sur la hauteur</string>
