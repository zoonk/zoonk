        <item quantity="one">Un rythme de %1$d étape, avec un battement toutes les %2$d étapes. Tape sur les étapes %3$s, en suivant le clic à chaque battement.</item>
        <item quantity="many">Un rythme de %1$d étapes, avec un battement toutes les %2$d étapes. Tape sur les étapes %3$s, en suivant le clic à chaque battement.</item>
        <item quantity="other">Un rythme de %1$d étapes, avec un battement toutes les %2$d étapes. Tape sur les étapes %3$s, en suivant le clic à chaque battement.</item>
    </plurals>
    <!-- The legend for the rhythm's steps to tap. -->
    <string name="activities_music_rhythm_hits">Coups en rythme</string>
