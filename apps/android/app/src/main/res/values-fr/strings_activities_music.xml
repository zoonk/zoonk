<resources>
    <string name="activities_music_badge_play_it">Joue</string>
    <!-- Training the ear to recognize notes and chords by their sound. -->
    <string name="activities_music_badge_ear_training">Oreille musicale</string>
    <!-- Reading music while it plays. -->
    <string name="activities_music_badge_read_listen">Lire et écouter</string>
    <!-- A note name read aloud, like "F sharp". -->
    <string name="activities_music_note_sharp">%1$s dièse</string>
    <!-- A note name read aloud, like "E flat". -->
    <string name="activities_music_note_flat">%1$s bémol</string>
    <!-- A chord's name: its root note, then the chord's kind, like "C major". -->
    <string name="activities_music_chord_major">%1$s majeur</string>
    <string name="activities_music_chord_minor">%1$s mineur</string>
    <string name="activities_music_chord_augmented">%1$s augmenté</string>
    <string name="activities_music_chord_diminished">%1$s diminué</string>
    <string name="activities_music_chord_dominant7">%1$s septième de dominante</string>
    <string name="activities_music_chord_major7">%1$s majeur septième</string>
    <string name="activities_music_chord_minor7">%1$s mineur septième</string>
    <!-- The title while the notes to find are only heard, not named. -->
    <string name="activities_music_by_ear">À l’oreille</string>
    <!-- How many notes the target has, like "2 notes". -->
    <plurals name="activities_music_note_count">
        <item quantity="one">%d note</item>
        <item quantity="many">%d notes</item>
        <item quantity="other">%d notes</item>
    </plurals>
    <!-- Nothing is pressed on the instrument. -->
    <string name="activities_music_no_notes">Aucune note pour le moment</string>
    <!-- For TalkBack: the notes the instrument plays now, like "On the keys: C, E flat, G". -->
    <string name="activities_music_on_the_keys">Sur les touches : %1$s</string>
    <!-- Plays the chord or notes to find by ear. -->
    <string name="activities_music_play_sound">Jouer le son</string>
    <!-- Plays the notes on the keys. -->
    <string name="activities_music_hear_it">Écouter</string>
    <!-- For a learner who can't play sound: shows the notes to find by ear as text. -->
    <string name="activities_music_show_notes">Tu ne peux pas écouter ? Affiche les notes</string>
    <!-- The notes the sound plays, as text, like "The sound plays: C, G". -->
    <string name="activities_music_sound_notes">Le son joue : %1$s</string>
    <!-- Under an instrument when the device couldn't play sound. -->
    <string name="activities_music_sound_unavailable">Le son n’a pas pu être joué. Tu peux quand même voir toutes les notes.</string>
    <!-- For TalkBack: the piano keyboard's name. -->
    <string name="activities_music_piano_keys">Touches du piano</string>
    <!-- For TalkBack: the guitar neck's name. -->
    <string name="activities_music_guitar_strings">Cordes de guitare</string>
    <!-- Above a guitar shape that plays the chord on the keys. -->
    <string name="activities_music_same_chord_guitar">Même accord à la guitare</string>
    <!-- Above a guitar shape that plays the notes on the keys. -->
    <string name="activities_music_same_notes_guitar">Mêmes notes à la guitare</string>
    <!-- Above a guitar shape that plays the right notes, after the check. -->
    <string name="activities_music_answer_on_guitar">Une façon de jouer la réponse</string>
    <!-- Under the piano when the pressed notes can't be played as one guitar shape. -->
    <string name="activities_music_no_hand_shape">Ces notes ne tiennent pas dans une seule position de main sur la guitare.</string>
    <!-- Moves the guitar neck's window toward the nut. -->
    <string name="activities_music_lower_frets">Cases plus basses</string>
    <!-- Moves the guitar neck's window up the neck. -->
    <string name="activities_music_higher_frets">Cases plus hautes</string>
    <!-- Which frets of the guitar neck show, like "Frets 1 to 4". -->
    <string name="activities_music_frets">Cases %1$d à %2$d</string>
    <!-- The thickest guitar string, read aloud. -->
    <string name="activities_music_string_low_e">Corde de mi grave</string>
    <!-- The thinnest guitar string, read aloud. -->
    <string name="activities_music_string_high_e">Corde de mi aiguë</string>
    <!-- A guitar string named by its open note, like "A string". -->
    <string name="activities_music_string">Corde de %1$s</string>
    <!-- A guitar string left silent (muted). -->
    <string name="activities_music_not_played">Non jouée</string>
    <!-- A guitar string played open, with the note it sounds, like "Open, D". -->
    <string name="activities_music_open_string">À vide, %1$s</string>
    <!-- A fret on a guitar string, with the note it sounds, like "Fret 3, G". -->
    <string name="activities_music_fret">Case %1$d, %2$s</string>
    <!-- For TalkBack: one string of a guitar shape, like "A string: Fret 3, C". -->
    <string name="activities_music_string_position">%1$s : %2$s</string>
    <!-- The title of a melody that has none. -->
    <string name="activities_music_melody">Mélodie</string>
    <!-- For TalkBack: the choice between showing the music as a staff or as guitar tab. -->
    <string name="activities_music_show_as">Afficher la musique en</string>
    <!-- Music written on the five-line staff. -->
    <string name="activities_music_staff">Portée</string>
    <!-- Guitar tablature: music written as fret numbers on the guitar's strings. -->
    <string name="activities_music_tab">Tablature</string>
    <string name="activities_music_play_melody">Jouer la mélodie</string>
    <!-- Stops the melody playing. -->
    <string name="activities_music_stop">Arrêter</string>
    <!-- Which bar of the melody is playing, like "Bar 2 of 4". -->
    <string name="activities_music_bar_of">Mesure %1$d sur %2$d</string>
    <!-- How many bars the melody has, like "4 bars". -->
    <plurals name="activities_music_bars">
        <item quantity="one">%d mesure</item>
        <item quantity="many">%d mesures</item>
        <item quantity="other">%d mesures</item>
    </plurals>
    <!-- For TalkBack: the tempo menu with its choice, like "Tempo: 80 bpm". -->
    <string name="activities_music_tempo">Tempo : %1$s</string>
    <!-- Beats per minute, like "80 bpm". -->
    <string name="activities_music_bpm">%1$d bpm</string>
    <!-- For TalkBack: one bar of the melody and its notes, like "Bar 1: E, E, F, G." -->
    <string name="activities_music_bar_notes">Mesure %1$d : %2$s.</string>
</resources>
