    <string name="language_unit_about">Bu ünite hakkında</string>
    <string name="language_skill_reading">Okuma</string>
    <string name="language_skill_listening">Dinleme</string>
    <string name="language_skill_speaking">Konuşma</string>
    <string name="language_skill_words">Kelime bilgisi</string>
    <string name="language_skill_writing">Yazma</string>
    <!-- Heads the learner's level in each skill (reading, listening, speaking, writing), on the CEFR scale from A1 to C2. -->
    <string name="language_level_by_skill">Beceriye göre seviye</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">Hedef %1$s · %2$s tarihine kadar</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">Hedef %1$s</string>
    <!-- What TalkBack says for a skill's row: "Reading, B1". -->
    <string name="language_skill_level">%1$s, %2$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Reading, B1, up since the level test". -->
    <string name="language_skill_level_trend">%1$s, %2$s, %3$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">seviye testinden beri yükseldi</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">seviye testinden beri düştü</string>
    <string name="language_levels_move">Pratik yaptıkça seviyelerin değişir. Her hafta becerilerini daha doğru yansıtır.</string>
    <!-- One skill rose: "Speaking went up to B1 since the level test." -->
    <string name="language_level_rose">%1$s seviyen seviye testinden beri %2$s seviyesine yükseldi.</string>
    <!-- The count is how many skills rose, always two or more; %1$s lists them: "Speaking and Writing went up since the level test." -->
    <plurals name="language_levels_rose">
        <item quantity="one">%1$s seviyelerin seviye testinden beri yükseldi.</item>
        <item quantity="other">%1$s seviyelerin seviye testinden beri yükseldi.</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">Artık şunları yapabiliyorum…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">Henüz değil</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s, hedef %2$s</string>
    <string name="language_pattern_noticed">Tekrarlayan bir hata fark ettik</string>
    <string name="language_pattern_typos">Sadece yazım hataları</string>
    <string name="language_pattern_typos_description">Son yanlışların dalgınlıktan kaynaklandı. Öğrenmen gereken bir kural yok.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">%d kelimeyi tekrar söyle</item>
        <item quantity="other">%d kelimeyi tekrar söyle</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">Sonraki çalışmanda ilk sırada · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">İstediğin zaman çalış · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">Zaten okuyabiliyorum</string>
    <string name="language_alphabet_skip_failed">Kaydedilemedi. Tekrar dene.</string>
    <!-- Button that opens the words to say aloud again; "them" is those words. -->
    <string name="language_say_them">Sesli söyle</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Aç</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">Tekrarlayan bir hata fark ettik: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Alıştırma yap</string>
    <string name="language_level">Seviye</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, hedef %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Planını gör</string>
