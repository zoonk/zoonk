    <!-- Title of a kind message to someone too young to use Zoonk where they live. -->
    <string name="account_below_minimum_age_title">Noch ein bisschen Geduld</string>
    <!-- %1$d is the minimum age to use Zoonk where the learner lives, like 13. Kind and encouraging, never scolding. -->
    <string name="account_below_minimum_age_description">Du kannst Zoonk ab %1$d Jahren nutzen. Wir sind für dich da, wenn es so weit ist.</string>
    <!-- %1$d is the minimum age to use Zoonk where the learner lives, like 13. Shown to someone signed in: "log you out" means Zoonk ends their session in the app when they tap OK, the same action as the menu's "Log out". Kind and encouraging, never scolding. -->
    <string name="account_below_minimum_age_log_out_description">Du musst mindestens %1$d Jahre alt sein, um Zoonk zu nutzen. Deshalb melden wir dich ab. Wir sind für dich da, wenn du so weit bist.</string>
    <!-- %1$d is the minimum age to use Zoonk where the learner lives, like 13. Shown to someone signed in whose birth year is certainly below it: Zoonk has already deleted the account. Kind and encouraging, never scolding. -->
    <string name="account_closed_below_minimum_age_description">Du musst mindestens %1$d Jahre alt sein, um Zoonk zu nutzen. Deshalb haben wir dein Konto geschlossen und die zugehörigen Daten gelöscht. Wenn du alt genug bist, sind wir für dich da.</string>
    <string name="account_below_minimum_age_ok">OK</string>
