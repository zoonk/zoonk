<resources>
    <string name="activities_music_badge_play_it">Spiel es</string>
    <!-- Training the ear to recognize notes and chords by their sound. -->
    <string name="activities_music_badge_ear_training">Gehörbildung</string>
    <!-- Reading music while it plays. -->
    <string name="activities_music_badge_read_listen">Lesen und hören</string>
    <!-- A note name read aloud, like "F sharp". -->
    <string name="activities_music_note_sharp">%1$sis</string>
    <!-- A note name read aloud, like "E flat". -->
    <string name="activities_music_note_flat">%1$ses</string>
    <!-- A chord's name: its root note, then the chord's kind, like "C major". -->
    <string name="activities_music_chord_major">%1$s-Dur</string>
    <string name="activities_music_chord_minor">%1$s-Moll</string>
    <string name="activities_music_chord_augmented">%1$s übermäßig</string>
    <string name="activities_music_chord_diminished">%1$s vermindert</string>
    <string name="activities_music_chord_dominant7">%1$s Dominantseptakkord</string>
    <string name="activities_music_chord_major7">%1$s Dur-Septakkord</string>
    <string name="activities_music_chord_minor7">%1$s Moll-Septakkord</string>
    <!-- The title while the notes to find are only heard, not named. -->
    <string name="activities_music_by_ear">Nach Gehör</string>
    <!-- How many notes the target has, like "2 notes". -->
    <plurals name="activities_music_note_count">
        <item quantity="one">%d Ton</item>
        <item quantity="other">%d Töne</item>
    </plurals>
    <!-- Nothing is pressed on the instrument. -->
    <string name="activities_music_no_notes">Noch keine Töne</string>
    <!-- For TalkBack: the notes the instrument plays now, like "On the keys: C, E flat, G". -->
    <string name="activities_music_on_the_keys">Auf den Tasten: %1$s</string>
    <!-- Plays the chord or notes to find by ear. -->
    <string name="activities_music_play_sound">Ton abspielen</string>
    <!-- Plays the notes on the keys. -->
    <string name="activities_music_hear_it">Anhören</string>
    <!-- For a learner who can't play sound: shows the notes to find by ear as text. -->
    <string name="activities_music_show_notes">Du kannst nicht hören? Noten anzeigen</string>
    <!-- The notes the sound plays, as text, like "The sound plays: C, G". -->
    <string name="activities_music_sound_notes">Der Ton spielt: %1$s</string>
    <!-- Under an instrument when the device couldn't play sound. -->
    <string name="activities_music_sound_unavailable">Der Ton konnte nicht abgespielt werden. Du kannst trotzdem alle Noten sehen.</string>
    <!-- For TalkBack: the piano keyboard's name. -->
    <string name="activities_music_piano_keys">Klaviertasten</string>
    <!-- For TalkBack: the guitar neck's name. -->
    <string name="activities_music_guitar_strings">Gitarrensaiten</string>
    <!-- Above a guitar shape that plays the chord on the keys. -->
    <string name="activities_music_same_chord_guitar">Derselbe Akkord auf der Gitarre</string>
    <!-- Above a guitar shape that plays the notes on the keys. -->
    <string name="activities_music_same_notes_guitar">Dieselben Töne auf der Gitarre</string>
    <!-- Above a guitar shape that plays the right notes, after the check. -->
    <string name="activities_music_answer_on_guitar">Eine Möglichkeit, die Antwort zu spielen</string>
    <!-- Under the piano when the pressed notes can't be played as one guitar shape. -->
    <string name="activities_music_no_hand_shape">Diese Töne lassen sich auf der Gitarre nicht mit einem einzigen Griff spielen.</string>
    <!-- Moves the guitar neck's window toward the nut. -->
    <string name="activities_music_lower_frets">Tiefere Bünde</string>
    <!-- Moves the guitar neck's window up the neck. -->
    <string name="activities_music_higher_frets">Höhere Bünde</string>
    <!-- Which frets of the guitar neck show, like "Frets 1 to 4". -->
    <string name="activities_music_frets">Bünde %1$d bis %2$d</string>
    <!-- The thickest guitar string, read aloud. -->
    <string name="activities_music_string_low_e">Tiefe E-Saite</string>
    <!-- The thinnest guitar string, read aloud. -->
    <string name="activities_music_string_high_e">Hohe E-Saite</string>
    <!-- A guitar string named by its open note, like "A string". -->
    <string name="activities_music_string">%1$s. Saite</string>
    <!-- A guitar string left silent (muted). -->
    <string name="activities_music_not_played">Nicht gespielt</string>
    <!-- A guitar string played open, with the note it sounds, like "Open, D". -->
    <string name="activities_music_open_string">Leersaite, %1$s</string>
    <!-- A fret on a guitar string, with the note it sounds, like "Fret 3, G". -->
    <string name="activities_music_fret">Bund %1$d, %2$s</string>
    <!-- For TalkBack: one string of a guitar shape, like "A string: Fret 3, C". -->
    <string name="activities_music_string_position">%1$s: %2$s</string>
    <!-- The title of a melody that has none. -->
    <string name="activities_music_melody">Melodie</string>
    <!-- For TalkBack: the choice between showing the music as a staff or as guitar tab. -->
    <string name="activities_music_show_as">Musik anzeigen als</string>
    <!-- Music written on the five-line staff. -->
    <string name="activities_music_staff">Notenschrift</string>
    <!-- Guitar tablature: music written as fret numbers on the guitar's strings. -->
    <string name="activities_music_tab">Tabulatur</string>
    <string name="activities_music_play_melody">Melodie abspielen</string>
    <!-- Stops the melody playing. -->
    <string name="activities_music_stop">Stopp</string>
    <!-- Which bar of the melody is playing, like "Bar 2 of 4". -->
    <string name="activities_music_bar_of">Takt %1$d von %2$d</string>
    <!-- How many bars the melody has, like "4 bars". -->
    <plurals name="activities_music_bars">
        <item quantity="one">%d Takt</item>
        <item quantity="other">%d Takte</item>
    </plurals>
    <!-- For TalkBack: the tempo menu with its choice, like "Tempo: 80 bpm". -->
    <string name="activities_music_tempo">Tempo: %1$s</string>
    <!-- Beats per minute, like "80 bpm". -->
    <string name="activities_music_bpm">%1$d BPM</string>
    <!-- For TalkBack: one bar of the melody and its notes, like "Bar 1: E, E, F, G." -->
    <string name="activities_music_bar_notes">Takt %1$d: %2$s.</string>
</resources>
