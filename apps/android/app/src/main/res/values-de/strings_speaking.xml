<resources>
    <!-- Practicing an official language exam's speaking paper (DELE, DELF, Goethe, Cambridge) on calls with an AI in the examiner's place. -->
    <string name="speaking_title">Sprechen üben</string>
    <string name="speaking_eyebrow">Sprechen wie in der Prüfung</string>
    <!-- The paper's task count and how long its speaking part lasts in the exam, such as "4 tasks · 15 min in the exam". -->
