    <string name="speaking_prep">%1$s zur Vorbereitung</string>
    <!-- The criteria the exam rates, listed, such as "Rated on fluency, vocabulary and grammar." -->
    <string name="speaking_rated_on">Bewertet nach %1$s.</string>
    <!-- Today's row for the paper: the exam, such as "DELE B2 tasks on a call". -->
