    <string name="speaking_last_near">Letzter Versuch: %1$s von %2$s, ungefähr am %3$s</string>
    <string name="speaking_last_below">Letzter Versuch: unter %1$s</string>
    <!-- Preparation time shared by several tasks, such as "20 min to prepare tasks 1 and 2". -->
