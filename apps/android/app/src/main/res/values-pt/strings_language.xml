<resources>
    <!-- A unit's place and its levels: "Unit 3 · A1–A2". -->
    <string name="language_unit_eyebrow">Unidade %1$s · %2$s</string>
    <plurals name="language_unit_lessons">
        <item quantity="one">%d aula</item>
        <item quantity="many">%d aulas</item>
        <item quantity="other">%d aulas</item>
    </plurals>
    <!-- How much of the unit is done, the unit being the subject: "33% done". -->
    <string name="language_unit_done_share">%1$s concluído</string>
    <string name="language_unit_start">Começar</string>
    <string name="language_unit_continue">Continuar</string>
    <string name="language_unit_objectives">Ao final desta unidade</string>
    <!-- Heads a finished unit's list of things the learner is now able to do in the language. -->
    <string name="language_unit_can_already">Eu já consigo…</string>
    <string name="language_unit_progress">Progresso</string>
    <string name="language_unit_practice">Prática</string>
    <string name="language_unit_mistakes">Seus erros</string>
    <string name="language_unit_reference">Para consultar</string>
    <string name="language_unit_grammar_tips">Dicas de gramática</string>
    <string name="language_unit_words">Palavras desta unidade</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s e mais %2$s</string>
    <string name="language_unit_summary">Resumo da unidade</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">Sobre esta unidade</string>
    <string name="language_skill_listening">Escuta</string>
    <string name="language_skill_speaking">Conversação</string>
    <string name="language_skill_words">Palavras</string>
    <string name="language_skill_writing">Escrita</string>
    <string name="language_pattern_noticed">Percebemos um padrão</string>
    <string name="language_pattern_typos">Só erros de digitação</string>
    <string name="language_pattern_typos_description">Seus erros recentes foram deslizes, não uma regra que você precisa aprender.</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="one">Repita %d palavra</item>
        <item quantity="many">Repita %d palavras</item>
        <item quantity="other">Repita %d palavras</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">Primeiro na sua próxima sessão · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">Pratique quando quiser · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">Já sei ler esse alfabeto</string>
    <string name="language_alphabet_skip_failed">Não foi possível salvar. Tente de novo.</string>
    <!-- Opens the words to say again. -->
    <string name="language_say_them">Diga em voz alta</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">Abrir</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">Percebemos um padrão: %1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">Pratique esse padrão</string>
    <string name="language_level">Nível</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s, meta %2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">Ver seu plano</string>
</resources>
