<resources>
    <!-- A grid like a Punnett square, where the learner fills each square. -->
    <string name="activities_reasoning_badge_fill_square">Preencha o quadrado</string>
    <!-- What a Punnett square shows, for TalkBack: the trait, then each parent with its alleles, like "A Punnett square for Flower color: Purple parent (Pp) down the side, White parent (pp) across the top." -->
    <string name="activities_reasoning_grid_punnett">Quadrado de Punnett para %1$s: %2$s (%3$s) na vertical, %4$s (%5$s) na horizontal.</string>
    <!-- What a grid of sums shows, for TalkBack, like "Two dice: First die (1, 2, 3) down the side, Second die (1, 2, 3) across the top, each square their sum." -->
    <string name="activities_reasoning_grid_sums">%1$s: %2$s (%3$s) na vertical, %4$s (%5$s) na horizontal; cada quadrado mostra a soma.</string>
    <!-- What a grid of products shows, for TalkBack, like "Times table: Number (2, 3, 4) down the side, Times (1, 2, 3) across the top, each square their product." -->
    <string name="activities_reasoning_grid_products">%1$s: %2$s (%3$s) na vertical, %4$s (%5$s) na horizontal; cada quadrado mostra o produto.</string>
    <!-- An empty square of the grid, for TalkBack: its number, then its row's and its column's values, like "Square 2, P and p: empty". -->
    <string name="activities_reasoning_grid_square_empty">Quadrado %1$d, %2$s e %3$s: vazio</string>
    <!-- A filled square of the grid, for TalkBack: its number, its row's and its column's values, then what's in it, like "Square 2, P and p: Pp, Purple". -->
    <string name="activities_reasoning_grid_square">Quadrado %1$d, %2$s e %3$s: %4$s</string>
    <!-- A genotype and the trait it shows, for TalkBack, like "Pp, Purple". -->
    <string name="activities_reasoning_grid_value_trait">%1$s, %2$s</string>
    <!-- A checked square the learner filled wrong, for TalkBack: the right value, then the learner's, like "Pp, Purple. Your answer: pp". -->
    <string name="activities_reasoning_grid_your_answer">%1$s. Sua resposta: %2$s</string>
    <!-- How many squares show the thing the check counted, like "2 of 4 squares: White" or "6 of 36 squares: 7". -->
    <plurals name="activities_reasoning_grid_counted">
        <item quantity="one">%1$d de %2$d quadrado: %3$s</item>
        <item quantity="many">%1$d de %2$d quadrados: %3$s</item>
        <item quantity="other">%1$d de %2$d quadrados: %3$s</item>
    </plurals>
    <!-- After the check, like "3 of 4 squares right". -->
    <plurals name="activities_reasoning_grid_right">
        <item quantity="one">%1$d de %2$d quadrado correto</item>
        <item quantity="many">%1$d de %2$d quadrados corretos</item>
        <item quantity="other">%1$d de %2$d quadrados corretos</item>
    </plurals>
    <!-- While filling, like "5 of 9 squares filled". -->
    <plurals name="activities_reasoning_grid_filled">
        <item quantity="one">%1$d de %2$d quadrado preenchido</item>
        <item quantity="many">%1$d de %2$d quadrados preenchidos</item>
        <item quantity="other">%1$d de %2$d quadrados preenchidos</item>
    </plurals>
    <!-- How many filled squares show each trait so far, out of all the squares, like "Purple: 2 of 4 · White: 1 of 4". -->
    <string name="activities_reasoning_grid_traits">%1$s: %2$d de %5$d · %3$s: %4$d de %5$d</string>
    <string name="activities_reasoning_grid_all_filled">Todos os quadrados estão preenchidos. Toque em um deles para mudar o valor.</string>
    <!-- Asks for the genotype of a square of a Punnett square, like "Which genotype goes in square 2?" -->
    <string name="activities_reasoning_grid_which_genotype">Qual genótipo vai no quadrado %1$d?</string>
    <!-- Asks for the value of a square of a grid of numbers, like "What goes in square 2?" -->
    <string name="activities_reasoning_grid_what_goes">O que vai no quadrado %1$d?</string>
</resources>
