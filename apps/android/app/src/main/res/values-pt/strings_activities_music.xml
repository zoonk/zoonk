        <item quantity="one">%1$d de %2$d toque no tempo certo.</item>
        <item quantity="many">%1$d de %2$d toques no tempo certo.</item>
        <item quantity="other">%1$d de %2$d toques no tempo certo.</item>
    </plurals>
    <!-- The tap furthest off, like "Tap 3 came 40 ms early". The first value is which tap, counted from 1. -->
    <string name="activities_music_tap_early">O toque %1$s aconteceu %2$d ms antes.</string>
    <!-- The tap furthest off, like "Tap 3 came 40 ms late". The first value is which tap, counted from 1. -->
    <string name="activities_music_tap_late">O toque %1$s aconteceu %2$d ms depois.</string>
