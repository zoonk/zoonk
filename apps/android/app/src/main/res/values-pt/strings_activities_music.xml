<resources>
    <string name="activities_music_badge_play_it">Toque</string>
    <!-- Training the ear to recognize notes and chords by their sound. -->
    <string name="activities_music_badge_ear_training">Treino auditivo</string>
    <!-- Reading music while it plays. -->
    <string name="activities_music_badge_read_listen">Leia e escute</string>
    <!-- Tapping a rhythm in time with the beat. -->
    <string name="activities_music_badge_tap_along">Toque no ritmo</string>
    <!-- A note name read aloud, like "F sharp". -->
    <string name="activities_music_note_sharp">%1$s sustenido</string>
    <!-- A note name read aloud, like "E flat". -->
    <string name="activities_music_note_flat">%1$s bemol</string>
    <!-- A chord's name: its root note, then the chord's kind, like "C major". -->
    <string name="activities_music_chord_major">%1$s maior</string>
    <string name="activities_music_chord_minor">%1$s menor</string>
    <string name="activities_music_chord_augmented">%1$s aumentado</string>
    <string name="activities_music_chord_diminished">%1$s diminuto</string>
    <string name="activities_music_chord_dominant7">%1$s com sétima dominante</string>
    <string name="activities_music_chord_major7">%1$s com sétima maior</string>
    <string name="activities_music_chord_minor7">%1$s com sétima menor</string>
    <!-- The title while the notes to find are only heard, not named. -->
    <string name="activities_music_by_ear">De ouvido</string>
    <!-- How many notes the target has, like "2 notes". -->
    <plurals name="activities_music_note_count">
        <item quantity="one">%d nota</item>
        <item quantity="many">%d notas</item>
        <item quantity="other">%d notas</item>
    </plurals>
    <!-- Nothing is pressed on the instrument. -->
    <string name="activities_music_no_notes">Ainda sem notas</string>
    <!-- For TalkBack: the notes the instrument plays now, like "On the keys: C, E flat, G". -->
    <string name="activities_music_on_the_keys">Nas teclas: %1$s</string>
    <!-- Plays the chord or notes to find by ear. -->
    <string name="activities_music_play_sound">Toque o som</string>
    <!-- Plays the notes on the keys. -->
    <string name="activities_music_hear_it">Ouça</string>
    <!-- For a learner who can't play sound: shows the notes to find by ear as text. -->
    <string name="activities_music_show_notes">Não consegue ouvir? Veja as notas</string>
    <!-- The notes the sound plays, as text, like "The sound plays: C, G". -->
    <string name="activities_music_sound_notes">O som toca: %1$s</string>
    <!-- Under an instrument when the device couldn't play sound. -->
    <string name="activities_music_sound_unavailable">Não foi possível tocar o som. Você ainda pode ver todas as notas.</string>
    <!-- For TalkBack: the piano keyboard's name. -->
    <string name="activities_music_piano_keys">Teclas do piano</string>
    <!-- For TalkBack: the checked piano keyboard, its lowest and highest notes, then the notes the learner pressed, like "A piano keyboard from C to B. Pressed: C, E flat, G." -->
    <string name="activities_music_piano_pressed">Um teclado de piano de %1$s a %2$s. Teclas pressionadas: %3$s.</string>
    <!-- For TalkBack: the checked piano keyboard, its lowest and highest notes, when the learner pressed no key, like "A piano keyboard from C to B. Nothing pressed." -->
    <string name="activities_music_piano_nothing_pressed">Um teclado de piano de %1$s a %2$s. Nenhuma tecla pressionada.</string>
    <!-- For TalkBack: the guitar neck's name. -->
    <string name="activities_music_guitar_strings">Cordas do violão</string>
    <!-- Above a guitar shape that plays the chord on the keys. -->
    <string name="activities_music_same_chord_guitar">Mesmo acorde no violão</string>
    <!-- Above a guitar shape that plays the notes on the keys. -->
    <string name="activities_music_same_notes_guitar">Mesmas notas no violão</string>
    <!-- Above a guitar shape that plays the right notes, after the check. -->
    <string name="activities_music_answer_on_guitar">Uma forma de tocar a resposta</string>
    <!-- Under the piano when the pressed notes can't be played as one guitar shape. -->
    <string name="activities_music_no_hand_shape">Essas notas não cabem em uma única posição da mão no violão.</string>
    <!-- Moves the guitar neck's window toward the nut. -->
    <string name="activities_music_lower_frets">Casas mais baixas</string>
    <!-- Moves the guitar neck's window up the neck. -->
    <string name="activities_music_higher_frets">Casas mais altas</string>
    <!-- Which frets of the guitar neck show, like "Frets 1 to 4". -->
    <string name="activities_music_frets">Casas %1$d a %2$d</string>
    <!-- The thickest guitar string, read aloud. -->
    <string name="activities_music_string_low_e">Corda mi grave</string>
    <!-- The thinnest guitar string, read aloud. -->
    <string name="activities_music_string_high_e">Corda mi aguda</string>
    <!-- A guitar string named by its open note, like "A string". -->
    <string name="activities_music_string">Corda %1$s</string>
    <!-- A guitar string left silent (muted). -->
    <string name="activities_music_not_played">Não tocada</string>
    <!-- A guitar string played open, with the note it sounds, like "Open, D". -->
    <string name="activities_music_open_string">Solta, %1$s</string>
    <!-- A fret on a guitar string, with the note it sounds, like "Fret 3, G". -->
    <string name="activities_music_fret">Casa %1$d, %2$s</string>
    <!-- For TalkBack: one string of a guitar shape, like "A string: Fret 3, C". -->
    <string name="activities_music_string_position">%1$s: %2$s</string>
    <!-- The title of a melody that has none. -->
    <string name="activities_music_melody">Melodia</string>
    <!-- For TalkBack: the choice between showing the music as a staff or as guitar tab. -->
    <string name="activities_music_show_as">Mostrar a música como</string>
    <!-- Music written on the five-line staff. -->
    <string name="activities_music_staff">Partitura</string>
    <!-- Guitar tablature: music written as fret numbers on the guitar's strings. -->
    <string name="activities_music_tab">Tablatura</string>
    <string name="activities_music_play_melody">Tocar a melodia</string>
    <!-- Stops the melody playing. -->
    <string name="activities_music_stop">Parar</string>
    <!-- Which bar of the melody is playing, like "Bar 2 of 4". -->
    <string name="activities_music_bar_of">Compasso %1$d de %2$d</string>
    <!-- How many bars the melody has, like "4 bars". -->
    <plurals name="activities_music_bars">
        <item quantity="one">%d compasso</item>
        <item quantity="many">%d compassos</item>
        <item quantity="other">%d compassos</item>
    </plurals>
    <!-- For TalkBack: the tempo menu with its choice, like "Tempo: 80 bpm". -->
    <string name="activities_music_tempo">Andamento: %1$s</string>
    <!-- Beats per minute, like "80 bpm". -->
    <string name="activities_music_bpm">%1$d bpm</string>
    <!-- For TalkBack: one bar of the melody and its notes, like "Bar 1: E, E, F, G." -->
    <string name="activities_music_bar_notes">Compasso %1$d: %2$s.</string>
    <!-- The rhythm's tempo while one round plays, like "90 bpm · Round 1 of 2". -->
    <string name="activities_music_rhythm_round">%1$d bpm · Rodada %2$d de %3$d</string>
    <!-- The rhythm's tempo and how many times it repeats, like "90 bpm · 2 rounds". -->
    <plurals name="activities_music_rhythm_rounds">
        <item quantity="one">%1$d bpm · %2$d rodada</item>
        <item quantity="many">%1$d bpm · %2$d rodadas</item>
        <item quantity="other">%1$d bpm · %2$d rodadas</item>
    </plurals>
    <!-- For TalkBack: the rhythm in words, like "A rhythm of 16 steps with a beat every 4. Tap on steps 1, 4, 7, 11, 13, over a click on every beat." -->
    <plurals name="activities_music_rhythm_description">
        <item quantity="one">Um ritmo de %1$d passo, com uma batida a cada %2$d. Toque nos passos %3$s, acompanhando um clique a cada batida.</item>
        <item quantity="many">Um ritmo de %1$d passos, com uma batida a cada %2$d. Toque nos passos %3$s, acompanhando um clique a cada batida.</item>
        <item quantity="other">Um ritmo de %1$d passos, com uma batida a cada %2$d. Toque nos passos %3$s, acompanhando um clique a cada batida.</item>
    </plurals>
