    <!-- A unit's place and its levels: "Unit 3 · A1–A2". -->
    <string name="language_unit_eyebrow">ユニット%1$s · %2$s</string>
    <plurals name="language_unit_lessons">
        <item quantity="other">%dレッスン</item>
    </plurals>
    <!-- How much of the unit is done, the unit being the subject: "33% done". -->
    <string name="language_unit_done_share">%1$s完了</string>
    <string name="language_unit_start">始める</string>
    <string name="language_unit_continue">続ける</string>
    <string name="language_unit_objectives">このユニットで身につくこと</string>
    <string name="language_unit_progress">進み具合</string>
    <string name="language_unit_practice">練習</string>
    <string name="language_unit_mistakes">間違い</string>
    <!-- Heading over material to look things up in, such as grammar tips and words, rather than lessons to do. -->
    <string name="language_unit_reference">参考資料</string>
    <string name="language_unit_grammar_tips">文法のポイント</string>
    <string name="language_unit_words">このユニットの語彙</string>
    <!-- A few of the unit's words, then how many more it teaches: "hola · gracias · adiós and 12 more". -->
    <string name="language_unit_words_more">%1$s、ほか%2$s語</string>
    <string name="language_unit_summary">ユニットのまとめ</string>
    <!-- TalkBack's name for the pane beside the unit's lessons. -->
    <string name="language_unit_about">このユニットについて</string>
    <string name="language_skill_reading">リーディング</string>
    <string name="language_skill_listening">リスニング</string>
    <string name="language_skill_speaking">スピーキング</string>
    <string name="language_skill_words">語彙</string>
    <string name="language_skill_writing">ライティング</string>
    <!-- Heads the learner's level in each skill (reading, listening, speaking, writing), on the CEFR scale from A1 to C2. -->
    <string name="language_level_by_skill">スキル別のレベル</string>
    <!-- The level the learner aims for and when: "Goal B2 by June 2027". %1$s is a CEFR level, %2$s a month and year. -->
    <string name="language_level_goal_by">目標：%1$s（%2$sまで）</string>
    <!-- The level the learner aims for: "Goal B2". -->
    <string name="language_level_goal">目標：%1$s</string>
    <!-- What TalkBack says for a skill's row: "Reading, B1". -->
    <string name="language_skill_level">%1$s、%2$s</string>
    <!-- What TalkBack says for a skill's row that moved: "Reading, B1, up since the level test". -->
    <string name="language_skill_level_trend">%1$s、%2$s、%3$s</string>
    <!-- Read by TalkBack after a skill's level that went up since the learner's first level test. -->
    <string name="language_level_up">レベルテスト時より上がっています</string>
    <!-- Read by TalkBack after a skill's level that went down since the learner's first level test. -->
    <string name="language_level_down">レベルテスト時より下がっています</string>
    <string name="language_levels_move">レベルは練習に応じて変わります。毎週、より正確に実力を表すようになります。</string>
    <!-- One skill rose: "Speaking went up to B1 since the level test." -->
    <string name="language_level_rose">%1$sのレベルが、レベルテスト時より上がって%2$sになりました。</string>
    <!-- The count is how many skills rose, always two or more; %1$s lists them: "Speaking and Writing went up since the level test." -->
    <plurals name="language_levels_rose">
        <item quantity="other">%1$sのレベルが、レベルテスト時より上がりました。</item>
    </plurals>
    <!-- Heads the list of things the learner is now able to do in the language, from the units they finished. -->
    <string name="language_can_already">できるようになったこと…</string>
    <!-- Read by TalkBack after the next thing the learner will be able to do, which they can't do yet. -->
    <string name="language_can_do_not_yet">まだできません</string>
    <!-- What TalkBack says for a level and the level the learner aims for, shown as "B1 → B2": "B1, goal B2". -->
    <string name="language_level_toward_goal">%1$s、目標は%2$s</string>
    <string name="language_pattern_noticed">ミスの傾向が見つかりました</string>
    <string name="language_pattern_typos">入力ミスだけです</string>
    <string name="language_pattern_typos_description">最近の間違いはうっかりミスで、新しく覚えるルールはありません。</string>
    <!-- A practice row. %d is how many words are due to be said out loud again, a count, never a word's number: "Say 2 words again" means repeat two words. -->
    <plurals name="language_say_again">
        <item quantity="other">%d語をもう一度声に出して言う</item>
    </plurals>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_first_next_session">次の学習の最初に · %1$s</string>
    <!-- %1$s is how long the alphabet lesson takes, such as "10 min". -->
    <string name="language_alphabet_anytime">いつでも練習できます · %1$s</string>
    <!-- Skips the alphabet lesson for a learner who reads the script. -->
    <string name="language_alphabet_skip">すでに読める</string>
    <string name="language_alphabet_skip_failed">保存できませんでした。もう一度お試しください。</string>
    <!-- Button that opens the words to say aloud again; "them" is those words. -->
    <string name="language_say_them">声に出して言う</string>
    <!-- Opens the noticed typos. -->
    <string name="language_typos_open">開く</string>
    <!-- %1$s names the rule the learner keeps getting wrong. -->
    <string name="language_pattern_noticed_summary">ミスの傾向が見つかりました：%1$s</string>
    <!-- Opens the noticed pattern. -->
    <string name="language_pattern_practice">練習する</string>
    <string name="language_level">レベル</string>
    <!-- %1$s is the learner's language level now, %2$s the level they aim for: "A2 → B1". -->
    <string name="language_level_toward">%1$s → %2$s</string>
    <!-- What TalkBack reads for "A2 → B1": %1$s is the level now, %2$s the level the learner aims for. -->
    <string name="language_level_toward_spoken">%1$s、目標は%2$s</string>
    <!-- Opens the Plan from Today's level. -->
    <string name="language_see_your_plan">学習計画を見る</string>
</resources>
