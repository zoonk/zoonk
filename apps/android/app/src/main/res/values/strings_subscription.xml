    <string name="subscription_cancel_failed">Unable to manage your subscription. Contact us at hello@zoonk.com</string>
    <!-- The title of the dialog that cancels a Plus bought on the web. -->
    <string name="subscription_cancel_title">Cancel Plus?</string>
    <!-- Within 14 days of subscribing. %1$s is the last day of the refund, like "Nov 14, 2026"; %2$s the amount, like "R$ 29,90". -->
    <string name="subscription_cancel_withdrawal">Until %1$s, you can get a full refund of %2$s. Plus ends right away.</string>
    <!-- Confirms withdrawing from the contract with a full refund. Use the official wording of the EU Consumer Rights Directive (art. 11a) in this language: in German exactly “Widerruf bestätigen”, in French “Confirmer la rétractation”, in Spanish “Confirmar desistimiento”, in Portuguese “Confirmar retratação”, in Italian “Conferma recesso”, in Polish “Potwierdź odstąpienie od umowy”. -->
    <string name="subscription_cancel_withdraw">Confirm withdrawal</string>
    <!-- Stopping the renewal. %1$s is the day Plus ends, like "Nov 14, 2026". -->
    <string name="subscription_cancel_at_period_end">You keep Plus until %1$s, then it ends. You won\'t be charged again.</string>
    <!-- Stopping the renewal after a yearly renewal. %1$s is the day Plus ends, like "Nov 14, 2026"; %2$s the amount refunded for the months that haven't started, like "R$ 99,90". -->
    <string name="subscription_cancel_at_period_end_refund">You keep Plus until %1$s. We refund %2$s for the months that haven\'t started.</string>
    <!-- Stops the renewal, so Plus ends at the end of what's paid. German law (BGB § 312k) requires this button to read exactly "Jetzt kündigen" in German. -->
    <string name="subscription_cancel_confirm">Cancel now</string>
    <!-- Closes the cancel dialog without canceling. -->
    <string name="subscription_keep_plus">Keep Plus</string>
