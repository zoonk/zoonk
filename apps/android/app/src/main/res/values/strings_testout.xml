    <string name="testout_rule">%1$d%% right skips the chapter. No feedback until the end.</string>
    <string name="testout_aside_title">What a pass skips</string>
    <plurals name="testout_lessons_left">
        <item quantity="one">%d lesson left</item>
        <item quantity="other">%d lessons left</item>
    </plurals>

    <string name="testout_passed">You already know this</string>
    <string name="testout_not_passed">Not yet, and that\'s fine</string>
    <string name="testout_not_passed_detail">The chapter stays in your plan, and your answers help it start at the right level.</string>
    <!-- The learner passed this chapter\'s test. "It" is the chapter. -->
    <string name="testout_already_skipped">Your plan already skips it.</string>
    <!-- The learner passed this chapter\'s test, so these lessons left the plan. -->
    <plurals name="testout_lessons_off">
        <item quantity="one">%d lesson is off your plan.</item>
        <item quantity="other">%d lessons are off your plan.</item>
    </plurals>
    <string name="testout_lessons_back">The lessons are back in your plan.</string>
    <string name="testout_continue">Continue</string>
</resources>
