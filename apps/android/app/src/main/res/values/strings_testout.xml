<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A chapter test-out's title. %1$s is the chapter's name. -->
    <string name="testout_title">Test out: %1$s</string>
    <!-- Stands in for a chapter's name while it isn't known. -->
    <string name="testout_this_chapter">This chapter</string>
    <string name="testout_intro_title">Already know this?</string>
    <string name="testout_intro_detail">A few questions on this chapter. Do well, and your plan skips what you already know.</string>
    <string name="testout_start">Start the test</string>
    <string name="testout_starting">Starting…</string>
    <string name="testout_see_plus">See Plus</string>

    <string name="testout_writing">Writing your questions</string>
    <string name="testout_writing_questions">Writing questions on this chapter</string>
    <string name="testout_writing_line">Picking the skills to ask about…</string>
    <string name="testout_writing_title">Getting your test ready</string>
    <string name="testout_writing_detail">We\'re writing a few questions on this chapter. The test opens here when they\'re ready.</string>

