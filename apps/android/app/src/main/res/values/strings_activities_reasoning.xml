<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A grid like a Punnett square, where the learner fills each square. -->
    <string name="activities_reasoning_badge_fill_square">Fill the square</string>

    <!-- What a Punnett square shows, for TalkBack: the trait, then each parent with its alleles, like "A Punnett square for Flower color: Purple parent (Pp) down the side, White parent (pp) across the top." -->
    <string name="activities_reasoning_grid_punnett">A Punnett square for %1$s: %2$s (%3$s) down the side, %4$s (%5$s) across the top.</string>
    <!-- What a grid of sums shows, for TalkBack, like "Two dice: First die (1, 2, 3) down the side, Second die (1, 2, 3) across the top, each square their sum." -->
    <string name="activities_reasoning_grid_sums">%1$s: %2$s (%3$s) down the side, %4$s (%5$s) across the top, each square their sum.</string>
    <!-- What a grid of products shows, for TalkBack, like "Times table: Number (2, 3, 4) down the side, Times (1, 2, 3) across the top, each square their product." -->
    <string name="activities_reasoning_grid_products">%1$s: %2$s (%3$s) down the side, %4$s (%5$s) across the top, each square their product.</string>
    <!-- An empty square of the grid, for TalkBack: its number, then its row's and its column's values, like "Square 2, P and p: empty". -->
    <string name="activities_reasoning_grid_square_empty">Square %1$d, %2$s and %3$s: empty</string>
    <!-- A filled square of the grid, for TalkBack: its number, its row's and its column's values, then what's in it, like "Square 2, P and p: Pp, Purple". -->
    <string name="activities_reasoning_grid_square">Square %1$d, %2$s and %3$s: %4$s</string>
    <!-- A genotype and the trait it shows, for TalkBack, like "Pp, Purple". -->
    <string name="activities_reasoning_grid_value_trait">%1$s, %2$s</string>
    <!-- A checked square the learner filled wrong, for TalkBack: the right value, then the learner's, like "Pp, Purple. Your answer: pp". -->
    <string name="activities_reasoning_grid_your_answer">%1$s. Your answer: %2$s</string>
    <!-- How many squares show the thing the check counted, like "2 of 4 squares: White" or "6 of 36 squares: 7". -->
    <plurals name="activities_reasoning_grid_counted">
        <item quantity="one">%1$d of %2$d square: %3$s</item>
        <item quantity="other">%1$d of %2$d squares: %3$s</item>
    </plurals>
    <!-- After the check, like "3 of 4 squares right". -->
    <plurals name="activities_reasoning_grid_right">
        <item quantity="one">%1$d of %2$d square right</item>
        <item quantity="other">%1$d of %2$d squares right</item>
    </plurals>
    <!-- While filling, like "5 of 9 squares filled". -->
    <plurals name="activities_reasoning_grid_filled">
        <item quantity="one">%1$d of %2$d square filled</item>
        <item quantity="other">%1$d of %2$d squares filled</item>
    </plurals>
    <!-- How many filled squares show each trait so far, out of all the squares, like "Purple: 2 of 4 · White: 1 of 4". -->
    <string name="activities_reasoning_grid_traits">%1$s: %2$d of %5$d · %3$s: %4$d of %5$d</string>
    <string name="activities_reasoning_grid_all_filled">Every square is filled. Tap one to change it.</string>
    <!-- Asks for the genotype of a square of a Punnett square, like "Which genotype goes in square 2?" -->
    <string name="activities_reasoning_grid_which_genotype">Which genotype goes in square %1$d?</string>
    <!-- Asks for the value of a square of a grid of numbers, like "What goes in square 2?" -->
    <string name="activities_reasoning_grid_what_goes">What goes in square %1$d?</string>

    <!-- Two sources the learner reads side by side to mark passages in each. -->
    <string name="activities_reasoning_badge_compare_sources">Compare sources</string>
    <!-- A TalkBack action on a source's text that marks one of its passages, like "Mark: The regulars fired on us". -->
    <string name="activities_reasoning_source_mark">Mark: %1$s</string>
    <!-- A TalkBack action on a source's text that unmarks one of its passages, like "Unmark: The regulars fired on us". -->
    <string name="activities_reasoning_source_unmark">Unmark: %1$s</string>
    <!-- For TalkBack, after a source's text: the passages the learner marked in it, separated by semicolons. -->
    <string name="activities_reasoning_source_you_marked">You marked: %1$s.</string>
    <!-- For TalkBack, after a source's text with no passage marked. -->
    <string name="activities_reasoning_source_nothing_marked">Nothing marked yet.</string>
    <!-- For TalkBack once checked, after a source's text: the passages the learner should have marked, separated by semicolons. -->
    <string name="activities_reasoning_source_missed_passages">Missed: %1$s.</string>
    <!-- Legend once checked: the tint of the passages the question was about. -->
    <string name="activities_reasoning_source_what_to_mark">What to mark</string>
    <!-- Legend once checked: the dashed line under a passage the learner should have marked. -->
    <string name="activities_reasoning_source_missed">Missed</string>

    <!-- A map the learner explores by tapping its numbered places. -->
    <string name="activities_reasoning_badge_explore_map">Explore the map</string>
    <!-- How many of the map's places the learner has opened, out of all of them, like "2 of 3 explored". -->
    <plurals name="activities_reasoning_map_explored">
        <item quantity="one">%1$d of %2$d explored</item>
        <item quantity="other">%1$d of %2$d explored</item>
    </plurals>
    <string name="activities_reasoning_map_hint">Tap a numbered place to see what\'s there.</string>
    <!-- A numbered place on the map, like "1. Broad Street pump". -->
    <string name="activities_reasoning_map_place">%1$d. %2$s</string>
    <!-- The name of the list of the map's places, for TalkBack. -->
    <string name="activities_reasoning_map_places">Places</string>
    <!-- What the map shows, for TalkBack: its name, then its numbered places, like "Map of Soho, London, in 1854 with 3 places to explore: 1. Broad Street pump, 2. Brewery on Broad Street, 3. Poland Street workhouse." -->
    <plurals name="activities_reasoning_map_description">
        <item quantity="one">%1$s with %2$d place to explore: %3$s.</item>
        <item quantity="other">%1$s with %2$d places to explore: %3$s.</item>
    </plurals>
    <string name="activities_reasoning_map_unavailable">This map can\'t be shown. Continue to the next screen.</string>
