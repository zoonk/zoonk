    <string name="activities_reasoning_map_world_continents">World map of the continents</string>
    <!-- Below a historical map whose borders are drawn simply. -->
    <string name="activities_reasoning_map_note_borders">Borders are simplified.</string>
    <!-- Below the 1854 map of Soho, drawn after the map the physician John Snow made of a cholera outbreak. -->
    <string name="activities_reasoning_map_note_london_1854">Simplified street plan, after John Snow\'s 1854 map.</string>
