<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="activities_sorting_badge_sort_groups">Sort into groups</string>

    <!-- Above the items still to sort into groups. -->
    <string name="activities_sorting_to_sort">To sort</string>
    <string name="activities_sorting_all_sorted">All sorted. Check when you\'re ready.</string>
    <!-- How many items are in a group so far, like "1 of 3 sorted". -->
    <string name="activities_sorting_sorted_count">%1$d of %2$d sorted</string>
    <!-- Places the picked item in a group, like "Put Melting ice in Same substance". Also a TalkBack action on each item. -->
    <string name="activities_sorting_put_in">Put %1$s in %2$s</string>
    <!-- In an empty group while an item is picked. -->
    <string name="activities_sorting_put_it_here">Put it here</string>
    <!-- In an empty group. -->
    <string name="activities_sorting_nothing_here">Nothing here yet</string>
    <!-- Read by TalkBack when an item is placed, like "Melting ice is in Same substance. 2 of 3 sorted." -->
    <string name="activities_sorting_placed">%1$s is in %2$s. %3$d of %4$d sorted.</string>
    <!-- An item once checked, for TalkBack, like "Melting ice, right group". -->
    <string name="activities_sorting_right_group">%1$s, right group</string>
    <!-- An item once checked, for TalkBack, like "Melting ice, wrong group". -->
    <string name="activities_sorting_wrong_group">%1$s, wrong group</string>
    <!-- How many items were sorted right, like "2 of 3 in the right group". -->
    <string name="activities_sorting_right_count">%1$d of %2$d in the right group</string>
    <!-- A misplaced item's group, like "Burning wood belongs in New substance." -->
    <string name="activities_sorting_belongs_in">%1$s belongs in %2$s.</string>

    <string name="activities_sorting_badge_put_in_order">Put in order</string>
    <!-- The name of the list of a process's steps the learner orders, for TalkBack. -->
    <string name="activities_sorting_steps_in_your_order">Steps, in your order</string>
    <string name="activities_sorting_drag_steps">Hold and drag the steps into order.</string>
    <!-- Above a process's steps in their true order, once checked. -->
    <string name="activities_sorting_right_order">The right order</string>
    <!-- Where the learner had a step that's out of place, like "You had it at 3". -->
    <string name="activities_sorting_you_had_it_at">You had it at %1$d</string>
</resources>
