<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="activities_sorting_badge_sort_groups">Sort into groups</string>

    <!-- Above the items still to sort into groups. -->
    <string name="activities_sorting_to_sort">To sort</string>
    <string name="activities_sorting_all_sorted">All sorted. Check when you\'re ready.</string>
    <!-- How many items are in a group so far, like "1 of 3 sorted". -->
    <string name="activities_sorting_sorted_count">%1$d of %2$d sorted</string>
    <!-- Places the picked item in a group, like "Put Melting ice in Same substance". Also a TalkBack action on each item. -->
    <string name="activities_sorting_put_in">Put %1$s in %2$s</string>
    <!-- In an empty group while an item is picked. -->
    <string name="activities_sorting_put_it_here">Put it here</string>
    <!-- In an empty group. -->
    <string name="activities_sorting_nothing_here">Nothing here yet</string>
    <!-- Read by TalkBack when an item is placed, like "Melting ice is in Same substance. 2 of 3 sorted." -->
    <string name="activities_sorting_placed">%1$s is in %2$s. %3$d of %4$d sorted.</string>
    <!-- An item once checked, for TalkBack, like "Melting ice, right group". -->
    <string name="activities_sorting_right_group">%1$s, right group</string>
    <!-- An item once checked, for TalkBack, like "Melting ice, wrong group". -->
    <string name="activities_sorting_wrong_group">%1$s, wrong group</string>
    <!-- How many items were sorted right, like "2 of 3 in the right group". -->
    <string name="activities_sorting_right_count">%1$d of %2$d in the right group</string>
    <!-- A misplaced item's group, like "Burning wood belongs in New substance." -->
    <string name="activities_sorting_belongs_in">%1$s belongs in %2$s.</string>

    <string name="activities_sorting_badge_put_in_order">Put in order</string>
    <!-- The name of the list of a process's steps the learner orders, for TalkBack. -->
    <string name="activities_sorting_steps_in_your_order">Steps, in your order</string>
    <string name="activities_sorting_drag_steps">Hold and drag the steps into order.</string>
    <!-- Above a process's steps in their true order, once checked. -->
    <string name="activities_sorting_right_order">The right order</string>
    <!-- Where the learner had a step that's out of place, like "You had it at 3". -->
    <string name="activities_sorting_you_had_it_at">You had it at %1$d</string>

    <string name="activities_sorting_badge_match_pairs">Match pairs</string>
    <!-- Pairs matched so far, like "1 of 3 pairs matched". -->
    <string name="activities_sorting_pairs_matched">%1$d of %2$d pairs matched</string>
    <!-- Cards that look like they match one on the other side but don't. -->
    <plurals name="activities_sorting_cards_without_match">
        <item quantity="one">%d card has no match</item>
        <item quantity="other">%d cards have no match</item>
    </plurals>
    <!-- The name of the two columns of cards, for TalkBack. -->
    <string name="activities_sorting_cards_to_match">Cards to match</string>
    <!-- A matched card, for TalkBack, like "pregnant, matched". -->
    <string name="activities_sorting_card_matched">%1$s, matched</string>
    <!-- A card with no match, for TalkBack, like "embarrassed, no match". -->
    <string name="activities_sorting_card_no_match">%1$s, no match</string>
    <!-- Read by TalkBack after a match, like "Matched éxito with success. 2 of 3 pairs matched." -->
    <string name="activities_sorting_matched">Matched %1$s with %2$s. %3$d of %4$d pairs matched.</string>
    <!-- Starts the reason a picked card has no match, like "“embarrassed” has no match." -->
    <string name="activities_sorting_no_match_note">“%1$s” has no match.</string>
    <!-- Read by TalkBack after a wrong pair, like "éxito and pregnant don't go together." -->
    <string name="activities_sorting_dont_go_together">%1$s and %2$s don\'t go together.</string>
    <string name="activities_sorting_dont_go_together_short">Those two don\'t go together.</string>
    <!-- Before why a pair is wrong. -->
    <string name="activities_sorting_not_quite">Not quite:</string>
    <!-- Above the pairs the learner got wrong on the first try. -->
    <string name="activities_sorting_missed_first_try">Missed on the first try</string>
    <!-- A pair missed on the first try, like "embarazada goes with pregnant, not embarrassed." -->
    <string name="activities_sorting_goes_with">%1$s goes with %2$s, not %3$s.</string>
    <!-- Above the cards that look like a match but have none. -->
    <string name="activities_sorting_look_alikes">Look-alikes with no match</string>

    <string name="activities_sorting_badge_link_causes">Link causes</string>
    <string name="activities_sorting_pick_cause">Pick a cause, then pick what it led to.</string>
    <!-- After a cause is picked, like "Now pick what Years of drought led to." -->
    <string name="activities_sorting_now_pick">Now pick what %1$s led to.</string>
    <!-- Links made so far out of all, like "1 of 2 links". -->
    <plurals name="activities_sorting_links_count">
        <item quantity="one">%1$d of %2$d link</item>
        <item quantity="other">%1$d of %2$d links</item>
    </plurals>
    <!-- On the picked card: what it caused comes next. -->
    <string name="activities_sorting_cause">Cause</string>
    <!-- A link that isn't in the story, like "Dust storms didn't lead straight to Prairie plowed for wheat here. Try another link." -->
    <string name="activities_sorting_not_straight">%1$s didn\'t lead straight to %2$s here. Try another link.</string>
    <!-- After a link is taken away, like "Removed: Years of drought led to Dust storms." -->
    <string name="activities_sorting_removed">Removed: %1$s led to %2$s.</string>
    <!-- After a link is made, like "Linked: Years of drought led to Dust storms." -->
    <string name="activities_sorting_linked">Linked: %1$s led to %2$s.</string>
    <!-- After a cause is picked, like "Years of drought picked. Now pick what it led to." -->
    <string name="activities_sorting_cause_picked">%1$s picked. Now pick what it led to.</string>
    <!-- The name of the list of causes and effects, for TalkBack. -->
    <string name="activities_sorting_causes_and_effects">Causes and effects</string>
    <!-- The name of the list of links made, for TalkBack. -->
    <string name="activities_sorting_your_links">Your links</string>
    <!-- Read by TalkBack in place of the arrow between a cause and its effect. -->
    <string name="activities_sorting_led_to">led to</string>
    <!-- Under a link the learner made that the story doesn't have. -->
    <string name="activities_sorting_not_a_link">Not a link in this story</string>
    <!-- Under a link the story has that the learner didn't make. -->
    <string name="activities_sorting_missed_link">Missed link</string>
    <!-- A button that takes a link away, like "Remove the link from Years of drought to Dust storms". -->
    <string name="activities_sorting_remove_link">Remove the link from %1$s to %2$s</string>
</resources>
