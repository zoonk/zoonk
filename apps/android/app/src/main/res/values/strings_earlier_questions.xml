<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Title of the page that keeps the questions the learner asked about lessons before every course was rewritten. -->
    <string name="earlier_questions_title">Earlier questions</string>
    <!-- Keep "before we rewrote them": every course was rewritten, which is why these questions moved here. -->
    <string name="earlier_questions_description">What you asked in your courses before we rewrote them. The lessons changed, so your questions stay here to reread.</string>
    <string name="earlier_questions_empty">You have no earlier questions.</string>
    <!-- Above a question about a lesson that no longer exists. %1$s is the course's title as the learner saw it, %2$s the lesson's. -->
    <string name="earlier_questions_from_course_lesson">From an earlier version of %1$s · %2$s</string>
    <!-- Above a question about a lesson that no longer exists. %1$s is the course's title as the learner saw it. -->
    <string name="earlier_questions_from_course">From an earlier version of %1$s</string>
    <!-- Above a question about a lesson that no longer exists, when the course's title wasn't saved. %1$s is the lesson's title. -->
    <string name="earlier_questions_from_lesson">From an earlier version of this course · %1$s</string>
    <!-- Above a question about a lesson that no longer exists, when neither title was saved. -->
    <string name="earlier_questions_from">From an earlier version of this course</string>
    <string name="earlier_questions_no_answer">No answer was saved.</string>
    <!-- Loads the next page of the learner's earlier questions. -->
    <string name="earlier_questions_older">Older questions</string>
    <string name="earlier_questions_older_failed">Couldn\'t load older questions. Try again.</string>
</resources>
