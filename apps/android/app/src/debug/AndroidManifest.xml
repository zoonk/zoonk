<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 17 counts the emulator's host (10.0.2.2) and .local names as the local network. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="com.zoonk.android.gallery.GalleryActivity"
            android:exported="true" />
        <!-- adb's shell holds DUMP, so `adb shell am broadcast` reaches it and other apps can't. -->
        <receiver
            android:name="com.zoonk.android.app.DebugSignInReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.zoonk.debug.SIGN_IN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
