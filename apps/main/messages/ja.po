msgid "and {count} more"
msgstr "ほか{count}トピック"

#. A certificate's fact: the day the learner finished the course or level.
#: src/lib/certificates/certificate-study-view.ts
msgctxt "95stPq"
msgid "Completed"
msgstr "修了日"

#. A certificate's fact: how many of the plan's lessons the learner studied.
#: src/lib/certificates/certificate-study-view.ts
msgctxt "mrBiB2"
msgid "Lessons studied"
msgstr "学習したレッスン数"

#. A certificate's fact: lessons the learner skipped by passing a test, said for outsiders.
#: src/lib/certificates/certificate-study-view.ts
msgctxt "dx3nJs"
msgid "Passed by test"
msgstr "テスト合格で免除されたレッスン数"

#. A certificate's fact: about how long the studied lessons take. In Brazilian Portuguese: “Carga horária”.
#: src/lib/certificates/certificate-study-view.ts
msgctxt "KHL8ap"
msgid "Study time"
msgstr "学習時間"

#. A certificate's study time, the plan's estimate for the lessons studied, such as “about 41 hr”. Brazilian schools read it as the certificate's workload (carga horária).
#: src/lib/certificates/certificate-study-view.ts
msgctxt "8QINPM"
msgid "about {duration}"
msgstr "約{duration}"

#. Under a big number on a certificate's social post: how many lessons the learner studied.
#: src/lib/certificates/certificate-study-view.ts
msgctxt "hYLeZv"
msgid "{count, plural, =0 {lessons studied} one {lesson studied} other {lessons studied}}"
msgstr "{count, plural, =0 {学習したレッスン} other {学習したレッスン}}"

#. Under a big number of hours on a certificate's social post, such as “~41 h” over “of study”.
#: src/lib/certificates/certificate-study-view.ts
msgctxt "6SwZ60"
msgid "of study"
msgstr "学習時間"

#. Shown on a certificate where the learner's name goes, until they add one to their profile.
#: src/lib/certificates/certificate-view.ts
msgctxt "vlKhIl"
msgid "Your name"
msgstr "氏名"

#. The kind of document, above the learner's name on a certificate.
#: src/lib/certificates/certificate-view.ts
msgctxt "zaINXN"
msgid "Certificate of completion"
msgstr "修了証明書"

#. Above a certificate's link and QR code, which open the page that proves it's real.
#: src/lib/certificates/certificate-view.ts
msgctxt "5FXh-Z"
msgid "Verify this certificate"
msgstr "この証明書を確認する"

#. The fine print on a language level certificate, such as B1.
#: src/lib/certificates/certificate-view.ts
msgctxt "0ytAdy"
msgid "Awarded for finishing this level on Zoonk. This is not an official exam result."
msgstr "Zoonkでこのレベルを修了した方に授与される証明書です。公式の試験結果ではありません。"

#. How a language level certificate was earned. The level follows the CEFR scale, without claiming official recognition.
#: src/lib/certificates/certificate-view.ts
msgctxt "PrhNZj"
msgid "Level completed · aligned with the CEFR"
msgstr "レベル修了・CEFRに準拠"

#. A course level certificate's level, such as “Beginner level”.
#: src/lib/certificates/certificate-view.ts
msgctxt "XmHKKJ"
msgid "{level} level"
msgstr "{level}レベル"

#. Above the topics a finished course covered, on its certificate.
#: src/lib/certificates/certificate-view.ts
msgctxt "fAGVcM"
msgid "Topics covered"
msgstr "学習したトピック"

#. The fine print on a course level's certificate.
#: src/lib/certificates/certificate-view.ts
msgctxt "anftNZ"
msgid "Awarded for finishing every lesson and challenge of this level on Zoonk."
msgstr "Zoonkでこのレベルのすべてのレッスンとチャレンジを修了した証として発行されます。"

#. The fine print on a certificate for a learner's whole study plan in a course, which may cover only part of the course: the topics it lists.
#: src/lib/certificates/certificate-view.ts
msgctxt "Sadn8K"
msgid "Awarded for finishing every lesson and challenge of a study plan on Zoonk."
msgstr "Zoonkで学習計画に含まれるすべてのレッスンとチャレンジを修了した証として発行されます。"

