#: src/components/pricing/plus-pricing.tsx
msgctxt "DfjjXa"
msgid "Zoonk Plus: plans and pricing"
msgstr "Zoonk Plus: formule e prezzi"

#: src/components/pricing/plus-pricing.tsx
msgctxt "rmN6Kk"
msgid "Start free. <rest>Plus when you want everything.</rest>"
msgstr "Inizia gratis. <rest>Passa a Plus quando vuoi tutto.</rest>"

#. “Free” and “Plus” are the names of the two subscription tiers.
#: src/components/pricing/plus-pricing.tsx
msgctxt "xrpz7X"
msgid "Free covers one goal at a time. Plus covers every goal, all the way to the big day."
msgstr "Con Free segui un obiettivo alla volta. Con Plus segui tutti i tuoi obiettivi fino al grande giorno."

#: src/components/pricing/plus-questions.tsx
msgctxt "1vrigA"
msgid "Start free with {count, plural, one {# lesson} other {# lessons}}, no account needed. With a free account, you get:"
