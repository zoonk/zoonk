msgctxt "a1ec1o"
msgid "I missed a day and it all fell apart."
msgstr "Jeden dzień przerwy i wszystko się posypało."

#: src/app/[lang]/(home)/_components/missed-day-section.tsx
msgctxt "qRIKt4"
msgid "<b>It happens.</b> What's left from yesterday comes first today. If a date changes, your plan tells you."
msgstr "<b>Zdarza się.</b> To, co zostało z wczoraj, trafia na początek dzisiejszego planu. Jeśli zmieni się termin, plan cię o tym poinformuje."

