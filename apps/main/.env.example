# Authentication secret for better-auth
# You can generate a random secret using a command like:
# openssl rand -hex 32
# You can also click the "Generate Secret" button from the better-auth docs:
# https://www.better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET=

# Database connection URL for Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/zoonk

# Direct database connection URL for Prisma Migrate
DATABASE_URL_UNPOOLED=

# This app's domain (eg localhost:3000, zoonk.com)
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Centralized API App URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Core asks the API to run a learner's follow-ups (preparing lessons, memory, mistake causes) with
# it; the same value in Main and the API. `pnpm dev` sets one for local runs.
# openssl rand -hex 32
APP_FOLLOW_UP_SECRET=

### OPTIONAL VARIABLES ###

# Mailer API key for email services
MAILER_API_KEY=

# Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Blob signs in with the project's OIDC token. Locally, link this app once (`vercel link`,
# project zoonk) and stay signed in to the Vercel CLI: the SDK fetches and refreshes the token
# itself. Set the dev stores' ids here, since scripts read only this file (`vercel blob
# list-stores` shows them).
# Public store: shared Library media, served by the CDN
BLOB_STORE_ID=
# Private store: learners' uploads and private course pictures
PRIVATE_BLOB_STORE_ID=

# AI Services
AI_GATEWAY_API_KEY=
# OpenAI directly, for what AI Gateway doesn't offer: gpt-transcribe for spoken answers and live calls
OPENAI_API_KEY=

# Sentry monitoring
NEXT_PUBLIC_SENTRY_DSN=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Android App Links (/.well-known/assetlinks.json): the SHA-256 fingerprints of the certificates
# that sign the app, comma-separated, as `keytool -list -v` prints them (AA:BB:…). Release
# (com.zoonk): Play Console's App signing key certificate. Debug (com.zoonk.debug): the local
# debug keystore. A build without one leaves that app out of the file.
ANDROID_RELEASE_CERT_FINGERPRINTS=
ANDROID_DEBUG_CERT_FINGERPRINTS=
