# Authentication secret for better-auth
# You can generate a random secret using a command like:
# openssl rand -hex 32
# You can also click the "Generate Secret" button from the better-auth docs:
# https://www.better-auth.com/docs/installation#set-environment-variables
BETTER_AUTH_SECRET=

# Database connection URL for Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/zoonk

# Direct database connection URL for Prisma Migrate
DATABASE_URL_UNPOOLED=

# This app's domain (eg localhost:3000, zoonk.com)
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Centralized API App URL
NEXT_PUBLIC_API_URL=http://localhost:4000

### OPTIONAL VARIABLES ###

# Mailer API key for email services
MAILER_API_KEY=

# Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Blob. On Vercel, calls sign in with OIDC through the store ids Vercel adds when a store is
# connected (BLOB_STORE_ID for the public store, PRIVATE_BLOB_STORE_ID for the private one), so
# these read-write tokens are only for local development.
# Public store: shared Library media, served by the CDN
BLOB_READ_WRITE_TOKEN=
# Private store: learners' uploads and private course pictures
PRIVATE_BLOB_READ_WRITE_TOKEN=

# AI Services
AI_GATEWAY_API_KEY=
# OpenAI directly, for what AI Gateway doesn't offer: gpt-transcribe for spoken answers and gpt-4o-mini-tts
OPENAI_API_KEY=

# Sentry monitoring
NEXT_PUBLIC_SENTRY_DSN=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
