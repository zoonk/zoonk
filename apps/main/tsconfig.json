{
  "compilerOptions": { "allowImportingTsExtensions": true, "paths": { "@/*": ["./src/*"] } },
  "exclude": ["node_modules"],
  "extends": "@zoonk/tsconfig/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/app/.well-known/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ]
}
