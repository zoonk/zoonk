# Nothing here is needed to run locally (`pnpm dev`, `pnpm start`, tests): each variable turns on a
# service or replaces a local default.

# Better Auth's secret, the same in Main, the API and Admin. Local runs share a built-in one.
# openssl rand -hex 32
BETTER_AUTH_SECRET=

# Defaults to postgres://postgres:postgres@localhost:5432/zoonk, which `pnpm db:setup` prepares.
# Deployments set both; migrations use the unpooled (direct) one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# This app's domain (eg admin.zoonk.com). Local runs use the address they serve at.
NEXT_PUBLIC_APP_DOMAIN=

# The API's URL, which `pnpm dev` and `pnpm start` set
NEXT_PUBLIC_API_URL=

# Mailer API key; without it, local runs deliver email to the local mailbox
MAILER_API_KEY=

# Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

