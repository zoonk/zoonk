# Use the same secret used in the `main` app
BETTER_AUTH_SECRET=

# Database connection URL for Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/zoonk

# Direct database connection URL for Prisma Migrate
DATABASE_URL_UNPOOLED=

# This app's domain (eg localhost:3200, admin.zoonk.com)
NEXT_PUBLIC_APP_DOMAIN=localhost:3200

# Centralized API App URL
NEXT_PUBLIC_API_URL=http://localhost:4000

### OPTIONAL VARIABLES ###

# Mailer API key for email services
MAILER_API_KEY=

# Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PostHog read access for AI cost and latency on /ai. A personal API key with the
# "Query Read" scope and the project's numeric ID. The host defaults to https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=
