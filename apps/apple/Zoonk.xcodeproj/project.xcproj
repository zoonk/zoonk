{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "de",
      "es",
      "fr",
      "pt",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/google/GoogleSignIn-iOS",
      "version": {
        "up-to-next-major-version": "10.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-openapi-generator",
      "version": {
        "up-to-next-major-version": "1.13.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-openapi-runtime",
      "version": {
        "up-to-next-major-version": "1.12.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-openapi-urlsession",
      "version": {
        "up-to-next-major-version": "1.3.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-http-types",
      "version": {
        "up-to-next-major-version": "1.8.0",
      },
    },
  ],
  "files": [
    { "path": "Configuration/Debug.xcconfig" },
    { "path": "Configuration/Release.xcconfig" },
    {
      "kind": "group",
      "name": "UI Test Resources",
      "children": [
        { "path": "Zoonk/Resources/StoreKit/Subscriptions.storekit", "target-membership": [ "ZoonkUITests/resources" ] },
      ],
    }, {
      "kind": "folder",
      "path": "Zoonk",
      "target-membership": [
        "Zoonk",
      ],
      "membership-exceptions": [
        {
          "target": "Zoonk",
          "exclusions": [
            "Info-Debug.plist",
            "Info.plist",
            "Resources/StoreKit/Subscriptions.storekit",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "ZoonkTests", "target-membership": [ "ZoonkTests" ] },
    { "kind": "folder", "path": "ZoonkUITests", "target-membership": [ "ZoonkUITests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Zoonk.app", "id": "BEB8AB5E3022709A00E0E150", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ZoonkTests.xctest", "id": "5A0A01000000000000000001", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/ZoonkUITests.xctest", "id": "BEB8AB773022709B00E0E150", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Zoonk",
      "id": "BEB8AB5D3022709A00E0E150",
      "product": "Products/Zoonk.app",
      "product-type": "application",
      "specialized-configurations": [
        { "name": "Debug", "file": "Debug.xcconfig" },
        { "name": "Release", "file": "Release.xcconfig" },
      ],
      "dependencies": [
        { "kind": "package", "package": "swift-openapi-generator", "product-name": "OpenAPIGenerator", "product-type": "build-tool-plugin" },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "GoogleSignIn-iOS",
          "product-name": "GoogleSignIn",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-http-types",
          "product-name": "HTTPTypes",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-openapi-runtime",
          "product-name": "OpenAPIRuntime",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-openapi-urlsession",
          "product-name": "OpenAPIURLSession",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "Zoonk/Zoonk.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "CGXYKAQUT9",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "NO",
        "INFOPLIST_KEY_CFBundleDisplayName": "Zoonk",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.education",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "nonisolated",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "ZOONK_API_BASE_URL[config=Debug]": "$(ZOONK_DEVELOPMENT_API_BASE_URL)",
        "ZOONK_API_BASE_URL[config=Release]": "https://api.zoonk.com",
      },
    }, {
      "name": "ZoonkTests",
      "id": "5A0A01030000000000000001",
      "product": "Products/ZoonkTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "Zoonk",
      "dependencies": [
        "Zoonk",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "CGXYKAQUT9",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Debug]": "com.zoonk.dev.ZoonkTests",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Release]": "com.zoonk.ZoonkTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Zoonk.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Zoonk",
      },
    }, {
      "name": "ZoonkUITests",
      "id": "BEB8AB763022709B00E0E150",
      "product": "Products/ZoonkUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "Zoonk",
      "dependencies": [
        "Zoonk",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "CGXYKAQUT9",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Debug]": "com.zoonk.dev.ZoonkUITests",
        "PRODUCT_BUNDLE_IDENTIFIER[config=Release]": "com.zoonk.ZoonkUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "Zoonk",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "CGXYKAQUT9",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "26.6",
}
