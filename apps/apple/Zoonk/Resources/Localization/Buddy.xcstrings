    "%@ took a nap. Anything you learn wakes it up." : {
      "comment" : "The buddy naps; the argument is its name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat ein Nickerchen gemacht. Alles, was du lernst, weckt es wieder auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ha echado una siesta. Cualquier cosa que aprendas hará que se despierte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a fait une sieste. Chaque leçon le réveille."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tirou uma soneca. Aprender qualquer coisa já ajuda a acordar."
