    "%@ is napping. Study to wake it up." : {
      "comment" : "The buddy naps; the argument is its name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macht ein Nickerchen. Lernen macht wieder wach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está tomando una siesta. Estudia para que despierte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait la sieste. Étudie pour l’aider à se réveiller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fa un pisolino. Studia e si sveglierà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はお昼寝中です。学習すると目を覚まします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(이)가 낮잠을 자고 있어요. 공부해서 깨워 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ drzemie. Poucz się, żeby przerwać drzemkę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está cochilando. Estude para espantar o sono."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uyukluyor. Uyandırmak için ders çalış."
          }
        }
      }
    },
