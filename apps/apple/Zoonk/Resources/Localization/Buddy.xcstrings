    "%@ took a nap. Anything you learn wakes it up." : {
      "comment" : "The buddy naps; the argument is its name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macht ein Nickerchen. Wenn du etwas lernst, wacht dein Kumpel wieder auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se tomó una siesta. Basta con aprender algo para que despierte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait une sieste. Il suffit d’apprendre quelque chose pour le réveiller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fa un pisolino. Basta imparare qualcosa e si sveglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はお昼寝中です。何か学ぶと目を覚まします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(이)가 낮잠을 자고 있어요. 무엇이든 배우면 깨어나요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ drzemie. Wystarczy nauczyć się czegoś, by przerwać drzemkę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tirou uma soneca. Aprender qualquer coisa faz %1$@ acordar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uykuya daldı. Bir şey öğrenince uyanır."
          }
        }
      }
    },
