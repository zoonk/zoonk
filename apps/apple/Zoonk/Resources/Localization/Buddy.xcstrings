    "Hi! I'm %@, your AI study buddy. Ask me anything, or tell me what to change in your plan." : {
      "comment" : "The buddy's hello at the top of its conversation; the argument is its name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi! Ich bin %@, dein KI-Lernkumpel. Frag mich, was du möchtest, oder sag mir, was ich an deinem Plan ändern soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Hola! Soy %@, tu compañero de estudio con IA. Pregúntame lo que quieras o dime qué cambiar en tu plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salut ! Moi, c’est %@, ton compagnon d’étude IA. Pose-moi toutes tes questions ou dis-moi quoi changer dans ton plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao! Sono %@, il tuo compagno di studio con l’IA. Chiedimi quello che vuoi o dimmi cosa cambiare nel tuo piano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは！わたしは%@です。学習の相棒としてお手伝いするAIです。何でも聞いてください。学習計画で変えたいことも教えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요! 저는 AI 공부 짝꿍 %@(이)라고 해요. 무엇이든 물어보거나 계획에서 바꾸고 싶은 점을 알려 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cześć! Tu %@, twój kumpel do nauki z AI. Pytaj o wszystko albo powiedz, co zmienić w twoim planie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oi! Sou %@, uma IA que te ajuda a estudar. Pergunte o que quiser ou me diga o que mudar no seu plano."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba! Ben %@, yapay zekâ destekli ders arkadaşın. Aklına geleni sor ya da planında neleri değiştirmemi istediğini söyle."
          }
        }
      }
    },
    "Hi! I'm %@, your AI study buddy. Tell me what you want to learn, and I'll build your plan." : {
