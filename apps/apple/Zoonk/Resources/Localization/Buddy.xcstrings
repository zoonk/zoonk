        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje pytania z wcześniejszych wersji kursów. Lekcje się zmieniły, więc pytania zostają tutaj i możesz je ponownie przeczytać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
