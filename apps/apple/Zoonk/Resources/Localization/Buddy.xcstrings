    "%@ took a nap. Anything you learn wakes it up." : {
      "comment" : "The buddy naps; the argument is its name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macht ein Nickerchen. Wenn du etwas lernst, wacht dein Kumpel wieder auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está echando una siesta. Aprender cualquier cosa le despertará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fait une sieste. Il suffit d’apprendre quelque chose pour le réveiller."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tirou uma soneca. Aprender qualquer coisa faz %1$@ acordar."
