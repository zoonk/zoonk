            "value" : "Le idee principali del capitolo in un’immagine"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この章のポイントを1枚の図に"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
