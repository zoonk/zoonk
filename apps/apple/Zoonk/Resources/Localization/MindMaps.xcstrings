    "Finish a chapter to make its mind map: its main ideas in one picture." : {
      "comment" : "Explains how a chapter gets a mind map",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe ein Kapitel ab, um seine Mindmap zu erstellen: die wichtigsten Ideen auf einen Blick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa un capítulo para crear su mapa mental: sus ideas principales en una imagen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine un chapitre pour créer sa carte mentale : ses idées principales en une image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa un capitolo per crearne la mappa mentale: le idee principali in un’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "章の学習を終えると、要点を1枚の図にまとめたマインドマップを作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "챕터를 끝내면 핵심 내용을 한 장의 그림에 담은 마인드맵을 만들 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukończ rozdział, by utworzyć jego mapę myśli: najważniejsze informacje na jednym obrazku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conclua um capítulo para criar seu mapa mental: as ideias principais em uma imagem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir üniteyi bitir, ana fikirlerini tek bir görselde toplayan zihin haritasını oluştur."
          }
        }
      }
    },
