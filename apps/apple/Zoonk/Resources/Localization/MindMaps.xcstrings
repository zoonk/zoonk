    "%lld lessons get written first and count toward your free lessons." : {
      "comment" : "A free learner's map of a chapter whose lessons aren't written yet",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Wir erstellen zuerst %lld Lektion, die auf deine kostenlosen Lektionen angerechnet wird."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Wir erstellen zuerst %lld Lektionen, die auf deine kostenlosen Lektionen angerechnet werden."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%lld lesson gets written first and counts toward your free lessons."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%lld lessons get written first and count toward your free lessons."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Primero se prepara %lld lección y se descuenta de tus lecciones gratis."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Primero se preparan %lld lecciones y se descuentan de tus lecciones gratis."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld leçon est d’abord préparée et décomptée de ton quota de leçons gratuites."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld leçons sont d’abord préparées et décomptées de ton quota de leçons gratuites."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Prima prepariamo %lld lezione, che viene conteggiata tra le tue lezioni gratuite."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Prima prepariamo %lld lezioni, che vengono conteggiate tra le tue lezioni gratuite."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "まず%lldレッスンを作成します。無料レッスンの利用数に含まれます。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "레슨 %lld개를 먼저 만들고, 이 레슨도 무료 레슨 한도에 포함돼요."
                }
              }
            }
          }
        },
        "pl" : {
