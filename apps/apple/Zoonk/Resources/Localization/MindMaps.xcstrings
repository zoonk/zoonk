          }
        }
      }
    },
    "Its picture had mistakes, so here's the mind map as text." : {
      "comment" : "A map whose picture failed its check, shown as its outline",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Bild hatte Fehler. Deshalb findest du die Mindmap hier als Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen tenía errores, así que aquí tienes el mapa mental en texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image contenait des erreurs, voici donc la carte mentale sous forme de texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine conteneva errori, quindi ecco la mappa mentale in versione testuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図に間違いがあったため、マインドマップをテキストで表示しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그림에 잘못된 부분이 있어 마인드맵을 글로 보여 드려요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na obrazku były błędy, więc pokazujemy mapę myśli w formie tekstu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem tinha erros, então aqui está o mapa mental em texto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görselde hatalar vardı, bu yüzden zihin haritasını metin olarak gösteriyoruz."
          }
        }
      }
    },
