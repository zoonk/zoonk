    "Create your free account to continue." : {
      "comment" : "A guest must create an account to make a map",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstell dein kostenloses Konto, um weiterzumachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
