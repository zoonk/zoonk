    "You've made the mind map you can try without an account. Create a free account to make more." : {
      "comment" : "A guest made the one map they can without an account",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die Mindmap erstellt, die du ohne Konto ausprobieren kannst. Erstell ein kostenloses Konto, um weitere zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya creaste el mapa mental que puedes probar sin una cuenta. Crea una cuenta gratis para hacer más."
