    "Its lessons get written first and count toward your free lessons." : {
      "comment" : "A free learner's map of a chapter whose lessons aren't written yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst erstellen wir die Lektionen des Kapitels. Sie werden auf deine kostenlosen Lektionen angerechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero se preparan sus lecciones, que cuentan para tu límite de lecciones gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses leçons sont d’abord préparées et comptent dans ton quota de leçons gratuites."
