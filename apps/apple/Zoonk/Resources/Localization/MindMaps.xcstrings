        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 챕터의 레슨을 먼저 만들어요. 만든 레슨은 무료 레슨 한도에 포함돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw przygotowujemy lekcje z tego rozdziału, które wliczają się do twojego limitu bezpłatnych lekcji."
          }
        },
        "pt" : {
          "stringUnit" : {
