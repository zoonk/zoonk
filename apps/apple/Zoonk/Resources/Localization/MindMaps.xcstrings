      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mindmap konnte dieses Mal nicht erstellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta vez no se pudo crear."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte mentale n’a pas pu être créée cette fois-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa volta non siamo riusciti a crearla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回は作成できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번에는 만들지 못했어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tym razem nie udało się jej utworzyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível criar desta vez."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kez oluşturulamadı."
          }
        }
      }
    },
    "Its main ideas in one picture" : {
      "comment" : "What a chapter's mind map is",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wichtigste aus dem Kapitel in einem Bild"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus ideas principales en una imagen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses idées principales en une image"
          }
        },
        "it" : {
          "stringUnit" : {
