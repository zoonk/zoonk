        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie zaczniesz każdy przedmiot od podstaw."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por enquanto, você começa pelo básico em cada matéria."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdilik tüm branşlarda temelden başlıyorsun."
          }
        }
      }
    },
    "Your time can't cover everything. Your plan can give these more time." : {
      "comment" : "Suggested focus the learner can apply to their plan",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Lernzeit reicht nicht für alles. Dein Plan kann für diese Fächer mehr Zeit vorsehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tiempo no alcanza para todo. Tu plan puede dedicar más tiempo a estas materias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton temps d’étude ne permet pas de tout aborder. Ton plan peut consacrer plus de temps à ces matières."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo a disposizione non basta per tutto. Il tuo piano può dedicare più tempo a queste materie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてを学ぶには時間が足りません。これらの科目に時間を多く割く学習計画にできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주어진 시간으로는 모든 내용을 공부하기 어려워요. 계획에서 이 과목들에 시간을 더 배정할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czasu nie wystarczy na wszystko. Twój plan może przeznaczyć więcej czasu na te przedmioty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
