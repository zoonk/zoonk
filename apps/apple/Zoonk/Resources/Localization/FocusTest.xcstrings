{
  "sourceLanguage" : "en",
  "strings" : {
    "“I don't know yet” is a fine answer." : {
      "comment" : "How it works: under \"There's no grade\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ich weiß es noch nicht“ ist völlig in Ordnung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Aún no lo sé” es una buena respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux répondre « Je ne sais pas encore »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Non lo so ancora” va benissimo come risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「まだわかりません」で大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“아직 모르겠어요”라고 답해도 괜찮아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Jeszcze nie wiem” to dobra odpowiedź."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ainda não sei” é uma boa resposta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Henüz bilmiyorum” da geçerli bir cevap."
          }
        }
      }
    },
    "%@ left" : {
