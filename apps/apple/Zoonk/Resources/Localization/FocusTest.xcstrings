    },
    "Your subjects start from the basics for now." : {
      "comment" : "Where the plan starts after the Focus test, with nothing to skip yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du startest in deinen Fächern vorerst mit den Grundlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora, empezarás por lo básico en tus materias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’instant, tu commences par les bases dans chaque matière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ora, in ogni materia parti dalle basi."
