    "Tell us what you want to learn, and we'll plan every day until you get there." : {
      "comment" : "Explains what starting a goal does, on a page that needs one",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag uns, was du lernen möchtest, und wir planen jeden Tag bis zu deinem Ziel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos qué quieres aprender y planificaremos cada día hasta que lo consigas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis-nous ce que tu veux apprendre et nous préparerons ton plan jour après jour jusqu’à ce que tu y arrives."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conte o que você quer aprender e a gente vai planejar cada dia até você chegar lá."
