            "value" : "Sag uns, was du lernen möchtest, und wir planen jeden Tag bis zu deinem Ziel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinos qué quieres aprender y organizaremos tu estudio de cada día hasta que lo logres."
          }
