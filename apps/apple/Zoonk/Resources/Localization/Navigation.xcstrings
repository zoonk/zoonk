    "A chapter of your plan, with its lessons and how far you are." : {
      "comment" : "What a chapter page shows, under its title until it can open",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Kapitel deines Plans mit seinen Lektionen und deinem Fortschritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un capítulo de tu plan, con sus lecciones y tu avance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un chapitre de ton plan, avec ses leçons et ta progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un capitolo del tuo piano, con le lezioni e i tuoi progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学習計画の章に含まれるレッスンと、進み具合がわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획에 담긴 챕터의 레슨과 진도를 볼 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozdział twojego planu, jego lekcje i twoje postępy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um capítulo do seu plano, com as aulas e seu progresso."
          }
