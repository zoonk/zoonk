    "Energy goes up with every lesson and drops a little on days off." : {
      "comment" : "Under the Energy page's title: how Energy moves",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Energie steigt mit jeder Lektion und sinkt an lernfreien Tagen ein wenig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Energía sube con cada lección y baja un poco los días que descansas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Énergie augmente à chaque leçon et baisse un peu les jours de pause."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Energia aumenta con ogni lezione e cala un po’ nei giorni di riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エネルギーはレッスンを終えるたびに増え、休みの日には少し減ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에너지는 레슨을 마칠 때마다 오르고 쉬는 날에는 조금 줄어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Energia rośnie z każdą lekcją i trochę spada w dni bez nauki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Energia aumenta a cada aula e cai um pouco nos dias de descanso."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enerji her dersle artar ve ara verdiğin günlerde biraz azalır."
          }
        }
      }
