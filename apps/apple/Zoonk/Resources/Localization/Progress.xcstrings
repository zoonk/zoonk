    "Your score shows after your first answers." : {
      "comment" : "In place of the Score trend before the learner has answers",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Score erscheint nach deinen ersten Antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu puntaje aparecerá después de tus primeras respuestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton Score s’affichera après tes premières réponses."
          }
        },
        "it" : {
          "stringUnit" : {
