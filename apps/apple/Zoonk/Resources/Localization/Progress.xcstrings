        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te va mejor por la noche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu réussis mieux la nuit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendi meglio di notte."
          }
