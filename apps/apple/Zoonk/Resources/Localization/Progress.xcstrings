    "You answer about the same every day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du antwortest jeden Tag etwa gleich gut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te va más o menos igual todos los días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu réussis à peu près aussi bien chaque jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottieni risultati simili ogni giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの曜日も成績はほぼ同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 요일에 풀든 결과가 비슷해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdego dnia masz podobne wyniki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu desempenho é parecido todos os dias."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her gün benzer sonuçlar alıyorsun."
          }
        }
      }
    },
    "You earn Brain Power for everything you study, and it never goes down." : {
      "comment" : "Under the Belt page's title: how Brain Power grows",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für alles, was du lernst, bekommst du Brain Power. Der Wert sinkt nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ganas Poder Mental por todo lo que estudias y nunca disminuye."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu gagnes des points de Puissance Mentale pour tout ce que tu étudies, et tu n’en perds jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guadagni punti di Potenza Mentale per tutto quello che studi e non li perdi mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学習するたびに脳力がたまり、減ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공부할 때마다 두뇌력이 쌓이고, 한 번 쌓인 두뇌력은 줄어들지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdobywasz Moc Umysłu za wszystko, czego się uczysz, i nigdy jej nie tracisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ganha Poder Mental com tudo o que estuda, e ele nunca diminui."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalıştığın her şey sana Beyin Gücü kazandırır ve bu güç hiç azalmaz."
          }
        }
      }
    },
    "Your best day is %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein bester Tag ist %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mejor día es el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu réussis le mieux le %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo giorno migliore è %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん成績がよい曜日は%@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 문제를 가장 잘 풀어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój najlepszy dzień to %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu melhor dia é %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi sonuç aldığın gün %@."
          }
        }
      }
    },
    "Your best time is the afternoon." : {
      "comment" : "Over the patterns charts: the part of the day the learner answers best",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachmittags antwortest du am besten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respondes mejor por la tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu réussis le mieux l’après-midi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi meglio nel pomeriggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も正答率が高いのは午後です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오후에 정답률이 가장 높아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najlepiej radzisz sobie po południu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você se sai melhor à tarde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi sonuçları öğleden sonra alıyorsun."
          }
        }
      }
    },
