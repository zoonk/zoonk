{
  "sourceLanguage" : "en",
  "strings" : {
    "Birth year" : {
      "comment" : "Label of the field where the learner types the year they were born",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geburtsjahr"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Año de nacimiento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Année de naissance"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ano de nascimento"
          }
        }
      }
    },
    "Check the year and try again." : {
      "comment" : "The four-digit birth year typed isn't a real one, such as one in the future",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüf das Jahr und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba el año y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie l’année et réessaie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira o ano e tente de novo."
          }
        }
      }
    },
    "Not just yet" : {
      "comment" : "Title when the learner is too young to use Zoonk",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não"
          }
        }
      }
    },
    "Not now" : {
      "comment" : "Closes the birth year question; nothing starts",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt nicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora no"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas maintenant"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora não"
          }
        }
      }
    },
    "OK" : {
      "comment" : "Closes the message for a learner too young",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’accord"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "That didn't save. Try again." : {
      "comment" : "Saving the birth year failed, usually the connection",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das wurde nicht gespeichert. Versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha guardado. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça n’a pas été enregistré. Réessaie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deu para salvar. Tente de novo."
          }
        }
      }
    },
    "We ask everyone once." : {
      "comment" : "Under the birth year question",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir fragen alle einmal danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo preguntamos a todo el mundo una sola vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On pose cette question à tout le monde, une seule fois."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gente faz essa pergunta uma vez para cada pessoa."
          }
        }
      }
    },
    "What year were you born?" : {
      "comment" : "Asked once of every learner before they keep learning",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In welchem Jahr bist du geboren?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿En qué año naciste?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle est ton année de naissance ?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em que ano você nasceu?"
          }
        }
      }
    },
    "You need to be %lld or older to use Zoonk, so we'll log you out. We'll be here when you are." : {
      "comment" : "Tells a signed-in learner below the minimum age kindly that OK logs them out; the number is that age",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst mindestens %lld Jahre alt sein, um Zoonk zu nutzen. Deshalb melden wir dich ab. Wir sind für dich da, wenn du alt genug bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes que tener al menos %lld años para usar Zoonk, así que cerraremos tu sesión. Aquí estaremos cuando los cumplas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut avoir au moins %lld ans pour utiliser Zoonk, alors on va te déconnecter. On sera là quand tu auras l’âge."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa ter %lld anos ou mais para usar o Zoonk, então vamos sair da sua conta. A gente vai estar aqui quando você tiver essa idade."
          }
        }
      }
    },
    "You need to be %lld or older to use Zoonk. We'll be here when you are." : {
      "comment" : "Tells a learner below the minimum age kindly; the number is that age",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst mindestens %lld Jahre alt sein, um Zoonk zu nutzen. Wir sind für dich da, wenn es so weit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas tener al menos %lld años para usar Zoonk. Aquí estaremos cuando los cumplas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dois avoir au moins %lld ans pour utiliser Zoonk. On sera là quand tu auras cet âge."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa ter pelo menos %lld anos para usar o Zoonk. A gente vai estar aqui quando você tiver essa idade."
          }
        }
      }
    }
  },
  "version" : "1.0"
}