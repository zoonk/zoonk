    "Still handing it in. This is taking longer than usual." : {
      "comment" : "A mock step is slow",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir geben noch ab. Das dauert länger als üblich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún se está enviando. Está tardando más de lo habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoi toujours en cours. Cela prend plus de temps que d’habitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stiamo ancora completando la consegna. Ci vuole più tempo del solito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提出しています。通常より時間がかかっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 제출하고 있어요. 평소보다 오래 걸리고 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal oddajemy egzamin. Trwa to dłużej niż zwykle."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda estamos enviando. Isso está demorando mais que o normal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hâlâ teslim ediyoruz. Bu işlem normalden uzun sürüyor."
          }
        }
      }
    },
    "Stop whenever you want: your plan uses the questions you answered. Your result shows at the end." : {
      "comment" : "Under the placement lengths",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jederzeit aufhören: Dein Plan nutzt die Fragen, die du beantwortet hast. Dein Ergebnis siehst du am Ende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes detenerte cuando quieras: tu plan toma en cuenta las preguntas que respondiste. Verás tu resultado al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête-toi quand tu veux : ton plan tient compte des questions auxquelles tu as répondu. Ton résultat s’affiche à la fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi fermarti quando vuoi: il tuo piano si basa sulle domande a cui hai risposto. Vedrai il risultato alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつでも終了できます。回答した問題をもとに学習計画を立てます。結果は終了時に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제든 멈춰도 돼요. 답한 문제를 계획에 반영해요. 결과는 끝나면 확인할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz przerwać w dowolnej chwili: twój plan uwzględnia pytania, na które odpowiesz. Wynik zobaczysz na końcu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare quando quiser: seu plano usa as perguntas que você respondeu. Seu resultado aparece no final."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğin zaman bitirebilirsin: planın cevapladığın sorulara göre hazırlanır. Sonucunu en sonda görürsün."
          }
        }
      }
    },
    "Sure: %lld of %lld right. Flagged as unsure: %lld of %lld right." : {
      "comment" : "How many of the answers the learner was sure of were right, against those flagged as unsure",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicher: %1$lld von %2$lld richtig. Als unsicher markiert: %3$lld von %4$lld richtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sure: %1$lld of %2$lld right. Flagged as unsure: %3$lld of %4$lld right."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin dudas: %1$lld de %2$lld correctas. Marcadas con dudas: %3$lld de %4$lld correctas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
