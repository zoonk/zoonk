    "%@ is left out until you pick which one you take, in your plan." : {
      "comment" : "The argument is a part of the exam, such as a specialty's own test, that the learner hasn't picked an option for yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird ausgelassen, bis du in deinem Plan auswählst, welchen Test du ablegst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se omite hasta que elijas en tu plan qué opción vas a presentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On laisse %@ de côté tant que tu n’as pas choisi ton option dans ton plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resta fuori finché non scegli nel piano quale prova sostenere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、学習計画でどれを受験するか選ぶまで模試に含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 계획에서 응시할 항목을 선택할 때까지 제외돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie pojawi się w egzaminie próbnym, dopóki nie wybierzesz w planie, który wariant zdajesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fica de fora até você escolher uma opção no seu plano."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, planında seçimini yapana kadar dışarıda kalır."
          }
        }
