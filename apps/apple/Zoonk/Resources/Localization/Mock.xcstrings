    "The objective tests together need %@ of their points, and this mock doesn't have them all." : {
      "comment" : "A minimum share of points this mock couldn't check",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die objektiv bewerteten Tests sind insgesamt mindestens %@ der möglichen Punkte nötig. Diese Probeprüfung enthält nicht alle davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pruebas objetivas requieren en conjunto el %@ de sus puntos y este simulacro no las incluye todas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’ensemble des épreuves objectives, il faut %@ des points possibles, mais elles ne figurent pas toutes dans cet examen blanc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La soglia complessiva per le prove oggettive è pari a %@ dei punti totali e questa simulazione non le include tutte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択式の試験では合計で満点の%@以上が必要ですが、この模試には一部の試験が含まれていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "객관식 시험의 합산 점수가 총점의 %@ 이상이어야 하지만, 이 모의고사에는 일부 시험만 포함되어 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z części testowych trzeba łącznie uzyskać co najmniej %@ możliwych punktów, a ten egzamin próbny nie obejmuje wszystkich tych części."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juntas, as provas objetivas exigem %@ dos pontos, e este simulado não inclui todas elas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objektif testlerin toplam puanında en az %@ oranına ulaşmak gerekiyor ve bu deneme sınavı bu testlerin hepsini kapsamıyor."
          }
        }
      }
    },
