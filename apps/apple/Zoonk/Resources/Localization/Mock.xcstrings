    "You left it blank." : {
      "comment" : "A blank essay\nA blank question",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast das Feld leer gelassen."
          }
        },
        "es" : {
