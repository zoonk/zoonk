          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as laissé cette réponse vide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai lasciato la risposta in bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空欄のままでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답을 비워 뒀어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak odpowiedzi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você deixou em branco."
          }
        },
        "tr" : {
