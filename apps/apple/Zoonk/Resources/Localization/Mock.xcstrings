        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai risposto per iscritto ad almeno un compito, quindi per quei compiti la stima non valuta come parli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字入力で答えたタスクがあるため、そのタスクでの話し方は推定スコアに反映されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글로 답한 과제가 있어 그 과제의 발음이나 말하는 방식은 예상 점수에 반영하지 않았어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W co najmniej jednym zadaniu jest odpowiedź pisemna. Szacunkowy wynik nie obejmuje więc oceny mówienia w tym zadaniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
