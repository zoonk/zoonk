{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ can't be part of a mock: it's a practical test." : {
      "comment" : "A practical part left out",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann nicht Teil einer Probeprüfung sein: Es handelt sich um eine praktische Prüfung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede incluirse en un simulacro: es una prueba práctica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas faire partie d’un examen blanc : c’est une épreuve pratique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non può far parte di una simulazione: è una prova pratica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は実技試験のため、模試には含められません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 실기 시험이라 모의고사에 포함할 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie może być częścią egzaminu próbnego: to test praktyczny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não pode fazer parte de um simulado: é uma prova prática."
          }
