        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 결과는 같은 회차에 응시한 사람들의 성적에 따라 달라져요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój rzeczywisty wynik zależy od wyników wszystkich osób zdających w tym samym terminie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu resultado real depende do desempenho de todas as pessoas que fizerem a prova junto com você."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerçek sonucun, seninle aynı sınava giren herkesin başarısına bağlı."
          }
        }
      }
    },
    "Your result only shows at the end, like on exam day." : {
      "comment" : "The mock's one rule",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
