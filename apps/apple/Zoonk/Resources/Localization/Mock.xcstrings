    "The exam asks for at least %@ of %@ on this paper and listening together." : {
      "comment" : "A speaking paper's pass mark shared with listening",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Prüfungsteil und im Teil Hören brauchst du zusammen mindestens %1$@ von %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The exam asks for at least %1$@ of %2$@ on this paper and listening together."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El examen exige al menos %1$@ de %2$@ entre esta prueba y la de escucha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour réussir l’examen, il faut au moins %1$@ sur %2$@ au total pour cette épreuve et celle d’écoute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’esame richiede almeno %1$@ su %2$@ sommando questa prova e quella di ascolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本試験では、このパートとリスニングを合わせて%1$@以上（%2$@満点）が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 시험은 말하기와 듣기 합산 점수가 %1$@ 이상이어야 해요(총점 %2$@)."
