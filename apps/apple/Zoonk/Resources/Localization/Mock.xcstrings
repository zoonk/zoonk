        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na egzaminie trzeba uzyskać co najmniej %1$@ z %2$@ łącznie za tę część i słuchanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A prova exige pelo menos %1$@ de %2$@ na soma desta parte com a de escuta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sınavda bu oturum ve dinlemeden toplam en az %1$@ almak gerekiyor (toplam %2$@ üzerinden)."
          }
        }
      }
    },
