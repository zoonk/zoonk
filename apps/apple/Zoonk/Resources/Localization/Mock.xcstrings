    "Your real result depends on how everyone in your sitting does." : {
      "comment" : "A relative exam score",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein tatsächliches Ergebnis hängt davon ab, wie alle abschneiden, die mit dir an der Prüfung teilnehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu resultado real depende de cómo les vaya a quienes presenten el examen en tu misma sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton résultat réel dépend des résultats de tous les candidats de ta session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo risultato effettivo dipende dai risultati degli altri candidati della tua sessione."
