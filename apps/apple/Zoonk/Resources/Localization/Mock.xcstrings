    "%@ is only in full mock exams." : {
      "comment" : "A written part only full mock exams ask",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gibt es nur in vollständigen Probeprüfungen."
          }
        },
