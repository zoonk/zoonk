    "Check your email and message, then try again." : {
      "comment" : "Feedback form error when the submitted fields are invalid.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüf deine E-Mail-Adresse und deine Nachricht und versuch es noch einmal."
