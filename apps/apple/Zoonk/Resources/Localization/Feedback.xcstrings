    "Feedback couldn't be sent. Try again later." : {
      "comment" : "Feedback form error when the service is temporarily unavailable.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Feedback konnte nicht gesendet werden. Versuch es später noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron enviar tus comentarios. Inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton avis n’a pas pu être envoyé. Réessaie plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile inviare il feedback. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フィードバックを送信できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의견을 보내지 못했어요. 나중에 다시 시도해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się wysłać opinii. Spróbuj ponownie później."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível enviar sua mensagem. Tente de novo mais tarde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri bildirim gönderilemedi. Daha sonra tekrar dene."
          }
        }
      }
    },
    "Found a problem or have an idea? Tell us below or email hello@zoonk.com." : {
      "comment" : "Introduction shown above the feedback fields.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du ein Problem entdeckt oder eine Idee? Schreib uns hier oder per E-Mail an hello@zoonk.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Encontraste un problema o tienes una idea? Cuéntanos abajo o escríbenos a contacto@zoonk.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as rencontré un problème ou tu as une idée ? Dis-le-nous ci-dessous ou écris-nous à hello@zoonk.com."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai trovato un problema o hai un’idea? Scrivici qui sotto o via email a hello@zoonk.com."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気になる点やアイデアはありますか？下のフォームか、hello@zoonk.comへのメールでお知らせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문제를 발견했거나 아이디어가 떠올랐나요? 아래에 적어 주시거나 hello@zoonk.com으로 이메일을 보내 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coś nie działa lub masz pomysł? Napisz nam poniżej lub na adres hello@zoonk.com."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrou um problema ou tem uma ideia? Conte pra gente abaixo ou envie um e-mail para contato@zoonk.com."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sorunla mı karşılaştın ya da bir fikrin mi var? Aşağıya yaz veya hello@zoonk.com adresine e-posta gönder."
          }
        }
      }
    },
