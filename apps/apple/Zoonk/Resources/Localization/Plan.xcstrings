    "Until you pick, your plan and mocks leave out %@: %lld of the exam's %lld points." : {
      "comment" : "The first argument is a part of the exam, such as a specialty's own test or a foreign language, that the plan skips until the learner picks an option; the numbers are points of the exam's score",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis du dich entschieden hast, lassen dein Plan und deine Probeprüfungen %1$@ aus: %2$lld von %3$lld Punkten der Prüfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Until you pick, your plan and mocks leave out %1$@: %2$lld of the exam's %3$lld points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta que elijas, tu plan y tus simulacros omiten %1$@: %2$lld de los %3$lld puntos del examen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que tu n’as pas fait ton choix, ton plan et tes examens blancs laissent %1$@ de côté : %2$lld sur les %3$lld points de l’examen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finché non scegli, il tuo piano e le simulazioni lasciano fuori %1$@: %2$lld dei %3$lld punti dell’esame."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選ぶまでは、学習計画と模試に%1$@は含まれません（%2$lld点分、試験全体は%3$lld点）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택할 때까지 계획과 모의고사에서 %1$@ 부분(%2$lld점, 시험 총점 %3$lld점)이 제외돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopóki nie wybierzesz opcji, twój plan i egzaminy próbne nie obejmują tej części: %1$@. To %2$lld z %3$lld punktów egzaminu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até você escolher, %1$@ fica de fora do seu plano e dos simulados: %2$lld dos %3$lld pontos da prova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçim yapana kadar %1$@ planının ve deneme sınavlarının dışında kalır: %2$lld puan (sınav toplamı: %3$lld puan)."
          }
        }
      }
    },
