        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mesma prática em semanas alternadas: menos espaçada, com mais prática de cada vez."
          }
        }
      }
    },
    "The subjects you pick come first and get more depth." : {
