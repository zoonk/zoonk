    "%lld lessons from earlier days come first: once you've done them, you're keeping pace again." : {
      "comment" : "How a learner behind by several lessons catches up",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst sind die %lld Lektionen von früheren Tagen dran. Danach bist du wieder im Tempo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero tienes que completar las %lld lecciones de días anteriores. Después volverás a ir al ritmo previsto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commence par les %lld leçons des jours précédents. Une fois terminées, tu auras retrouvé ton rythme."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As %lld aulas dos dias anteriores vêm primeiro. Depois de concluí-las, você volta ao ritmo."
          }
        }
      }
    },
