    "%@ a day" : {
      "comment" : "The plan's time a day, under the pace",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Tag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al día"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par jour"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por dia"
          }
        }
      }
    },
    "%@ a day doesn't reach every part of your goal: what comes last in your path is left out." : {
      "comment" : "What the time a day leaves out of a goal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ pro Tag schaffst du nicht alle Teile deines Ziels: Was auf deinem Lernweg zuletzt kommt, wird ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día no llegas a todas las partes de tu objetivo: se omite lo último de tu recorrido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu ne peux pas étudier toutes les parties de ton objectif : les dernières de ton parcours sont laissées de côté."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, não dá para estudar todas as partes da sua meta: o que vem por último na sua trilha fica de fora."
          }
        }
      }
    },
    "%@ a day doesn't reach every topic by the exam: the ones that come up least come after it." : {
      "comment" : "What the time a day leaves for after the exam",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ pro Tag schaffst du bis zur Prüfung nicht alle Themen: Die seltensten kommen erst danach dran."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día no llegas a todos los temas antes del examen: los que menos aparecen se estudian después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu ne peux pas étudier tous les sujets avant l’examen : ceux qui tombent le moins souvent seront étudiés après."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, não dá para estudar todos os tópicos antes da prova: os que menos caem ficam para depois."
          }
        }
      }
    },
    "%@ a day doesn't reach every topic: the ones that come up least are left out." : {
      "comment" : "What the time a day leaves out of an exam",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ pro Tag schaffst du nicht alle Themen: Die seltensten werden ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día no llegas a todos los temas: se omiten los que menos aparecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu ne peux pas étudier tous les sujets : ceux qui tombent le moins souvent sont laissés de côté."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, não dá para estudar todos os tópicos: os que menos caem ficam de fora."
          }
        }
      }
    },
    "%@ a day isn't enough time to cover your goal." : {
      "comment" : "The time a day covers next to nothing",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Tag reichen nicht aus, um dein Ziel abzudecken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al día no es suficiente para cubrir tu objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu n’as pas assez de temps pour couvrir ton objectif."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, não dá tempo de estudar sua meta."
          }
        }
      }
    },
    "%@ a day studies every part of your goal, the ones that matter most in more depth." : {
      "comment" : "What the time a day covers of a goal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ pro Tag deckst du alle Teile deines Ziels ab und lernst die wichtigsten genauer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día estudias todas las partes de tu objetivo y en más profundidad las más importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu étudies toutes les parties de ton objectif, en approfondissant celles qui comptent le plus."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, você estuda todas as partes da sua meta e se aprofunda mais nas mais importantes."
          }
        }
      }
    },
    "%@ a day studies every topic of the exam, some of them in less depth." : {
      "comment" : "What the time a day covers of an exam",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ pro Tag lernst du alle Prüfungsthemen, manche davon weniger ausführlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día estudias todos los temas del examen, algunos con menos profundidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu étudies tous les sujets de l’examen, certains moins en profondeur."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, você estuda todos os tópicos da prova, alguns com menos profundidade."
          }
        }
      }
    },
    "%@ a day studies every topic of the exam, the ones that come up most in more depth." : {
      "comment" : "What the time a day covers of an exam",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ pro Tag lernst du alle Prüfungsthemen und die häufigsten davon genauer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día estudias todos los temas del examen y en más profundidad los que más aparecen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu étudies tous les sujets de l’examen, en approfondissant ceux qui tombent le plus souvent."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, você estuda todos os tópicos da prova e se aprofunda mais nos que mais caem."
