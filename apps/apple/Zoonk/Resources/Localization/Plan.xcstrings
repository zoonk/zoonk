    "Less spaced practice, concentrated in the final weeks before the exam." : {
      "comment" : "What practicing in the final weeks does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger über die Zeit verteilte Übungen, konzentriert auf die letzten Wochen vor der Prüfung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Práctica menos espaciada, concentrada en las últimas semanas antes del examen."
          }
