    },
    "Done. Today's lessons changed too." : {
      "comment" : "A plan change was applied, and today's lessons follow it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erledigt. Deine heutigen Lektionen wurden auch angepasst."
          }
        },
