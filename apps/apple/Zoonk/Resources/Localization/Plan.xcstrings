    },
    "In your own words, like “less on weekends”. You'll see the change before it applies." : {
      "comment" : "Explains changing the plan by talking to the buddy",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deinen eigenen Worten, zum Beispiel „am Wochenende weniger“. Du siehst die Änderung, bevor sie übernommen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tus propias palabras, como “menos los fines de semana”. Verás el cambio antes de que se aplique."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec tes mots, par exemple « moins le week-end ». Tu verras le changement avant qu’il soit appliqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con parole tue, ad esempio “meno nei fine settimana”. Vedrai la modifica prima che venga applicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「週末は少なめに」など、自分の言葉で伝えられます。変更内容は適用前に確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“주말에는 덜 공부할래요”처럼 편하게 말해 주세요. 적용 전에 변경 내용을 확인할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własnymi słowami, np. „mniej w weekendy”. Zobaczysz zmianę, zanim zacznie obowiązywać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com suas palavras, como “menos tempo nos fins de semana”. Você verá a mudança antes de ela ser aplicada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hafta sonları daha az çalışayım” gibi kendi sözlerinle anlat. Değişikliği uygulanmadan önce göreceksin."
          }
        }
      }
    },
    "In your own words, like “skip a module” or “less on weekends”. You'll see the change before it applies." : {
      "comment" : "Explains changing a plan with modules by talking to the buddy",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deinen eigenen Worten, zum Beispiel „ein Modul überspringen“ oder „am Wochenende weniger lernen“. Du siehst die Änderung, bevor sie übernommen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con tus propias palabras, como “saltar un módulo” o “menos los fines de semana”. Verás el cambio antes de que se aplique."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec tes mots, par exemple « sauter un module » ou « en faire moins le week-end ». Tu verras le changement avant qu’il soit appliqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con parole tue, ad esempio “salta un modulo” o “meno nei fine settimana”. Vedrai la modifica prima che venga applicata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「モジュールをスキップして」「週末は少なめに」など、自分の言葉で伝えられます。変更内容は適用前に確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“모듈 하나는 건너뛸래요”나 “주말에는 덜 공부할래요”처럼 편하게 말해 주세요. 적용 전에 변경 내용을 확인할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Własnymi słowami, np. „pomiń moduł” lub „mniej w weekendy”. Zobaczysz zmianę, zanim zacznie obowiązywać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga do seu jeito, como “pular um módulo” ou “estudar menos nos fins de semana”. Você vai ver a mudança antes de ela ser aplicada."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bir modülü atla” veya “hafta sonları daha az çalışayım” gibi kendi sözlerinle anlat. Değişikliği uygulanmadan önce göreceksin."
          }
        }
      }
    },
