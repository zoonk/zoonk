    "That gives you time to finish each phase's lessons." : {
      "comment" : "Why moving several phases' ends later",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So hast du Zeit, die Lektionen jeder Phase abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así tienes tiempo para terminar las lecciones de cada fase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça te laisse le temps de terminer les leçons de chaque phase."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Così hai il tempo di completare le lezioni di ogni fase."
