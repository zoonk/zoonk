    "%@ a day doesn't reach every part of your goal: what comes last in your path is left out." : {
      "comment" : "What the time a day leaves out of a goal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ am Tag schaffst du nicht alle Teile deines Ziels: Was auf deinem Lernweg zuletzt kommt, wird ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día no se cubren todas las partes de tu objetivo: se omite lo que va al final de tu recorrido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu ne peux pas tout étudier : la fin de ton plan est laissée de côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al giorno non c’è tempo per tutte le parti del tuo obiettivo: le ultime del percorso vengono lasciate fuori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日%@では目標のすべてを学びきれず、最後に学ぶ内容は計画に入りきりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 %@으로는 목표에 필요한 내용을 모두 학습할 수 없어 마지막에 배울 내용이 제외돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dziennie nie wystarcza na cały materiał związany z twoim celem: końcowe części ścieżki nie mieszczą się w planie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, não dá para estudar toda a sua meta: o que vem por último na trilha fica de fora."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde %@ hedefinin tamamını ele almaya yetmiyor: öğrenme yolunun sonundakiler dışarıda kalıyor."
          }
        }
      }
    },
    "%@ a day doesn't reach every topic by the exam: the ones that come up least come after it." : {
      "comment" : "What the time a day leaves for after the exam",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ am Tag schaffst du nicht alle Themen bis zur Prüfung: Die Themen, die am seltensten vorkommen, folgen danach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día no se cubren todos los temas antes del examen: los menos frecuentes quedan para después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu ne peux pas étudier tous les sujets avant l’examen : les moins fréquents seront étudiés après."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al giorno non c’è tempo per tutti gli argomenti prima dell’esame: quelli meno frequenti si studiano dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日%@では試験までにすべてのトピックを学びきれず、出題の少ないものは試験後になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 %@으로는 시험 전까지 모든 주제를 학습할 수 없어 출제 빈도가 가장 낮은 주제는 시험 후로 미뤄져요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dziennie nie wystarcza na wszystkie tematy przed egzaminem: te najrzadsze są zaplanowane dopiero po nim."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, nem todos os tópicos serão estudados até a prova: os que menos caem ficam para depois."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde %@ tüm konuları sınava kadar çalışmaya yetmiyor: sınavda en az çıkanlar sınav sonrasına kalıyor."
          }
        }
      }
    },
    "%@ a day doesn't reach every topic: the ones that come up least are left out." : {
      "comment" : "What the time a day leaves out of an exam",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ am Tag schaffst du nicht alle Themen: Die Themen, die am seltensten vorkommen, werden ausgelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día no se cubren todos los temas: se omiten los menos frecuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu ne peux pas étudier tous les sujets : les moins fréquents sont laissés de côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al giorno non c’è tempo per tutti gli argomenti: quelli meno frequenti vengono lasciati fuori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日%@ではすべてのトピックを学びきれず、出題の少ないものは計画に入りきりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 %@으로는 모든 주제를 학습할 수 없어 출제 빈도가 가장 낮은 주제는 제외돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dziennie nie wystarcza na wszystkie tematy: te, które pojawiają się najrzadziej, nie mieszczą się w planie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, não dá para estudar todos os tópicos: os que menos caem ficam de fora."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde %@ tüm konuları çalışmaya yetmiyor: sınavda en az çıkanlar dışarıda kalıyor."
          }
        }
      }
    },
    "%@ a day isn't enough time to cover your goal." : {
      "comment" : "The time a day covers next to nothing",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ pro Tag reicht die Zeit nicht für dein Ziel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día no hay tiempo suficiente para cubrir tu objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par jour ne suffit pas pour étudier tout ce que couvre ton objectif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al giorno non c’è abbastanza tempo per il tuo obiettivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日%@では目標に必要な学習時間が足りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 %@으로는 목표에 필요한 내용을 배우기에 시간이 부족해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dziennie to za mało czasu na materiał związany z twoim celem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por dia não é tempo suficiente para estudar sua meta."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde %@ hedefin için yeterli değil."
          }
        }
      }
    },
    "%@ a day studies every part of your goal, the ones that matter most in more depth." : {
      "comment" : "What the time a day covers of a goal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ am Tag bearbeitest du alle Teile deines Ziels, die wichtigsten davon ausführlicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día se estudian todas las partes de tu objetivo, con más profundidad en las más importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu étudies tout ce que couvre ton objectif, en approfondissant les points les plus importants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al giorno studi ogni parte del tuo obiettivo e approfondisci quelle più importanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日%@で目標に必要な内容をすべて学び、特に大切な内容をより深く学習します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 %@씩 목표에 필요한 내용을 모두 배우고, 가장 중요한 내용은 더 깊이 다뤄요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan na %@ dziennie obejmuje cały materiał związany z twoim celem, a najważniejsze części omawia dokładniej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, você estuda toda a sua meta e se aprofunda mais no que é mais importante."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde %@ ile hedefinin tamamı ele alınıyor, en önemli kısımlar daha ayrıntılı işleniyor."
          }
        }
      }
    },
    "%@ a day studies every topic of the exam, some of them in less depth." : {
      "comment" : "What the time a day covers of an exam",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ am Tag bearbeitest du alle Themen der Prüfung, einige davon weniger ausführlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día se estudian todos los temas del examen, algunos con menos profundidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %@ par jour, tu étudies tous les sujets de l’examen, certains moins en profondeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al giorno studi tutti gli argomenti dell’esame, alcuni meno a fondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日%@で試験のすべてのトピックを学習し、一部は要点に絞って学びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 %@씩 시험의 모든 주제를 학습하고, 일부 주제는 가볍게 다뤄요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan na %@ dziennie obejmuje wszystkie tematy egzaminu, niektóre z nich mniej szczegółowo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, você estuda todos os tópicos da prova, alguns com menos profundidade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde %@ ile sınavın tüm konuları çalışılıyor, bazıları daha az ayrıntılı ele alınıyor."
