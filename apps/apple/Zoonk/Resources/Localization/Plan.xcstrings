    "Your plan changes from today. Less time spreads your lessons over more days." : {
      "comment" : "Explains what changing the time a day does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Plan ändert sich ab heute. Mit weniger Zeit pro Tag verteilen sich deine Lektionen auf mehr Tage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan cambia a partir de hoy. Con menos tiempo, tus lecciones se reparten en más días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton plan change dès aujourd’hui. Si tu y consacres moins de temps par jour, tes leçons seront réparties sur plus de jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo piano cambia a partire da oggi. Con meno tempo al giorno, le lezioni si distribuiscono su più giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学習計画は今日から変わります。1日の学習時間を減らすと、レッスンをより多くの日に分けて進めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘부터 계획이 바뀌어요. 하루 학습 시간을 줄이면 레슨을 더 긴 기간에 걸쳐 학습해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój plan zmienia się od dziś. Krótszy dzienny czas nauki oznacza rozłożenie lekcji na więcej dni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano muda a partir de hoje. Com menos tempo por dia, suas aulas ficam distribuídas em mais dias."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planın bugünden itibaren değişir. Günlük çalışma süreni azaltmak derslerini daha fazla güne yayar."
          }
        }
      }
    },
