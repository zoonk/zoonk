    "%@ a day covers about %@ of your exam topics" : {
      "comment" : "The share of an exam's topics a time a day covers; the first argument is a duration",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %1$@ pro Tag deckst du etwa %2$@ deiner Prüfungsthemen ab"
          }
