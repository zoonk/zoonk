    "Your buddy and practice calls use %@. Lessons and their audio use %@." : {
      "comment" : "Under a language goal's country; the arguments are a language with its country, like 'Spanish (Argentina)', then the one lessons teach, like 'Spanish (Mexico)'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kumpel und die Übungsgespräche verwenden %1$@. Die Lektionen und ihre Audioaufnahmen sind auf %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your buddy and practice calls use %1$@. Lessons and their audio use %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compañero y las llamadas de práctica usan %1$@. Las lecciones y su audio usan %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compagnon et tes appels d’entraînement utilisent %1$@. Les leçons et leurs versions audio utilisent %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo compagno e le conversazioni di allenamento usano %1$@. Le lezioni e il loro audio usano %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相棒とのやり取りや会話練習では%1$@を使います。レッスンとその音声では%2$@を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짝꿍과 대화 연습에는 %1$@을(를) 사용해요. 레슨과 오디오에는 %2$@을(를) 사용해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z kumplem i podczas rozmów ćwiczeniowych używasz tej odmiany języka: %1$@. W lekcjach i ich nagraniach używamy odmiany: %2$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu parceiro e as conversas de prática usam %1$@. As aulas e seus áudios usam %2$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ders arkadaşınla ve pratik sohbetlerinde %1$@ kullanılır. Derslerde ve seslendirmelerinde %2$@ kullanılır."
          }
        }
      }
    },
    "Your buddy and practice calls use the country you choose. Lessons and their audio use %@." : {
      "comment" : "Under the countries a language goal can choose from; the argument is the language as lessons teach it, like 'Spanish (Mexico)'",
