    "Your plan changes from today. Less time spreads your lessons over more days." : {
      "comment" : "Explains what changing the time a day does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Plan wird ab heute angepasst. Mit weniger Lernzeit verteilen sich deine Lektionen auf mehr Tage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan cambia a partir de hoy. Si dedicas menos tiempo, tus lecciones se repartirán en más días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton plan change à partir d’aujourd’hui. Avec moins de temps chaque jour, tes leçons s’étalent sur plus de jours."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano muda a partir de hoje. Com menos tempo, suas aulas se distribuem por mais dias."
          }
        }
      }
    },
    "Your plan follows it from now on." : {
