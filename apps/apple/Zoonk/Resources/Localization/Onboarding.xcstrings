    "These goals share your daily time. You can change all of this later." : {
      "comment" : "Under several understood goals",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ziele teilen sich deine tägliche Lernzeit. Du kannst das alles später ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos objetivos comparten tu tiempo diario. Puedes cambiar todo esto después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces objectifs se partagent ta durée quotidienne. Tu pourras modifier tout ça plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo tempo giornaliero si divide tra questi obiettivi. Puoi modificare tutto più avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日の学習時間をこれらの目標に振り分けます。どの設定もあとで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 학습 시간을 이 목표들에 나눠 써요. 나중에 모두 바꿀 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzielimy twój dzienny czas nauki między te cele. Wszystko to możesz później zmienić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses objetivos dividem seu tempo diário. Você pode mudar tudo isso depois."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük çalışma süren bu hedefler arasında bölünür. Bunların hepsini daha sonra değiştirebilirsin."
          }
        }
      }
    },
    "This course is in %@. Your lessons will be in %@." : {
      "comment" : "Under the level question when a course's language isn't the app's. Both placeholders are language names, as they're written mid-sentence",
      "localizations" : {
