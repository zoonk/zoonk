      }
    },
    "We can't read “%@” anymore. Remove it and add it again." : {
      "comment" : "Under the learner's attached material when one item sent with their goal can't be read anymore. {title} is its name, like \"Cell cycle.pdf\".",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht mehr gelesen werden. Entferne die Datei und füge sie noch einmal hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no podemos leer “%@”. Quítalo y vuelve a agregarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n’arrivons plus à lire « %@ ». Supprime ce fichier et ajoute-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non riusciamo più a leggere “%@”. Rimuovilo e aggiungilo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を読み取れなくなりました。削除して、もう一度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 더 이상 읽을 수 없어요. 삭제한 뒤 다시 추가해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie możemy już odczytać „%@”. Usuń ten plik i dodaj go ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não dá mais para ler “%@”. Remova esse arquivo e adicione-o de novo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” dosyasını artık okuyamıyoruz. Kaldırıp yeniden ekle."
          }
        }
      }
    },
    "We can't read some of your files anymore. Remove them and add them again." : {
      "comment" : "Under the learner's attached material when several items sent with their goal can't be read anymore.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige deiner Dateien können nicht mehr gelesen werden. Entferne sie und füge sie noch einmal hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no podemos leer algunos de tus archivos. Quítalos y vuelve a agregarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains de tes fichiers ne sont plus lisibles. Supprime-les et ajoute-les à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non riusciamo più a leggere alcuni dei tuoi file. Rimuovili e aggiungili di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの一部を読み取れなくなりました。削除して、もう一度追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 파일을 더 이상 읽을 수 없어요. 삭제한 뒤 다시 추가해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
