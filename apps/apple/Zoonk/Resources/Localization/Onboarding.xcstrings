    "Without an account, you can follow one goal. Your plan and progress come with you." : {
      "comment" : "Why a guest needs an account to start another goal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Konto kannst du ein Ziel verfolgen. Dein Plan und dein Fortschritt bleiben dir erhalten."
          }
