    "Musicianship for %@: hear chords, read short melodies and keep the beat. No microphone needed." : {
      "comment" : "What a musicianship goal teaches",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikalische Grundlagen für %@: Akkorde hören, kurze Melodien lesen und den Takt halten. Kein Mikrofon nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formación musical para %@: reconocer acordes, leer melodías cortas y seguir el ritmo. No necesitas micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formation musicale pour %@ : reconnaître des accords à l’écoute, lire de courtes mélodies et garder le rythme. Pas besoin de microphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formazione musicale per %@: riconoscere gli accordi, leggere brevi melodie e tenere il tempo. Non serve il microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のための音楽の基礎：和音を聴き取り、短いメロディーの楽譜を読み、リズムをとる練習をします。マイクは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 연주를 위한 음악 기초: 화음을 듣고, 짧은 멜로디의 악보를 읽고, 박자를 맞춰요. 마이크는 필요 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podstawy muzyki: %@. Rozpoznawaj akordy, czytaj krótkie melodie i trzymaj rytm. Mikrofon nie jest potrzebny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
