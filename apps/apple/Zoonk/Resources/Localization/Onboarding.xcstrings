      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist mehr, als die meisten auf Dauer schaffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un ritmo que la mayoría no puede mantener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est un rythme que la plupart des gens ne peuvent pas tenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un impegno difficile da mantenere per la maggior parte delle persone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日続けるには、多くの人にとって長すぎる時間です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 사람이 매일 꾸준히 하기에는 부담스러운 시간이에요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Większości osób trudno utrzymać takie tempo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É um ritmo que a maioria das pessoas não consegue manter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu kişi her gün bu kadar süre ayıramıyor."
          }
        }
      }
    },
    "The %@ test is new in your language, so its questions are being written now. It usually takes a minute or two, and only this once." : {
      "comment" : "Why the level test waits: the language's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %@-Test ist neu in deiner Sprache, deshalb erstellen wir gerade die Fragen. Das dauert normalerweise ein bis zwei Minuten und ist nur einmal nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba de %@ es nueva en tu idioma, así que estamos preparando las preguntas. Suele tardar uno o dos minutos y solo tendrás que esperar esta vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le test de %@ est nouveau dans ta langue, alors ses questions sont en cours de préparation. Cela prend généralement une ou deux minutes, et seulement cette fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il test di %@ è nuovo nella tua lingua, quindi stiamo preparando le domande. Dovrai aspettare solo questa volta: di solito bastano uno o due minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用中の言語で%@のテストを初めて用意するため、問題を作成しています。通常1〜2分ほどかかりますが、お待ちいただくのは初回だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 쓰는 언어로 %@ 테스트를 처음 제공해서 문제를 만들고 있어요. 보통 1~2분 정도 걸리고, 이번 한 번만 기다리면 돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test „%@” jest nowy w twojej wersji językowej, więc właśnie przygotowujemy pytania. Zwykle zajmuje to minutę lub dwie i jest potrzebne tylko raz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teste de %@ é novo no seu idioma, então as perguntas estão sendo criadas agora. Isso costuma levar um ou dois minutos e só acontece uma vez."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullandığın dilde %@ testi yeni olduğu için sorularını şimdi hazırlıyoruz. Bu yalnızca ilk seferde olur ve genellikle bir iki dakika sürer."
          }
        }
      }
    },
