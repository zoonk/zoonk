    "To be confirmed" : {
      "comment" : "An exam date that isn't out yet",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch zu bestätigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por confirmar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À confirmer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da confermare"
          }
        },
        "ja" : {
          "stringUnit" : {
