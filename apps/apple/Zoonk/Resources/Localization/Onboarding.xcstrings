        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽기, 듣기, 한 문장 소리 내어 말하기에 약 %@ 걸려요. 그 결과에 맞는 수준에서 계획을 시작해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
