    "Your plan and lessons will use it." : {
      "comment" : "Under the way to add material",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Plan und deine Lektionen nutzen es."
          }
        },
        "es" : {
          "stringUnit" : {
