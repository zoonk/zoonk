      }
    },
    "The days you picked can't cover everything in depth by your date. More study days would help." : {
      "comment" : "No time a day covers the whole goal on the days picked",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gewählten Lerntage reichen nicht aus, um bis zu deinem Zieldatum alles gründlich zu lernen. Mehr Lerntage würden helfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con los días que has elegido no da tiempo a estudiarlo todo en profundidad para esa fecha. Añadir más días de estudio ayudaría."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours que tu as choisis ne suffisent pas pour tout étudier en profondeur d’ici la date prévue. Ajouter des jours d’étude serait utile."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com os dias que você escolheu, não dá para estudar tudo a fundo até a data definida. Mais dias de estudo ajudariam."
          }
        }
      }
    },
    "The exam notice says %@." : {
      "comment" : "The day an exam's notice gives",
      "localizations" : {
        "de" : {
