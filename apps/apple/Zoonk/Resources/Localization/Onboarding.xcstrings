    "That's all the goals you can study at once" : {
      "comment" : "A free learner studies as many goals at once as their plan allows; it's about goals at the same time, not new goals started per day or month",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst keine weiteren Ziele gleichzeitig verfolgen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcanzaste el límite de objetivos que puedes estudiar a la vez"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suis déjà le maximum d’objectifs à la fois"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto il limite di obiettivi da seguire insieme"
