    "Not even a whole day covers everything in depth by %@." : {
      "comment" : "No time a day covers the whole goal; the argument is a date like 'May 5, 2027'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selbst wenn du täglich den ganzen Tag lernst, kannst du bis zum %@ nicht alles gründlich lernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni siquiera dedicando todo el día se puede cubrir todo a fondo para el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même en étudiant toute la journée, tu ne peux pas tout étudier en profondeur d’ici le %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non basta nemmeno studiare tutto il giorno per approfondire tutto entro il %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日丸1日学習しても、%@までにすべてを深く学ぶことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지는 하루 종일 공부해도 모든 내용을 깊이 있게 배울 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet nauka przez cały dzień nie wystarczy, by dokładnie przerobić cały materiał do %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem estudando o dia inteiro dá para cobrir tudo a fundo até %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde 24 saat çalışmak bile %@ tarihine kadar her şeyi derinlemesine öğrenmeye yetmez."
          }
        }
      }
    },
    "Not even a whole day covers everything in depth by the start of %@." : {
