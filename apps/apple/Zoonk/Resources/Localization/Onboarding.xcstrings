    "We already read this document. Upload a different one." : {
      "comment" : "The learner sent again a document research already read for an earlier ask",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dieses Dokument schon gelesen. Lad ein anderes hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya leímos este documento. Sube uno diferente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a déjà lu ce document. Importe-en un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo già letto questo documento. Caricane un altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この資料はすでに読み込み済みです。別の資料をアップロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
