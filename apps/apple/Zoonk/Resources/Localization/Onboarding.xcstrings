    "Pause one in your Plan, or subscribe to study more at once." : {
      "comment" : "Pausing a goal keeps its progress",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausier ein Ziel in deinem Plan oder schließ ein Abo ab, um mehr Ziele gleichzeitig zu verfolgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa uno en tu Plan o suscríbete para estudiar más a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets un objectif en pause dans ton Plan ou abonne-toi pour en suivre plus à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa un obiettivo nel tuo Piano o abbonati per seguirne di più insieme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学習計画で目標を1つ一時停止するか、登録して同時に進める目標を増やしてください。"
