        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획에서 목표 하나를 일시 중지하거나 구독해서 더 많은 목표를 동시에 공부해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
