    },
    "The %@ test is new in your language, so its questions are being written now. It usually takes a minute or two, and only this once." : {
      "comment" : "Why the level test waits: the language's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Test für %@ ist neu, deshalb werden die Fragen gerade erstellt. Das dauert meist ein bis zwei Minuten und ist nur beim ersten Mal nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba de %@ es nueva en tu idioma, así que estamos preparando sus preguntas. Suele tardar uno o dos minutos y solo tendrás que esperar esta vez."
          }
        },
        "fr" : {
