    "Covers about %@ of your exam topics in depth by %@, starting with what comes up most." : {
      "comment" : "The share of an exam a time a day covers by its date; the second argument is a date like 'May 5, 2027'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit lernst du etwa %1$@ deiner Prüfungsthemen bis zum %2$@ gründlich. Die häufigsten Prüfungsthemen kommen zuerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Covers about %1$@ of your exam topics in depth by %2$@, starting with what comes up most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubre a fondo aproximadamente el %1$@ de los temas de tu examen para el %2$@, empezando por los más frecuentes."
