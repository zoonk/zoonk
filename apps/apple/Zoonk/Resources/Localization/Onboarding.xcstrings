    "The situations you care about shape every lesson." : {
      "comment" : "Under the language reason question",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Situationen, die dir wichtig sind, prägen jede Lektion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada lección se basa en las situaciones que te importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les situations qui comptent pour toi donnent forme à chaque leçon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni lezione si basa sulle situazioni che ti interessano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使いたい場面に合わせて、すべてのレッスンを作ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중요하게 생각하는 상황에 맞춰 모든 레슨을 구성해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda lekcja uwzględnia sytuacje, które są dla ciebie ważne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
