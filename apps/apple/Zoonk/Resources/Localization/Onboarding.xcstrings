        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non conosci ancora l’alfabeto? Salta il test. La tua prima sessione inizia con una breve lezione per imparare a leggerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この言語の文字は初めてですか？テストはスキップしましょう。最初の学習は、文字の読み方を学ぶ短いレッスンから始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 언어의 문자가 낯선가요? 테스트를 건너뛰세요. 첫 학습은 문자를 읽는 법을 배우는 짧은 레슨으로 시작해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znasz jeszcze tego alfabetu? Pomiń test. Pierwszy dzień nauki zacznie się od krótkiej lekcji czytania w tym alfabecie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
