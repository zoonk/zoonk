          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour tout étudier en profondeur d’ici la date prévue, il faut %@ par jour, les jours que tu as choisis. Ajouter des jours d’étude réduit cette durée."
