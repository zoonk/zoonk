        },
        "fr" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pour cet examen, tu as %lld choix à faire. Ton plan et tes examens blancs s’adaptent à tes choix, que tu peux modifier dans ton plan."
