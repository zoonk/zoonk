    "Your plan will follow the exam's subjects, topics and dates. This usually takes a few minutes." : {
      "comment" : "While an exam's public notice is read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Plan wird sich nach den Fächern, Themen und Terminen der Prüfung richten. Das dauert meist ein paar Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan se basará en las materias, los temas y las fechas del examen. Esto suele tardar unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton plan suivra les matières, les sujets et les dates de l’examen. Cela prend généralement quelques minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo piano seguirà le materie, gli argomenti e le date dell’esame. Di solito ci vogliono pochi minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試験の科目とトピック、日程に沿って学習計画を立てます。通常は数分かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시험의 과목, 주제, 일정에 맞춰 계획을 세울 거예요. 보통 몇 분 정도 걸려요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój plan uwzględni przedmioty, tematy i terminy egzaminu. Zwykle zajmuje to kilka minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano vai seguir as matérias, os tópicos e as datas da prova. Isso costuma levar alguns minutos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planın sınavın branşlarına, konularına ve tarihlerine göre hazırlanacak. Bu genellikle birkaç dakika sürer."
          }
        }
      }
    },
