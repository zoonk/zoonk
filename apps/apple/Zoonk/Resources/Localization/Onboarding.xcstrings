        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo piano seguirà le materie, gli argomenti e le date del bando. Di solito ci mettiamo pochi minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要項に記載された科目・トピック・日程に沿って学習計画を作成します。通常、数分かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공고에 나온 과목과 주제, 날짜에 맞춰 계획을 세워요. 보통 몇 분 정도 걸려요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W twoim planie uwzględnimy przedmioty, tematy i terminy z ogłoszenia. Zwykle zajmuje to kilka minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano vai seguir as matérias, os tópicos e as datas do edital. Isso costuma levar alguns minutos."
