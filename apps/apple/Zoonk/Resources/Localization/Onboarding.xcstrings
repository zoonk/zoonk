    "At %@ a day, you finish in %@, after the exam in %@." : {
      "comment" : "When an exam plan that studies everything ends; the second and third arguments are months like 'May 2027'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %1$@ am Tag bist du im %2$@ fertig, also nach der Prüfung im %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At %1$@ a day, you finish in %2$@, after the exam in %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %1$@ al día, terminas en %2$@, después del examen de %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec %1$@ par jour, tu termines en %2$@, après l’examen prévu en %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %1$@ al giorno, completi il piano a %2$@, dopo l’esame di %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日%1$@のペースでは、学習が終わるのは%2$@で、%3$@の試験より後になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 %1$@씩 공부하면 %2$@에 끝나는데, 시험이 있는 %3$@보다 늦어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy %1$@ nauki dziennie koniec planu przypada na %2$@, czyli po egzaminie (%3$@)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %1$@ por dia, você termina em %2$@, depois da prova em %3$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde %1$@ çalışırsan %2$@ ayında, yani %3$@ ayındaki sınavdan sonra bitirirsin."
          }
        }
      }
    },
