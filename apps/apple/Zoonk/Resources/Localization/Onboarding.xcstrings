{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ a day" : {
      "comment" : "How long the learner studies each day",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Tag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al día"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par jour"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por dia"
          }
        }
      }
    },
    "%@ a day covers everything in depth by %@." : {
      "comment" : "The time a day found that covers the whole goal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %1$@ pro Tag deckst du bis zum %2$@ alles gründlich ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ a day covers everything in depth by %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %1$@ al día, se estudia todo a fondo antes del %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À raison de %1$@ par jour, tout est étudié en profondeur d’ici le %2$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %1$@ por dia, dá para estudar tudo a fundo até %2$@."
          }
        }
      }
    },
    "%@ a day studies every topic, some in less depth." : {
      "comment" : "The time a day that studies every topic",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit %@ pro Tag lernst du jedes Thema, manche weniger gründlich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %@ al día, se estudian todos los temas, algunos con menos profundidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À raison de %@ par jour, chaque sujet est étudié, certains moins en profondeur."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %@ por dia, dá para estudar todos os tópicos, alguns com menos profundidade."
          }
        }
      }
    },
    "%@ of the plan's exam topics in depth by %@." : {
