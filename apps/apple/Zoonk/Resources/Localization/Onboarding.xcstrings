    "This exam is held several times a year. Until you pick one, your plan uses the first." : {
      "comment" : "Under the sittings of an exam held several times a year",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Prüfung findet mehrmals im Jahr statt. Bis du einen Termin auswählst, geht dein Plan vom ersten aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
