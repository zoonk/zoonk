        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 코스는 %1$@로 진행돼요. 레슨은 %2$@로 진행돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Język kursu: %1$@. Język lekcji: %2$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este curso está em %1$@. Suas aulas serão em %2$@."
