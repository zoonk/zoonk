    "Pause another goal to start these." : {
      "comment" : "Under the goals a card can't start yet; pausing a goal keeps its progress",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausier ein anderes Ziel, um diese zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa otro objetivo para empezar a estudiar estos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mets un autre objectif en pause pour commencer ceux-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa un altro obiettivo per iniziare questi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの目標を始めるには、ほかの目標を一時停止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 목표들을 시작하려면 다른 목표를 일시 중지해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymaj inny cel, żeby zacząć realizować te cele."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause outro objetivo para começar esses."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlara başlamak için başka bir hedefi duraklat."
          }
        }
      }
    },
