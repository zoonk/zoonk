    "The %@ test is new in your language, so its questions are being written now. It usually takes a minute or two, and only this once." : {
      "comment" : "Why the level test waits: the language's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %@-Test ist neu in deiner Sprache, deshalb erstellen wir gerade die Fragen. Das dauert normalerweise ein bis zwei Minuten und ist nur einmal nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba de %@ es nueva en tu idioma, así que estamos preparando las preguntas ahora. Suele tardar uno o dos minutos y solo hay que hacerlo esta vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le test de %@ est nouveau dans ta langue, alors ses questions sont en cours de préparation. Cela prend généralement une ou deux minutes, et seulement cette fois."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teste de %@ é novo no seu idioma, então as perguntas estão sendo criadas agora. Isso costuma levar um ou dois minutos e só acontece uma vez."
          }
        }
      }
    },
