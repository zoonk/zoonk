    },
    "The exam's official calendar says %@." : {
      "comment" : "The day a language certificate's official calendar gives",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im offiziellen Prüfungskalender steht der %@."
          }
