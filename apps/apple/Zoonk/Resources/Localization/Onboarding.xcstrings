        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時に進められる目標の上限に達しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동시에 공부할 수 있는 목표 수를 다 채웠어요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz już maksymalną liczbę aktywnych celów"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já estuda o máximo de objetivos ao mesmo tempo"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı anda bu kadar hedef üzerinde çalışabilirsin"
          }
        }
      }
    },
    "That's all the goals you can study at once. Pause one, or subscribe to study more." : {
      "comment" : "A free learner studies as many goals at once as their plan allows; it's about goals at the same time, not new goals started per day or month. Pausing a goal keeps its progress",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst keine weiteren Ziele gleichzeitig verfolgen. Pausier eines oder schließ ein Abo ab, um mehr Ziele gleichzeitig zu verfolgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcanzaste el límite de objetivos que puedes estudiar a la vez. Pausa uno o suscríbete para estudiar más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suis déjà le maximum d’objectifs à la fois. Mets-en un en pause ou abonne-toi pour en suivre plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai raggiunto il limite di obiettivi da seguire insieme. Mettine uno in pausa o abbonati per seguirne di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時に進められる目標の上限に達しました。目標を1つ一時停止するか、登録して同時に進める目標を増やしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동시에 공부할 수 있는 목표 수를 다 채웠어요. 목표 하나를 일시 중지하거나 구독해서 더 많은 목표를 공부해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz już maksymalną liczbę aktywnych celów. Wstrzymaj jeden z nich lub wykup subskrypcję, żeby realizować więcej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já estuda o máximo de objetivos ao mesmo tempo. Pause um ou assine para estudar mais."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı anda bu kadar hedef üzerinde çalışabilirsin. Birini duraklat ya da daha fazla hedef için abone ol."
          }
        }
      }
    },
