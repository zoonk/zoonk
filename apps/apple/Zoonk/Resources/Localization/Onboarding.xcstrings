    "We can't estimate a finish date for this schedule. Try more time or more study days." : {
      "comment" : "No finish date fits the time and days picked",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diesen Plan können wir kein Abschlussdatum schätzen. Versuch es mit mehr Zeit oder mehr Lerntagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
