      }
    },
    "We can't estimate an end date. Try more time or more study days." : {
      "comment" : "No finish date fits the time and days picked",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir können kein Enddatum ermitteln. Versuch es mit mehr Zeit oder mehr Lerntagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podemos calcular cuándo terminarás. Prueba con más tiempo o más días de estudio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’estimer une date de fin. Essaie avec plus de temps ou plus de jours d’étude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non possiamo stimare una data di fine. Prova con più tempo o più giorni di studio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了日の目安を出せません。学習時間を長くするか、学習する日を増やしてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료일을 예상할 수 없어요. 학습 시간이나 학습하는 날을 늘려 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie możemy oszacować daty zakończenia. Spróbuj wydłużyć czas nauki lub wybrać więcej dni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não dá para estimar uma data de término. Tente aumentar o tempo ou os dias de estudo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitiş tarihini tahmin edemiyoruz. Çalışma süreni veya çalışacağın gün sayısını artırmayı dene."
          }
        }
      }
    },
    "We can't help with this goal" : {
      "comment" : "A goal the app declines",
      "localizations" : {
        "de" : {
          "stringUnit" : {
