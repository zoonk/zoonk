                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Para el examen debes tomar %lld decisiones. Tu plan y tus simulacros se basan en tus elecciones, y puedes cambiarlas en tu plan."
                }
              }
            }
