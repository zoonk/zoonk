      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An den gewählten Lerntagen brauchst du jeweils %@, um bis zu deinem Zieldatum alles gründlich zu lernen. Mit mehr Lerntagen sinkt die tägliche Lernzeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
