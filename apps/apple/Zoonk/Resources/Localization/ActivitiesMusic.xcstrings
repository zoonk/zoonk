    "A rhythm of %lld steps with a beat every %lld. Tap on steps %@, over a click on every beat." : {
      "comment" : "VoiceOver description of a rhythm's grid",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rhythmus mit %1$lld Schritten und einem Schlag alle %2$lld Schritte. Tippe bei den Schritten %3$@. Zu jedem Schlag hörst du ein Klicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A rhythm of %1$lld steps with a beat every %2$lld. Tap on steps %3$@, over a click on every beat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ritmo de %1$lld pasos con un pulso cada %2$lld. Toca en los pasos %3$@ mientras suena un clic en cada pulso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rythme de %1$lld cases, avec un temps toutes les %2$lld cases. Appuie sur les cases %3$@, avec un clic à chaque temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un ritmo di %1$lld posizioni con un battito ogni %2$lld. Tocca nelle posizioni %3$@, con un clic a ogni battito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全%1$lldステップで、%2$lldステップごとに拍があるリズムです。拍ごとに鳴るクリック音を聴きながら、ステップ%3$@でタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "총 %1$lld칸이고 %2$lld칸마다 한 박자인 리듬이에요. 매 박자에 나는 클릭 소리를 들으며 %3$@번 칸에서 누르세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba kroków w rytmie: %1$lld, miara co %2$lld. Stukaj na krokach %3$@; każdą miarę wyznacza kliknięcie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ritmo de %1$lld passos, com uma batida a cada %2$lld. Toque nos passos %3$@, acompanhando um clique a cada batida."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld adımlık ritimde her %2$lld adımda bir vuruş var. Her vuruşta duyduğun tık sesi eşliğinde şu adımlarda dokun: %3$@."
          }
        }
      }
    },
