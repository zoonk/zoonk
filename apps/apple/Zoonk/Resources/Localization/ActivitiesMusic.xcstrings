        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소리에 맞춰 탭한 횟수가 부족했어요. 소리가 날 때마다 탭하면서 다시 시도해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się dopasować wystarczającej liczby uderzeń do kliknięć. Spróbuj ponownie i stukaj przy każdym kliknięciu."
          }
        },
        "pt" : {
