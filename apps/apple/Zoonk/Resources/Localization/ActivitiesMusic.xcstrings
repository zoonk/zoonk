    "We couldn't match enough taps to the clicks. Try again, tapping with each one." : {
      "comment" : "The sound check got too few taps",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten nicht genug deiner Tippbewegungen den Klicks zuordnen. Versuch es noch einmal und tipp bei jedem Klick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No detectamos suficientes toques que coincidieran con los clics. Inténtalo de nuevo y toca con cada clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop peu de frappes correspondent aux clics. Réessaie en tapant à chaque clic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo rilevato abbastanza colpi a tempo con i clic. Riprova, toccando a ogni clic."
          }
