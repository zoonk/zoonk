    "A rhythm of %lld steps with a beat every %lld. Tap on steps %@, over a click on every beat." : {
      "comment" : "VoiceOver description of a rhythm's grid",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Rhythmus mit %1$lld Schritten und einem Schlag alle %2$lld. Tippe bei den Schritten %3$@ im Takt zu jedem Klick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A rhythm of %1$lld steps with a beat every %2$lld. Tap on steps %3$@, over a click on every beat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ritmo de %1$lld pasos, con un pulso cada %2$lld. Da un toque en los pasos %3$@, siguiendo el clic de cada pulso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rythme de %1$lld temps, avec un battement tous les %2$lld. Tape sur les temps %3$@, en suivant le clic à chaque battement."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ritmo de %1$lld passos, com uma batida a cada %2$lld. Toque nos passos %3$@, junto com um clique a cada batida."
          }
        }
      }
    },
