          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suit le cours à partir d’ici, à ton rythme, avec des révisions avant que tu n’oublies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segue il corso da qui, al tuo ritmo, con ripassi prima che tu dimentichi ciò che hai imparato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここからコースに沿って、自分のペースで学び、忘れる前に復習できる計画です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서부터 학습 속도에 맞춰 코스를 이어 가고, 잊기 전에 복습해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan prowadzi cię stąd dalej przez kurs w twoim tempie. Powtórki pojawiają się, zanim zapomnisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
