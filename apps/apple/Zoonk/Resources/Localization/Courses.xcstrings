    "With Zoonk, your plan starts at this chapter and fits your schedule." : {
      "comment" : "On a chapter's page, what Zoonk does with it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Zoonk beginnt dein Plan bei diesem Kapitel und passt zu deinem Zeitplan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Zoonk, tu plan empieza en este capítulo y se adapta a tu horario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Zoonk, ton plan commence à ce chapitre et s’adapte à ton emploi du temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Zoonk, il tuo piano parte da questo capitolo e si adatta ai tuoi impegni."
