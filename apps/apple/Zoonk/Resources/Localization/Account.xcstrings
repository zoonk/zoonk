          }
        }
      }
    },
    "A security check blocked this request. Try again or contact hello@zoonk.com." : {
      "comment" : "Recovery when the security check blocks a sign-in or a verification code; avoids the verb on the Verify and delete button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sicherheitsprüfung hat diese Anfrage blockiert. Versuch es noch einmal oder schreib an hello@zoonk.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una comprobación de seguridad ha bloqueado esta solicitud. Inténtalo de nuevo o escribe a contacto@zoonk.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un contrôle de sécurité a bloqué cette demande. Réessaie ou contacte hello@zoonk.com."
