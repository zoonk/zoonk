    "Your Zoonk account and personalized data were permanently deleted." : {
      "comment" : "Confirms that account data was permanently deleted",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Zoonk-Konto und deine personalisierten Daten wurden endgültig gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de Zoonk y tus datos personalizados se eliminaron de forma permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte Zoonk et tes données personnalisées ont été définitivement supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account Zoonk e i tuoi dati personalizzati sono stati eliminati definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonkアカウントと個人用データを完全に削除しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk 계정과 개인 맞춤 데이터가 영구적으로 삭제됐어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto w Zoonku i spersonalizowane dane zostały trwale usunięte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta do Zoonk e seus dados personalizados foram excluídos permanentemente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk hesabın ve sana özel verilerin kalıcı olarak silindi."
          }
        }
      }
    },
    "Your Zoonk data was deleted, but Apple couldn't confirm that its authorization was removed. Remove Zoonk from Sign in with Apple to finish." : {
      "comment" : "Explains that Zoonk deletion succeeded but Apple authorization needs manual removal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zoonk-Daten wurden gelöscht, aber Apple konnte nicht bestätigen, dass die Autorisierung entfernt wurde. Entferne Zoonk aus „Mit Apple anmelden“, um den Vorgang abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos de Zoonk se eliminaron, pero Apple no pudo confirmar que se revocara la autorización de acceso. Elimina Zoonk de Iniciar sesión con Apple para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données Zoonk ont été supprimées, mais Apple n’a pas pu confirmer le retrait de l’autorisation accordée à Zoonk. Retire Zoonk de « Se connecter avec Apple » pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati Zoonk sono stati eliminati, ma Apple non ha potuto confermare la revoca dell’autorizzazione. Rimuovi Zoonk da Sign in with Apple per completare l’operazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonkのデータは削除されましたが、Apple側で連携の解除を確認できませんでした。「Appleでサインイン」からZoonkを削除して、手続きを完了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk 데이터는 삭제됐지만, Apple에서 로그인 권한이 해제됐는지 확인하지 못했어요. 완료하려면 ‘Apple로 로그인’에서 Zoonk를 삭제해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje dane w Zoonku zostały usunięte, ale Apple nie potwierdziło cofnięcia uprawnień. Aby dokończyć, usuń Zoonk z funkcji Sign in with Apple."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados do Zoonk foram excluídos, mas a Apple não conseguiu confirmar que a autorização foi removida. Remova o Zoonk de Iniciar sessão com a Apple para concluir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk verilerin silindi, ancak Apple, Zoonk’a verdiğin iznin kaldırıldığını doğrulayamadı. İşlemi tamamlamak için Apple ile Giriş Yap bölümünden Zoonk’u kaldır."
          }
        }
      }
    },
    "Zoonk checked your App Store purchases, but none currently provide Plus." : {
      "comment" : "Explains that restored App Store purchases do not grant an active subscription",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk hat deine App-Store-Käufe geprüft, aber keiner davon schaltet aktuell Plus frei."
