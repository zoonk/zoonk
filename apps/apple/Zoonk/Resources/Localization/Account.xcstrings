    "Plus from Google Play keeps charging until you cancel it there." : {
      "comment" : "Shown only to subscribers, in the box that deletes their account.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Plus von Google Play zahlst du weiter, bis du es dort kündigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play seguirá cobrándote por Plus hasta que lo canceles ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu continues à payer Plus tant que tu ne résilies pas ton abonnement sur Google Play."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuerai a pagare Plus finché non lo disdici su Google Play."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Playで登録したPlusは、Google Playで解約するまで請求が続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play에서 구독한 Plus는 Google Play에서 해지할 때까지 요금이 계속 청구돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play będzie pobierać opłaty za Plus, dopóki go tam nie anulujesz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Plus do Google Play continua sendo cobrado até você cancelar por lá."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Play’den aldığın Plus için oradan iptal edene kadar ücret alınmaya devam eder."
          }
        }
      }
    },
