    "Deletes your account and everything in it for good. Plus bought on the web is canceled; App Store purchases are managed in the App Store." : {
      "comment" : "What deleting the account does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht dein Konto und alle zugehörigen Daten endgültig. Im Web gekauftes Plus wird gekündigt; Käufe im App Store verwaltest du dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tu cuenta y todo su contenido de forma permanente. Si compraste Plus en la web, se cancela; las compras de App Store se gestionan en App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement ton compte et tout son contenu. L’abonnement Plus acheté sur le web est résilié ; les achats effectués dans l’App Store sont gérés dans l’App Store."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui sua conta e tudo o que está nela para sempre. O Plus comprado pelo site é cancelado; as compras pela App Store são gerenciadas na App Store."
          }
        }
      }
    },
    "Deleting your Zoonk account doesn't cancel App Store billing. Cancel the subscription first if you don't want it to renew." : {
      "comment" : "Warns that App Store billing continues independently of Zoonk account deletion",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dein Zoonk-Konto löschst, wird dein App-Store-Abo nicht gekündigt. Kündige das Abo zuerst, wenn es sich nicht verlängern soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar tu cuenta de Zoonk no cancela la facturación de App Store. Cancela primero la suscripción si no quieres que se renueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de ton compte Zoonk ne met pas fin à la facturation par l’App Store. Résilie d’abord l’abonnement si tu ne veux pas qu’il soit renouvelé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir sua conta do Zoonk não cancela a cobrança pela App Store. Cancele a assinatura antes se não quiser que ela seja renovada."
          }
        }
      }
    },
    "Deleting your Zoonk account doesn't cancel Google Play billing. Use Google Play on an Android device to cancel it first if you don't want it to renew." : {
      "comment" : "Warns that Google Play billing continues independently of Zoonk account deletion",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dein Zoonk-Konto löschst, wird dein Google-Play-Abo nicht gekündigt. Kündige es zuerst über Google Play auf einem Android-Gerät, wenn es sich nicht verlängern soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar tu cuenta de Zoonk no cancela la facturación de Google Play. Si no quieres que se renueve, cancela primero la suscripción en Google Play desde un dispositivo Android."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de ton compte Zoonk ne met pas fin à la facturation par Google Play. Si tu ne veux pas que l’abonnement soit renouvelé, résilie-le d’abord dans Google Play sur un appareil Android."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir sua conta do Zoonk não cancela a cobrança pelo Google Play. Se não quiser que a assinatura seja renovada, cancele ela antes pelo Google Play em um dispositivo Android."
