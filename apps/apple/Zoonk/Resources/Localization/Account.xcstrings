          }
        }
      }
    },
    "Zoonk couldn't connect. Check your connection and try again." : {
      "comment" : "Error shown when an account request cannot reach the service",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk konnte keine Verbindung herstellen. Prüf deine Verbindung und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk no pudo conectarse. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk n’a pas pu se connecter. Vérifie ta connexion et réessaie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk non è riuscito a connettersi. Controlla la connessione e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonkに接続できませんでした。通信状況を確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk에 연결하지 못했어요. 인터넷 연결을 확인하고 다시 시도해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
