    },
    "Your purchase is safe and hasn't been finished yet. Restore purchases when you're back online." : {
      "comment" : "Explains that a transaction remains available after server synchronization fails",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf ist sicher und wurde noch nicht abgeschlossen. Stelle deine Käufe wieder her, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra está guardada y aún no se completó. Restaura las compras cuando vuelvas a tener conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton achat est en sécurité et n’est pas encore finalisé. Restaure tes achats une fois reconnecté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo acquisto è al sicuro e non è ancora stato completato. Ripristina gli acquisti quando hai di nuovo una connessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入情報は保存されていますが、手続きはまだ完了していません。オンラインに戻ったら、購入を復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매 내역은 안전하게 보관되어 있지만 아직 처리가 끝나지 않았어요. 인터넷에 다시 연결되면 구매 내역을 복원해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój zakup nie przepadnie. Wciąż czeka na dokończenie. Przywróć zakupy, gdy znów połączysz się z internetem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua compra está segura e ainda não foi concluída. Restaure suas compras quando estiver online novamente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın alma işlemin güvende ve henüz tamamlanmadı. Yeniden internete bağlandığında satın alımlarını geri yükle."
          }
        }
      }
    },
    "Your purchase is safe. Sign in, then restore purchases to add Plus to your Zoonk account." : {
      "comment" : "Explains how to recover a purchase after the Zoonk session expires",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf ist sicher. Melde dich an und stelle dann deine Käufe wieder her, um Plus zu deinem Zoonk-Konto hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra está guardada. Inicia sesión y luego restaura las compras para agregar Plus a tu cuenta de Zoonk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton achat est en sécurité. Connecte-toi, puis restaure tes achats pour ajouter Plus à ton compte Zoonk."
