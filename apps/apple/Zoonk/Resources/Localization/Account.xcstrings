    "We've refunded %@ to the payment method you used. We emailed you the confirmation." : {
      "comment" : "After canceling Plus bought on the web; the argument is the refunded amount",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben dir %@ über die verwendete Zahlungsmethode zurückerstattet. Die Bestätigung haben wir dir per E-Mail geschickt."
