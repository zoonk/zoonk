        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk revisó tus compras en el App Store, pero ninguna te da acceso a Plus en este momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk a vérifié tes achats App Store, mais aucun ne donne actuellement accès à Plus."
