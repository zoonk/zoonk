    "Your Zoonk account and personalized data were permanently deleted." : {
      "comment" : "Confirms that account data was permanently deleted",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Zoonk-Konto und deine personalisierten Daten wurden endgültig gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta de Zoonk y tus datos personalizados se han eliminado definitivamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte Zoonk et tes données personnalisées ont été définitivement supprimés."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta do Zoonk e seus dados personalizados foram excluídos permanentemente."
          }
        }
      }
    },
    "Your Zoonk data was deleted, but Apple couldn't confirm that its authorization was removed. Remove Zoonk from Sign in with Apple to finish." : {
      "comment" : "Explains that Zoonk deletion succeeded but Apple authorization needs manual removal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zoonk-Daten wurden gelöscht, aber Apple konnte nicht bestätigen, dass die Autorisierung entfernt wurde. Entferne Zoonk aus „Mit Apple anmelden“, um den Vorgang abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos de Zoonk se han eliminado, pero Apple no ha podido confirmar que se haya retirado la autorización. Para terminar, elimina Zoonk de Iniciar sesión con Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes données Zoonk ont été supprimées, mais Apple n’a pas pu confirmer le retrait de l’autorisation accordée à Zoonk. Retire Zoonk de « Se connecter avec Apple » pour terminer."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados do Zoonk foram excluídos, mas Apple não conseguiu confirmar a remoção da autorização. Remova o Zoonk de Iniciar sessão com Apple para concluir."
          }
        }
      }
    },
    "Zoonk checked your App Store purchases, but none currently provide Plus." : {
      "comment" : "Explains that restored App Store purchases do not grant an active subscription",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk hat deine App Store-Käufe geprüft, aber keiner davon schaltet derzeit Plus frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk ha comprobado tus compras de App Store, pero ninguna incluye Plus actualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk a vérifié tes achats App Store, mais aucun ne donne actuellement accès à Plus."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zoonk conferiu suas compras via App Store, mas nenhuma dá acesso ao Plus no momento."
          }
        }
      }
    },
    "Zoonk couldn't connect. Check your connection and try again." : {
      "comment" : "Error shown when an account request cannot reach the service",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk konnte keine Verbindung herstellen. Prüf deine Verbindung und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk no ha podido conectarse. Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk n’a pas pu se connecter. Vérifie ta connexion et réessaie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zoonk não conseguiu se conectar. Confira sua conexão e tente de novo."
          }
        }
      }
    },
    "Zoonk couldn't delete your account. Try again or contact hello@zoonk.com." : {
      "comment" : "Generic account deletion failure message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
