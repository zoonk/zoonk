    "3-30 characters. Letters a–z, numbers, and underscores only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3–30 Zeichen. Nur Buchstaben a–z, Ziffern und Unterstriche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 3 a 30 caracteres. Solo letras a–z, números y guiones bajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 à 30 caractères. Lettres de a à z, chiffres et tirets bas uniquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3-30 caratteri. Solo lettere a–z, numeri e trattini bassi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3〜30文字。半角英小文字（a–z）、数字、アンダースコアのみ使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3~30자. 영문 소문자(a–z), 숫자, 밑줄만 사용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3–30 znaków. Tylko litery a–z, cyfry i podkreślenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 3 a 30 caracteres. Apenas letras a–z, números e sublinhados."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3-30 karakter. Yalnızca a–z harfleri, rakamlar ve alt çizgi kullanılabilir."
          }
        }
      }
    },
