        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tarihine kadar %2$@ tutarında tam para iadesi alabilirsin. Plus hemen sona erer."
          }
        }
      }
    },
    "Until %@, you can still end Plus now and get a full refund." : {
