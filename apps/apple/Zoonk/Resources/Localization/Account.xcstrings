{
  "sourceLanguage" : "en",
  "strings" : {
    "%@/%@ buddy messages used today" : {
      "comment" : "A free plan's buddy messages used today, as in “3/5 buddy messages used today”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heute %1$@/%2$@ Kumpel-Nachrichten genutzt"
