    },
    "Zoonk couldn't load your account. Your sign-in is still safely stored." : {
      "comment" : "Explains that a temporary account load failure did not remove the session",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk konnte dein Konto nicht laden. Deine Anmeldung ist weiterhin sicher gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk no pudo cargar tu cuenta. Tu sesión sigue guardada de forma segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk n’a pas pu charger ton compte. Ta connexion est toujours enregistrée en toute sécurité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk non è riuscito a caricare il tuo account. I tuoi dati di accesso restano salvati al sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonkアカウントを読み込めませんでした。サインイン情報は引き続き安全に保存されています。"
          }
        },
        "ko" : {
