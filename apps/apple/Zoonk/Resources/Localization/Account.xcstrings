    "We couldn't delete your account. Try again or email hello@zoonk.com." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten dein Konto nicht löschen. Versuch es noch einmal oder schreib an hello@zoonk.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos eliminar tu cuenta. Inténtalo de nuevo o escribe a contacto@zoonk.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n’avons pas pu supprimer ton compte. Réessaie ou écris à hello@zoonk.com."
