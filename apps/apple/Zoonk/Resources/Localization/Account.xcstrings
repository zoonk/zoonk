        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O sistema de segurança bloqueou essa solicitação. Tente de novo ou entre em contato pelo e-mail contato@zoonk.com."
          }
        }
      }
    },
