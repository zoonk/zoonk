        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매 내역은 안전하게 보관되어 있어요. 로그인한 뒤 구매 내역을 복원해 Zoonk 계정에 Plus를 적용해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
