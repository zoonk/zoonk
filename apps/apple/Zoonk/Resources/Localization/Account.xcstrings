    "You're still logged in. Check your connection and try again." : {
      "comment" : "Explains that a temporary account load failure did not remove the session",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist weiterhin angemeldet. Prüf deine Verbindung und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión aún está abierta. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta session est toujours ouverte. Vérifie ta connexion et réessaie."
