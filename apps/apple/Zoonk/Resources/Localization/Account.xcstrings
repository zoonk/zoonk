            "state" : "translated",
            "value" : "Zoonk bağlanamadı. İnternet bağlantını kontrol edip tekrar dene."
          }
        }
      }
    },
    "Zoonk couldn't delete your account. Try again or contact hello@zoonk.com." : {
      "comment" : "Generic account deletion failure message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
