    "Your Plus ends right away, and we refund %@ to the payment method you used." : {
      "comment" : "Before deleting the account, what happens to Plus bought on the web; the argument is the refunded amount",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Plus endet sofort, und wir erstatten dir %@ auf das verwendete Zahlungsmittel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu suscripción a Plus termina de inmediato y te reembolsamos %@ al método de pago que usaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta formule Plus prend fin immédiatement et nous te remboursons %@ sur le moyen de paiement utilisé."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu Plus acaba na hora, e a gente reembolsa %@ no mesmo meio de pagamento que você usou."
          }
        }
      }
    },
    "Your Plus ends right away, without a refund. You won't be charged again." : {
