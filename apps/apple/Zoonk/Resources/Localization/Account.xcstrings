    "By continuing, you agree to our %@ and %@." : {
      "comment" : "Legal agreement below the sign-in methods; the arguments are the links to the terms of service and the privacy policy",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du fortfährst, akzeptierst du unsere %1$@ und %2$@."
