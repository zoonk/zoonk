          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/%2$@ mensajes usados hoy con tu compañero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@/%2$@ messages avec ton Compagnon utilisés aujourd’hui"
