    "Until %@, you can get a full refund of %@. Plus ends right away." : {
      "comment" : "In the dialog that cancels Plus: the 14-day full refund; the arguments are its last day and the amount",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zum %1$@ kannst du dir %2$@ vollständig erstatten lassen. Plus endet sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Until %1$@, you can get a full refund of %2$@. Plus ends right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta el %1$@, puedes recibir un reembolso completo de %2$@. Plus termina de inmediato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’au %1$@, tu peux obtenir un remboursement intégral de %2$@. Plus prend fin immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino al %1$@ puoi ottenere un rimborso completo di %2$@. Plus termina subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@までは、%2$@の全額返金を受けられます。Plusは解約と同時に終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@까지 %2$@ 전액을 환불받을 수 있어요. Plus는 즉시 종료돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do %1$@ możesz otrzymać pełny zwrot w wysokości %2$@. Dostęp do Plus zakończy się od razu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até %1$@, você pode receber o reembolso integral de %2$@. O Plus termina na hora."
