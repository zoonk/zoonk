    "Tap the bookmark on a lesson to keep it here." : {
      "comment" : "Explains how a lesson gets on the saved lessons page, before there's any",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe bei einer Lektion auf das Lesezeichen, um sie hier zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el marcador de una lección para guardarla aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuie sur le marque-page d’une leçon pour la retrouver ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il segnalibro di una lezione per ritrovarla qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レッスンのブックマークをタップすると、ここに保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "레슨에서 북마크를 누르면 여기에 저장돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij ikonę zakładki przy lekcji, aby ją tutaj zachować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque no ícone de salvar de uma aula para ela ficar aqui."
          }
        },
        "tr" : {
          "stringUnit" : {
