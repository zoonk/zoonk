    "A star for finishing, one for getting everything across and one without Help." : {
      "comment" : "How a call's stars are earned",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Stern fürs Abschließen, einen dafür, alles verständlich zu vermitteln, und einen fürs Abschließen ohne Hilfe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una estrella por terminar, otra por transmitir todo el mensaje y otra por no usar Ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une étoile pour avoir terminé, une pour avoir tout réussi à exprimer et une pour ne pas avoir utilisé l’aide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una stella se finisci, una se riesci a comunicare tutto e una se non usi Aiuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後まで取り組むと星1つ、伝える内容をすべて伝えられると星1つ、ヘルプを使わないと星1つもらえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끝까지 마치면 별 하나, 할 말을 모두 전하면 하나, 도움 없이 마치면 하나를 받아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po gwiazdce za ukończenie rozmowy, przekazanie wszystkich informacji i rozmowę bez Pomocy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma estrela por terminar, uma por transmitir tudo o que queria e uma por não usar a Ajuda."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitirdiğin için bir yıldız, her şeyi anlatabildiğin için bir yıldız, Yardım kullanmadığın için bir yıldız."
          }
        }
      }
    },
