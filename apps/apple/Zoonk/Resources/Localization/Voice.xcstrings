    "%@ is an official exam. Practice its speaking tasks whether or not you plan to take it." : {
      "comment" : "The exam is official; practicing doesn't mean taking it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist eine offizielle Prüfung. Übe die Sprechaufgaben, egal ob du die Prüfung ablegen möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un examen oficial. Practica sus pruebas orales tanto si tienes pensado presentarte como si no."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un examen officiel. Entraîne-toi aux épreuves orales, que tu prévoies de le passer ou non."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é uma prova oficial. Pratique as tarefas de conversação, mesmo que você não pretenda fazê-la."
          }
        }
      }
    },
