    "It ended when you started another call." : {
      "comment" : "Another call took this one over",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde beendet, als du ein anderes Gespräch begonnen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La llamada terminó cuando empezaste otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appel s’est terminé quand tu en as commencé un autre."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela terminou quando você começou outra conversa."
          }
        }
      }
    },
    "It's open in another tab or on another device. Ending it from here skips its feedback." : {
      "comment" : "Another call of the learner's is open",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist in einem anderen Tab oder auf einem anderen Gerät geöffnet. Wenn du es hier beendest, erhältst du kein Feedback dazu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La llamada está abierta en otra pestaña o en otro dispositivo. Si la terminas desde aquí, no recibirás comentarios sobre ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est ouvert dans un autre onglet ou sur un autre appareil. Si tu y mets fin ici, tu ne recevras pas de retour."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela está aberta em outra aba ou em outro dispositivo. Se você encerrar por aqui, não vai receber o retorno sobre ela."
          }
        }
      }
    },
    "It's the same for everyone right now. Try again later." : {
      "comment" : "Calls are paused for everyone",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist gerade bei allen so. Versuch es später noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo las llamadas están pausadas para todo el mundo. Vuelve a intentarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels sont en pause pour tout le monde en ce moment. Réessaie plus tard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas estão em pausa para todo mundo agora. Tente de novo mais tarde."
          }
        }
      }
    },
