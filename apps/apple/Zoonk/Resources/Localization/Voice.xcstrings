    "It ended when you started another call." : {
      "comment" : "Another call took this one over",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gespräch wurde beendet, als du ein anderes gestartet hast."
