    },
    "It's open in another tab or on another device. Ending it from here skips its feedback." : {
      "comment" : "Another call of the learner's is open",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gespräch ist in einem anderen Tab oder auf einem anderen Gerät geöffnet. Wenn du es hier beendest, erhältst du kein Feedback dazu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está abierta en otra pestaña o dispositivo. Si la terminas desde aquí, no recibirás comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appel est ouvert dans un autre onglet ou sur un autre appareil. Si tu le termines ici, tu n’auras pas son retour."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela está aberta em outra aba ou dispositivo. Se você encerrar daqui, vai pular os comentários."
          }
        }
      }
    },
    "It's the same for everyone right now. Try again later." : {
      "comment" : "Calls are paused for everyone",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gilt gerade für alle. Versuch es später noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo está en pausa para todo el mundo. Inténtalo más tarde."
