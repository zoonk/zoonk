    "It comes back %@." : {
      "comment" : "When the word comes back to say again",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kommt %@ wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volverá a aparecer %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pourras le redire %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornerà %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に出てくるのは%@です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 단어는 %@ 다시 나와요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wróci %@ do powtórki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela volta %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tekrar karşına çıkacak."
          }
        }
      }
    },
    "It ended when you started another call." : {
      "comment" : "Another call took this one over",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde beendet, als du ein anderes Gespräch begonnen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminó cuando iniciaste otra llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appel s’est terminé quand tu en as commencé un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è conclusa quando hai iniziato un’altra conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の会話を始めたため、この会話は終了しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 대화를 시작해서 이 대화는 끝났어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończyła się po rozpoczęciu kolejnej rozmowy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela terminou quando você começou outra conversa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir sohbet başlattığında sona erdi."
          }
        }
      }
    },
    "It's open in another tab or on another device. Ending it from here skips its feedback." : {
      "comment" : "Another call of the learner's is open",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist in einem anderen Tab oder auf einem anderen Gerät geöffnet. Wenn du es hier beendest, erhältst du kein Feedback dazu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está abierta en otra pestaña o en otro dispositivo. Si la terminas desde aquí, no recibirás comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est ouvert dans un autre onglet ou sur un autre appareil. Si tu y mets fin ici, tu ne recevras pas de retour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È aperta in un’altra scheda o su un altro dispositivo. Se la termini da qui, non riceverai i commenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のタブかデバイスで会話中です。ここから終了すると、その会話のフィードバックは受け取れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 탭이나 기기에서 대화가 열려 있어요. 여기서 끝내면 그 대화의 피드백을 받을 수 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest otwarta w innej karcie lub na innym urządzeniu. Jeśli zakończysz ją tutaj, nie dostaniesz informacji zwrotnej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela está aberta em outra aba ou em outro dispositivo. Se você encerrar por aqui, não vai receber o retorno sobre ela."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir sekmede veya cihazda açık. Buradan bitirirsen geri bildirim alamazsın."
          }
        }
      }
    },
    "It's the same for everyone right now. Try again later." : {
      "comment" : "Calls are paused for everyone",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist gerade bei allen so. Versuch es später noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A todos les pasa lo mismo en este momento. Vuelve a intentarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels sont en pause pour tout le monde en ce moment. Réessaie plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento è così per tutti. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今はどなたも会話を利用できません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 모두 대화를 이용할 수 없어요. 나중에 다시 시도해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tej chwili dotyczy to wszystkich. Spróbuj ponownie później."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas estão em pausa para todo mundo agora. Tente de novo mais tarde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu an herkes aynı durumda. Daha sonra tekrar dene."
          }
        }
      }
    },
