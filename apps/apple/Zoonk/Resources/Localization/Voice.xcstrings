    "%@ is an official exam. Practice its speaking tasks whether or not you plan to take it." : {
      "comment" : "The exam is official; practicing doesn't mean taking it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist eine offizielle Prüfung. Übe die Sprechaufgaben, auch wenn du die Prüfung nicht ablegen möchtest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un examen oficial. Practica sus tareas de expresión oral, tengas o no pensado presentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un examen officiel. Entraîne-toi aux épreuves orales, que tu comptes le passer ou non."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un esame ufficiale. Esercitati con i compiti della prova orale anche se non pensi di sostenerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は正式な試験です。受験予定がなくても、スピーキングのタスクを練習できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 공식 시험이에요. 응시 계획이 없어도 말하기 과제를 연습해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ to oficjalny egzamin. Ćwicz zadania z części ustnej, nawet jeśli nie planujesz do niego podchodzić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é uma prova oficial. Pratique as tarefas de conversação mesmo que você não pretenda fazer a prova."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ resmî bir sınav. Sınava girmeyi düşünmesen bile konuşma bölümlerini çalışabilirsin."
          }
        }
      }
    },
