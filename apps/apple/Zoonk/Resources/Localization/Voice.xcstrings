    "Rating your speaking on the exam's criteria. It usually takes about half a minute." : {
      "comment" : "An exam task is graded",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir bewerten deine Sprechleistung nach den Prüfungskriterien. Das dauert meist etwa eine halbe Minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evaluando tu expresión oral según los criterios del examen. Suele tardar aproximadamente medio minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évaluation de ton expression orale selon les critères de l’examen. Cela prend généralement une trentaine de secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
