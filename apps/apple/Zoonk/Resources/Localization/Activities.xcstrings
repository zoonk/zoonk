    "Drag the steps into order, or tap one and then its place." : {
      "comment" : "Under the steps of a process to put in order",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh die Schritte in die richtige Reihenfolge oder tipp erst auf einen Schritt und dann auf seinen Platz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra los pasos para ordenarlos, o toca uno y luego el lugar donde va."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais glisser les étapes pour les mettre dans l’ordre, ou appuie sur une étape puis sur sa place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina i passaggi per metterli in ordine, oppure toccane uno e poi la sua posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステップをドラッグして並べ替えるか、ステップをタップしてから移動先をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단계를 끌어서 순서를 맞추거나, 단계를 누른 다음 놓을 자리를 누르세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij kroki na właściwe miejsca lub stuknij krok, a potem jego miejsce."
          }
        },
        "pt" : {
