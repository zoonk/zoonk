    "Paused while you're away. Studying turns them back on." : {
      "comment" : "Reminders stopped after a week without study",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert, solange du weg bist. Sobald du wieder lernst, sind die Erinnerungen wieder aktiv."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En pausa mientras no estás. Se reactivan cuando vuelves a estudiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels sont en pause pendant ton absence. Ils reprennent quand tu te remets à étudier."
