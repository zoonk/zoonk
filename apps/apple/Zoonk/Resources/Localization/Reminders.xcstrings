    "At %@ on your study days, when you still have learning left." : {
      "comment" : "What the reminder offer below a lesson promises",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An deinen Lerntagen um %@, wenn du noch etwas zu lernen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A las %@ en tus días de estudio, si aún te queda algo por estudiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %@ les jours d’étude, s’il te reste des choses à apprendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@ nei tuoi giorni di studio, se hai ancora qualcosa da studiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学習日の%@に、まだ学習が残っていればお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "학습일에 할 공부가 남아 있으면 %@에 알려 드려요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ w dni nauki, jeśli masz jeszcze coś do nauki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Às %@ nos seus dias de estudo, quando ainda tiver o que estudar."
