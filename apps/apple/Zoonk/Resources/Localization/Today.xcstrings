    "At %@ a day, your plan now covers %@ of the exam, down from %@." : {
      "comment" : "Missed days left an exam plan covering less",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei %1$@ am Tag deckt dein Plan jetzt %2$@ der Prüfungsinhalte ab, vorher waren es %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "At %1$@ a day, your plan now covers %2$@ of the exam, down from %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %1$@ al día, tu plan ahora cubre el %2$@ del examen; antes cubría el %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À raison de %1$@ par jour, ton plan couvre maintenant %2$@ de l’examen, contre %3$@ auparavant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con %1$@ al giorno, il tuo piano ora copre una parte minore dell’esame: %2$@ rispetto a %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日%1$@では、計画で学べる試験範囲は%2$@となり、以前の%3$@より少なくなっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 %1$@씩 공부하는 현재 계획으로는 시험 범위의 %2$@까지 공부할 수 있어요. 이전의 %3$@보다 줄었어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy %1$@ nauki dziennie twój plan obejmuje teraz %2$@ materiału do egzaminu, a wcześniej obejmował %3$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com %1$@ por dia, seu plano agora cobre %2$@ da prova, antes cobria %3$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde %1$@ ile planının sınavı kapsama oranı %2$@ düzeyine düştü; önceden %3$@ idi."
          }
        }
      }
    },
