      "comment" : "Greets a learner back with no goal",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen zurück"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué gusto verte de nuevo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content de te revoir"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che bello rivederti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おかえりなさい"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 만나서 반가워요"
