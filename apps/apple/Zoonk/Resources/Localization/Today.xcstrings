    "Noted. You keep your time, with less depth where it counts least." : {
      "comment" : "The learner kept their daily time after falling behind",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles klar. Deine Lernzeit bleibt gleich. Weniger wichtige Themen behandelst du dafür weniger tief."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anotado. Mantienes tu tiempo diario y profundizas menos en los temas menos importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est noté. Tu gardes ta durée quotidienne, en approfondissant moins les points les moins importants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’accordo. Il tuo tempo di studio resta lo stesso, con meno approfondimenti sugli argomenti meno importanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "わかりました。学習時間はそのままに、重要度の低い部分を浅めに学習します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알겠어요. 하루 학습 시간은 유지하고, 중요도가 가장 낮은 부분은 가볍게 공부해요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jasne. Czas nauki zostaje bez zmian, a najmniej istotne tematy omawiamy mniej szczegółowo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combinado. Você mantém seu tempo, com menos profundidade no que tem menos peso."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamam. Çalışma süren aynı kalıyor, etkisi en az olan konuları daha az ayrıntıyla işliyoruz."
          }
        }
      }
    },
