    "It takes a minute or two. Your first day opens here as soon as it's ready." : {
      "comment" : "While a goal's plan is being built",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das dauert ein bis zwei Minuten. Sobald dein erster Lerntag bereit ist, siehst du ihn hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarda uno o dos minutos. Tu primer día se abrirá aquí en cuanto esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça prend une ou deux minutes. Ta première journée s’affichera ici dès qu’elle sera prête."
          }
