    "What you already know" : {
      "comment" : "The first week's warm-up block of placement questions",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du schon weißt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que ya sabes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que tu sais déjà"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quello che sai già"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに知っていること"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
