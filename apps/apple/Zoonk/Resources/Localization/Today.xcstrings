    "Welcome back. Today is short, so it's easy to start again." : {
      "comment" : "Under Today's title on a return after days away, until the learner starts",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen zurück. Heute steht nur wenig an, damit dir der Wiedereinstieg leichtfällt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué bueno que volviste. Hoy tienes poco que estudiar, así que será fácil volver a empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça fait plaisir de te revoir. Tu as peu à faire aujourd’hui pour reprendre en douceur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Che piacere rivederti. Oggi la sessione è breve, così è facile ricominciare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おかえりなさい。今日の学習は短めなので、気軽に再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 만나서 반가워요. 오늘은 학습 시간이 짧아서 부담 없이 다시 시작할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miło cię znów widzieć. Dziś nauki jest niewiele, więc łatwiej będzie wrócić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que bom ter você de volta. Hoje tem pouco para estudar, então fica fácil recomeçar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrar hoş geldin. Bugünkü çalışma kısa, kolayca yeniden başlayabilirsin."
          }
        }
