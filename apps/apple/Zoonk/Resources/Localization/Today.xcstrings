    "Thanks. We're reading it now, and your plan will update in a few minutes." : {
      "comment" : "After the learner uploaded the document research asked for",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke. Wir lesen das Dokument jetzt und dein Plan wird in ein paar Minuten aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias. Ya lo estamos leyendo y tu plan se actualizará en unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci. Nous l’analysons et ton plan sera mis à jour dans quelques minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie. Stiamo leggendo il documento e il tuo piano si aggiornerà tra pochi minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ありがとうございます。資料の内容を確認しています。数分後に学習計画が更新されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고마워요. 지금 문서를 읽고 있어요. 몇 분 후에 계획이 업데이트돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzięki. Czytamy już dokument, a twój plan zaktualizuje się za kilka minut."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeu! A gente está lendo o documento e seu plano vai ser atualizado em alguns minutos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teşekkürler. Belgeyi şimdi okuyoruz, planın birkaç dakika içinde güncellenecek."
          }
        }
      }
    },
    "That didn't save. Try again." : {
