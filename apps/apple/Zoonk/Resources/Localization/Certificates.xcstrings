    "Levels are aligned with the CEFR, the Common European Framework of Reference for Languages. This is not an official exam result." : {
      "comment" : "What a language certificate's level is, before the note about its name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Level orientieren sich am CEFR, dem Gemeinsamen Europäischen Referenzrahmen für Sprachen. Das ist kein offizielles Prüfungsergebnis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
