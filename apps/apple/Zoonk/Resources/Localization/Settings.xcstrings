    "Zoonk doesn't keep health, religion or other sensitive details unless you ask it to." : {
      "comment" : "Note about sensitive details at the Memory page's end",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk speichert Angaben zu Gesundheit, Religion oder andere sensible Daten nur, wenn du darum bittest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk no guarda datos de salud, religión ni otros datos sensibles, salvo que se lo pidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk ne retient pas les informations sur ta santé, ta religion ou d’autres sujets sensibles, sauf si tu le lui demandes."
