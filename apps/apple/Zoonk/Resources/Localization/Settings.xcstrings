    "Memory is off. Nothing new is learned, and these facts aren't used." : {
      "comment" : "What happens while memory is off",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gedächtnis ist ausgeschaltet. Es wird nichts Neues gemerkt und diese Einträge werden nicht verwendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria está desactivada. No se guarda información nueva ni se usan estos datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mémoire est désactivée. Rien de nouveau n’est retenu et ces informations ne sont pas utilisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La memoria è disattivata. Non memorizziamo nuove informazioni e non usiamo questi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリはオフです。新しい情報は記録されず、保存済みの情報も使われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리가 꺼져 있어요. 새로운 내용을 기억하지 않고, 저장된 내용도 사용하지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć jest wyłączona. Nie zapamiętujemy nic nowego ani nie korzystamy z tych informacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A memória está desativada. Nada de novo é aprendido, e essas informações não são usadas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bellek kapalı. Yeni bilgi kaydedilmiyor ve bu bilgiler kullanılmıyor."
          }
        }
      }
    },
