    },
    "Zoonk follows your device's language. Change it for Zoonk alone in Settings." : {
      "comment" : "Explains where the app's language is changed on iPhone and iPad",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk verwendet die Sprache deines Geräts. In den Einstellungen kannst du die Sprache nur für Zoonk ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk usa el idioma de tu dispositivo. Puedes cambiarlo solo para Zoonk en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk utilise la langue de ton appareil. Pour changer uniquement la langue de Zoonk, va dans Réglages."
