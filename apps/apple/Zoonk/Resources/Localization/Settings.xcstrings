    "Zoonk doesn't keep health, religion or other sensitive details unless you ask it to." : {
      "comment" : "Note about sensitive details at the Memory page's end",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk speichert Angaben zu Gesundheit, Religion oder andere sensible Daten nur, wenn du darum bittest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk no guarda información sobre tu salud o religión ni otros datos sensibles a menos que se lo pidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk ne retient pas les informations sur ta santé, ta religion ou d’autres sujets sensibles, sauf si tu le lui demandes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk non conserva informazioni sulla salute, sulla religione o altri dettagli sensibili, a meno che tu non glielo chieda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonkは、頼まれない限り健康や宗教などのデリケートな情報を保存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "따로 요청하지 않으면 Zoonk는 건강이나 종교 같은 민감한 정보를 저장하지 않아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk nie przechowuje informacji o zdrowiu, religii ani innych wrażliwych danych, chyba że o to poprosisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zoonk não guarda dados de saúde, religião ou outras informações sensíveis, a menos que você peça."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk, sen istemedikçe sağlığın, dinin veya diğer hassas konularla ilgili bilgileri saklamaz."
          }
        }
      }
    },
    "Zoonk follows your device's language. Change it for Zoonk alone in Settings." : {
      "comment" : "Explains where the app's language is changed on iPhone and iPad",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk verwendet die Sprache deines Geräts. In den Einstellungen kannst du die Sprache nur für Zoonk ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk usa el idioma de tu dispositivo. Cámbialo solo para Zoonk en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk utilise la langue de ton appareil. Tu peux la changer uniquement pour Zoonk dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk usa la lingua del tuo dispositivo. Cambiala solo per Zoonk in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonkはデバイスの言語に合わせて表示されます。Zoonkだけ別の言語にするには、「設定」で変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk는 기기의 언어 설정을 따라요. 설정에서 Zoonk의 언어만 따로 바꾸세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk używa języka urządzenia. W Ustawieniach możesz zmienić język samego Zoonka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Zoonk usa o idioma do seu aparelho. Para mudar só o do Zoonk, vá aos Ajustes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk cihazının dilini kullanır. Yalnızca Zoonk’un dilini değiştirmek için Ayarlar’a git."
          }
        }
      }
    },
