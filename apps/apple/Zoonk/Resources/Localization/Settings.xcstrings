    "Zoonk doesn't keep health, religion or other sensitive details unless you ask it to." : {
      "comment" : "Note about sensitive details at the Memory page's end",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk speichert keine Angaben zu Gesundheit, Religion oder anderen sensiblen Themen, außer du bittest darum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk no guarda información sobre tu salud, religión u otros datos sensibles a menos que se lo pidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoonk ne conserve pas d’informations sensibles sur ta santé, ta religion ou d’autres sujets, sauf si tu le lui demandes."
          }
        },
