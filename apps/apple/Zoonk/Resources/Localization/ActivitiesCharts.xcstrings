    "%@ samples of %@ from %@. The true value is %@; 95%% of samples landed between %@ and %@." : {
      "comment" : "A sampling simulation, for VoiceOver",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Stichproben mit je %2$@ aus %3$@. Der tatsächliche Wert beträgt %4$@; 95%% der Stichproben lagen zwischen %5$@ und %6$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ samples of %2$@ from %3$@. The true value is %4$@; 95%% of samples landed between %5$@ and %6$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ muestras de %2$@ tomadas de %3$@. El valor real es %4$@; el 95%% de las muestras quedó entre %5$@ y %6$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ échantillons de %2$@ issus de %3$@. La valeur réelle est de %4$@ ; 95%% des échantillons ont donné une valeur entre %5$@ et %6$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ campioni da %2$@ estratti da %3$@. Il valore reale è %4$@; il 95%% dei campioni è compreso tra %5$@ e %6$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@組の標本（標本サイズ：%2$@）を%3$@から抽出しました。真の値は%4$@で、標本の95%%が%5$@から%6$@の間に収まりました。"
