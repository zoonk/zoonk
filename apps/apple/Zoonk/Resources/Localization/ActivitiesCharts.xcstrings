    "This pattern can't run. Check that brackets close, and don't repeat a group that already repeats inside." : {
      "comment" : "A regex that doesn't compile or is unsafe",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Muster kann nicht ausgeführt werden. Prüfe, ob alle Klammern geschlossen sind, und wiederhole keine Gruppe, die bereits eine Wiederholung enthält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este patrón no se puede ejecutar. Comprueba que los paréntesis y corchetes estén cerrados y no repitas un grupo que ya contenga repeticiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce motif ne peut pas être utilisé. Vérifie que les parenthèses et les crochets sont fermés et ne répète pas un groupe qui contient déjà une répétition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa espressione non può essere eseguita. Controlla che le parentesi siano chiuse e non ripetere un gruppo che contiene già ripetizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパターンは実行できません。かっこが閉じているか、繰り返しを含むグループをさらに繰り返していないか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 패턴은 실행할 수 없어요. 괄호가 모두 닫혔는지 확인하고, 내부에 반복이 있는 그룹을 다시 반복하지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można uruchomić tego wzorca. Sprawdź, czy nawiasy są domknięte, i nie powtarzaj grupy, która zawiera już powtórzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível executar esse padrão. Confira se os colchetes estão fechados e não repita um grupo que já tenha uma repetição dentro dele."
          }
        },
