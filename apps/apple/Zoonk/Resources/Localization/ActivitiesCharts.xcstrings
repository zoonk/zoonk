    "%@ is selected. Tap another atom to bond them, or an element to add one bonded to it." : {
      "comment" : "What to do with a selected atom",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ausgewählt. Tippe auf ein anderes Atom, um beide zu verbinden, oder auf ein Element, um ein damit verbundenes Atom hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionaste %@. Toca otro átomo para enlazarlos o un elemento para agregar uno enlazado al que seleccionaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est sélectionné. Appuie sur un autre atome pour les lier, ou sur un élément pour lui ajouter un atome lié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai selezionato %@. Tocca un altro atomo per legarli, oppure un elemento per aggiungerne uno legato all’atomo selezionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を選択しています。ほかの原子をタップすると結合できます。元素をタップすると、その元素の原子を結合して追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(이)가 선택됐어요. 다른 원자를 탭해 두 원자를 결합하거나, 원소를 탭해 선택한 원자와 결합된 새 원자를 추가하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany atom: %@. Stuknij inny atom, aby utworzyć między nimi wiązanie, lub pierwiastek, aby dodać atom połączony z wybranym."
          }
        },
        "pt" : {
