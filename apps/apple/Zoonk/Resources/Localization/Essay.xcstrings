    "A new question like the ones on your exam. It opens here when it's ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Frage, wie sie auch in deiner Prüfung vorkommt. Sie wird hier angezeigt, sobald sie fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pregunta nueva, similar a las de tu examen. Aparecerá aquí cuando esté lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle question du même type que celles de ton examen. Elle s’affichera ici quand elle sera prête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nuova domanda come quelle del tuo esame. Si aprirà qui quando sarà pronta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試験に出る問題に似た新しい問題です。準備ができると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시험에 나오는 문제와 비슷한 새 문제예요. 준비되면 여기에 표시돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe pytanie podobne do tych na twoim egzaminie. Pojawi się tutaj, gdy będzie gotowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
