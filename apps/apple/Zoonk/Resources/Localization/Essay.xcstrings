    "Graders stop at line %@, so the rest isn't read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bewertung endet bei Zeile %@; der Rest wird nicht mehr gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quienes califican se detienen en la línea %@, así que no leen el resto."
