{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ depends on your choice of %@" : {
      "comment" : "Under a written test where one question waits for an exam choice the learner hasn't made. {task} is the question, such as \"The 60-line question\"; {groups} names the choices.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hängt von deiner Wahl bei %2$@ ab"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ depends on your choice of %2$@"
          }
        },
        "es" : {
