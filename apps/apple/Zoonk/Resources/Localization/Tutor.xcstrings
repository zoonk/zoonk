    "Calls are paused for everyone right now. Try again later." : {
      "comment" : "The buddy offers a practice call while calls are paused for everyone",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespräche sind gerade für niemanden verfügbar. Versuch es später noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las llamadas están en pausa para todos por ahora. Inténtalo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les appels sont suspendus pour tout le monde en ce moment. Réessaie plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento le conversazioni sono sospese per tutti. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、会話練習のサービスを一時停止しています。しばらくしてからもう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 모든 이용자의 대화 기능이 일시 중지되어 있어요. 나중에 다시 시도해 보세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmowy są teraz wstrzymane dla wszystkich. Spróbuj ponownie później."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas estão pausadas para todo mundo no momento. Tente de novo mais tarde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli sohbetler şu anda herkese kapalı. Daha sonra tekrar dene."
          }
        }
      }
    },
