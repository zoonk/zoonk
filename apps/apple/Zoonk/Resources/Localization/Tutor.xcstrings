    "You've used the free help you can get without an account. Create a free account to keep going." : {
      "comment" : "A guest's help is used up",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die kostenlose Hilfe ohne Konto aufgebraucht. Erstelle ein kostenloses Konto, um weiterzumachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya usaste toda la ayuda gratuita disponible sin una cuenta. Crea una cuenta gratis para seguir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as utilisé toute l’aide gratuite disponible sans compte. Crée un compte gratuit pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai usato tutto l’aiuto gratuito disponibile senza un account. Crea un account gratuito per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントなしでの無料相談は上限に達しました。続けるには、無料アカウントを作成してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정 없이 무료로 받을 수 있는 도움을 다 받았어요. 계속하려면 무료 계정을 만드세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystano już całą bezpłatną pomoc dostępną bez konta. Utwórz bezpłatne konto, aby kontynuować."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usou toda a ajuda gratuita disponível sem uma conta. Crie uma conta grátis para continuar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesap açmadan alabileceğin ücretsiz yardım hakkını kullandın. Devam etmek için ücretsiz bir hesap oluştur."
          }
        }
      }
    },
    "You've used this month's help. It comes back next month, or get Plus to keep going now." : {
      "comment" : "A free learner's help for the month is used up",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast deine Hilfe für diesen Monat aufgebraucht. Nächsten Monat ist sie wieder verfügbar. Mit Plus kannst du sofort weitermachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya usaste toda la ayuda de este mes. Tendrás más el próximo mes o puedes obtener Plus para seguir ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as utilisé toute ton aide pour ce mois-ci. Elle sera de nouveau disponible le mois prochain. Tu peux aussi choisir Plus pour continuer dès maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai usato tutto l’aiuto disponibile per questo mese. Ne avrai altro il mese prossimo, oppure passa a Plus per continuare subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今月の相談は上限に達しました。来月また利用できます。今すぐ続けるには、Plusに登録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 달에 받을 수 있는 도움을 다 받았어요. 다음 달에 다시 이용할 수 있고, Plus를 구독하면 지금 계속할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykorzystano już całą pomoc na ten miesiąc. W przyszłym miesiącu będzie znów dostępna. Możesz też przejść na Plus, aby kontynuować już teraz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usou toda a ajuda disponível neste mês. Ela volta no mês que vem, ou você pode assinar o Plus para continuar agora."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayki yardım hakkını kullandın. Hakkın gelecek ay yenilenir; hemen devam etmek için Plus’a geçebilirsin."
          }
        }
      }
    },
