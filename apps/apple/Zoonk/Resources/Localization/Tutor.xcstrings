        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você usou toda a ajuda gratuita disponível sem uma conta. Crie uma conta grátis para continuar."
          }
        }
      }
    },
    "You've used this month's help. It comes back next month, or get Plus to keep going now." : {
      "comment" : "A free learner's help for the month is used up",
      "localizations" : {
        "de" : {
          "stringUnit" : {
