    "Past or present, finished or not. Pick up to 3." : {
      "comment" : "Under What have you studied?",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Früher oder heute, abgeschlossen oder nicht. Wähl bis zu 3 aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estudios anteriores o actuales, terminados o no. Elige hasta 3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Études passées ou en cours, terminées ou non. Choisis jusqu’à 3 réponses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studi passati o attuali, conclusi o no. Scegline fino a 3."
