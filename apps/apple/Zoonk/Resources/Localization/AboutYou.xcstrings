    "We checked what often helps with what you picked. Change anything you like." : {
      "comment" : "Over the rows checked for the conditions picked on the screen before",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passend zu deiner Auswahl haben wir angekreuzt, was oft hilft. Pass alles nach deinen Wünschen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcamos las opciones que suelen ayudar según lo que elegiste. Cambia lo que quieras."
