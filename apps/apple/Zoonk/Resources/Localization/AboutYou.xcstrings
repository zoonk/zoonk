        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去の学習も今の学習も、修了したかどうかに関係なく選べます。3つまで選べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예전에 배웠든 지금 배우든, 끝내지 않았어도 괜찮아요. 최대 3개까지 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wcześniejsze lub obecne, ukończone lub nie. Wybierz maksymalnie 3."
