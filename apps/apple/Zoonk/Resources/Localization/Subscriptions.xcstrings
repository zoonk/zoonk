    "Your purchase is safe. Log in, then restore purchases." : {
      "comment" : "Explains how to recover a purchase after the Zoonk session expires",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf bleibt erhalten. Melde dich an und stell dann deine Käufe wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra está segura. Inicia sesión y luego restaura tus compras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton achat est bien enregistré. Connecte-toi, puis restaure tes achats."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo acquisto è al sicuro. Accedi, poi ripristina gli acquisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入情報は保存されています。ログインしてから、購入を復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구입 내역은 그대로 남아 있어요. 로그인한 후 구입 항목을 복원하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój zakup nie przepadł. Zaloguj się, a potem przywróć zakupy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua compra está segura. Entre na sua conta e depois restaure as compras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satın aldığın abonelik güvende. Giriş yap, ardından satın aldıklarını geri yükle."
          }
        }
      }
    },
    "Your purchase is safe. Restore purchases when you're back online." : {
