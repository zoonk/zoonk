    "Your free week of exam prep is over" : {
      "comment" : "Title of the notice when a free exam plan's first week ended",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine kostenlose Woche zur Prüfungsvorbereitung ist vorbei"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminó tu semana gratis de preparación para el examen"
          }
        },
        "fr" : {
