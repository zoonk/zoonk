    "Log in to the Zoonk account that bought it, or write to us at hello@zoonk.com." : {
      "comment" : "Recovery guidance when an App Store purchase belongs to another Zoonk account",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld dich mit dem Zoonk-Konto an, mit dem du Plus gekauft hast, oder schreib uns an hello@zoonk.com."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en la cuenta de Zoonk con la que hiciste la compra o escríbenos a contacto@zoonk.com."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi au compte Zoonk utilisé pour cet achat, ou écris-nous à hello@zoonk.com."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi all’account Zoonk usato per l’acquisto oppure scrivici a hello@zoonk.com."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入に使ったZoonkアカウントでログインするか、hello@zoonk.comまでご連絡ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매에 사용한 Zoonk 계정으로 로그인하거나 hello@zoonk.com으로 문의해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się na konto w Zoonku użyte do zakupu lub napisz do nas na hello@zoonk.com."
          }
