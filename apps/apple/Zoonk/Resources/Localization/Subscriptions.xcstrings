{
  "sourceLanguage" : "en",
  "strings" : {
    "Available with Plus" : {
      "comment" : "Title of the notice on a feature the learner's plan doesn't include\nWhat VoiceOver says for the Plus mark on a feature the learner's plan lacks",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Plus verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible con Plus"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponible avec Plus"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibile con Plus"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusで利用できます"
          }
        },
        "ko" : {
