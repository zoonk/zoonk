    "You have Plus until %@." : {
      "comment" : "When Plus that Zoonk added to the account ends",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Plus bis zum %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes Plus hasta el %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as Plus jusqu’au %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai Plus fino al %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@までPlusを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지 Plus를 이용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz Plus do %@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem o Plus até %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tarihine kadar Plus kullanabilirsin."
          }
        }
      }
    },
    "You keep Plus until the end of the period you already paid for." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behältst Plus bis zum Ende des bereits bezahlten Zeitraums."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservarás Plus hasta que termine el periodo que ya pagaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu gardes Plus jusqu’à la fin de la période que tu as déjà payée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus resta attivo fino alla fine del periodo già pagato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お支払い済みの期間が終わるまで、引き続きPlusを利用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 결제한 기간이 끝날 때까지 Plus를 이용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz korzystać z Plus do końca opłaconego okresu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você continua com o Plus até o fim do período já pago."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödemesini yaptığın dönem bitene kadar Plus’ı kullanmaya devam edersin."
          }
        }
      }
    },
    "You keep Plus until the end of the period you already paid for. Then you're back to free, and your goals and progress stay with you." : {
      "comment" : "“Back to free” means using Zoonk without paying again. Don't call it a “free plan” or use your language's word for the learner's study plan.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behältst Plus bis zum Ende des Zeitraums, für den du schon bezahlt hast. Danach nutzt du Zoonk wieder kostenlos, und deine Ziele und dein Fortschritt bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservas Plus hasta el final del periodo que ya pagaste. Después vuelves a usar Zoonk gratis y conservas tus objetivos y tu progreso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu gardes Plus jusqu’à la fin de la période que tu as déjà payée. Ensuite, tu utilises à nouveau Zoonk gratuitement et tu gardes tes objectifs et ta progression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continui a usare Plus fino alla fine del periodo che hai già pagato. Poi torni a usare Zoonk gratis e conservi i tuoi obiettivi e progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お支払い済みの期間が終わるまでPlusを利用できます。その後は無料での利用に戻り、目標や学習の進み具合はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 결제한 기간이 끝날 때까지 Plus를 계속 이용할 수 있어요. 그 후에는 다시 무료로 이용하게 되고, 목표와 진도는 그대로 유지돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowasz Plus do końca opłaconego okresu. Potem znów będziesz korzystać z Zoonka bezpłatnie, a twoje cele i postępy zostaną z tobą."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você continua com o Plus até o fim do período que já pagou. Depois, volta a usar o Zoonk de graça e mantém seus objetivos e seu progresso."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ödemesini yaptığın dönem bitene kadar Plus’ı kullanmaya devam edersin. Ardından ücretsiz kullanıma dönersin; hedeflerin ve ilerlemen korunur."
          }
        }
      }
    },
