            "value" : "Plus ile kullanılabilir"
          }
        }
      }
    },
    "Create a free account" : {
      "comment" : "Opens sign-up for a guest who reached what they can try without an account",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenloses Konto erstellen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crear una cuenta gratis"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer un compte gratuit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un account gratuito"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料アカウントを作成する"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 계정 만들기"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz bezpłatne konto"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Criar uma conta grátis"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz hesap oluştur"
          }
        }
      }
    },
    "It writes more lessons than you get for free." : {
      "comment" : "Under the title of a notice on a chapter's mind map: making the map writes its lessons first, and this one has more lessons than a free learner can start.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dafür werden mehr Lektionen erstellt, als du kostenlos bekommst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al crearlo, se preparan más lecciones de las que incluye el plan gratis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle prépare plus de leçons que la formule gratuite n’en inclut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per crearla dobbiamo preparare più lezioni di quelle incluse gratis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマップで作成されるレッスン数は、無料で使える数を超えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료로 제공되는 것보다 더 많은 레슨을 만들어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do tej mapy przygotowujemy więcej lekcji, niż dostajesz bezpłatnie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele cria mais aulas do que você recebe de graça."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu harita için ücretsiz ders hakkından daha fazla ders hazırlamamız gerekiyor."
          }
        }
      }
    },
    "More next month, or subscribe to keep going." : {
      "comment" : "Under a limit a free learner reached: it comes back next month",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächsten Monat gibt es mehr. Mit einem Abo kannst du weitermachen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendrás más el próximo mes o puedes suscribirte para seguir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu en auras d’autres le mois prochain, ou tu peux t’abonner pour continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrai continuare il mese prossimo, oppure abbonati per farlo subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来月また利用できます。サブスクリプションに登録すると、このまま続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 달에 다시 이용할 수 있어요. 구독하면 지금 계속 이용할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Więcej w przyszłym miesiącu lub już teraz z subskrypcją."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No mês que vem tem mais. Para continuar agora, assine."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakkın gelecek ay yenilenecek. Devam etmek için abone ol."
          }
        }
      }
    },
