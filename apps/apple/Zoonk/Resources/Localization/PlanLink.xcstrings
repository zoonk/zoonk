            "value" : "Quanto tempo por dia?"
          }
        }
      }
    },
    "Start from this plan" : {
      "comment" : "Starts the learner's own plan from a shared one",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem Plan starten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar con este plan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencer avec ce plan"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começar com este plano"
          }
        }
      }
    },
    "That didn't work. Try again in a moment." : {
      "comment" : "Starting from a shared plan failed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hat nicht geklappt. Versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo ha fallado. Vuelve a intentarlo dentro de un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça n’a pas marché. Réessaie dans un instant."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deu certo. Tente novamente em instantes."
          }
        }
      }
    },
    "This plan isn't available" : {
      "comment" : "A shared plan link that doesn't exist",
