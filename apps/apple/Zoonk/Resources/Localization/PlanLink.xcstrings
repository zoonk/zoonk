    "How much time a day?" : {
      "comment" : "Label of the daily time picker for a shared plan",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viel Zeit am Tag?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuánto tiempo al día?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Combien de temps par jour ?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto tempo por dia?"
          }
        }
      }
    },
    "Start from this plan" : {
      "comment" : "Starts the learner's own plan from a shared one",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesem Plan starten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar con este plan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partir de ce plan"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começar a partir deste plano"
          }
        }
      }
    },
    "That didn't work. Try again in a moment." : {
      "comment" : "Starting from a shared plan failed",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hat nicht geklappt. Versuch es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ha funcionado. Vuelve a intentarlo dentro de un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça n’a pas marché. Réessaie dans un instant."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não deu certo. Tente de novo daqui a pouco."
          }
        }
      }
    },
    "This plan isn't available" : {
      "comment" : "A shared plan link that doesn't exist",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Plan ist nicht verfügbar"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plan no está disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce plan n’est pas disponible"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este plano não está disponível"
          }
        }
      }
    },
    "Try again" : {
      "comment" : "Loads the shared plan again",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch einmal versuchen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a intentarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayer"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tentar de novo"
          }
        }
      }
    },
    "We couldn't load this plan" : {
      "comment" : "A shared plan failed to load",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Plan konnte nicht geladen werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hemos podido cargar este plan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger ce plan"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar este plano"
          }
        }
      }
    },
    "You can't start another goal right now. Finish or pause one first." : {
      "comment" : "A goal limit refused starting from a shared plan",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst gerade kein weiteres Ziel starten. Schließe zuerst ein Ziel ab oder pausiere es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes empezar otro objetivo ahora mismo. Completa o pausa uno primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas démarrer un autre objectif pour le moment. Termine-en un ou mets-en un en pause d’abord."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não pode começar outra meta agora. Conclua ou pause uma primeiro."
          }
        }
      }
    },
    "You get your own plan for the same subject, at your own pace. A few questions then skip what you already know." : {
      "comment" : "What starting from a shared plan does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst deinen eigenen Plan für dasselbe Thema und lernst in deinem Tempo. Nach ein paar Fragen kannst du überspringen, was du schon weißt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendrás tu propio plan para la misma materia y a tu ritmo. Responde a unas preguntas y omite lo que ya sabes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu auras ton propre plan sur le même sujet, à ton rythme. Réponds à quelques questions, puis ignore ce que tu connais déjà."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você recebe seu próprio plano para a mesma matéria, no seu ritmo. Responda a algumas perguntas para pular o que você já sabe."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
