    "Lessons you finish show up here, so you can do them again anytime." : {
      "comment" : "Explains what the completed lessons page lists, before there's any",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier findest du deine abgeschlossenen Lektionen und kannst sie jederzeit noch einmal machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las lecciones que completes aparecerán aquí para que puedas repetirlas cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les leçons que tu termines s’affichent ici pour que tu puisses les refaire quand tu veux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lezioni che completi compaiono qui, così puoi rifarle quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了したレッスンがここに表示され、いつでももう一度取り組めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완료한 레슨이 여기에 모여요. 언제든 다시 학습할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pojawią się ukończone lekcje, które możesz powtórzyć w każdej chwili."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As aulas que você conclui aparecem aqui para você fazer de novo quando quiser."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamladığın dersler burada görünür, böylece istediğin zaman tekrar yapabilirsin."
          }
        }
      }
    },
