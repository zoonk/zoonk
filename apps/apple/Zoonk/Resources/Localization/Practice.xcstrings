    "Finish with the answers you gave: they still choose where your plan goes deeper." : {
      "comment" : "A focus test can finish with the answers given when its writing stopped short.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließ den Test mit deinen bisherigen Antworten ab: Sie bestimmen auch so, welche Inhalte dein Plan vertieft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finaliza con las respuestas que diste: aún determinan qué temas de tu plan se trabajan más a fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine avec les réponses que tu as données : elles aideront quand même à déterminer les points à approfondir dans ton plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina con le risposte date: servono comunque a stabilire cosa approfondire nel tuo piano."
