        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここまでの回答で終了できます。この回答をもとに、学習計画で重点的に学ぶ内容を決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금까지 답한 내용으로 끝내세요. 이 답변만으로도 계획에서 더 집중해서 공부할 부분을 정할 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ z tymi odpowiedziami: nadal zdecydują, które tematy twój plan omówi dokładniej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finalize com as respostas que você deu: elas ainda ajudam a decidir o que aprofundar no seu plano."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdiğin cevaplarla bitir: planında hangi konuların daha ayrıntılı işleneceğini yine bu cevaplar belirler."
          }
        }
      }
    },
