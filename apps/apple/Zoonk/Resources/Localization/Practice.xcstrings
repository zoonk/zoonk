    "You got it right on %@. Reviewing it now helps it stick." : {
      "comment" : "Time machine note: right last time, wrong today.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am %@ hast du die Frage richtig beantwortet. Wenn du sie jetzt wiederholst, merkst du es dir besser."
