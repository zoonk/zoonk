    "Only answer when you're sure. Saying you're not sure is fine." : {
      "comment" : "How a no-guessing drill goes.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworte nur, wenn du sicher bist. Du kannst auch sagen, dass du dir nicht sicher bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde solo si no tienes dudas. Está bien decir que tienes dudas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réponds seulement si tu es sûr de toi. Tu peux aussi dire que tu ne sais pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rispondi solo quando non hai dubbi. Se hai dubbi, va bene dirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自信があるときだけ答えてください。「自信がない」と答えても大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확신이 있을 때만 답하세요. 잘 모르겠다고 해도 괜찮아요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiadaj tylko wtedy, gdy masz pewność. Możesz powiedzieć, że nie masz pewności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responda só quando tiver certeza. Tudo bem dizer que não tem certeza."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca emin olduğunda cevapla. Emin olmadığını söylemen de sorun değil."
          }
        }
      }
    },
