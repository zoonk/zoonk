    "It didn't pass our quality checks, so your plan goes on without it." : {
      "comment" : "A lesson its quality checks set aside",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hat unsere Qualitätsprüfungen nicht bestanden. Dein Plan wird deshalb ohne sie fortgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pasó nuestros controles de calidad, así que tu plan sigue sin ella."
          }
        },
