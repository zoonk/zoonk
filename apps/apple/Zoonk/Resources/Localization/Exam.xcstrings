    "Your unsure answers cost more than they earn: leave those blank." : {
      "comment" : "Advice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falsche Antworten kosten mehr Punkte, als richtige einbringen. Lass Antworten, bei denen du unsicher bist, deshalb frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas que no tienes claras te restan más de lo que suman: déjalas en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes réponses incertaines te coûtent plus qu’elles ne rapportent : laisse-les vides."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respostas incertas podem tirar mais pontos do que dar: deixe-as em branco."
