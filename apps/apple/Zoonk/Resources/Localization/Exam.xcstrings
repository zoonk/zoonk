    "A short speaking test with an examiner. After it, an estimated band for each criterion." : {
      "comment" : "What the IELTS speaking mock is",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze mündliche Prüfung mit einer prüfenden Person. Danach erhältst du für jedes Kriterium eine geschätzte Bandbewertung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una prueba breve de expresión oral con un examinador. Al terminar, recibirás una banda estimada para cada criterio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une courte épreuve orale avec un examinateur. À la fin, une note estimée pour chaque critère."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma prova curta de conversação com um examinador. Depois, você recebe uma faixa de nota estimada para cada critério."
          }
        }
      }
    },
    "A wrong answer cancels a right one" : {
      "comment" : "Net scoring",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine falsche Antwort hebt eine richtige auf"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una respuesta incorrecta anula una correcta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mauvaise réponse annule une bonne réponse"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma resposta errada anula uma certa"
          }
        }
      }
    },
    "A wrong answer costs %@ of a right one" : {
      "comment" : "Net scoring with a partial penalty",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
