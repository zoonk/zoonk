        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una respuesta incorrecta anula una correcta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une mauvaise réponse annule une bonne réponse"
          }
