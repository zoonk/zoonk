    "Estimated from past editions. We'll tell you when the official dates are out." : {
      "comment" : "Estimated days, before the calendar",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Grundlage früherer Prüfungen geschätzt. Wir sagen dir Bescheid, sobald die offiziellen Termine feststehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimado a partir de ediciones anteriores. Te avisaremos cuando se publiquen las fechas oficiales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dates estimées d’après les éditions précédentes. On te préviendra dès la publication des dates officielles."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa baseada em edições anteriores. A gente te avisa quando as datas oficiais saírem."
          }
        }
      }
    },
    "Estimated from past editions. We'll tell you when the official notice is out." : {
      "comment" : "Estimated days, before the notice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Grundlage früherer Prüfungen geschätzt. Wir sagen dir Bescheid, sobald die offizielle Bekanntmachung erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimado a partir de ediciones anteriores. Te avisaremos cuando se publique la convocatoria oficial."
          }
        },
