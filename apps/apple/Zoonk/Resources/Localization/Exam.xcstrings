    },
    "Add your official result when it comes out. You can change it later." : {
      "comment" : "Under the official result form",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage dein offizielles Ergebnis ein, sobald es da ist. Du kannst es später ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tu resultado oficial cuando se publique. Podrás cambiarlo más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ton résultat officiel dès sa publication. Tu pourras le modifier plus tard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione seu resultado oficial quando ele sair. Você pode alterar depois."
