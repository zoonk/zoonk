    "Your plan keeps your date unless you switch to one of the closest." : {
      "comment" : "The closest sittings to pick from",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Plan behält dein Datum, es sei denn, du wechselst zu einem der nächstgelegenen Termine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan mantiene tu fecha a menos que elijas una de las más cercanas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton plan garde ta date, sauf si tu choisis l’une des sessions les plus proches."
