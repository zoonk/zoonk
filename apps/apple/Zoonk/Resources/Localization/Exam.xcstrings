      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Monat, den du uns genannt hast. Wir nennen dir den Tag, sobald er in der Ausschreibung steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mes que nos dijiste. Te diremos el día cuando se indique en la convocatoria."
