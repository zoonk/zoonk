    "Your unsure answers cost more than they earn: leave those blank." : {
      "comment" : "Advice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten, bei denen du unsicher bist, kosten mehr Punkte, als sie bringen: Lass sie frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas de las que dudas te quitan más puntos de los que te dan: déjalas en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes réponses incertaines te coûtent plus de points qu’elles ne t’en rapportent : laisse ces questions sans réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con le risposte su cui hai dubbi perdi più punti di quanti ne guadagni: lasciale in bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自信のない問題は減点が加点を上回るので、空欄にしておきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확신 없이 푼 문제는 얻는 점수보다 잃는 점수가 더 많아요. 그런 문제는 비워 두세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy nie masz pewności, tracisz więcej punktów, niż zyskujesz: zostaw te pytania bez odpowiedzi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas respostas quando você tem dúvida tiram mais pontos do que dão: deixe essas em branco."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emin olmadığın cevaplar kazandırdığından fazla puan kaybettiriyor: bu soruları boş bırak."
          }
        }
      }
    },
    "Your unsure answers still earn points: keep answering them." : {
      "comment" : "Advice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Antworten, bei denen du unsicher bist, bringen Punkte: Beantworte sie weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas de las que dudas aún te dan puntos: sigue respondiendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes réponses incertaines te rapportent quand même des points : continue à répondre à ces questions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con le risposte su cui hai dubbi guadagni comunque punti: continua a rispondere."
          }
        },
