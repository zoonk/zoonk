    "Your flagged answers cost more than they earn: leave those blank." : {
      "comment" : "Advice",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine markierten Antworten kosten mehr Punkte, als sie einbringen: Lass diese Fragen unbeantwortet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus respuestas marcadas te restan más puntos de los que te dan: deja esas preguntas en blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes réponses aux questions marquées te coûtent plus de points qu’elles ne t’en rapportent : laisse ces questions sans réponse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con le domande contrassegnate perdi più punti di quanti ne guadagni: lasciale in bianco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見直し対象にした問題では、得点より減点が多くなっています。そうした問題は空欄のままにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시한 문제는 얻는 점수보다 잃는 점수가 더 많아요. 답을 비워 두세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na oznaczonych pytaniach tracisz więcej punktów, niż zdobywasz: zostawiaj je bez odpowiedzi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você perde mais pontos do que ganha nas questões marcadas: deixe essas questões em branco."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşaretlediğin sorularda kazandığından fazla puan kaybediyorsun: bu soruları boş bırak."
          }
        }
      }
    },
    "Your flagged answers still earn points: keep answering them." : {
