    "That code belongs to a different account. Request a new code for this account.": {
      "comment": "Error shown when an account deletion code belongs to a different account",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code gehört zu einem anderen Konto. Fordere einen neuen Code für dieses Konto an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código pertenece a otra cuenta. Solicita un código nuevo para esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code appartient à un autre compte. Demande un nouveau code pour ce compte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código pertence a outra conta. Solicite um novo código para esta conta."
          }
        }
      }
    },
    "That code is invalid or expired. Request a new code and try again.": {
      "comment": "Error shown when an email verification code is invalid or expired",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist ungültig oder abgelaufen. Fordere einen neuen Code an und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no es válido o ha caducado. Solicita uno nuevo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code est invalide ou a expiré. Demande un nouveau code et réessaie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código é inválido ou expirou. Solicite um novo código e tente novamente."
          }
        }
      }
    },
    "That code isn't valid. Check the email and try again.": {
      "comment": "Error shown when an email sign-in code is invalid",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist ungültig. Überprüfe die E-Mail und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no es válido. Revisa el correo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code n’est pas valide. Vérifie l’e-mail et réessaie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não é válido. Confira o email e tente de novo."
          }
        }
      }
    },
    "That username is already taken.": {
      "comment": "Error shown when a chosen username is unavailable",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Benutzername ist bereits vergeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese nombre de usuario ya está en uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom d’utilisateur est déjà pris."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse nome de usuário já está em uso."
          }
        }
      }
    },
    "This Zoonk session is shared through iCloud Keychain, so signing out removes it from your other Apple devices too.": {
      "comment": "Explains why sign-out affects the user's other Apple devices",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zoonk-Sitzung wird über den iCloud-Schlüsselbund geteilt. Wenn du dich abmeldest, wird sie daher auch von deinen anderen Apple-Geräten entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión de Zoonk se comparte a través del llavero de iCloud, por lo que al cerrar sesión también se eliminará de tus otros dispositivos Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session Zoonk est partagée via le trousseau iCloud. Si tu te déconnectes, elle sera donc aussi supprimée de tes autres appareils Apple."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão do Zoonk é compartilhada pelas Chaves do iCloud. Por isso, ao sair, ela também será removida dos seus outros dispositivos Apple."
          }
        }
      }
    },
    "This permanently deletes your profile, progress, and personalized courses. This can't be undone.": {
      "comment": "Explains the consequences of confirming permanent account deletion",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden dein Profil, dein Fortschritt und deine personalisierten Kurse dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tu perfil, tu progreso y tus cursos personalizados. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton profil, ta progression et tes cours personnalisés seront supprimés définitivement. Cette action est irréversible."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente seu perfil, seu progresso e seus cursos personalizados. Não é possível desfazer."
          }
        }
      }
    },
    "This signs you out on this Apple TV.": {
      "comment": "Explains that Apple TV uses a local session",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wirst du auf diesem Apple TV abgemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto cerrará tu sesión en este Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu seras déconnecté de cette Apple TV."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso encerra sua sessão nesta Apple TV."
          }
        }
      }
    },
