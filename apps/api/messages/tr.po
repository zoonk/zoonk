#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "Aşağıda {chapter} ile ilgili kısa bir test var: geçersen zaten bildiğin dersler atlanır."

#: src/lib/tutor-confirmation.ts
msgctxt "OPj8y4"
msgid "Below you can choose where to focus, or take a short test that chooses for you."
msgstr "Aşağıda neye odaklanacağını seçebilir ya da bunu senin için belirleyen kısa bir test çözebilirsin."

#: src/lib/tutor-confirmation.ts
msgctxt "ejo0Qg"
msgid "Below you can start a short practice call whenever you're ready."
msgstr "Hazır olduğunda aşağıdan pratik yapmak için kısa bir sohbet başlatabilirsin."

#: src/lib/tutor-confirmation.ts
msgctxt "c7OWI5"
msgid "Below you can see when your plan practices {subject}."
msgstr "Aşağıda {subject} alıştırmalarının planında ne zaman yer aldığını görebilirsin."

#: src/lib/tutor-confirmation.ts
msgctxt "zPC6bz"
msgid "Below is your week in review."
msgstr "Haftanın özeti aşağıda."

#: src/lib/tutor-confirmation.ts
msgctxt "CinPvg"
msgid "Below you can see and change what I remember about you."
msgstr "Aşağıda seninle ilgili hatırladıklarımı görebilir ve değiştirebilirsin."

#: src/lib/tutor-confirmation.ts
msgctxt "u6lEYv"
msgid "Below is your mistakes notebook, with practice for each one."
msgstr "Aşağıda yanlış defterini ve her yanlışın için alıştırmaları bulabilirsin."

#: src/lib/tutor-confirmation.ts
msgctxt "qmjNYT"
msgid "Below you can choose a mock exam to take now."
msgstr "Aşağıdan bir deneme sınavı seçip hemen başlayabilirsin."

#: src/lib/tutor-confirmation.ts
msgctxt "aK1CcD"
msgid "Below is the Plus page."
msgstr "Plus sayfası aşağıda."

#: src/lib/tutor-confirmation.ts
msgctxt "KAqcUe"
msgid "Below you can say again the words that were hard to pronounce."
msgstr "Aşağıda telaffuz etmekte zorlandığın kelimeleri tekrar söyleyebilirsin."

#: src/lib/tutor-confirmation.ts
msgctxt "BXdAAo"
msgid "I've put the change to your plan below. Nothing changes until you apply it."
msgstr "Planın için önerdiğim değişikliği aşağıya ekledim. Sen uygulayana kadar hiçbir şey değişmez."

#: src/lib/tutor-confirmation.ts
msgctxt "cVQNWB"
msgid "Below you can start it as a new goal."
msgstr "Bunu aşağıdan yeni bir hedef olarak başlatabilirsin."

#: src/lib/tutor-confirmation.ts
msgctxt "40I13C"
msgid "Below are your statistics."
msgstr "İstatistiklerin aşağıda."
