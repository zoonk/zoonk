msgstr "E-posta adresini değiştir"

#: src/app/auth/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "E-postanı kontrol et"

#: src/app/auth/otp/page.tsx
msgctxt "AmelVC"
msgid "Enter the code we sent to {email}."
msgstr "{email} adresine gönderdiğimiz kodu gir."

#: src/app/auth/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Profilini oluştur"

#: src/app/auth/setup/page.tsx
msgctxt "SmuYUd"
msgid "What should we call you?"
msgstr "Sana nasıl hitap edelim?"

#. “it” is the name and username the learner picks on this screen.
#: src/app/auth/setup/page.tsx
msgctxt "y9wzAs"
msgid "You can change it later in your profile."
msgstr "Adını ve kullanıcı adını daha sonra profilinden değiştirebilirsin."

#: src/app/auth/setup/setup-form.tsx
msgctxt "1SvspN"
msgid "Checking..."
msgstr "Kontrol ediyoruz…"

#: src/app/auth/setup/setup-form.tsx
msgctxt "9N4_rz"
msgid "{username} is available"
msgstr "{username} kullanılabilir"

#: src/app/auth/setup/setup-form.tsx
msgctxt "R76cpj"
msgid "{username} is already taken"
msgstr "{username} zaten kullanılıyor"

#: src/app/auth/setup/setup-form.tsx
msgctxt "vLl7z0"
msgid "3-30 characters. Letters, numbers, and underscores only."
msgstr "3-30 karakter. Yalnızca harf, rakam ve alt çizgi kullan."

#: src/app/auth/setup/setup-form.tsx
msgctxt "9j8lDu"
msgid "Your username: @{username}"
msgstr "Kullanıcı adın: @{username}"

#: src/app/auth/setup/setup-form.tsx
msgctxt "UJWPJj"
