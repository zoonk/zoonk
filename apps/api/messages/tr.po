#: src/app/auth/layout.tsx
msgctxt "dVItHD"
msgid "Sign in to Zoonk"
msgstr "Zoonk’a giriş yap"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
msgctxt "vO6NBp"
msgid "Temporary email addresses aren't supported. Use another email or a privacy alias."
msgstr "Geçici e-posta adresleri desteklenmiyor. Başka bir e-posta adresi veya asıl adresini gizleyen bir takma adres kullan."

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/login/social-login.tsx
msgctxt "pN2p0t"
msgid "There was an error signing you in. Please try again or contact hello@zoonk.com"
msgstr "Giriş yaparken bir hata oluştu. Lütfen tekrar dene veya hello@zoonk.com adresinden bize ulaş"

#: src/app/auth/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Geçerli bir e-posta adresi gir"

#: src/app/auth/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "E-posta"

#. An example address shown in the empty email field. Keep it as written, like the app's other example addresses.
#: src/app/auth/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "me@gmail.com"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
#: src/app/auth/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Devam et"

#: src/app/auth/login/page.tsx
msgctxt "eN8MTJ"
msgid "Sign in or create an account"
msgstr "Giriş yap veya hesap oluştur"

#: src/app/auth/login/page.tsx
msgctxt "o_pwJP"
msgid "That sign-in expired. Try again."
msgstr "Bu giriş işleminin süresi doldu. Tekrar dene."

#: src/app/auth/login/page.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "Veya"

#: src/app/auth/login/page.tsx
msgctxt "Ju9oB-"
msgid "By clicking on Continue, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "“Devam et” düğmesine tıklayarak <terms>Hizmet Koşullarımızı</terms> ve <privacy>Gizlilik Politikamızı</privacy> kabul edersin."

#: src/app/auth/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Google ile devam et"

#: src/app/auth/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Apple ile devam et"

#: src/app/auth/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Bir sorun oluştu. Birazdan tekrar dene."

#: src/app/auth/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Bu kodun süresi doldu. Yeni bir kod al."

#: src/app/auth/otp/otp-form.tsx
msgctxt "hUjCDW"
msgid "Too many tries. Wait a minute, then try again."
msgstr "Çok fazla deneme yapıldı. Bir dakika bekle, sonra tekrar dene."

#: src/app/auth/otp/otp-form.tsx
msgctxt "P-D93T"
msgid "Too many wrong tries with this code. Get a new one."
msgstr "Bu kodla çok fazla hatalı deneme yapıldı. Yeni bir kod al."

#: src/app/auth/otp/otp-form.tsx
msgctxt "AFMAKd"
msgid "That code isn't right. Check the email and try again."
msgstr "Bu kod doğru değil. E-postayı kontrol edip tekrar dene."

#: src/app/auth/otp/otp-form.tsx
msgctxt "U2LhAf"
msgid "We sent a new code to {email}."
msgstr "{email} adresine yeni bir kod gönderdik."

#: src/app/auth/otp/otp-form.tsx
msgctxt "E05GNf"
msgid "Wait a minute before asking for another code."
msgstr "Yeni bir kod istemeden önce bir dakika bekle."

#: src/app/auth/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "Yeni bir kod gönderemedik. Tekrar dene."

#: src/app/auth/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "E-postadaki kod"

#: src/app/auth/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Yeni bir kod gönder"

#: src/app/auth/otp/otp-form.tsx
msgctxt "X1bhjS"
msgid "Didn't get it?"
msgstr "Kod gelmedi mi?"

#: src/app/auth/otp/otp-form.tsx
msgctxt "qs4xBq"
msgid "Send again"
msgstr "Tekrar gönder"

#: src/app/auth/otp/otp-form.tsx
msgctxt "ChATeO"
