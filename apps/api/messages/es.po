#: src/app/auth/guardian/end-link-button.tsx
msgctxt "eq8fyl"
msgid "End link"
msgstr "Desvincular"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "yXrPHy"
msgid "Stop being {name}'s guardian?"
msgstr "¿Dejar de ser tutor de {name}?"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "jdTv0j"
msgid "You'll stop seeing their week, and your daily limit, memory choice and Plus approval end. They can invite you again later."
msgstr "Dejarás de ver su actividad semanal. También dejarán de aplicarse el límite diario, la opción de memoria y la aprobación de Plus. Podrá volver a invitarte más adelante."

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "47FYwb"
msgid "Cancel"
msgstr "Cancelar"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "OZbt2X"
msgid "We couldn't end the link. Try again."
msgstr "No se ha podido desvincular. Inténtalo de nuevo."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "JzvSPP"
msgid "Daily time limit"
msgstr "Límite de tiempo diario"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "PfW4AI"
msgid "No limit"
msgstr "Sin límite"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "AVWDvG"
msgid "{minutes} min a day"
msgstr "{minutes} min al día"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "jvo0vs"
msgid "Save"
msgstr "Guardar"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "OxnxZb"
msgid "Daily limit saved"
msgstr "Límite diario guardado"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "fynQpZ"
msgid "We couldn't save the limit. Try again."
msgstr "No se ha podido guardar el límite. Inténtalo de nuevo."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "NG9KbJ"
msgid "Off. {name} can't turn it on."
msgstr "Desactivada. {name} no puede activarla."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "qRTS8x"
msgid "On. Zoonk remembers {name}'s goals and how they learn, to fit examples to them."
msgstr "Activada. Zoonk recuerda los objetivos de {name} y cómo aprende para adaptar los ejemplos."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "s4EmrE"
msgid "Off. It stays off unless {name} turns it on."
msgstr "Desactivada. Seguirá así a menos que {name} la active."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "aLIOCf"
msgid "Let {name} use memory"
msgstr "Permitir que {name} use la memoria"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "8ArJq7"
msgid "We couldn't save that. Try again."
msgstr "No se ha podido guardar. Inténtalo de nuevo."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "3-s4XD"
msgid "You approved Plus on {date}."
msgstr "Aprobaste Plus el {date}."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "U9BvCE"
msgid "{name} needs your approval to subscribe to Plus."
msgstr "{name} necesita tu aprobación para suscribirse a Plus."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "330Hte"
msgid "Approve Plus"
msgstr "Aprobar Plus"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "Mfp11j"
msgid "We couldn't save your approval. Try again."
msgstr "No se ha podido guardar tu aprobación. Inténtalo de nuevo."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "gpodmF"
msgid "Minutes each day"
msgstr "Minutos cada día"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "1zggxX"
msgid "{day}: {minutes, plural, =0 {# minutes} one {# minute} other {# minutes}}, {lessons, plural, =0 {# lessons} one {# lesson} other {# lessons}}"
msgstr "{day}: {minutes, plural, =0 {# minutos} one {# minuto} other {# minutos}}, {lessons, plural, =0 {# lecciones} one {# lección} other {# lecciones}}"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "D16ndi"
msgid "Last 7 days: {minutes, plural, =0 {# minutes} one {# minute} other {# minutes}} and {lessons, plural, =0 {# lessons} one {# lesson} other {# lessons}}"
msgstr "Últimos 7 días: {minutes, plural, =0 {# minutos} one {# minuto} other {# minutos}} y {lessons, plural, =0 {# lecciones} one {# lección} other {# lecciones}}"

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "arjdPf"
msgid "Confirm your email address first, then open the invite again."
msgstr "Confirma primero tu correo electrónico y vuelve a abrir la invitación."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "6ychX4"
msgid "This invite was sent to another email. Sign in with that email to accept it."
msgstr "Esta invitación se envió a otra dirección de correo. Inicia sesión con esa dirección para aceptarla."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "VWppro"
msgid "This invite expired. Ask for a new one."
msgstr "La invitación ha caducado. Pide una nueva."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "NKNtUt"
msgid "Sign in with the email this invite was sent to."
msgstr "Inicia sesión con la dirección de correo a la que se envió la invitación."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "S3n5VD"
msgid "We couldn't find this invite. It may have been canceled."
msgstr "No se ha podido encontrar esta invitación. Puede que se haya cancelado."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "8YMK0-"
msgid "Accept invite"
msgstr "Aceptar invitación"

#: src/app/auth/guardian/page.tsx
msgctxt "poUf8i"
msgid "Guardian"
msgstr "Tutor"

#: src/app/auth/guardian/page.tsx
msgctxt "je39I0"
msgid "Sign in with the email this invite was sent to. It's free."
msgstr "Inicia sesión con la dirección de correo a la que se envió la invitación. Es gratis."

#: src/app/auth/guardian/page.tsx
msgctxt "ZJzI65"
msgid "Sign in to see the learners who invited you."
msgstr "Inicia sesión para ver quién te ha invitado."

#: src/app/auth/guardian/page.tsx
msgctxt "szo7Rq"
msgid "Sign in to continue"
msgstr "Inicia sesión para continuar"

#: src/app/auth/guardian/page.tsx
msgctxt "lSvmLC"
msgid "Accept the invite"
msgstr "Aceptar la invitación"

#: src/app/auth/guardian/page.tsx
msgctxt "gtva5X"
msgid "As their guardian, you'll see their weekly activity and can set a daily time limit, turn memory off and approve Plus. You won't see their answers or messages."
msgstr "Como su responsable legal, podrás ver su actividad semanal, establecer un límite diario de tiempo, desactivar la memoria y aprobar Plus. No verás sus respuestas ni sus mensajes."

#: src/app/auth/guardian/page.tsx
msgctxt "JPtSV8"
msgid "Your learners"
msgstr "Tus estudiantes"

#: src/app/auth/guardian/page.tsx
msgctxt "xltR8k"
msgid "Invite accepted. Here's their week and the controls you can set."
msgstr "Invitación aceptada. Aquí tienes su actividad de esta semana y los controles que puedes configurar."

#: src/app/auth/guardian/page.tsx
msgctxt "UmTQLH"
msgid "Their last seven days and the controls you can set."
msgstr "Su actividad de los últimos siete días y los controles que puedes configurar."

#: src/app/auth/guardian/page.tsx
msgctxt "n19CR6"
msgid "No learner has invited you yet. Invites arrive by email."
msgstr "Todavía no te ha invitado ningún estudiante. Las invitaciones llegan por correo electrónico."

#: src/app/auth/layout.tsx
msgctxt "dVItHD"
msgid "Sign in to Zoonk"
msgstr "Inicia sesión en Zoonk"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
msgctxt "vO6NBp"
msgid "Temporary email addresses aren't supported. Use another email or a privacy alias."
msgstr "No se admiten direcciones de correo temporales. Usa otro correo o un alias privado."

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/login/social-login.tsx
msgctxt "pN2p0t"
msgid "There was an error signing you in. Please try again or contact hello@zoonk.com"
msgstr "Hubo un error al iniciar sesión. Inténtalo de nuevo o escribe a contacto@zoonk.com"

#: src/app/auth/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Ingresa un correo electrónico válido"

#: src/app/auth/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "Correo electrónico"

#: src/app/auth/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "yo@gmail.com"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
#: src/app/auth/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Continuar"

#: src/app/auth/login/page.tsx
msgctxt "eN8MTJ"
msgid "Sign in or create an account"
msgstr "Inicia sesión o crea una cuenta"

#: src/app/auth/login/page.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "O"

#: src/app/auth/login/page.tsx
msgctxt "Ju9oB-"
msgid "By clicking on Continue, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "Al hacer clic en Continuar, aceptas nuestros <terms>Términos del Servicio</terms> y nuestra <privacy>Política de Privacidad</privacy>."

#: src/app/auth/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Continuar con Google"

#: src/app/auth/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Continuar con Apple"

#: src/app/auth/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Algo ha salido mal. Vuelve a intentarlo dentro de un momento."

#: src/app/auth/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Este código ha caducado. Solicita uno nuevo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "hUjCDW"
msgid "Too many tries. Wait a minute, then try again."
msgstr "Lo has intentado demasiadas veces. Espera un minuto y vuelve a intentarlo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "P-D93T"
msgid "Too many wrong tries with this code. Get a new one."
msgstr "Has introducido mal este código demasiadas veces. Solicita uno nuevo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "AFMAKd"
msgid "That code isn't right. Check the email and try again."
msgstr "El código no es correcto. Comprueba el correo y vuelve a intentarlo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "U2LhAf"
msgid "We sent a new code to {email}."
msgstr "Te hemos enviado un código nuevo a {email}."

#: src/app/auth/otp/otp-form.tsx
msgctxt "E05GNf"
msgid "Wait a minute before asking for another code."
msgstr "Espera un minuto antes de solicitar otro código."

#: src/app/auth/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "No hemos podido enviar un código nuevo. Vuelve a intentarlo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "Código del correo electrónico"

#: src/app/auth/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Enviar un código nuevo"

#: src/app/auth/otp/otp-form.tsx
msgctxt "3WXGFW"
msgid "Didn't get it? Send a new code"
msgstr "¿No te ha llegado? Envía un código nuevo"

#: src/app/auth/otp/otp-form.tsx
msgctxt "ChATeO"
msgid "Change email"
msgstr "Cambiar correo"

#: src/app/auth/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "Revisa tu correo"

#: src/app/auth/otp/page.tsx
msgctxt "AmelVC"
msgid "Enter the code we sent to {email}."
msgstr "Introduce el código que te hemos enviado a {email}."

#: src/app/auth/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Crea tu perfil"

#: src/app/auth/setup/page.tsx
msgctxt "jN5Gqb"
msgid "Your name and a username. You can change both later in your profile."
msgstr "Tu nombre y un nombre de usuario. Más adelante podrás cambiar ambos en tu perfil."

#: src/app/auth/setup/setup-form.tsx
msgctxt "1SvspN"
msgid "Checking..."
msgstr "Comprobando…"

#: src/app/auth/setup/setup-form.tsx
msgctxt "9N4_rz"
msgid "{username} is available"
msgstr "El nombre de usuario {username} está disponible"

#: src/app/auth/setup/setup-form.tsx
msgctxt "R76cpj"
msgid "{username} is already taken"
msgstr "El nombre de usuario {username} ya está en uso"

#: src/app/auth/setup/setup-form.tsx
msgctxt "vLl7z0"
msgid "3-30 characters. Letters, numbers, and underscores only."
msgstr "De 3 a 30 caracteres. Solo letras, números y guiones bajos."

#: src/app/auth/setup/setup-form.tsx
msgctxt "HAlOn1"
msgid "Name"
msgstr "Nombre"

#: src/app/auth/setup/setup-form.tsx
msgctxt "JCIgkj"
msgid "Username"
msgstr "Nombre de usuario"

#: src/app/auth/setup/setup-form.tsx
msgctxt "bz5AYp"
msgid "We couldn't save your profile. Try again."
msgstr "No hemos podido guardar tu perfil. Inténtalo de nuevo."

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "1vqX2W"
msgid "Unable to redirect"
msgstr "No se puede redirigir"

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "83K2kN"
msgid "The destination URL is not recognized as a trusted Zoonk application."
msgstr "La URL de destino no se reconoce como una aplicación de Zoonk confiable."

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "-e4BVR"
msgid "Continue to Zoonk"
msgstr "Continuar a Zoonk"

#: src/components/auth-frame.tsx
msgctxt "m-X1D0"
msgid "Back to Zoonk"
msgstr "Volver a Zoonk"

#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "A continuación tienes una breve prueba sobre {chapter}: si la superas, te saltarás las lecciones que ya conoces."

#: src/lib/tutor-confirmation.ts
msgctxt "OPj8y4"
msgid "Below you can choose where to focus, or take a short test that chooses for you."
msgstr "A continuación puedes elegir en qué centrarte o hacer una breve prueba para que lo elija por ti."

#: src/lib/tutor-confirmation.ts
msgctxt "ejo0Qg"
msgid "Below you can start a short practice call whenever you're ready."
msgstr "A continuación puedes iniciar una breve llamada de práctica cuando quieras."

#: src/lib/tutor-confirmation.ts
msgctxt "c7OWI5"
msgid "Below you can see when your plan practices {subject}."
msgstr "Aquí puedes ver cuándo tu plan incluye práctica de {subject}."

#: src/lib/tutor-confirmation.ts
msgctxt "zPC6bz"
msgid "Below is your week in review."
msgstr "Aquí tienes el resumen de tu semana."

#: src/lib/tutor-confirmation.ts
msgctxt "CinPvg"
msgid "Below you can see and change what I remember about you."
msgstr "Aquí puedes ver y cambiar lo que recuerdo de ti."

#: src/lib/tutor-confirmation.ts
msgctxt "u6lEYv"
msgid "Below is your mistakes notebook, with practice for each one."
msgstr "Aquí tienes tu cuaderno de errores, con ejercicios para practicar cada uno."

#: src/lib/tutor-confirmation.ts
msgctxt "qmjNYT"
msgid "Below you can choose a mock exam to take now."
msgstr "A continuación, puedes elegir un simulacro para hacer ahora."

#: src/lib/tutor-confirmation.ts
msgctxt "aK1CcD"
msgid "Below is the Plus page."
msgstr "Aquí tienes la página de Plus."

#: src/lib/tutor-confirmation.ts
msgctxt "KAqcUe"
msgid "Below you can say again the words that were hard to pronounce."
msgstr "Aquí puedes volver a decir las palabras que te costó pronunciar."

#: src/lib/tutor-confirmation.ts
msgctxt "BXdAAo"
msgid "I've put the change to your plan below. Nothing changes until you apply it."
msgstr "He añadido abajo el cambio a tu plan. No cambiará nada hasta que lo apliques."

#: src/lib/tutor-confirmation.ts
msgctxt "cVQNWB"
msgid "Below you can start it as a new goal."
msgstr "Aquí puedes empezar un nuevo objetivo a partir de esto."

#: src/lib/tutor-confirmation.ts
msgctxt "40I13C"
msgid "Below are your statistics."
msgstr "Aquí tienes tus estadísticas."
