#: src/app/auth/layout.tsx
msgctxt "dVItHD"
msgid "Sign in to Zoonk"
msgstr "Inicia sesión en Zoonk"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
msgctxt "vO6NBp"
msgid "Temporary email addresses aren't supported. Use another email or a privacy alias."
msgstr "No se admiten direcciones de correo temporales. Usa otra dirección o un alias de privacidad."

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/login/social-login.tsx
msgctxt "pN2p0t"
msgid "There was an error signing you in. Please try again or contact hello@zoonk.com"
msgstr "No hemos podido iniciar sesión. Inténtalo de nuevo o contacta con contacto@zoonk.com"

#: src/app/auth/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Introduce una dirección de correo válida"

#: src/app/auth/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "Correo electrónico"

#: src/app/auth/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "me@gmail.com"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
#: src/app/auth/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Continuar"

#: src/app/auth/login/page.tsx
msgctxt "eN8MTJ"
msgid "Sign in or create an account"
msgstr "Inicia sesión o crea una cuenta"

#: src/app/auth/login/page.tsx
msgctxt "o_pwJP"
msgid "That sign-in expired. Try again."
msgstr "El inicio de sesión ha caducado. Inténtalo de nuevo."

#: src/app/auth/login/page.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "O"

#: src/app/auth/login/page.tsx
msgctxt "Ju9oB-"
msgid "By clicking on Continue, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "Al hacer clic en Continuar, aceptas nuestras <terms>Condiciones de servicio</terms> y nuestra <privacy>Política de privacidad</privacy>."

#: src/app/auth/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Continuar con Google"

#: src/app/auth/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Continuar con Apple"

#: src/app/auth/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Algo ha salido mal. Inténtalo de nuevo en un momento."

#: src/app/auth/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Este código ha caducado. Solicita uno nuevo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "hUjCDW"
msgid "Too many tries. Wait a minute, then try again."
msgstr "Demasiados intentos. Espera un minuto y vuelve a intentarlo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "P-D93T"
msgid "Too many wrong tries with this code. Get a new one."
msgstr "Demasiados intentos fallidos con este código. Solicita uno nuevo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "AFMAKd"
msgid "That code isn't right. Check the email and try again."
msgstr "Ese código no es correcto. Comprueba el correo y vuelve a intentarlo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "U2LhAf"
msgid "We sent a new code to {email}."
msgstr "Hemos enviado un código nuevo a {email}."

#: src/app/auth/otp/otp-form.tsx
msgctxt "E05GNf"
msgid "Wait a minute before asking for another code."
msgstr "Espera un minuto antes de solicitar otro código."

#: src/app/auth/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "No hemos podido enviar un código nuevo. Inténtalo de nuevo."

#: src/app/auth/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "Código del correo"

#: src/app/auth/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Enviar un código nuevo"

#: src/app/auth/otp/otp-form.tsx
msgctxt "X1bhjS"
msgid "Didn't get it?"
msgstr "¿No lo has recibido?"

#: src/app/auth/otp/otp-form.tsx
msgctxt "qs4xBq"
msgid "Send again"
msgstr "Enviar de nuevo"

#: src/app/auth/otp/otp-form.tsx
msgctxt "ChATeO"
msgid "Change email"
msgstr "Cambiar correo"

#: src/app/auth/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "Revisa tu correo"

#: src/app/auth/otp/page.tsx
msgctxt "AmelVC"
msgid "Enter the code we sent to {email}."
msgstr "Introduce el código que hemos enviado a {email}."

#: src/app/auth/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Crea tu perfil"

#: src/app/auth/setup/page.tsx
msgctxt "SmuYUd"
msgid "What should we call you?"
msgstr "¿Cómo quieres que te llamemos?"

#: src/app/auth/setup/page.tsx
msgctxt "y9wzAs"
msgid "You can change it later in your profile."
msgstr "Puedes cambiarlo más adelante en tu perfil."

#: src/app/auth/setup/setup-form.tsx
msgctxt "1SvspN"
msgid "Checking..."
msgstr "Comprobando…"

#: src/app/auth/setup/setup-form.tsx
msgctxt "9N4_rz"
msgid "{username} is available"
msgstr "{username} está disponible"

#: src/app/auth/setup/setup-form.tsx
msgctxt "R76cpj"
msgid "{username} is already taken"
msgstr "{username} ya está en uso"

#: src/app/auth/setup/setup-form.tsx
msgctxt "vLl7z0"
msgid "3-30 characters. Letters, numbers, and underscores only."
msgstr "De 3 a 30 caracteres. Solo letras, números y guiones bajos."

#: src/app/auth/setup/setup-form.tsx
msgctxt "9j8lDu"
msgid "Your username: @{username}"
msgstr "Tu nombre de usuario: @{username}"

#: src/app/auth/setup/setup-form.tsx
msgctxt "UJWPJj"
msgid "Change username"
msgstr "Cambiar nombre de usuario"

#: src/app/auth/setup/setup-form.tsx
msgctxt "BY343C"
msgid "Change"
msgstr "Cambiar"

#: src/app/auth/setup/setup-form.tsx
msgctxt "HAlOn1"
msgid "Name"
msgstr "Nombre"

#: src/app/auth/setup/setup-form.tsx
msgctxt "JCIgkj"
msgid "Username"
msgstr "Nombre de usuario"

#: src/app/auth/setup/setup-form.tsx
msgctxt "bz5AYp"
msgid "We couldn't save your profile. Try again."
msgstr "No hemos podido guardar tu perfil. Inténtalo de nuevo."

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "1vqX2W"
msgid "Unable to redirect"
msgstr "No se ha podido redirigir"

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "83K2kN"
msgid "The destination URL is not recognized as a trusted Zoonk application."
msgstr "La URL de destino no se reconoce como una aplicación de Zoonk de confianza."

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "-e4BVR"
msgid "Continue to Zoonk"
msgstr "Continuar a Zoonk"

#: src/components/auth-frame.tsx
msgctxt "m-X1D0"
msgid "Back to Zoonk"
msgstr "Volver a Zoonk"

#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "A continuación tienes una breve prueba sobre {chapter}: si la superas, no tendrás que hacer las lecciones que ya conoces."

#: src/lib/tutor-confirmation.ts
msgctxt "OPj8y4"
msgid "Below you can choose where to focus, or take a short test that chooses for you."
msgstr "A continuación puedes elegir en qué centrarte o hacer una breve prueba que lo elija por ti."

#: src/lib/tutor-confirmation.ts
msgctxt "ejo0Qg"
msgid "Below you can start a short practice call whenever you're ready."
msgstr "A continuación puedes empezar una breve llamada de práctica cuando quieras."

#: src/lib/tutor-confirmation.ts
msgctxt "c7OWI5"
msgid "Below you can see when your plan practices {subject}."
msgstr "A continuación puedes ver cuándo practicarás {subject} en tu plan."

#: src/lib/tutor-confirmation.ts
msgctxt "zPC6bz"
msgid "Below is your week in review."
msgstr "A continuación tienes el resumen de tu semana."

#: src/lib/tutor-confirmation.ts
msgctxt "CinPvg"
msgid "Below you can see and change what I remember about you."
msgstr "A continuación puedes ver y cambiar lo que recuerdo sobre ti."

#: src/lib/tutor-confirmation.ts
msgctxt "u6lEYv"
msgid "Below is your mistakes notebook, with practice for each one."
msgstr "A continuación tienes tu Cuaderno de errores, con ejercicios para practicar cada uno."

#: src/lib/tutor-confirmation.ts
msgctxt "qmjNYT"
msgid "Below you can choose a mock exam to take now."
msgstr "A continuación puedes elegir un simulacro para hacer ahora."

#: src/lib/tutor-confirmation.ts
msgctxt "aK1CcD"
msgid "Below is the Plus page."
msgstr "A continuación tienes la página de Plus."

#: src/lib/tutor-confirmation.ts
msgctxt "KAqcUe"
msgid "Below you can say again the words that were hard to pronounce."
msgstr "A continuación puedes volver a decir las palabras que te costó pronunciar."

#: src/lib/tutor-confirmation.ts
msgctxt "BXdAAo"
msgid "I've put the change to your plan below. Nothing changes until you apply it."
msgstr "He puesto la propuesta de cambio de tu plan a continuación. Nada cambiará hasta que la apliques."

#: src/lib/tutor-confirmation.ts
msgctxt "cVQNWB"
msgid "Below you can start it as a new goal."
msgstr "A continuación puedes empezar un nuevo objetivo con esto."

#: src/lib/tutor-confirmation.ts
msgctxt "40I13C"
msgid "Below are your statistics."
msgstr "A continuación tienes tus estadísticas."
