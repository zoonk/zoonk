#: src/lib/reminders/reminder-copy.ts
msgctxt "Kc3Giq"
msgid "Today's exam prep: {minutes, plural, one {# minute} other {# minutes}}."
msgstr "Preparación de hoy para el examen: {minutes, plural, one {# minuto} other {# minutos}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "QGJAH7"
msgid "{minutes, plural, one {# minute} other {# minutes}} today moves your exam prep forward."
msgstr "Con {minutes, plural, one {# minuto} other {# minutos}} hoy, avanzas en tu preparación para el examen."

#: src/lib/reminders/reminder-copy.ts
msgctxt "dN9j0T"
msgid "{minutes, plural, one {# minute} other {# minutes}} on your plan today."
msgstr "{minutes, plural, one {# minuto} other {# minutos}} en tu plan de hoy."

