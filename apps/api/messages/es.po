msgid "{left, plural, one {# more minute} other {# more minutes}} finishes today's plan."
msgstr "Con {left, plural, one {# minuto más} other {# minutos más}} completas tu plan de hoy."

#: src/lib/reminders/reminder-copy.ts
msgctxt "doiP8l"
msgid "{minutes, plural, one {# minute} other {# minutes}} today, then {others, plural, one {# more goal} other {# more goals}}."
msgstr "{minutes, plural, one {# minuto} other {# minutos}} hoy y después {others, plural, one {# objetivo más} other {# objetivos más}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "dBVV88"
msgid "Start with {minutes, plural, one {# minute} other {# minutes}}. {others, plural, one {# other goal is} other {# other goals are}} on today's plan too."
msgstr "Empieza con {minutes, plural, one {# minuto} other {# minutos}}. El plan de hoy también incluye {others, plural, one {# objetivo más} other {# objetivos más}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "EUWgvZ"
msgid "{minutes, plural, one {# minute} other {# minutes}} for this one, and {others, plural, one {# more goal} other {# more goals}} after it."
msgstr "{minutes, plural, one {# minuto} other {# minutos}} para este objetivo y después {others, plural, one {# objetivo más} other {# objetivos más}}."

#: src/lib/reminders/reminder-copy.ts
