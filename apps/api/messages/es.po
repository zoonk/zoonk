#: src/app/auth/guardian/end-link-button.tsx
msgctxt "eq8fyl"
msgid "End link"
msgstr "Desvincular"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "yXrPHy"
msgid "Stop being {name}'s guardian?"
msgstr "¿Dejar de ser tutor de {name}?"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "350UFs"
msgid "You'll stop seeing their week, and your daily limit and Plus approval end. They can invite you again later."
msgstr "Dejarás de ver su semana y se desactivarán tu límite diario y la aprobación de Plus. Te podrá invitar de nuevo más adelante."

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "47FYwb"
msgid "Cancel"
msgstr "Cancelar"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "OZbt2X"
msgid "We couldn't end the link. Try again."
msgstr "No se ha podido desvincular. Inténtalo de nuevo."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "JzvSPP"
msgid "Daily time limit"
msgstr "Límite de tiempo diario"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "PfW4AI"
msgid "No limit"
msgstr "Sin límite"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "AVWDvG"
msgid "{minutes} min a day"
msgstr "{minutes} min al día"

#: src/app/auth/guardian/guarded-learner-card.tsx
