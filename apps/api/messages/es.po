msgstr "Cuando quieras: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "I0h01A"
msgid "Still on today: {goal}"
msgstr "Aún en tu plan de hoy: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "FdTl5c"
msgid "Your study time: {goal}"
msgstr "Tu tiempo de estudio: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "CdHWeN"
msgid "On your plan today: {goal}"
msgstr "En tu plan de hoy: {goal}"

#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "Abajo tienes una prueba breve sobre {chapter}: si la apruebas, te saltas las lecciones que ya conoces."

#: src/lib/tutor-confirmation.ts
msgctxt "OPj8y4"
msgid "Below you can choose where to focus, or take a short test that chooses for you."
msgstr "Abajo puedes elegir en qué enfocarte o hacer una prueba breve que elija por ti."

#: src/lib/tutor-confirmation.ts
msgctxt "ejo0Qg"
msgid "Below you can start a short practice call whenever you're ready."
msgstr "Abajo puedes iniciar una llamada breve de práctica cuando quieras."

#: src/lib/tutor-confirmation.ts
msgctxt "c7OWI5"
msgid "Below you can see when your plan practices {subject}."
msgstr "Abajo puedes ver cuándo practicarás {subject} según tu plan."

#: src/lib/tutor-confirmation.ts
msgctxt "zPC6bz"
msgid "Below is your week in review."
msgstr "Abajo tienes el resumen de tu semana."

#: src/lib/tutor-confirmation.ts
msgctxt "CinPvg"
msgid "Below you can see and change what I remember about you."
msgstr "Abajo puedes ver y cambiar lo que recuerdo de ti."

#: src/lib/tutor-confirmation.ts
msgctxt "u6lEYv"
msgid "Below is your mistakes notebook, with practice for each one."
msgstr "Abajo tienes tu cuaderno de errores, con ejercicios para cada uno."

#: src/lib/tutor-confirmation.ts
msgctxt "qmjNYT"
msgid "Below you can choose a mock exam to take now."
msgstr "Abajo puedes elegir un simulacro para hacer ahora."

#: src/lib/tutor-confirmation.ts
msgctxt "aK1CcD"
msgid "Below is the Plus page."
msgstr "Abajo tienes la página de Plus."

#: src/lib/tutor-confirmation.ts
msgctxt "KAqcUe"
msgid "Below you can say again the words that were hard to pronounce."
msgstr "Abajo puedes volver a decir las palabras que te costó pronunciar."

#: src/lib/tutor-confirmation.ts
msgctxt "BXdAAo"
msgid "I've put the change to your plan below. Nothing changes until you apply it."
msgstr "Te dejé abajo el cambio propuesto para tu plan. Nada cambia hasta que lo apliques."

#: src/lib/tutor-confirmation.ts
msgctxt "cVQNWB"
msgid "Below you can start it as a new goal."
msgstr "Más abajo puedes crear un nuevo objetivo con esto."

#: src/lib/tutor-confirmation.ts
msgctxt "40I13C"
msgid "Below are your statistics."
msgstr "Abajo tienes tus estadísticas."
