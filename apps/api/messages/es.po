msgid "We couldn't save the limit. Try again."
msgstr "No se ha podido guardar el límite. Inténtalo de nuevo."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "3-s4XD"
msgid "You approved Plus on {date}."
msgstr "Aprobaste Plus el {date}."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "U9BvCE"
msgid "{name} needs your approval to subscribe to Plus."
msgstr "{name} necesita tu aprobación para suscribirse a Plus."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "330Hte"
msgid "Approve Plus"
msgstr "Aprobar Plus"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "Mfp11j"
msgid "We couldn't save your approval. Try again."
msgstr "No se ha podido guardar tu aprobación. Inténtalo de nuevo."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "gpodmF"
msgid "Minutes each day"
msgstr "Minutos cada día"

