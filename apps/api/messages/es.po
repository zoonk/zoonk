msgstr "Lo que sigue: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "A3jTYj"
msgid "Today's study: {goal}"
msgstr "Estudio de hoy: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "s-800F"
