#: src/app/auth/[locale]/layout.tsx
msgctxt "dVItHD"
msgid "Sign in to Zoonk"
msgstr "Iniciar sesión en Zoonk"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "vO6NBp"
msgid "Temporary email addresses aren't supported. Use another email or a privacy alias."
msgstr "No se aceptan direcciones de correo temporales. Usa otro correo o un alias para proteger tu privacidad."

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "pN2p0t"
msgid "There was an error signing you in. Please try again or contact hello@zoonk.com"
msgstr "Hubo un error al iniciar sesión. Inténtalo de nuevo o escríbenos a contacto@zoonk.com"

#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Ingresa una dirección de correo válida"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "hUjCDW"
msgid "Too many tries. Wait a minute, then try again."
msgstr "Demasiados intentos. Espera un minuto y vuelve a intentarlo."

#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "Correo electrónico"

#. An example address shown in the empty email field. Keep it as written, like the app's other example addresses.
#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "me@gmail.com"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Continuar"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "eN8MTJ"
msgid "Sign in or create an account"
msgstr "Inicia sesión o crea una cuenta"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "o_pwJP"
msgid "That sign-in expired. Try again."
msgstr "Se agotó el tiempo para iniciar sesión. Inténtalo de nuevo."

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "O"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "Ju9oB-"
msgid "By clicking on Continue, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "Al hacer clic en Continuar, aceptas nuestros <terms>Términos de servicio</terms> y nuestra <privacy>Política de privacidad</privacy>."

#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Continuar con Google"

#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Continuar con Apple"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Algo salió mal. Inténtalo de nuevo en un momento."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Este código expiró. Pide uno nuevo."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "P-D93T"
msgid "Too many wrong tries with this code. Get a new one."
msgstr "Demasiados intentos incorrectos con este código. Pide uno nuevo."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "AFMAKd"
msgid "That code isn't right. Check the email and try again."
msgstr "Ese código no es correcto. Revisa el correo e inténtalo de nuevo."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "U2LhAf"
msgid "We sent a new code to {email}."
msgstr "Te enviamos un nuevo código a {email}."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "E05GNf"
msgid "Wait a minute before asking for another code."
msgstr "Espera un minuto antes de pedir otro código."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "No pudimos enviar un nuevo código. Inténtalo de nuevo."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "Código del correo"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Enviar un nuevo código"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "X1bhjS"
msgid "Didn't get it?"
msgstr "¿No lo recibiste?"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "qs4xBq"
msgid "Send again"
msgstr "Volver a enviar"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "ChATeO"
msgid "Change email"
msgstr "Cambiar correo electrónico"

#: src/app/auth/[locale]/otp/page.tsx
msgctxt "AmelVC"
msgid "Enter the code we sent to {email}."
msgstr "Ingresa el código que enviamos a {email}."

#: src/app/auth/[locale]/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "Revisa tu correo"

#: src/app/auth/[locale]/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Crea tu perfil"

#: src/app/auth/[locale]/setup/page.tsx
msgctxt "SmuYUd"
msgid "What should we call you?"
msgstr "¿Cómo quieres que te llamemos?"

#. “it” is the name and username the learner picks on this screen.
#: src/app/auth/[locale]/setup/page.tsx
msgctxt "y9wzAs"
msgid "You can change it later in your profile."
msgstr "Puedes cambiarlos después en tu perfil."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "1SvspN"
msgid "Checking..."
msgstr "Verificando…"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "9N4_rz"
msgid "{username} is available"
msgstr "{username} está disponible"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "R76cpj"
msgid "{username} is already taken"
msgstr "{username} ya está en uso"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "wubfpa"
msgid "3-30 characters. Letters a–z, numbers, and underscores only."
msgstr "De 3 a 30 caracteres. Solo letras a–z, números y guiones bajos."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "9j8lDu"
msgid "Your username: @{username}"
msgstr "Tu nombre de usuario: @{username}"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "UJWPJj"
msgid "Change username"
msgstr "Cambiar nombre de usuario"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "BY343C"
msgid "Change"
msgstr "Cambiar"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "HAlOn1"
msgid "Name"
msgstr "Nombre"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "D4cYHr"
msgid "Use 150 characters or fewer."
msgstr "Usa 150 caracteres o menos."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "JCIgkj"
msgid "Username"
msgstr "Nombre de usuario"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "bz5AYp"
msgid "We couldn't save your profile. Try again."
msgstr "No pudimos guardar tu perfil. Inténtalo de nuevo."

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "1vqX2W"
msgid "Unable to redirect"
msgstr "No pudimos redirigirte"

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "83K2kN"
msgid "The destination URL is not recognized as a trusted Zoonk application."
msgstr "No reconocemos la URL de destino como parte de una aplicación de confianza de Zoonk."

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "-e4BVR"
msgid "Continue to Zoonk"
msgstr "Ir a Zoonk"

#. The link shows only the word "Zoonk", so keep "Zoonk" as a separate word, with no ending or particle attached.
#: src/components/auth-frame.tsx
msgctxt "m-X1D0"
msgid "Back to Zoonk"
msgstr "Volver a Zoonk"

#: src/lib/reminders/reminder-copy.ts
msgctxt "yDrTAE"
msgid "{minutes, plural, one {# minute} other {# minutes}} of exam prep on your plan today."
