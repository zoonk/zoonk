msgid "Turn off email reminders"
msgstr "Desactivar los recordatorios por correo"

#: src/lib/reminders/reminder-copy.ts
msgctxt "TMLja4"
msgid "You get this because you turned on study reminders in Zoonk."
msgstr "Recibes este correo porque activaste los recordatorios de estudio en Zoonk."

#: src/lib/reminders/reminder-copy.ts
msgctxt "7gq6C7"
