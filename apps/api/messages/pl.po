#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "Poniżej znajdziesz krótki test z rozdziału: {chapter}. Jeśli go zdasz, pominiesz lekcje z materiałem, który już znasz."

