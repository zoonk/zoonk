#: src/app/auth/[locale]/layout.tsx
msgctxt "dVItHD"
msgid "Sign in to Zoonk"
msgstr "Zaloguj się do Zoonka"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "vO6NBp"
msgid "Temporary email addresses aren't supported. Use another email or a privacy alias."
msgstr "Nie obsługujemy tymczasowych adresów e-mail. Użyj innego adresu lub aliasu chroniącego prywatność."

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "pN2p0t"
msgid "There was an error signing you in. Please try again or contact hello@zoonk.com"
msgstr "Nie udało się zalogować. Spróbuj ponownie lub napisz na hello@zoonk.com"

#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Wpisz poprawny adres e-mail"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "hUjCDW"
msgid "Too many tries. Wait a minute, then try again."
msgstr "Zbyt wiele prób. Poczekaj minutę i spróbuj ponownie."

#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "E-mail"

#. An example address shown in the empty email field. Keep it as written, like the app's other example addresses.
#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "me@gmail.com"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Kontynuuj"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "eN8MTJ"
msgid "Sign in or create an account"
msgstr "Zaloguj się lub utwórz konto"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "o_pwJP"
msgid "That sign-in expired. Try again."
msgstr "Sesja logowania wygasła. Spróbuj ponownie."

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "Lub"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "Ju9oB-"
msgid "By clicking on Continue, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "Klikając „Kontynuuj”, akceptujesz nasz <terms>Regulamin</terms> i <privacy>Politykę prywatności</privacy>."

#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Kontynuuj z Google"

#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Kontynuuj z Apple"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Coś poszło nie tak. Spróbuj ponownie za chwilę."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Ten kod wygasł. Poproś o nowy."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "P-D93T"
msgid "Too many wrong tries with this code. Get a new one."
msgstr "Ten kod wpisano błędnie zbyt wiele razy. Poproś o nowy."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "AFMAKd"
msgid "That code isn't right. Check the email and try again."
msgstr "Kod się nie zgadza. Sprawdź wiadomość i spróbuj ponownie."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "U2LhAf"
msgid "We sent a new code to {email}."
msgstr "Wysłaliśmy nowy kod na adres {email}."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "E05GNf"
msgid "Wait a minute before asking for another code."
msgstr "Poczekaj minutę, zanim poprosisz o kolejny kod."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "Nie udało się wysłać nowego kodu. Spróbuj ponownie."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "Kod z wiadomości e-mail"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Wyślij nowy kod"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "X1bhjS"
msgid "Didn't get it?"
msgstr "Kod nie dotarł?"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "qs4xBq"
msgid "Send again"
msgstr "Wyślij ponownie"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "ChATeO"
msgid "Change email"
msgstr "Zmień adres e-mail"

#: src/app/auth/[locale]/otp/page.tsx
msgctxt "AmelVC"
msgid "Enter the code we sent to {email}."
msgstr "Wpisz kod, który wysłaliśmy na adres {email}."

#: src/app/auth/[locale]/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "Sprawdź pocztę"

#: src/app/auth/[locale]/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Utwórz profil"

#: src/app/auth/[locale]/setup/page.tsx
msgctxt "SmuYUd"
msgid "What should we call you?"
msgstr "Jak mamy cię nazywać?"

#. “it” is the name and username the learner picks on this screen.
#: src/app/auth/[locale]/setup/page.tsx
msgctxt "y9wzAs"
msgid "You can change it later in your profile."
msgstr "Możesz to później zmienić w swoim profilu."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "1SvspN"
msgid "Checking..."
msgstr "Sprawdzamy…"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "9N4_rz"
msgid "{username} is available"
msgstr "Nazwa {username} jest dostępna"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "R76cpj"
msgid "{username} is already taken"
msgstr "Nazwa {username} jest już zajęta"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "wubfpa"
msgid "3-30 characters. Letters a–z, numbers, and underscores only."
msgstr "3–30 znaków. Tylko litery a–z, cyfry i podkreślenia."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "9j8lDu"
msgid "Your username: @{username}"
msgstr "Twoja nazwa użytkownika: @{username}"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "UJWPJj"
msgid "Change username"
msgstr "Zmień nazwę użytkownika"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "BY343C"
msgid "Change"
msgstr "Zmień"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "HAlOn1"
msgid "Name"
msgstr "Imię"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "D4cYHr"
msgid "Use 150 characters or fewer."
msgstr "Wpisz maksymalnie 150 znaków."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "JCIgkj"
msgid "Username"
msgstr "Nazwa użytkownika"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "bz5AYp"
msgid "We couldn't save your profile. Try again."
msgstr "Nie udało się zapisać profilu. Spróbuj ponownie."

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "1vqX2W"
msgid "Unable to redirect"
msgstr "Nie udało się przekierować"

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "83K2kN"
msgid "The destination URL is not recognized as a trusted Zoonk application."
msgstr "Nie rozpoznajemy adresu docelowego jako adresu zaufanej aplikacji Zoonka."

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "-e4BVR"
msgid "Continue to Zoonk"
msgstr "Przejdź do Zoonka"

#. The link shows only the word "Zoonk", so keep "Zoonk" as a separate word, with no ending or particle attached.
#: src/components/auth-frame.tsx
