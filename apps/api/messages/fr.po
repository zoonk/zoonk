#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "arjdPf"
msgid "Confirm your email address first, then open the invite again."
msgstr "Confirme d’abord ton adresse e-mail, puis rouvre l’invitation."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "6ychX4"
msgid "This invite was sent to another email. Sign in with that email to accept it."
msgstr "Cette invitation a été envoyée à une autre adresse e-mail. Connecte-toi avec cette adresse pour l’accepter."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "VWppro"
msgid "This invite expired. Ask for a new one."
msgstr "Cette invitation a expiré. Demande-en une nouvelle."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "NKNtUt"
msgid "Sign in with the email this invite was sent to."
msgstr "Connecte-toi avec l’adresse e-mail à laquelle cette invitation a été envoyée."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "S3n5VD"
msgid "We couldn't find this invite. It may have been canceled."
msgstr "On n’a pas trouvé cette invitation. Elle a peut-être été annulée."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "8YMK0-"
msgid "Accept invite"
msgstr "Accepter l’invitation"

#: src/app/auth/guardian/page.tsx
msgctxt "poUf8i"
msgid "Guardian"
msgstr "Parent ou tuteur"

#: src/app/auth/guardian/page.tsx
msgctxt "je39I0"
msgid "Sign in with the email this invite was sent to. It's free."
msgstr "Connecte-toi avec l’adresse e-mail à laquelle cette invitation a été envoyée. C’est gratuit."

#: src/app/auth/guardian/page.tsx
msgctxt "ZJzI65"
