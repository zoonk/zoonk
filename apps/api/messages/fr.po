#: src/app/auth/[locale]/layout.tsx
msgctxt "dqGyqS"
msgid "Log in to Zoonk"
msgstr "Connexion à Zoonk"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "Lgbcpa"
msgid "Temporary emails don't work. Use another."
msgstr "Les adresses e-mail temporaires ne sont pas acceptées. Utilise une autre adresse."

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "QDMzfE"
msgid "We couldn't log you in. Try again."
msgstr "Impossible de te connecter. Réessaie."

#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Saisis une adresse e-mail valide"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "b27sTL"
msgid "Too many tries. Try again in a minute."
msgstr "Trop de tentatives. Réessaie dans une minute."

#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "Adresse e-mail"

#. An example address shown in the empty email field. Keep it as written, like the app's other example addresses.
#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "me@gmail.com"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Continuer"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "tUBpHv"
msgid "Log in or create an account"
msgstr "Connecte-toi ou crée un compte"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "B04QDm"
msgid "Logging in took too long. Try again."
msgstr "La connexion a pris trop de temps. Réessaie."

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "Ou"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "V3Izs2"
msgid "By continuing, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "En continuant, tu acceptes nos <terms>Conditions d’utilisation</terms> et notre <privacy>Politique de confidentialité</privacy>."

#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Continuer avec Google"

#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Continuer avec Apple"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "Nous n’avons pas pu envoyer de nouveau code. Réessaie."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "QNbzsf"
msgid "Wait a minute, then ask for a new code."
msgstr "Attends une minute, puis demande un nouveau code."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "s0lBqy"
msgid "We sent you a new code."
msgstr "Nous t’avons envoyé un nouveau code."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Une erreur s’est produite. Réessaie dans un instant."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Ce code a expiré. Demande-en un nouveau."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "5F-3fe"
msgid "Too many wrong tries. Get a new code."
msgstr "Trop de codes incorrects. Demande un nouveau code."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "vnORxw"
msgid "That code isn't right. Try again."
msgstr "Ce code est incorrect. Réessaie."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "Code reçu par e-mail"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Envoyer un nouveau code"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "X1bhjS"
msgid "Didn't get it?"
msgstr "Tu ne l’as pas reçu ?"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "qs4xBq"
msgid "Send again"
msgstr "Renvoyer"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "ChATeO"
msgid "Change email"
msgstr "Changer d’adresse e-mail"

#: src/app/auth/[locale]/otp/page.tsx
msgctxt "xNDAQj"
msgid "Enter the code we sent to <address>{email}</address>."
msgstr "Saisis le code que nous avons envoyé à <address>{email}</address>."

#: src/app/auth/[locale]/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "Consulte tes e-mails"

#: src/app/auth/[locale]/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Crée ton profil"

#: src/app/auth/[locale]/setup/page.tsx
msgctxt "SmuYUd"
msgid "What should we call you?"
msgstr "Comment doit-on t’appeler ?"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "bz5AYp"
msgid "We couldn't save your profile. Try again."
msgstr "Nous n’avons pas pu enregistrer ton profil. Réessaie."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "HAlOn1"
msgid "Name"
msgstr "Nom"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "D4cYHr"
msgid "Use 150 characters or fewer."
msgstr "Utilise au maximum 150 caractères."

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "cUktz7"
msgid "That link didn't work"
msgstr "Ce lien n’a pas fonctionné"

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "15PZTm"
msgid "Go to Zoonk"
msgstr "Aller sur Zoonk"

#. The link shows only the word "Zoonk", so keep "Zoonk" as a separate word, with no ending or particle attached.
#: src/components/auth-frame.tsx
msgctxt "m-X1D0"
msgid "Back to Zoonk"
msgstr "Retour à Zoonk"

#: src/lib/reminders/reminder-copy.ts
msgctxt "yDrTAE"
msgid "{minutes, plural, one {# minute} other {# minutes}} of exam prep on your plan today."
msgstr "Ton plan prévoit {minutes, plural, one {# minute} other {# minutes}} de préparation à l’examen aujourd’hui."

#: src/lib/reminders/reminder-copy.ts
msgctxt "Kc3Giq"
msgid "Today's exam prep: {minutes, plural, one {# minute} other {# minutes}}."
msgstr "Préparation à l’examen aujourd’hui : {minutes, plural, one {# minute} other {# minutes}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "QGJAH7"
msgid "{minutes, plural, one {# minute} other {# minutes}} today moves your exam prep forward."
msgstr "{minutes, plural, one {# minute} other {# minutes}} aujourd’hui pour avancer dans ta préparation à l’examen."

#: src/lib/reminders/reminder-copy.ts
msgctxt "dN9j0T"
msgid "{minutes, plural, one {# minute} other {# minutes}} on your plan today."
msgstr "Ton plan prévoit {minutes, plural, one {# minute} other {# minutes}} aujourd’hui."

#: src/lib/reminders/reminder-copy.ts
msgctxt "CHd8Js"
msgid "Today's plan has {minutes, plural, one {# minute} other {# minutes}} for it."
msgstr "Ton plan du jour prévoit {minutes, plural, one {# minute} other {# minutes}} pour cet objectif."

#: src/lib/reminders/reminder-copy.ts
msgctxt "T3CRm8"
msgid "{minutes, plural, one {# minute} other {# minutes}} to study today."
msgstr "{minutes, plural, one {# minute} other {# minutes}} pour étudier aujourd’hui."

#: src/lib/reminders/reminder-copy.ts
msgctxt "jfc4ic"
msgid "{left, plural, one {# minute} other {# minutes}} left today. You've already done {done, plural, one {# minute} other {# minutes}}."
msgstr "Il te reste {left, plural, one {# minute} other {# minutes}} aujourd’hui. Tu as déjà étudié {done, plural, one {# minute} other {# minutes}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "ox2un2"
msgid "You've done {done, plural, one {# minute} other {# minutes}} today. {left, plural, one {# minute} other {# minutes}} to go."
msgstr "Tu as étudié {done, plural, one {# minute} other {# minutes}} aujourd’hui. Encore {left, plural, one {# minute} other {# minutes}}."

#. A study reminder's body under a title naming one goal. “it” is that goal, not the whole day: other goals may still be left, so never say the day or today's study is done.
#: src/lib/reminders/reminder-copy.ts
msgctxt "fD5xFe"
msgid "{left, plural, one {# more minute} other {# more minutes}} to finish it today."
msgstr "{left, plural, one {Encore # minute} other {Encore # minutes}} pour atteindre cet objectif aujourd’hui."

#: src/lib/reminders/reminder-copy.ts
msgctxt "doiP8l"
msgid "{minutes, plural, one {# minute} other {# minutes}} today, then {others, plural, one {# more goal} other {# more goals}}."
msgstr "{minutes, plural, one {# minute} other {# minutes}} aujourd’hui, puis {others, plural, one {# autre objectif} other {# autres objectifs}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "dBVV88"
msgid "Start with {minutes, plural, one {# minute} other {# minutes}}. {others, plural, one {# other goal is} other {# other goals are}} on today's plan too."
msgstr "Commence par {minutes, plural, one {# minute} other {# minutes}}. Ton plan prévoit aussi {others, plural, one {# autre objectif} other {# autres objectifs}} aujourd’hui."

#: src/lib/reminders/reminder-copy.ts
msgctxt "EUWgvZ"
msgid "{minutes, plural, one {# minute} other {# minutes}} for this one, and {others, plural, one {# more goal} other {# more goals}} after it."
msgstr "{minutes, plural, one {# minute} other {# minutes}} pour cet objectif, puis {others, plural, one {# autre objectif} other {# autres objectifs}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "l22EVR"
msgid "Open Zoonk"
msgstr "Ouvrir Zoonk"

#: src/lib/reminders/reminder-copy.ts
msgctxt "wdqkFx"
msgid "Change reminder settings"
msgstr "Modifier les paramètres des rappels"

#: src/lib/reminders/reminder-copy.ts
msgctxt "YvVUvF"
msgid "Turn off email reminders"
msgstr "Désactiver les rappels par e-mail"

#: src/lib/reminders/reminder-copy.ts
msgctxt "TMLja4"
msgid "You get this because you turned on study reminders in Zoonk."
msgstr "Tu reçois ce message parce que tu as activé les rappels d’étude dans Zoonk."

#: src/lib/reminders/reminder-copy.ts
msgctxt "7gq6C7"
msgid "Next up: {goal}"
msgstr "À suivre : {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "A3jTYj"
msgid "Today's study: {goal}"
msgstr "À étudier aujourd’hui : {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "s-800F"
msgid "Time to study: {goal}"
msgstr "C’est l’heure d’étudier : {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "R9vV3q"
msgid "Ready when you are: {goal}"
msgstr "Quand tu veux : {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "I0h01A"
msgid "Still on today: {goal}"
msgstr "Toujours dans ton plan du jour : {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "FdTl5c"
msgid "Your study time: {goal}"
msgstr "Ton temps d’étude : {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "CdHWeN"
msgid "On your plan today: {goal}"
msgstr "Dans ton plan du jour : {goal}"

#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "Voici un court test sur {chapter} : si tu le réussis, tu n’auras pas à suivre les leçons que tu connais déjà."

#: src/lib/tutor-confirmation.ts
msgctxt "OPj8y4"
msgid "Below you can choose where to focus, or take a short test that chooses for you."
msgstr "Tu peux choisir tes priorités ci-dessous, ou faire un court test qui les choisira pour toi."

#: src/lib/tutor-confirmation.ts
msgctxt "lW8O7a"
msgid "Below you can change the country your lessons are about."
msgstr "Tu peux changer ci-dessous le pays dont parlent tes leçons."

#: src/lib/tutor-confirmation.ts
msgctxt "ejo0Qg"
msgid "Below you can start a short practice call whenever you're ready."
msgstr "Tu peux lancer un court appel d’entraînement ci-dessous quand tu seras prêt."

#: src/lib/tutor-confirmation.ts
msgctxt "c7OWI5"
msgid "Below you can see when your plan practices {subject}."
msgstr "Tu peux voir ci-dessous quand ton plan prévoit de travailler {subject}."

#: src/lib/tutor-confirmation.ts
msgctxt "3zTiTF"
msgid "Below you can save where you live for new goals and your examples."
msgstr "Tu peux enregistrer ci-dessous le pays où tu vis pour tes nouveaux objectifs et tes exemples."

#: src/lib/tutor-confirmation.ts
msgctxt "zPC6bz"
msgid "Below is your week in review."
msgstr "Voici le bilan de ta semaine."

#: src/lib/tutor-confirmation.ts
msgctxt "CinPvg"
msgid "Below you can see and change what I remember about you."
msgstr "Tu peux voir et modifier ci-dessous ce que je retiens sur toi."

#: src/lib/tutor-confirmation.ts
msgctxt "u6lEYv"
msgid "Below is your mistakes notebook, with practice for each one."
msgstr "Voici ton Carnet d’erreurs, avec de quoi t’entraîner sur chacune d’elles."

#: src/lib/tutor-confirmation.ts
msgctxt "qmjNYT"
msgid "Below you can choose a mock exam to take now."
msgstr "Tu peux choisir ci-dessous un examen blanc à faire maintenant."

#: src/lib/tutor-confirmation.ts
msgctxt "cO6qa4"
msgid "Below you can subscribe."
msgstr "Tu peux t’abonner ci-dessous."

#: src/lib/tutor-confirmation.ts
msgctxt "KAqcUe"
msgid "Below you can say again the words that were hard to pronounce."
msgstr "Tu peux redire ci-dessous les mots que tu as eu du mal à prononcer."

#: src/lib/tutor-confirmation.ts
msgctxt "BXdAAo"
msgid "I've put the change to your plan below. Nothing changes until you apply it."
msgstr "J’ai proposé une modification de ton plan ci-dessous. Rien ne change tant que tu ne l’appliques pas."

#: src/lib/tutor-confirmation.ts
msgctxt "cVQNWB"
msgid "Below you can start it as a new goal."
msgstr "Tu peux en faire un nouvel objectif ci-dessous."

#: src/lib/tutor-confirmation.ts
msgctxt "40I13C"
msgid "Below are your statistics."
msgstr "Voici tes statistiques."

#: src/lib/tutor-confirmation.ts
msgctxt "v3uUXk"
msgid "Below you can choose that variety for your buddy and practice calls."
msgstr "Tu peux choisir cette variante ci-dessous pour ton compagnon et tes appels d’entraînement."
