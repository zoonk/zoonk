#: src/app/auth/[locale]/layout.tsx
msgctxt "dVItHD"
msgid "Sign in to Zoonk"
msgstr "Bei Zoonk anmelden"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "vO6NBp"
msgid "Temporary email addresses aren't supported. Use another email or a privacy alias."
msgstr "Temporäre E-Mail-Adressen werden nicht unterstützt. Verwende eine andere E-Mail-Adresse oder einen Alias zum Schutz deiner Privatsphäre."

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "pN2p0t"
msgid "There was an error signing you in. Please try again or contact hello@zoonk.com"
msgstr "Bei der Anmeldung ist ein Fehler aufgetreten. Versuch es noch einmal oder schreib an hello@zoonk.com"

#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Gib eine gültige E-Mail-Adresse ein"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "hUjCDW"
msgid "Too many tries. Wait a minute, then try again."
msgstr "Zu viele Versuche. Warte eine Minute und versuch es dann noch einmal."

#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "E-Mail"

#. An example address shown in the empty email field. Keep it as written, like the app's other example addresses.
#: src/app/auth/[locale]/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "me@gmail.com"

#: src/app/auth/[locale]/login/email-login-form.tsx
#: src/app/auth/[locale]/otp/otp-form.tsx
#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Weiter"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "eN8MTJ"
msgid "Sign in or create an account"
msgstr "Anmelden oder Konto erstellen"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "o_pwJP"
msgid "That sign-in expired. Try again."
msgstr "Die Anmeldung ist abgelaufen. Versuch es noch einmal."

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "Oder"

#: src/app/auth/[locale]/login/login-screen.tsx
msgctxt "Ju9oB-"
msgid "By clicking on Continue, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "Mit einem Klick auf „Weiter“ stimmst du unseren <terms>Nutzungsbedingungen</terms> und unserer <privacy>Datenschutzerklärung</privacy> zu."

#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Mit Google fortfahren"

#: src/app/auth/[locale]/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Mit Apple fortfahren"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Da ist etwas schiefgelaufen. Versuch es gleich noch einmal."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Dieser Code ist abgelaufen. Fordere einen neuen an."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "P-D93T"
msgid "Too many wrong tries with this code. Get a new one."
msgstr "Zu viele Fehlversuche mit diesem Code. Fordere einen neuen an."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "AFMAKd"
msgid "That code isn't right. Check the email and try again."
msgstr "Der Code stimmt nicht. Schau in der E-Mail nach und versuch es noch einmal."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "U2LhAf"
msgid "We sent a new code to {email}."
msgstr "Wir haben einen neuen Code an {email} gesendet."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "E05GNf"
msgid "Wait a minute before asking for another code."
msgstr "Warte eine Minute, bevor du einen neuen Code anforderst."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "Wir konnten keinen neuen Code senden. Versuch es noch einmal."

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "Code aus der E-Mail"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Neuen Code senden"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "X1bhjS"
msgid "Didn't get it?"
msgstr "Nicht erhalten?"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "qs4xBq"
msgid "Send again"
msgstr "Noch einmal senden"

#: src/app/auth/[locale]/otp/otp-form.tsx
msgctxt "ChATeO"
msgid "Change email"
msgstr "E-Mail-Adresse ändern"

#: src/app/auth/[locale]/otp/page.tsx
msgctxt "AmelVC"
msgid "Enter the code we sent to {email}."
msgstr "Gib den Code ein, den wir an {email} gesendet haben."

#: src/app/auth/[locale]/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "Prüfe deine E-Mails"

#: src/app/auth/[locale]/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Erstelle dein Profil"

#: src/app/auth/[locale]/setup/page.tsx
msgctxt "SmuYUd"
msgid "What should we call you?"
msgstr "Wie sollen wir dich nennen?"

#. “it” is the name and username the learner picks on this screen.
#: src/app/auth/[locale]/setup/page.tsx
msgctxt "y9wzAs"
msgid "You can change it later in your profile."
msgstr "Du kannst beides später in deinem Profil ändern."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "1SvspN"
msgid "Checking..."
msgstr "Wir prüfen…"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "9N4_rz"
msgid "{username} is available"
msgstr "{username} ist verfügbar"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "R76cpj"
msgid "{username} is already taken"
msgstr "{username} ist bereits vergeben"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "wubfpa"
msgid "3-30 characters. Letters a–z, numbers, and underscores only."
msgstr "3–30 Zeichen. Nur Buchstaben a–z, Ziffern und Unterstriche."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "9j8lDu"
msgid "Your username: @{username}"
msgstr "Dein Benutzername: @{username}"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "UJWPJj"
msgid "Change username"
msgstr "Benutzernamen ändern"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "BY343C"
msgid "Change"
msgstr "Ändern"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "HAlOn1"
msgid "Name"
msgstr "Name"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "D4cYHr"
msgid "Use 150 characters or fewer."
msgstr "Gib höchstens 150 Zeichen ein."

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "JCIgkj"
msgid "Username"
msgstr "Benutzername"

#: src/app/auth/[locale]/setup/setup-form.tsx
msgctxt "bz5AYp"
msgid "We couldn't save your profile. Try again."
msgstr "Wir konnten dein Profil nicht speichern. Versuch es noch einmal."

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "1vqX2W"
msgid "Unable to redirect"
msgstr "Weiterleitung nicht möglich"

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "83K2kN"
msgid "The destination URL is not recognized as a trusted Zoonk application."
msgstr "Die Ziel-URL wird nicht als vertrauenswürdige Zoonk-Anwendung erkannt."

#: src/app/auth/[locale]/untrusted-origin/page.tsx
msgctxt "-e4BVR"
msgid "Continue to Zoonk"
msgstr "Weiter zu Zoonk"

#. The link shows only the word "Zoonk", so keep "Zoonk" as a separate word, with no ending or particle attached.
#: src/components/auth-frame.tsx
msgctxt "m-X1D0"
msgid "Back to Zoonk"
msgstr "Zurück zu Zoonk"

#: src/lib/reminders/reminder-copy.ts
