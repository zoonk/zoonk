#: src/app/auth/layout.tsx
msgctxt "dVItHD"
msgid "Sign in to Zoonk"
msgstr "Bei Zoonk anmelden"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
msgctxt "vO6NBp"
msgid "Temporary email addresses aren't supported. Use another email or a privacy alias."
msgstr "Temporäre E-Mail-Adressen werden nicht unterstützt. Verwende eine andere E-Mail-Adresse oder einen Alias zum Schutz deiner Privatsphäre."

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/login/social-login.tsx
msgctxt "pN2p0t"
msgid "There was an error signing you in. Please try again or contact hello@zoonk.com"
msgstr "Beim Anmelden ist ein Fehler aufgetreten. Bitte versuche es erneut oder kontaktiere hello@zoonk.com"

#: src/app/auth/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Gib eine gültige E-Mail‑Adresse ein"

#: src/app/auth/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "E-Mail"

#: src/app/auth/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "me@gmail.com"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
#: src/app/auth/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Weiter"

#: src/app/auth/login/page.tsx
msgctxt "eN8MTJ"
msgid "Sign in or create an account"
msgstr "Anmelden oder ein Konto erstellen"

#: src/app/auth/login/page.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "Oder"

#: src/app/auth/login/page.tsx
msgctxt "Ju9oB-"
msgid "By clicking on Continue, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "Indem du auf Weiter klickst, stimmst du unseren <terms>Nutzungsbedingungen</terms> und der <privacy>Datenschutzrichtlinie</privacy> zu."

#: src/app/auth/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Weiter mit Google"

#: src/app/auth/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Weiter mit Apple"

#: src/app/auth/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Etwas ist schiefgelaufen. Versuch es gleich noch einmal."

#: src/app/auth/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Dieser Code ist abgelaufen. Hol dir einen neuen."

#: src/app/auth/otp/otp-form.tsx
msgctxt "hUjCDW"
msgid "Too many tries. Wait a minute, then try again."
msgstr "Zu viele Versuche. Warte eine Minute und versuch es dann noch einmal."

#: src/app/auth/otp/otp-form.tsx
msgctxt "P-D93T"
msgid "Too many wrong tries with this code. Get a new one."
msgstr "Du hast diesen Code zu oft falsch eingegeben. Hol dir einen neuen."

#: src/app/auth/otp/otp-form.tsx
msgctxt "AFMAKd"
msgid "That code isn't right. Check the email and try again."
msgstr "Dieser Code stimmt nicht. Prüfe die E-Mail und versuch es noch einmal."

#: src/app/auth/otp/otp-form.tsx
msgctxt "U2LhAf"
msgid "We sent a new code to {email}."
msgstr "Wir haben einen neuen Code an {email} gesendet."

#: src/app/auth/otp/otp-form.tsx
msgctxt "E05GNf"
msgid "Wait a minute before asking for another code."
msgstr "Warte eine Minute, bevor du einen weiteren Code anforderst."

#: src/app/auth/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "Wir konnten keinen neuen Code senden. Versuch es noch einmal."

#: src/app/auth/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "Code aus der E-Mail"

#: src/app/auth/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Neuen Code senden"

#: src/app/auth/otp/otp-form.tsx
msgctxt "3WXGFW"
msgid "Didn't get it? Send a new code"
msgstr "Nichts erhalten? Neuen Code senden"

#: src/app/auth/otp/otp-form.tsx
msgctxt "ChATeO"
msgid "Change email"
msgstr "E‑Mail ändern"

#: src/app/auth/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "Schau in dein Postfach"

#: src/app/auth/otp/page.tsx
msgctxt "AmelVC"
msgid "Enter the code we sent to {email}."
msgstr "Gib den Code ein, den wir an {email} gesendet haben."

#: src/app/auth/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Erstelle dein Profil"

#: src/app/auth/setup/page.tsx
msgctxt "jN5Gqb"
msgid "Your name and a username. You can change both later in your profile."
msgstr "Dein Name und ein Benutzername. Beides kannst du später in deinem Profil ändern."

#: src/app/auth/setup/setup-form.tsx
msgctxt "1SvspN"
msgid "Checking..."
msgstr "Wird überprüft…"

#: src/app/auth/setup/setup-form.tsx
msgctxt "9N4_rz"
msgid "{username} is available"
msgstr "{username} ist verfügbar"

#: src/app/auth/setup/setup-form.tsx
msgctxt "R76cpj"
msgid "{username} is already taken"
msgstr "{username} ist bereits vergeben"

#: src/app/auth/setup/setup-form.tsx
msgctxt "vLl7z0"
msgid "3-30 characters. Letters, numbers, and underscores only."
msgstr "3–30 Zeichen. Nur Buchstaben, Zahlen und Unterstriche."

#: src/app/auth/setup/setup-form.tsx
msgctxt "HAlOn1"
msgid "Name"
msgstr "Name"

#: src/app/auth/setup/setup-form.tsx
msgctxt "JCIgkj"
msgid "Username"
msgstr "Benutzername"

#: src/app/auth/setup/setup-form.tsx
msgctxt "bz5AYp"
msgid "We couldn't save your profile. Try again."
msgstr "Wir konnten dein Profil nicht speichern. Versuch es noch einmal."

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "1vqX2W"
msgid "Unable to redirect"
msgstr "Weiterleitung nicht möglich"

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "83K2kN"
msgid "The destination URL is not recognized as a trusted Zoonk application."
msgstr "Die Ziel-URL wird nicht als vertrauenswürdige Zoonk-Anwendung erkannt."

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "-e4BVR"
msgid "Continue to Zoonk"
msgstr "Weiter zu Zoonk"

#: src/components/auth-frame.tsx
msgctxt "m-X1D0"
msgid "Back to Zoonk"
msgstr "Zurück zu Zoonk"

#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "Unten findest du einen kurzen Test zu {chapter}: Wenn du ihn bestehst, überspringst du die Lektionen, die du schon kennst."

#: src/lib/tutor-confirmation.ts
msgctxt "OPj8y4"
msgid "Below you can choose where to focus, or take a short test that chooses for you."
msgstr "Unten kannst du auswählen, worauf du dich konzentrieren möchtest, oder einen kurzen Test machen, der das für dich entscheidet."

#: src/lib/tutor-confirmation.ts
msgctxt "ejo0Qg"
msgid "Below you can start a short practice call whenever you're ready."
msgstr "Unten kannst du jederzeit mit einem kurzen Übungsgespräch anfangen, sobald du bereit bist."

#: src/lib/tutor-confirmation.ts
msgctxt "c7OWI5"
msgid "Below you can see when your plan practices {subject}."
msgstr "Unten siehst du, wann du laut deinem Plan {subject} übst."

#: src/lib/tutor-confirmation.ts
msgctxt "zPC6bz"
msgid "Below is your week in review."
msgstr "Unten findest du deinen Wochenrückblick."

#: src/lib/tutor-confirmation.ts
msgctxt "CinPvg"
msgid "Below you can see and change what I remember about you."
msgstr "Unten kannst du sehen und ändern, was ich mir über dich gemerkt habe."

#: src/lib/tutor-confirmation.ts
msgctxt "u6lEYv"
msgid "Below is your mistakes notebook, with practice for each one."
msgstr "Unten findest du dein Fehlerheft mit Übungen zu jedem Fehler."

#: src/lib/tutor-confirmation.ts
msgctxt "qmjNYT"
msgid "Below you can choose a mock exam to take now."
msgstr "Unten kannst du eine Probeprüfung auswählen, die du jetzt ablegen möchtest."

#: src/lib/tutor-confirmation.ts
msgctxt "aK1CcD"
msgid "Below is the Plus page."
msgstr "Unten findest du die Plus-Seite."

#: src/lib/tutor-confirmation.ts
msgctxt "KAqcUe"
msgid "Below you can say again the words that were hard to pronounce."
msgstr "Unten kannst du die Wörter, deren Aussprache dir schwerfiel, noch einmal sprechen."

#: src/lib/tutor-confirmation.ts
msgctxt "BXdAAo"
msgid "I've put the change to your plan below. Nothing changes until you apply it."
msgstr "Unten habe ich die Änderung an deinem Plan zusammengestellt. Nichts ändert sich, bis du sie übernimmst."

#: src/lib/tutor-confirmation.ts
msgctxt "cVQNWB"
msgid "Below you can start it as a new goal."
msgstr "Unten kannst du es als neues Ziel starten."

#: src/lib/tutor-confirmation.ts
msgctxt "40I13C"
msgid "Below are your statistics."
msgstr "Unten findest du deine Statistiken."
