msgid "{minutes, plural, one {# minute} other {# minutes}} today keeps your plan on track."
msgstr "Mit {minutes, plural, one {# Minute} other {# Minuten}} heute bleibst du im Zeitplan."

#: src/lib/reminders/reminder-copy.ts
msgctxt "jfc4ic"
msgid "{left, plural, one {# minute} other {# minutes}} left today. You've already done {done, plural, one {# minute} other {# minutes}}."
msgstr "Heute noch {left, plural, one {# Minute} other {# Minuten}}. Du hast schon {done, plural, one {# Minute} other {# Minuten}} gelernt."

