#: src/app/auth/guardian/end-link-button.tsx
msgctxt "eq8fyl"
msgid "End link"
msgstr "Verbindung beenden"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "yXrPHy"
msgid "Stop being {name}'s guardian?"
msgstr "Möchtest du nicht mehr die Betreuungsperson von {name} sein?"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "jdTv0j"
msgid "You'll stop seeing their week, and your daily limit, memory choice and Plus approval end. They can invite you again later."
msgstr "Du siehst die Wochenübersicht nicht mehr. Dein tägliches Zeitlimit, deine Gedächtniseinstellung und die Plus-Freigabe enden. Sie können dich später wieder einladen."

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "47FYwb"
msgid "Cancel"
msgstr "Abbrechen"

#: src/app/auth/guardian/end-link-button.tsx
msgctxt "OZbt2X"
msgid "We couldn't end the link. Try again."
msgstr "Verbindung konnte nicht beendet werden. Versuch es noch einmal."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "JzvSPP"
msgid "Daily time limit"
msgstr "Tägliches Zeitlimit"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "PfW4AI"
msgid "No limit"
msgstr "Kein Limit"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "AVWDvG"
msgid "{minutes} min a day"
msgstr "{minutes} Min. pro Tag"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "jvo0vs"
msgid "Save"
msgstr "Speichern"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "OxnxZb"
msgid "Daily limit saved"
msgstr "Tageslimit gespeichert"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "fynQpZ"
msgid "We couldn't save the limit. Try again."
msgstr "Das Limit konnte nicht gespeichert werden. Versuch es noch einmal."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "NG9KbJ"
msgid "Off. {name} can't turn it on."
msgstr "Aus. {name} kann es nicht einschalten."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "qRTS8x"
msgid "On. Zoonk remembers {name}'s goals and how they learn, to fit examples to them."
msgstr "An. Zoonk merkt sich die Ziele von {name} und wie {name} lernt, um passende Beispiele auszuwählen."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "s4EmrE"
msgid "Off. It stays off unless {name} turns it on."
msgstr "Aus. Es bleibt ausgeschaltet, bis {name} es einschaltet."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "aLIOCf"
msgid "Let {name} use memory"
msgstr "Gedächtnis für {name} erlauben"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "8ArJq7"
msgid "We couldn't save that. Try again."
msgstr "Das konnten wir nicht speichern. Versuch es noch einmal."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "3-s4XD"
msgid "You approved Plus on {date}."
msgstr "Du hast Plus am {date} genehmigt."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "U9BvCE"
msgid "{name} needs your approval to subscribe to Plus."
msgstr "{name} braucht deine Zustimmung, um Plus zu abonnieren."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "330Hte"
msgid "Approve Plus"
msgstr "Plus genehmigen"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "Mfp11j"
msgid "We couldn't save your approval. Try again."
msgstr "Deine Zustimmung konnte nicht gespeichert werden. Versuch es noch einmal."

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "gpodmF"
msgid "Minutes each day"
msgstr "Minuten pro Tag"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "1zggxX"
msgid "{day}: {minutes, plural, =0 {# minutes} one {# minute} other {# minutes}}, {lessons, plural, =0 {# lessons} one {# lesson} other {# lessons}}"
msgstr "{day}: {minutes, plural, =0 {# Minuten} one {# Minute} other {# Minuten}}, {lessons, plural, =0 {# Lektionen} one {# Lektion} other {# Lektionen}}"

#: src/app/auth/guardian/guarded-learner-card.tsx
msgctxt "D16ndi"
msgid "Last 7 days: {minutes, plural, =0 {# minutes} one {# minute} other {# minutes}} and {lessons, plural, =0 {# lessons} one {# lesson} other {# lessons}}"
msgstr "Letzte 7 Tage: {minutes, plural, =0 {# Minuten} one {# Minute} other {# Minuten}} und {lessons, plural, =0 {# Lektionen} one {# Lektion} other {# Lektionen}}"

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "arjdPf"
msgid "Confirm your email address first, then open the invite again."
msgstr "Bestätige zuerst deine E-Mail-Adresse und öffne dann die Einladung erneut."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "6ychX4"
msgid "This invite was sent to another email. Sign in with that email to accept it."
msgstr "Diese Einladung wurde an eine andere E-Mail-Adresse geschickt. Melde dich mit dieser Adresse an, um sie anzunehmen."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "VWppro"
msgid "This invite expired. Ask for a new one."
msgstr "Diese Einladung ist abgelaufen. Bitte um eine neue."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "NKNtUt"
msgid "Sign in with the email this invite was sent to."
msgstr "Melde dich mit der E-Mail-Adresse an, an die diese Einladung geschickt wurde."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "S3n5VD"
msgid "We couldn't find this invite. It may have been canceled."
msgstr "Diese Einladung wurde nicht gefunden. Vielleicht wurde sie zurückgezogen."

#: src/app/auth/guardian/guardian-accept.tsx
msgctxt "8YMK0-"
msgid "Accept invite"
msgstr "Einladung annehmen"

#: src/app/auth/guardian/page.tsx
msgctxt "poUf8i"
msgid "Guardian"
msgstr "Erziehungsberechtigte"

#: src/app/auth/guardian/page.tsx
msgctxt "je39I0"
msgid "Sign in with the email this invite was sent to. It's free."
msgstr "Melde dich mit der E-Mail-Adresse an, an die diese Einladung geschickt wurde. Das ist kostenlos."

#: src/app/auth/guardian/page.tsx
msgctxt "ZJzI65"
msgid "Sign in to see the learners who invited you."
msgstr "Melde dich an, um die Lernenden zu sehen, die dich eingeladen haben."

#: src/app/auth/guardian/page.tsx
msgctxt "szo7Rq"
msgid "Sign in to continue"
msgstr "Zum Fortfahren anmelden"

#: src/app/auth/guardian/page.tsx
msgctxt "lSvmLC"
msgid "Accept the invite"
msgstr "Einladung annehmen"

#: src/app/auth/guardian/page.tsx
msgctxt "gtva5X"
msgid "As their guardian, you'll see their weekly activity and can set a daily time limit, turn memory off and approve Plus. You won't see their answers or messages."
msgstr "Als Erziehungsberechtigte:r siehst du die wöchentlichen Aktivitäten und kannst ein tägliches Zeitlimit festlegen, das Gedächtnis ausschalten und Plus freigeben. Die Antworten und Nachrichten siehst du nicht."

#: src/app/auth/guardian/page.tsx
msgctxt "JPtSV8"
msgid "Your learners"
msgstr "Deine Lernenden"

#: src/app/auth/guardian/page.tsx
msgctxt "xltR8k"
msgid "Invite accepted. Here's their week and the controls you can set."
msgstr "Einladung angenommen. Hier siehst du ihre Aktivitäten der letzten Woche und kannst Einstellungen vornehmen."

#: src/app/auth/guardian/page.tsx
msgctxt "UmTQLH"
msgid "Their last seven days and the controls you can set."
msgstr "Hier siehst du ihre Aktivitäten der letzten sieben Tage und kannst Einstellungen vornehmen."

#: src/app/auth/guardian/page.tsx
msgctxt "n19CR6"
msgid "No learner has invited you yet. Invites arrive by email."
msgstr "Noch hat dich kein Lernender eingeladen. Einladungen kommen per E-Mail."

#: src/app/auth/layout.tsx
msgctxt "dVItHD"
msgid "Sign in to Zoonk"
msgstr "Bei Zoonk anmelden"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
msgctxt "vO6NBp"
msgid "Temporary email addresses aren't supported. Use another email or a privacy alias."
msgstr "Temporäre E-Mail-Adressen werden nicht unterstützt. Verwende eine andere E-Mail-Adresse oder einen Alias zum Schutz deiner Privatsphäre."

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/login/social-login.tsx
msgctxt "pN2p0t"
msgid "There was an error signing you in. Please try again or contact hello@zoonk.com"
msgstr "Beim Anmelden ist ein Fehler aufgetreten. Bitte versuche es erneut oder kontaktiere hello@zoonk.com"

#: src/app/auth/login/email-login-form.tsx
msgctxt "YRe93Y"
msgid "Enter a valid email address"
msgstr "Gib eine gültige E-Mail‑Adresse ein"

#: src/app/auth/login/email-login-form.tsx
msgctxt "sy-pv5"
msgid "Email"
msgstr "E-Mail"

#: src/app/auth/login/email-login-form.tsx
msgctxt "apQW0E"
msgid "me@gmail.com"
msgstr "me@gmail.com"

#: src/app/auth/login/email-login-form.tsx
#: src/app/auth/otp/otp-form.tsx
#: src/app/auth/setup/setup-form.tsx
msgctxt "acrOoz"
msgid "Continue"
msgstr "Weiter"

#: src/app/auth/login/page.tsx
msgctxt "eN8MTJ"
msgid "Sign in or create an account"
msgstr "Anmelden oder ein Konto erstellen"

#: src/app/auth/login/page.tsx
msgctxt "4wpUNc"
msgid "Or"
msgstr "Oder"

#: src/app/auth/login/page.tsx
msgctxt "Ju9oB-"
msgid "By clicking on Continue, you agree to our <terms>Terms of Service</terms> and <privacy>Privacy Policy</privacy>."
msgstr "Indem du auf Weiter klickst, stimmst du unseren <terms>Nutzungsbedingungen</terms> und der <privacy>Datenschutzrichtlinie</privacy> zu."

#: src/app/auth/login/social-login.tsx
msgctxt "FJ6r9E"
msgid "Continue with Google"
msgstr "Weiter mit Google"

#: src/app/auth/login/social-login.tsx
msgctxt "BmecBA"
msgid "Continue with Apple"
msgstr "Weiter mit Apple"

#: src/app/auth/otp/otp-form.tsx
msgctxt "_8e0dn"
msgid "Something went wrong. Try again in a moment."
msgstr "Etwas ist schiefgelaufen. Versuch es gleich noch einmal."

#: src/app/auth/otp/otp-form.tsx
msgctxt "__wP3o"
msgid "This code expired. Get a new one."
msgstr "Dieser Code ist abgelaufen. Hol dir einen neuen."

#: src/app/auth/otp/otp-form.tsx
msgctxt "hUjCDW"
msgid "Too many tries. Wait a minute, then try again."
msgstr "Zu viele Versuche. Warte eine Minute und versuch es dann noch einmal."

#: src/app/auth/otp/otp-form.tsx
msgctxt "P-D93T"
msgid "Too many wrong tries with this code. Get a new one."
msgstr "Du hast diesen Code zu oft falsch eingegeben. Hol dir einen neuen."

#: src/app/auth/otp/otp-form.tsx
msgctxt "AFMAKd"
msgid "That code isn't right. Check the email and try again."
msgstr "Dieser Code stimmt nicht. Prüfe die E-Mail und versuch es noch einmal."

#: src/app/auth/otp/otp-form.tsx
msgctxt "U2LhAf"
msgid "We sent a new code to {email}."
msgstr "Wir haben einen neuen Code an {email} gesendet."

#: src/app/auth/otp/otp-form.tsx
msgctxt "E05GNf"
msgid "Wait a minute before asking for another code."
msgstr "Warte eine Minute, bevor du einen neuen Code anforderst."

#: src/app/auth/otp/otp-form.tsx
msgctxt "bWxjFV"
msgid "We couldn't send a new code. Try again."
msgstr "Wir konnten keinen neuen Code senden. Versuch es noch einmal."

#: src/app/auth/otp/otp-form.tsx
msgctxt "5UeJRL"
msgid "Code from the email"
msgstr "Code aus der E-Mail"

#: src/app/auth/otp/otp-form.tsx
msgctxt "gdlGkp"
msgid "Send a new code"
msgstr "Neuen Code senden"

#: src/app/auth/otp/otp-form.tsx
msgctxt "3WXGFW"
msgid "Didn't get it? Send a new code"
msgstr "Nichts erhalten? Neuen Code senden"

#: src/app/auth/otp/otp-form.tsx
msgctxt "ChATeO"
msgid "Change email"
msgstr "E‑Mail ändern"

#: src/app/auth/otp/page.tsx
msgctxt "zx7CKB"
msgid "Check your email"
msgstr "Schau in dein Postfach"

#: src/app/auth/otp/page.tsx
msgctxt "AmelVC"
msgid "Enter the code we sent to {email}."
msgstr "Gib den Code ein, den wir an {email} gesendet haben."

#: src/app/auth/setup/page.tsx
msgctxt "CjpGzJ"
msgid "Create your profile"
msgstr "Erstelle dein Profil"

#: src/app/auth/setup/page.tsx
msgctxt "jN5Gqb"
msgid "Your name and a username. You can change both later in your profile."
msgstr "Dein Name und ein Benutzername. Beides kannst du später in deinem Profil ändern."

#: src/app/auth/setup/setup-form.tsx
msgctxt "1SvspN"
msgid "Checking..."
msgstr "Wird überprüft…"

#: src/app/auth/setup/setup-form.tsx
msgctxt "9N4_rz"
msgid "{username} is available"
msgstr "{username} ist verfügbar"

#: src/app/auth/setup/setup-form.tsx
msgctxt "R76cpj"
msgid "{username} is already taken"
msgstr "{username} ist bereits vergeben"

#: src/app/auth/setup/setup-form.tsx
msgctxt "vLl7z0"
msgid "3-30 characters. Letters, numbers, and underscores only."
msgstr "3–30 Zeichen. Nur Buchstaben, Zahlen und Unterstriche."

#: src/app/auth/setup/setup-form.tsx
msgctxt "HAlOn1"
msgid "Name"
msgstr "Name"

#: src/app/auth/setup/setup-form.tsx
msgctxt "JCIgkj"
msgid "Username"
msgstr "Benutzername"

#: src/app/auth/setup/setup-form.tsx
msgctxt "bz5AYp"
msgid "We couldn't save your profile. Try again."
msgstr "Wir konnten dein Profil nicht speichern. Versuch es noch einmal."

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "1vqX2W"
msgid "Unable to redirect"
msgstr "Weiterleitung nicht möglich"

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "83K2kN"
msgid "The destination URL is not recognized as a trusted Zoonk application."
msgstr "Die Ziel-URL wird nicht als vertrauenswürdige Zoonk-Anwendung erkannt."

#: src/app/auth/untrusted-origin/page.tsx
msgctxt "-e4BVR"
msgid "Continue to Zoonk"
msgstr "Weiter zu Zoonk"

#: src/components/auth-frame.tsx
msgctxt "m-X1D0"
msgid "Back to Zoonk"
msgstr "Zurück zu Zoonk"

#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "Unten findest du einen kurzen Test zu {chapter}: Wenn du ihn bestehst, überspringst du die Lektionen, die du schon kennst."

#: src/lib/tutor-confirmation.ts
msgctxt "OPj8y4"
msgid "Below you can choose where to focus, or take a short test that chooses for you."
msgstr "Unten kannst du auswählen, worauf du dich konzentrieren möchtest, oder einen kurzen Test machen, der das für dich entscheidet."

#: src/lib/tutor-confirmation.ts
msgctxt "ejo0Qg"
msgid "Below you can start a short practice call whenever you're ready."
msgstr "Unten kannst du jederzeit mit einem kurzen Übungsgespräch anfangen, sobald du bereit bist."

#: src/lib/tutor-confirmation.ts
msgctxt "c7OWI5"
msgid "Below you can see when your plan practices {subject}."
msgstr "Unten siehst du, wann du laut deinem Plan {subject} übst."

#: src/lib/tutor-confirmation.ts
msgctxt "zPC6bz"
msgid "Below is your week in review."
msgstr "Unten findest du deinen Wochenrückblick."

#: src/lib/tutor-confirmation.ts
msgctxt "CinPvg"
msgid "Below you can see and change what I remember about you."
msgstr "Unten kannst du sehen und ändern, was ich mir über dich gemerkt habe."

#: src/lib/tutor-confirmation.ts
msgctxt "u6lEYv"
msgid "Below is your mistakes notebook, with practice for each one."
msgstr "Unten findest du dein Fehlerheft mit Übungen zu jedem Fehler."

#: src/lib/tutor-confirmation.ts
msgctxt "qmjNYT"
msgid "Below you can choose a mock exam to take now."
msgstr "Unten kannst du eine Probeprüfung auswählen, die du jetzt ablegen möchtest."

#: src/lib/tutor-confirmation.ts
msgctxt "aK1CcD"
msgid "Below is the Plus page."
msgstr "Unten findest du die Plus-Seite."

#: src/lib/tutor-confirmation.ts
msgctxt "KAqcUe"
msgid "Below you can say again the words that were hard to pronounce."
msgstr "Unten kannst du die Wörter, deren Aussprache dir schwerfiel, noch einmal sprechen."

#: src/lib/tutor-confirmation.ts
msgctxt "BXdAAo"
msgid "I've put the change to your plan below. Nothing changes until you apply it."
msgstr "Unten habe ich die Änderung an deinem Plan zusammengestellt. Nichts ändert sich, bis du sie übernimmst."

#: src/lib/tutor-confirmation.ts
msgctxt "cVQNWB"
msgid "Below you can start it as a new goal."
msgstr "Unten kannst du es als neues Ziel starten."

#: src/lib/tutor-confirmation.ts
msgctxt "40I13C"
msgid "Below are your statistics."
msgstr "Unten findest du deine Statistiken."
