msgstr "Als Nächstes: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "A3jTYj"
msgid "Today's study: {goal}"
msgstr "Heute lernen: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "s-800F"
msgid "Time to study: {goal}"
msgstr "Zeit zum Lernen: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "R9vV3q"
msgid "Ready when you are: {goal}"
msgstr "Bereit, wenn du es bist: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "I0h01A"
msgid "Still on today: {goal}"
msgstr "Heute noch auf dem Plan: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "FdTl5c"
msgid "Your study time: {goal}"
msgstr "Deine Lernzeit: {goal}"

#: src/lib/reminders/reminder-copy.ts
msgctxt "CdHWeN"
msgid "On your plan today: {goal}"
msgstr "Heute auf deinem Plan: {goal}"

#: src/lib/tutor-confirmation.ts
msgctxt "Sd1Qq1"
msgid "Below is a short test on {chapter}: passing it skips the lessons you already know."
msgstr "Unten findest du einen kurzen Test zu {chapter}. Wenn du ihn bestehst, werden die Lektionen übersprungen, deren Inhalte du schon kennst."

#: src/lib/tutor-confirmation.ts
msgctxt "OPj8y4"
msgid "Below you can choose where to focus, or take a short test that chooses for you."
msgstr "Unten kannst du deinen Schwerpunkt wählen oder einen kurzen Test machen, der ihn für dich auswählt."

#: src/lib/tutor-confirmation.ts
msgctxt "ejo0Qg"
msgid "Below you can start a short practice call whenever you're ready."
msgstr "Unten kannst du ein kurzes Übungsgespräch starten, sobald du bereit bist."

#: src/lib/tutor-confirmation.ts
msgctxt "c7OWI5"
msgid "Below you can see when your plan practices {subject}."
msgstr "Unten siehst du, wann du {subject} in deinem Plan übst."

#: src/lib/tutor-confirmation.ts
msgctxt "zPC6bz"
msgid "Below is your week in review."
msgstr "Unten findest du deinen Wochenrückblick."

#: src/lib/tutor-confirmation.ts
msgctxt "CinPvg"
msgid "Below you can see and change what I remember about you."
msgstr "Unten kannst du sehen und ändern, was ich mir über dich merke."

#: src/lib/tutor-confirmation.ts
msgctxt "u6lEYv"
msgid "Below is your mistakes notebook, with practice for each one."
msgstr "Unten findest du dein Fehlerheft mit Übungen zu jedem Fehler."

#: src/lib/tutor-confirmation.ts
msgctxt "qmjNYT"
msgid "Below you can choose a mock exam to take now."
msgstr "Unten kannst du eine Probeprüfung auswählen, die du jetzt machen möchtest."

#: src/lib/tutor-confirmation.ts
msgctxt "aK1CcD"
msgid "Below is the Plus page."
msgstr "Unten findest du die Plus-Seite."

#: src/lib/tutor-confirmation.ts
msgctxt "KAqcUe"
msgid "Below you can say again the words that were hard to pronounce."
msgstr "Unten kannst du die Wörter, die schwer auszusprechen waren, noch einmal sagen."

#: src/lib/tutor-confirmation.ts
msgctxt "BXdAAo"
msgid "I've put the change to your plan below. Nothing changes until you apply it."
msgstr "Ich habe den Änderungsvorschlag für deinen Plan unten eingefügt. Erst wenn du ihn übernimmst, ändert sich etwas."

#: src/lib/tutor-confirmation.ts
msgctxt "cVQNWB"
msgid "Below you can start it as a new goal."
msgstr "Unten kannst du es als neues Ziel starten."

#: src/lib/tutor-confirmation.ts
msgctxt "40I13C"
msgid "Below are your statistics."
msgstr "Unten findest du deine Statistiken."
