msgstr "{minutes, plural, one {# Minute} other {# Minuten}} heute, danach {others, plural, one {# weiteres Ziel} other {# weitere Ziele}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "dBVV88"
msgid "Start with {minutes, plural, one {# minute} other {# minutes}}. {others, plural, one {# other goal is} other {# other goals are}} on today's plan too."
msgstr "Fang mit {minutes, plural, one {# Minute} other {# Minuten}} an. {others, plural, one {# weiteres Ziel steht} other {# weitere Ziele stehen}} heute auch auf deinem Plan."

#: src/lib/reminders/reminder-copy.ts
msgctxt "EUWgvZ"
msgid "{minutes, plural, one {# minute} other {# minutes}} for this one, and {others, plural, one {# more goal} other {# more goals}} after it."
msgstr "{minutes, plural, one {# Minute} other {# Minuten}} für dieses Ziel, danach {others, plural, one {# weiteres Ziel} other {# weitere Ziele}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "4u16G2"
msgid "Open today's plan"
msgstr "Heutigen Plan öffnen"

#: src/lib/reminders/reminder-copy.ts
msgctxt "wdqkFx"
msgid "Change reminder settings"
msgstr "Erinnerungseinstellungen ändern"

#: src/lib/reminders/reminder-copy.ts
msgctxt "YvVUvF"
msgid "Turn off email reminders"
msgstr "E-Mail-Erinnerungen ausschalten"

#: src/lib/reminders/reminder-copy.ts
msgctxt "TMLja4"
msgid "You get this because you turned on study reminders in Zoonk."
msgstr "Du bekommst diese E-Mail, weil du in Zoonk Erinnerungen ans Lernen eingeschaltet hast."

#: src/lib/reminders/reminder-copy.ts
msgctxt "7gq6C7"
