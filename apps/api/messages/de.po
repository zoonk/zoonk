#: src/lib/reminders/reminder-copy.ts
msgctxt "Kc3Giq"
msgid "Today's exam prep: {minutes, plural, one {# minute} other {# minutes}}."
msgstr "Deine Prüfungsvorbereitung heute: {minutes, plural, one {# Minute} other {# Minuten}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "QGJAH7"
msgid "{minutes, plural, one {# minute} other {# minutes}} today moves your exam prep forward."
msgstr "Mit {minutes, plural, one {# Minute} other {# Minuten}} heute kommst du bei der Prüfungsvorbereitung weiter."

#: src/lib/reminders/reminder-copy.ts
msgctxt "dN9j0T"
msgid "{minutes, plural, one {# minute} other {# minutes}} on your plan today."
msgstr "Heute auf deinem Plan: {minutes, plural, one {# Minute} other {# Minuten}}."

#: src/lib/reminders/reminder-copy.ts
msgctxt "CHd8Js"
msgid "Today's plan has {minutes, plural, one {# minute} other {# minutes}} for it."
