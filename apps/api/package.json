{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "next experimental-analyze",
    "build": "next build",
    "build:e2e": "env $(cat ../../packages/db/.env.e2e | xargs) next build",
    "dev": "node ../../scripts/dev/run-service.mts api",
    "dev:app": "next dev",
    "dev:direct": "next dev -p 4000",
    "e2e": "env $(cat ../../packages/db/.env.e2e | xargs) playwright test",
    "e2e:ui": "env $(cat ../../packages/db/.env.e2e | xargs) playwright test --ui",
    "i18n:lint": "eloqnt lint --strict",
    "i18n": "eloqnt translate",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "openapi:generate": "tsx scripts/openapi.ts",
    "start": "next start -p 4000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "workflow:inspect": "workflow inspect runs",
    "workflow:web": "workflow web"
  },
  "dependencies": {
    "@sentry/nextjs": "catalog:",
    "@vercel/analytics": "catalog:",
    "@zoonk/ai": "workspace:*",
    "@zoonk/auth": "workspace:*",
    "@zoonk/core": "workspace:*",
    "@zoonk/db": "workspace:*",
    "@zoonk/ui": "workspace:*",
    "@zoonk/utils": "workspace:*",
    "ai": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "posthog-js": "catalog:",
    "posthog-node": "5.49.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:",
    "workflow": "5.0.0-beta.42",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@scalar/nextjs-api-reference": "0.11.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@zoonk/e2e": "workspace:*",
    "@zoonk/i18n": "workspace:*",
    "@zoonk/testing": "workspace:*",
    "@zoonk/tsconfig": "workspace:*",
    "raw-loader": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod-openapi": "6.0.1"
  }
}
