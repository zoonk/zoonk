# Nothing here is needed to run locally (`pnpm dev`, `pnpm start`, tests): each variable turns on a
# service or replaces a local default.

# Better Auth's secret, the same in Main, the API and Admin. Local runs share a built-in one.
# openssl rand -hex 32
BETTER_AUTH_SECRET=

# Defaults to postgres://postgres:postgres@localhost:5432/zoonk, which `pnpm db:setup` prepares.
# Deployments set both; migrations use the unpooled (direct) one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# This app's domain (eg api.zoonk.com). Local runs use the address they serve at.
NEXT_PUBLIC_APP_DOMAIN=

# The API's own URL and the main web app's, where a sign-in started on this API ends. `pnpm dev` and
# `pnpm start` set both.
NEXT_PUBLIC_API_URL=
MAIN_APP_URL=

# Better Auth cookie cache
AUTH_COOKIE_CACHE_ENABLED=false

# Core asks the API to run a learner's follow-ups (preparing lessons, memory, mistake causes) with
# it; the same value in Main and the API. `pnpm dev` and `pnpm start` set one.
# openssl rand -hex 32
APP_FOLLOW_UP_SECRET=

# Mailer API key; without it, local runs deliver email to the local mailbox
MAILER_API_KEY=
# Study reminder emails go through their own ZeptoMail mail agent (reminders@zoonk.com); without its
# key, local runs deliver them to the local mailbox
MAILER_REMINDERS_API_KEY=

# Signs the links that turn study reminder emails off; the same value in Main and the API. Local runs
# share a built-in one.
# openssl rand -hex 32
STUDY_REMINDER_UNSUBSCRIBE_SECRET=

# Study reminder push. Without these, reminders skip push. iOS goes straight to APNs with a .p8
# token key (Certificates, Identifiers & Profiles > Keys, with Apple Push Notifications service),
# signed for APPLE_TEAM_ID and sent to APPLE_APP_BUNDLE_IDENTIFIER; production uses Apple's
# production service, everything else the sandbox. Literal \n sequences become PEM line breaks.
APPLE_APNS_KEY_ID=
APPLE_APNS_PRIVATE_KEY=
# Android goes through FCM HTTP v1: the JSON key of a service account in the app's Firebase
# project with the Firebase Cloud Messaging API Admin role.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Vercel Blob signs in with the project's OIDC token. Locally, link this app once (`vercel link`,
# project zoonk-api) and stay signed in to the Vercel CLI: the SDK fetches and refreshes the token
# itself. Set the dev stores' ids here, since scripts read only this file (`vercel blob
# list-stores` shows them).
# Public store: shared Library media, served by the CDN
BLOB_STORE_ID=
# Private store: learners' uploads and private course pictures
PRIVATE_BLOB_STORE_ID=

# Stripe API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google secrets for authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=

# Android restore keys (POST /v1/sessions/restore-key) accept only apps signed with these certificates:
# the same fingerprints as main's, comma-separated, as `keytool -list -v` prints them (AA:BB:…).
# Release (com.zoonk): Play Console's App signing key certificate. Debug (com.zoonk.debug): the
# local debug keystore.
ANDROID_RELEASE_CERT_FINGERPRINTS=
ANDROID_DEBUG_CERT_FINGERPRINTS=

# Apple secrets for authentication
APPLE_APP_BUNDLE_IDENTIFIER=com.zoonk.dev
APPLE_TEAM_ID=
APPLE_CLIENT_ID=test.zoonk.dev
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# App Store verification rejects signed data for other apps. Find the Release bundle ID and numeric Apple ID in App Store Connect > App Information.
# https://developer.apple.com/help/app-store-connect/reference/app-information/app-information
APPLE_IAP_BUNDLE_ID=com.zoonk
# Must match the Debug bundle identifier used by the local Xcode StoreKit configuration.
APPLE_IAP_XCODE_BUNDLE_ID=com.zoonk.dev
APPLE_IAP_APP_ID=
# Current-chain lookups require a separate In-App Purchase key from App Store Connect > Users and Access > Integrations > In-App Purchase.
# https://developer.apple.com/help/app-store-connect/configure-in-app-purchase-settings/generate-keys-for-in-app-purchases/
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Store the downloaded .p8 contents as a secret; literal \n sequences are converted to PEM line breaks.
APPLE_IAP_PRIVATE_KEY=
# Explicitly accepts Xcode-signed StoreKit transactions outside production; leave false in deployed environments.
APPLE_IAP_ALLOW_XCODE_TRANSACTIONS=false

# Everything that generates (plans, lessons, grading, speech, transcription) goes through AI Gateway.
# Leave it empty to sign in with the app's Vercel link and your Vercel CLI login.
AI_GATEWAY_API_KEY=
# OpenAI directly, only for live language calls (GPT-Live), which the server must start and hang up
OPENAI_API_KEY=

# Sentry monitoring
NEXT_PUBLIC_SENTRY_DSN=

# PostHog: learners' server events and AI generations
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# Google Play subscriptions: the JSON key of the service account that Play Console grants
# "View financial data" and "Manage orders and subscriptions". Pub/Sub pushes Real-time Developer
# Notifications as the same service account.
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=
