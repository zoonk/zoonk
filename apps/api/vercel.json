{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=api",
  "ignoreCommand": "exit 1",
  "schedules": { "daily-sweeps": { "schedule": "0 6 * * *", "function": "cron/daily-sweeps" } },
  "functions": {
    "src/app/cron/daily-sweeps/route.ts": {
      "experimentalTriggers": [{ "type": "schedule/v1beta" }]
    },
    "src/app/v1/generations/*/events/route.ts": { "supportsCancellation": true }
  }
}
