{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=api",
  "ignoreCommand": "exit 1",
  "crons": [{ "path": "/cron/daily-sweeps", "schedule": "0 6 * * *" }],
  "functions": { "src/app/v1/generations/*/events/route.ts": { "supportsCancellation": true } }
}
