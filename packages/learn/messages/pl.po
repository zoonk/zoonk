msgid "A short explanation written for you, about 5 minutes."
msgstr "Krótkie wyjaśnienie przygotowane dla ciebie, do przeczytania w około 5 minut."

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "rnVK11"
msgid "Opening your explanation…"
msgstr "Otwieramy twoje wyjaśnienie…"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "n-6wcY"
msgid "Explain it"
msgstr "Wyjaśnij to"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "dXKhtW"
msgid "We can't help with this goal"
msgstr "Nie możemy pomóc ci osiągnąć tego celu"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "Q354iN"
msgid "Zoonk doesn't teach anything that could hurt you or others, gambling or ways to cheat. Is there something else you'd like to learn?"
msgstr "Zoonk nie uczy niczego, co mogłoby zaszkodzić tobie lub innym, ani hazardu czy sposobów oszukiwania. Czy chcesz nauczyć się czegoś innego?"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "PDFZz6"
msgid "Try another goal"
msgstr "Wybierz inny cel"

#: src/onboarding/entry/goal-outcomes.tsx
#: src/onboarding/steps/question-steps.tsx
msgctxt "E10uH8"
msgid "Tell us a bit more"
msgstr "Opowiedz nam trochę więcej"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "Rt585I"
msgid "What do you want to learn or be able to do? For example: “pass the driving test”, “understand statistics for work” or “speak French on my trip”."
msgstr "Czego chcesz się nauczyć lub co chcesz umieć robić? Na przykład: „zdać egzamin na prawo jazdy”, „rozumieć statystykę potrzebną w pracy” lub „mówić po francusku w podróży”."

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "Bwx5dr"
msgid "Write my goal again"
msgstr "Napisz cel jeszcze raz"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "2P4gfK"
msgid "You're on the list. We'll let you know when lessons for playing are ready."
msgstr "Jesteś na liście. Damy ci znać, gdy lekcje gry będą gotowe."

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "nOrf4S"
msgid "Create an account so we can let you know."
msgstr "Załóż konto, żebyśmy mogli dać ci znać."

#. {instrument} names what the learner wants to play, or singing, like "guitar".
#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "qG3mZH"
msgid "Lessons for playing {instrument} are coming"
msgstr "Lekcje już wkrótce: {instrument}"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "xR84Dg"
msgid "To teach you to play, we need to hear you play, and we're still building that. Join the waitlist, and start with musicianship today: reading music, ear training and rhythm."
msgstr "Żeby nauczyć cię grać, musimy słyszeć, jak grasz, a nad tą funkcją jeszcze pracujemy. Zapisz się na listę oczekujących i zacznij dziś od podstaw muzyki: czytania nut, kształcenia słuchu i rytmu."

#. {instrument} names what the learner wants to play, or singing, like "guitar".
#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "irzzdg"
msgid "Musicianship for {instrument}: hear chords, read short melodies and keep the beat. No microphone needed."
msgstr "Podstawy muzyki: {instrument}. Rozpoznawaj akordy ze słuchu, czytaj krótkie melodie i trzymaj rytm. Nie potrzebujesz mikrofonu."

#: src/onboarding/entry/goal-outcomes.tsx
#: src/onboarding/understood/understood-screen.tsx
msgctxt "LlWqkT"
msgid "Saving your goal…"
msgstr "Zapisujemy twój cel…"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "2zqqBZ"
msgid "Start musicianship"
msgstr "Zacznij od podstaw muzyki"

#: src/onboarding/entry/goal-outcomes.tsx
msgctxt "h6_d7P"
msgid "Join the waitlist"
msgstr "Dołącz do listy oczekujących"

#: src/onboarding/entry/guest-goal-gate.tsx
