enum GenerationStatus {
  pending
  running
  completed
  failed
}

/// What a tutor question is about: a lesson, one of its screens or an answer on it, or the chapter,
/// plan, subject, item-bank question or mock its thread belongs to.
enum LessonQuestionContextKind {
  lesson
  step
  answer
  chapter
  plan
  mock
  subject
  item
}

/// What a tutor thread is attached to: one learner has one thread per lesson, chapter, goal's plan,
/// goal's subject, item-bank question or mock.
enum TutorThreadKind {
  lesson
  chapter
  plan
  mock
  subject
  item
}

enum LessonQuestionStatus {
  pending
  running
  completed
  failed
}

enum CourseFormat {
  coding
  core
  exam
  instrument
  language
  personalized
  practical
  question
}

enum SubscriptionProvider {
  stripe
  google
  apple
  zoonk
}
