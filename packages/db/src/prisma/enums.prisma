enum GenerationStatus {
  pending
  running
  completed
  failed
}

/// What a tutor question is about: a lesson, one of its screens or an answer on it, or the chapter,
/// plan or mock its thread belongs to.
enum LessonQuestionContextKind {
  lesson
  step
  answer
  chapter
  plan
  mock
}

/// What a tutor thread is attached to: one learner has one thread per lesson, chapter, goal's plan or
/// mock.
enum TutorThreadKind {
  lesson
  chapter
  plan
  mock
}

enum LessonQuestionStatus {
  pending
  running
  completed
  failed
}

enum CourseFormat {
  coding
