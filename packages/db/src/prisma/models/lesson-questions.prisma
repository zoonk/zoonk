/// The server words a tapped suggestion itself, so its words are never a learner's.
enum LessonScreenSuggestion {
  simpler
  deeper
  example
}

/// One thread per learner and thing. Plan, subject and mock threads go with their goal or mock.
model LessonQuestionThread {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            TutorThreadKind  @default(lesson)
  libraryLessonId String?          @map("library_lesson_id") @db.Uuid
  libraryLesson   Lesson?          @relation(fields: [libraryLessonId], references: [id], onDelete: SetNull)
  chapterId       String?          @map("chapter_id") @db.Uuid
  chapter         Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  goalId          String?          @map("goal_id") @db.Uuid
  goal            Goal?            @relation("GoalQuestionThreads", fields: [goalId], references: [id], onDelete: Cascade)
  subjectGoalId   String?          @map("subject_goal_id") @db.Uuid
  subjectGoal     Goal?            @relation("SubjectQuestionThreads", fields: [subjectGoalId], references: [id], onDelete: Cascade)
  /// Stable within its goal's syllabus.
  subjectKey      String?          @map("subject_key")
  itemId          String?          @map("item_id") @db.Uuid
  item            Item?            @relation(fields: [itemId], references: [id], onDelete: SetNull)
  mockExamId      String?          @map("mock_exam_id") @db.Uuid
  mockExam        MockExam?        @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at")
  questions       LessonQuestion[]

  @@unique([userId, libraryLessonId], name: "userLibraryLessonQuestionThread")
  @@unique([userId, chapterId], name: "userChapterQuestionThread")
  @@unique([userId, goalId], name: "userGoalQuestionThread")
  @@unique([userId, mockExamId], name: "userMockQuestionThread")
  @@unique([userId, subjectGoalId, subjectKey], name: "userSubjectQuestionThread")
  @@unique([userId, itemId], name: "userItemQuestionThread")
  @@index([libraryLessonId])
  @@index([chapterId])
  @@index([goalId])
  @@index([subjectGoalId])
  @@index([itemId])
  @@index([mockExamId])
  @@map("lesson_question_threads")
}

model LessonQuestion {
  id                 String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  threadId           String                    @map("thread_id") @db.Uuid
  thread             LessonQuestionThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  requestId          String                    @map("request_id") @db.Uuid
  requestFingerprint String                    @map("request_fingerprint")
  libraryStepId      String?                   @map("library_step_id") @db.Uuid
  libraryStep        Step?                     @relation(fields: [libraryStepId], references: [id], onDelete: SetNull)
  stepNumber         Int?                      @map("step_number")
  contextKind        LessonQuestionContextKind @map("context_kind")
  contextSnapshot    Json                      @map("context_snapshot")
  question           String
  suggestion         LessonScreenSuggestion?
  answer             String?
  status             LessonQuestionStatus      @default(pending)
  generationRevision Int                       @default(0) @map("generation_revision")
  requestedModel     String?                   @map("requested_model")
  model              String?
  promptVersion      String?                   @map("prompt_version")
  runId              String?                   @map("run_id")
  generatedAt        DateTime?                 @map("generated_at")
  provider           String?
  finishReason       String?                   @map("finish_reason")
  sharedAnswerId     String?                   @map("shared_answer_id") @db.Uuid
  sharedAnswer       TutorSharedAnswer?        @relation(fields: [sharedAnswerId], references: [id], onDelete: SetNull)
  planChangeId       String?                   @map("plan_change_id") @db.Uuid
  planChange         PlanChange?               @relation(fields: [planChangeId], references: [id], onDelete: SetNull)
  toolOffer          Json?                     @map("tool_offer")
  /// The answer acts on this goal alone, even after the learner opens another. Null on questions
  /// asked before it was saved.
  goalId             String?                   @map("goal_id") @db.Uuid
  goal               Goal?                     @relation("TutorQuestionGoal", fields: [goalId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at")

  @@unique([threadId, requestId], name: "threadLessonQuestionRequest")
  @@index([createdAt])
  @@index([threadId, createdAt])
  @@index([libraryStepId])
  @@index([sharedAnswerId])
  @@index([planChangeId])
  @@index([goalId])
  @@map("lesson_questions")
}

/// Written without any learner's memory or conversation, for the tutor's own suggestions only, so
/// no learner's words are ever in it.
model TutorSharedAnswer {
  id            String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stepId        String                 @map("step_id") @db.Uuid
  step          Step                   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  suggestion    LessonScreenSuggestion
  question      String
  answer        String
  model         String
  promptVersion String                 @map("prompt_version")
  runId         String                 @map("run_id")
  generatedAt   DateTime               @default(now()) @map("generated_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  questions     LessonQuestion[]

  @@unique([stepId, suggestion], name: "stepSuggestion")
  @@map("tutor_shared_answers")
}
