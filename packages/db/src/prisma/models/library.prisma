enum CourseLevel {
  overview
  beginner
  intermediate
  advanced
}

/// Private content is built for one learner's too-specific goal. It is never indexed, listed or reused.
enum LibraryVisibility {
  public
  private
}

/// Mapped to `LibraryStepKind`: a legacy `StepKind` database type held the name.
enum StepKind {
  hook
  explanation
  workedExample  @map("worked_example")
  check
  typedAnswer    @map("typed_answer")
  spokenAnswer   @map("spoken_answer")
  activity
  multipleChoice @map("multiple_choice")
  fillBlank      @map("fill_blank")
  matchColumns   @map("match_columns")
  vocabulary
  reading
  listening
  translation
  alphabet
  summary
  challenge

  @@map("LibraryStepKind")
}

enum StepVariantKind {
  field
  tool
}

enum MediaKind {
  image
  audio
}

/// `identityKey` is unique per language, so concurrent requests never create two copies.
model Chapter {
  id                    String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  language              String                 @db.VarChar(10)
  targetLanguage        String?                @map("target_language") @db.VarChar(10)
  /// Claimed by one generation workflow at a time.
  identityKey           String                 @map("identity_key")
  slug                  String
  title                 String
  normalizedTitle       String                 @map("normalized_title")
  description           String
  objectives            String[]               @default([])
  level                 CourseLevel
  homeCourseId          String?                @map("home_course_id") @db.Uuid
  homeCourse            Course?                @relation(fields: [homeCourseId], references: [id], onDelete: SetNull)
  visibility            LibraryVisibility      @default(public)
  /// Private content is deleted with its owner.
  ownerId               String?                @map("owner_id") @db.Uuid
  owner                 User?                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  outlineStatus         GenerationStatus       @default(pending) @map("outline_status")
  outlineRunId          String?                @map("outline_run_id")
  /// `[{ name, essential }]`
  tools                 Json                   @default("[]")
  model                 String
  promptVersion         String                 @map("prompt_version")
  runId                 String                 @map("run_id")
  generatedAt           DateTime               @default(now()) @map("generated_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at")
  courses               CourseChapter[]
  lessons               ChapterLesson[]
  homeLessons           Lesson[]
  planItems             PlanItem[]
  goalSkills            ChapterSkill[]
  conversations         LanguageConversation[]
  conversationScenarios ConversationScenario[]
  questionThreads       LessonQuestionThread[]
  mindMap               ChapterMindMap?

  @@unique([language, identityKey], name: "languageIdentity")
  @@unique([homeCourseId, slug], name: "homeCourseSlug")
  @@index([language, level, normalizedTitle])
  @@index([ownerId])
  @@map("library_chapters")
}

model CourseChapter {
  courseId  String      @map("course_id") @db.Uuid
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapterId String      @map("chapter_id") @db.Uuid
  chapter   Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  level     CourseLevel
  position  Int
  /// Kept when the exam's active skill graph changes.
  area      String?
  createdAt DateTime    @default(now()) @map("created_at")

  @@id([courseId, chapterId])
  @@unique([courseId, level, position], name: "courseLevelPosition")
  @@index([chapterId])
  @@map("course_chapters")
}

model ChapterSkill {
  chapterId String   @map("chapter_id") @db.Uuid
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  skillId   String   @map("skill_id") @db.Uuid
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([chapterId, skillId])
  @@index([skillId])
  @@map("chapter_skills")
}

model Lesson {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  language          String                 @db.VarChar(10)
  targetLanguage    String?                @map("target_language") @db.VarChar(10)
  /// Claimed by one generation workflow at a time.
  identityKey       String                 @map("identity_key")
  slug              String
  title             String
  normalizedTitle   String                 @map("normalized_title")
  description       String
  canDo             String?                @map("can_do")
  level             CourseLevel
  estimatedMinutes  Int                    @map("estimated_minutes") @db.SmallInt
  homeChapterId     String?                @map("home_chapter_id") @db.Uuid
  homeChapter       Chapter?               @relation(fields: [homeChapterId], references: [id], onDelete: SetNull)
  visibility        LibraryVisibility      @default(public)
  /// Private content is deleted with its owner.
  ownerId           String?                @map("owner_id") @db.Uuid
  owner             User?                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  spec              Json?
  specStatus        GenerationStatus       @default(pending) @map("spec_status")
  specRunId         String?                @map("spec_run_id")
  contentStatus     GenerationStatus       @default(pending) @map("content_status")
  /// Claim held by the running content generation, so one workflow writes the steps.
  contentRunId      String?                @map("content_run_id")
  /// Oldest first. The next draft is told what held them back; publishing clears them.
  heldBackDrafts    Json                   @default("[]") @map("held_back_drafts")
  /// Set when the last allowed draft was held back: nothing writes it again and plans move on.
  setAsideAt        DateTime?              @map("set_aside_at")
  /// Public on SEO pages.
  summary           Json?
  /// They belong to the lesson, not the goal that first asked, so every reuse gets them.
  relatedQuestions  String[]               @default([]) @map("related_questions")
  goFurtherCourseId String?                @map("go_further_course_id") @db.Uuid
  goFurtherCourse   Course?                @relation(fields: [goFurtherCourseId], references: [id], onDelete: SetNull)
  model             String
  promptVersion     String                 @map("prompt_version")
  runId             String                 @map("run_id")
  generatedAt       DateTime               @default(now()) @map("generated_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at")
  chapters          ChapterLesson[]
  steps             Step[]
  skills            LessonSkill[]
  planItems         PlanItem[]
  studyBlocks       StudySessionBlock[]
  words             LessonWord[]
  sentences         LessonSentence[]
  questionThreads   LessonQuestionThread[]
  reviewFlags       ContentReviewFlag[]
  anonymousPaces    AnonymousLessonPace[]

  @@unique([language, identityKey], name: "languageIdentity")
  @@unique([homeChapterId, slug], name: "homeChapterSlug")
  @@index([language, level, normalizedTitle])
  @@index([ownerId])
  @@index([goFurtherCourseId])
  @@map("library_lessons")
}

model ChapterLesson {
  chapterId String   @map("chapter_id") @db.Uuid
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lessonId  String   @map("lesson_id") @db.Uuid
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@id([chapterId, lessonId])
  @@unique([chapterId, position], name: "chapterPosition")
  @@index([lessonId])
  @@map("chapter_lessons")
}

/// `content` follows core's versioned step contract (`contractVersion`). Learner rows point at
/// steps with SetNull, so regenerating a lesson never deletes anyone's progress.
model Step {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  lessonId           String              @map("lesson_id") @db.Uuid
  lesson             Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position           Int
  /// A problem found after publishing publishes a new version; the replaced screens stay, retired,
  /// so learners finish the version they opened.
  version            Int                 @default(1) @db.SmallInt
  /// Null for current screens, the only ones lessons read. Retired screens are deleted a day later.
  retiredAt          DateTime?           @map("retired_at")
  kind               StepKind
  contractVersion    Int                 @default(1) @map("contract_version") @db.SmallInt
  content            Json
  skillId            String?             @map("skill_id") @db.Uuid
  skill              Skill?              @relation(fields: [skillId], references: [id], onDelete: SetNull)
  itemId             String?             @map("item_id") @db.Uuid
  item               Item?               @relation(fields: [itemId], references: [id], onDelete: SetNull)
  wordId             String?             @map("word_id") @db.Uuid
  word               Word?               @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sentenceId         String?             @map("sentence_id") @db.Uuid
  sentence           Sentence?           @relation(fields: [sentenceId], references: [id], onDelete: SetNull)
  mediaAssetId       String?             @map("media_asset_id") @db.Uuid
  mediaAsset         MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  /// Null on older links; ordinary screen edits never change it.
  pictureAvailableAt DateTime?           @map("picture_available_at")
  sourceId           String?             @map("source_id") @db.Uuid
  source             Source?             @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// Starts at 1.
  sourcePage         Int?                @map("source_page") @db.SmallInt
  model              String
  promptVersion      String              @map("prompt_version")
  runId              String              @map("run_id")
  generatedAt        DateTime            @default(now()) @map("generated_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")
  variants           StepVariant[]
  exampleLines       StepExampleLine[]
  optionPictures     StepOptionPicture[]
  answerExplanations AnswerExplanation[]
  attempts           Attempt[]
  mistakes           Mistake[]
  questions          LessonQuestion[]
  sharedTutorAnswers TutorSharedAnswer[]

  @@unique([lessonId, version, position], name: "lessonVersionPosition")
  @@index([retiredAt])
  @@index([skillId])
  @@index([itemId])
  @@index([wordId])
  @@index([sentenceId])
  @@index([mediaAssetId])
  @@index([sourceId])
  @@map("library_steps")
}

/// When a picture is taken out of use its row goes with it, and the option shows its description.
model StepOptionPicture {
  stepId       String     @map("step_id") @db.Uuid
  step         Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  optionId     String     @map("option_id")
  mediaAssetId String     @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@id([stepId, optionId])
  @@index([mediaAssetId])
  @@map("library_step_option_pictures")
}

/// `key` names the field or tool ("nursing", "excel").
model StepVariant {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stepId          String          @map("step_id") @db.Uuid
  step            Step            @relation(fields: [stepId], references: [id], onDelete: Cascade)
  kind            StepVariantKind
  key             String
  contractVersion Int             @default(1) @map("contract_version") @db.SmallInt
  content         Json
  model           String
  promptVersion   String          @map("prompt_version")
  runId           String          @map("run_id")
  generatedAt     DateTime        @default(now()) @map("generated_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@unique([stepId, kind, key], name: "stepVariantKey")
  @@map("step_variants")
}

/// `contextKey` hashes what it was written from, so a change in those facts writes it again. `text`
/// is null when nothing the learner shared fits, so the model isn't asked again for the same facts.
model StepExampleLine {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stepId        String   @map("step_id") @db.Uuid
  step          Step     @relation(fields: [stepId], references: [id], onDelete: Cascade)
  text          String?
  contextKey    String   @map("context_key")
  model         String
  promptVersion String   @map("prompt_version")
  runId         String   @map("run_id")
  generatedAt   DateTime @default(now()) @map("generated_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, stepId], name: "userStep")
  @@index([stepId])
  @@map("step_example_lines")
}

/// `reuseKey` makes each picture or sound once (audio keys include the language). An image with
/// labels has the labels' `language`; one without text serves every language.
model MediaAsset {
  id            String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  kind          MediaKind
  url           String
  mimeType      String?             @map("mime_type")
  reuseKey      String              @unique @map("reuse_key")
  language      String?             @db.VarChar(10)
  prompt        String?
  scene         Json?
  palette       String?
  styleVersion  Int?                @map("style_version")
  width         Int?
  height        Int?
  durationMs    Int?                @map("duration_ms")
  visibility    LibraryVisibility   @default(public)
  /// Private assets are deleted with their owner.
  ownerId       String?             @map("owner_id") @db.Uuid
  owner         User?               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  model         String
  promptVersion String              @map("prompt_version")
  runId         String              @map("run_id")
  generatedAt   DateTime            @default(now()) @map("generated_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  steps         Step[]
  stepOptions   StepOptionPicture[]
  items         Item[]
  itemSets      ItemSet[]

  @@index([ownerId])
  @@map("media_assets")
}

/// A private chapter's picture stays in its owner's private files. A picture with serious mistakes
/// is drawn again; when that fails too, `imageUrl` is null and the outline is the map.
model ChapterMindMap {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  chapterId     String           @unique @map("chapter_id") @db.Uuid
  chapter       Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  language      String           @db.VarChar(10)
  status        GenerationStatus @default(pending)
  runId         String?          @map("run_id")
  structure     Json?
  imageUrl      String?          @map("image_url")
  imageWidth    Int?             @map("image_width")
  imageHeight   Int?             @map("image_height")
  thumbnailUrl  String?          @map("thumbnail_url")
  model         String?
  imageModel    String?          @map("image_model")
  promptVersion String?          @map("prompt_version")
  generatedAt   DateTime?        @map("generated_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at")

  @@map("chapter_mind_maps")
}
