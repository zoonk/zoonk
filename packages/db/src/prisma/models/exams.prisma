enum MockExamStatus {
  active
  finished
}

/// One sitting of a mock exam in real conditions: an exam goal's weekly Big Challenge, played
/// section by section in the blueprint's order, time and scoring. `conditions` fixes each section's
/// questions and minutes when the mock starts (an adaptive exam picks a later module when the one
/// before it is submitted). Answers stay drafts until the mock finishes, when they're graded and
/// recorded as attempts. `result` keeps the analysis as numbers and title snapshots, so it survives
/// content changes. `listeningPlays` counts each recording's plays in its listening section by item
/// set id (`{ "<setId>": 1 }`), so another tab or device can't play it again past the exam's limit.
model MockExam {
  id               String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId           String?                @map("goal_id") @db.Uuid
  goal             Goal?                  @relation(fields: [goalId], references: [id], onDelete: SetNull)
  blockId          String?                @unique @map("block_id") @db.Uuid
  block            StudySessionBlock?     @relation(fields: [blockId], references: [id], onDelete: SetNull)
  examBlueprintId  String?                @map("exam_blueprint_id") @db.Uuid
  examBlueprint    ExamBlueprint?         @relation(fields: [examBlueprintId], references: [id], onDelete: SetNull)
  status           MockExamStatus         @default(active)
  conditions       Json
  sectionIndex     Int                    @default(0) @map("section_index") @db.SmallInt
  sectionStartedAt DateTime               @map("section_started_at")
  startedAt        DateTime               @default(now()) @map("started_at")
  finishedAt       DateTime?              @map("finished_at")
  result           Json?
  listeningPlays   Json                   @default("{}") @map("listening_plays")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at")
  answers          MockExamAnswer[]
  attempts         Attempt[]
  questionThreads  LessonQuestionThread[]

  @@index([userId, goalId, finishedAt])
  @@index([goalId])
  @@index([examBlueprintId])
  @@map("mock_exams")
}

/// A mock answer while the mock runs: the pick (null when the question was left blank), whether it
/// was flagged to come back to, which also marks the answers the learner wasn't sure of, and the
/// time spent on it. `itemId` is a plain id: the graded answer becomes an `Attempt` at the end.
/// `changes` counts the times a given answer was changed in a section that limits them, like the
/// GMAT's review of 3 answers at a section's end.
model MockExamAnswer {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  mockExamId String   @map("mock_exam_id") @db.Uuid
  mockExam   MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  itemId     String   @map("item_id") @db.Uuid
  answer     Json?
  flagged    Boolean  @default(false)
  durationMs Int      @default(0) @map("duration_ms")
  changes    Int      @default(0) @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([mockExamId, itemId], name: "mockItem")
  @@map("mock_exam_answers")
}

/// The official result a learner reports after the exam ("How did it go?"), next to the estimate
/// they saw before it, so future estimates for the exam can be calibrated and outcomes measured.
/// One per goal; the exam's name is a snapshot so the row stays readable without its blueprint.
model ExamResult {
  id              String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId          String?        @unique @map("goal_id") @db.Uuid
  goal            Goal?          @relation(fields: [goalId], references: [id], onDelete: SetNull)
  examBlueprintId String?        @map("exam_blueprint_id") @db.Uuid
  examBlueprint   ExamBlueprint? @relation(fields: [examBlueprintId], references: [id], onDelete: SetNull)
  examName        String         @map("exam_name")
  examDate        DateTime?      @map("exam_date") @db.Date
  /// The official score on the exam's own scale, or null when the learner only says pass or fail.
  score           Float?
  /// "irt" for item response theory scales like ENEM's, "percent" or "points" (with `maxScore`).
  scale           String?
  maxScore        Float?         @map("max_score")
  passed          Boolean?
  /// The estimated range shown before the exam, on the same scale, when there was one.
  estimateLow     Float?         @map("estimate_low")
  estimateHigh    Float?         @map("estimate_high")
  mocksTaken      Int            @default(0) @map("mocks_taken") @db.SmallInt
  reportedAt      DateTime       @default(now()) @map("reported_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@index([examBlueprintId, reportedAt])
  @@map("exam_results")
}

/// An essay draft being graded, claimed before the grader is called, so the same draft sent twice at
/// once is graded once: the other request waits for its grade instead of paying for another. A claim
/// counts toward the day's essay grades until its grade is recorded (the same transaction deletes
/// it) or grading fails (which deletes it too). `id` is the attempt id the grade is recorded under.
/// A claim older than any grade takes was left by a request that crashed, and can be taken again.
model EssayGradeClaim {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The learner's day the grade counts toward.
  localDate DateTime @map("local_date") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, localDate])
  @@map("essay_grade_claims")
}
