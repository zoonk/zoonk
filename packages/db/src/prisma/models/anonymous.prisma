// What deleted learners' study still teaches everyone, kept with nothing that points at them: no
// user, goal or mock id, random ids (`gen_random_uuid()`, unlike uuidv7 they don't say when a row
// was written) and days instead of times. Deleting a learner (account deletion, the inactive-guest
// sweep) moves their rows here from the personal tables in one transaction
// (`@zoonk/auth/anonymous-records`), and each aggregate reads them next to the live rows.

/// A deleted learner's first answer to an item, which item recalibration counts with live
/// learners' first answers (`library/items/recalibrate-item-difficulty`).
model AnonymousFirstAnswer {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId    String  @map("item_id") @db.Uuid
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  isCorrect Boolean @map("is_correct")

  @@index([itemId])
  @@map("anonymous_first_answers")
}

/// One answer of a deleted learner's finished mock, which the exam's mock pace averages with live
/// mocks' answers (`exams/mocks/_utils/mock-pace`). `mockKey` groups one mock's answers and
/// `learnerKey` one learner's mocks, both random, so the pace still counts mocks and learners.
model AnonymousMockAnswer {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examBlueprintId String        @map("exam_blueprint_id") @db.Uuid
  examBlueprint   ExamBlueprint @relation(fields: [examBlueprintId], references: [id], onDelete: Cascade)
  mockKey         String        @map("mock_key") @db.Uuid
  learnerKey      String        @map("learner_key") @db.Uuid
  finishedOn      DateTime      @map("finished_on") @db.Date
  durationMs      Int           @map("duration_ms")

  @@index([examBlueprintId, finishedOn])
  @@map("anonymous_mock_answers")
}

/// How long a deleted learner took on a finished Library lesson, on their local day, which pace
/// samples read with the live ledger (`plans/_utils/pace-samples`).
model AnonymousLessonPace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  localDate DateTime @map("local_date") @db.Date
  seconds   Int

  @@index([localDate])
  @@map("anonymous_lesson_paces")
}

/// A deleted learner's official exam result next to the estimate they saw before it, which
/// calibrates later estimates for the exam with live reports (`exams/estimates/load-goal-estimate`).
model AnonymousExamResult {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  examBlueprintId String        @map("exam_blueprint_id") @db.Uuid
  examBlueprint   ExamBlueprint @relation(fields: [examBlueprintId], references: [id], onDelete: Cascade)
  score           Float
  scale           String
  maxScore        Float?        @map("max_score")
  estimateLow     Float         @map("estimate_low")
  estimateHigh    Float         @map("estimate_high")
  reportedOn      DateTime      @map("reported_on") @db.Date

  @@index([examBlueprintId, reportedOn])
  @@map("anonymous_exam_results")
}
