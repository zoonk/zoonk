/// `input` holds what the model read only when that text is stored elsewhere anyway; otherwise only
/// `inputHash`. Rows are kept 30 days. A `personal` run goes away with its learner or goal; one
/// about shared Library content is linked to neither.
model EvaluationRun {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  task           String
  model          String
  requestedModel String   @map("requested_model")
  promptVersion  String   @map("prompt_version")
  userId         String?  @map("user_id") @db.Uuid
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId         String?  @map("goal_id") @db.Uuid
  goal           Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  contentScope   String   @map("content_scope") @db.VarChar(10)
  traceId        String?  @map("trace_id")
  input          Json?
  inputHash      String   @map("input_hash")
  answers        Json
  latencyMs      Int      @map("latency_ms")
  runId          String   @map("run_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([task, createdAt])
  @@index([createdAt])
  @@index([userId])
  @@index([goalId])
  @@map("evaluation_runs")
}
