enum LearningEventKind {
  lesson
  review
  questions
  mock
  checkpoint
  session
  explanation
  conversation
}

/// Stats read it instead of content tables, so content is referenced by plain ids in `contentIds`,
/// never by foreign keys. `localDate`, `hour` and `weekday` are learner-local and describe when the
/// activity ended (or started, while `endedAt` is null).
model LearningEvent {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             LearningEventKind
  /// The lesson's kind as text (legacy kinds included), so it survives enum changes.
  lessonKind       String?           @map("lesson_kind")
  goalId           String?           @map("goal_id") @db.Uuid
  startedAt        DateTime          @map("started_at")
  /// Null until a started activity finishes, so completion rates count starts that never ended.
  endedAt          DateTime?         @map("ended_at")
  localDate        DateTime          @map("local_date") @db.Date
  hour             Int               @db.SmallInt
  weekday          Int               @db.SmallInt
  correctAnswers   Int               @default(0) @map("correct_answers")
  incorrectAnswers Int               @default(0) @map("incorrect_answers")
  seconds          Int               @default(0)
  brainPower       Int               @default(0) @map("brain_power")
  energyDelta      Float             @default(0) @map("energy_delta")
  contentIds       Json              @default("{}") @map("content_ids")
  titleSnapshot    String?           @map("title_snapshot")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@index([userId, localDate])
  @@index([userId, hour])
  @@index([userId, lessonKind, id])
  @@index([localDate])
  @@index([contentIds(ops: JsonbPathOps)], type: Gin)
  @@map("learning_events")
}
