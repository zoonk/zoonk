enum FollowUpKind {
  refreshStudyDay            @map("refresh_study_day")
  prepareSession             @map("prepare_session")
  prepareGoalLessons         @map("prepare_goal_lessons")
  prepareMockSupply          @map("prepare_mock_supply")
  preparePlacementItems      @map("prepare_placement_items")
  prepareLevelTestBank       @map("prepare_level_test_bank")
  prepareLevelTestOut        @map("prepare_level_test_out")
  replenishLevelTestChecks   @map("replenish_level_test_checks")
  rebuildGoalCurriculum      @map("rebuild_goal_curriculum")
  writeLesson                @map("write_lesson")
  classifyMistakeCause       @map("classify_mistake_cause")
  findMistakePattern         @map("find_mistake_pattern")
  suggestProfileTools        @map("suggest_profile_tools")
  rememberOnboarding         @map("remember_onboarding")
  rememberSession            @map("remember_session")
  checkDailyInsight          @map("check_daily_insight")
  checkFactSensitivity       @map("check_fact_sensitivity")
  voiceWord                  @map("voice_word")
  writeSpeakingPaper         @map("write_speaking_paper")
  reviewAlphabetLesson       @map("review_alphabet_lesson")
  checkUploadVisibility      @map("check_upload_visibility")
  endWebPlusBesideStore      @map("end_web_plus_beside_store")
  askToCancelSecondStorePlus @map("ask_to_cancel_second_store_plus")
  settleSessionDay           @map("settle_session_day")
  settleSessionPlan          @map("settle_session_plan")
  makeChapterMindMap         @map("make_chapter_mind_map")
  prepareContentFixMedia     @map("prepare_content_fix_media")
  voiceContentFix            @map("voice_content_fix")
  writeSentenceOrders        @map("write_sentence_orders")
  updateLessonsShowing       @map("update_lessons_showing")
  refreshPlanSuggestion      @map("refresh_plan_suggestion")
}

/// Work owed after a learner's write; ended by the run that started it unless asked again since,
/// which `revision` counts.
model FollowUp {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        FollowUpKind
  key         String
  input       Json
  revision    Int          @default(0)
  requestedAt DateTime     @default(now()) @map("requested_at")
  /// A terminal failure waits for a new ask; dispatch and sweeps skip it.
  failedAt    DateTime?    @map("failed_at")

  @@unique([userId, kind, key], name: "userKindKey")
  @@index([requestedAt])
  @@map("follow_ups")
}
