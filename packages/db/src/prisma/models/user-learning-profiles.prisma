enum BuddyKind {
  zu
  noodle
  beep
  otto
}

enum BuddyGlasses {
  round
  star
  aviator
  catEye  @map("cat_eye")
  retro
  monocle
}

/// The buddy stores only its kind, name and chosen glasses: stage and glow come from the belt and
/// Energy, and earned glasses are `Milestone` rows.
model UserLearningProfile {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String       @unique @map("user_id") @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests         Json?
  preferences       Json?
  instructions      String?
  buddyKind         BuddyKind?   @map("buddy_kind")
  buddyName         String?      @map("buddy_name")
  buddyGlasses      BuddyGlasses @default(round) @map("buddy_glasses")
  activeGoalId      String?      @unique @map("active_goal_id") @db.Uuid
  activeGoal        Goal?        @relation(fields: [activeGoalId], references: [id], onDelete: SetNull)
  /// Off stops Zoonk from learning new facts and from using the ones it has, which stay listed.
  memoryEnabled     Boolean      @default(true) @map("memory_enabled")
  /// The device's own mute still wins.
  soundsEnabled     Boolean      @default(true) @map("sounds_enabled")
  dailyLimitMinutes Int?         @map("daily_limit_minutes") @db.SmallInt
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")

  @@map("user_learning_profiles")
}
