/// Shared by every language pair learning it. Its provenance and `audio*` columns are null for rows
/// made before generated rows stored their provenance.
model Word {
  id                   String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetLanguage       String                @map("target_language") @db.VarChar(10)
  word                 String
  romanization         String?
  audioUrl             String?               @map("audio_url")
  model                String?
  promptVersion        String?               @map("prompt_version")
  runId                String?               @map("run_id")
  generatedAt          DateTime?             @map("generated_at")
  audioModel           String?               @map("audio_model")
  audioPromptVersion   String?               @map("audio_prompt_version")
  audioRunId           String?               @map("audio_run_id")
  audioGeneratedAt     DateTime?             @map("audio_generated_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at")
  pronunciations       WordPronunciation[]
  librarySteps         Step[]
  lessonWords          LessonWord[]
  pronunciationReviews PronunciationReview[]

  @@unique([organizationId, targetLanguage, word], name: "orgWord")
  @@map("words")
}

/// A guide depends on the learner's language, not the word's meaning, so it's keyed on
/// (wordId, userLanguage) rather than living on `Word` or `LessonWord`.
model WordPronunciation {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  wordId        String    @map("word_id") @db.Uuid
  word          Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)
  userLanguage  String    @map("user_language") @db.VarChar(10)
  pronunciation String
  /// Null when there is no real trap. Rows written before tips existed are filled the next time the
  /// word is taught.
  tip           String?
  model         String?
  promptVersion String?   @map("prompt_version")
  runId         String?   @map("run_id")
  generatedAt   DateTime? @map("generated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([wordId, userLanguage], name: "wordPronunciation")
  @@map("word_pronunciations")
}

model Sentence {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetLanguage     String           @map("target_language") @db.VarChar(10)
  sentence           String
  romanization       String?
  audioUrl           String?          @map("audio_url")
  model              String?
  promptVersion      String?          @map("prompt_version")
  runId              String?          @map("run_id")
  generatedAt        DateTime?        @map("generated_at")
  audioModel         String?          @map("audio_model")
  audioPromptVersion String?          @map("audio_prompt_version")
  audioRunId         String?          @map("audio_run_id")
  audioGeneratedAt   DateTime?        @map("audio_generated_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")
  librarySteps       Step[]
  lessonSentences    LessonSentence[]

  @@unique([organizationId, targetLanguage, sentence], name: "orgSentence")
  @@map("sentences")
}

/// The translation, distractors and note belong to the lesson, because meaning depends on the
/// situation ("banco" is a bank in one lesson and a bench in another).
model LessonWord {
  lessonId      String   @map("lesson_id") @db.Uuid
  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  wordId        String   @map("word_id") @db.Uuid
  word          Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  position      Int      @db.SmallInt
  translation   String
  distractors   String[] @default([])
  note          String?
  model         String
  promptVersion String   @map("prompt_version")
  runId         String   @map("run_id")
  generatedAt   DateTime @default(now()) @map("generated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@id([lessonId, wordId])
  @@index([wordId])
  @@map("lesson_words")
}

model LessonSentence {
  lessonId               String   @map("lesson_id") @db.Uuid
  lesson                 Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sentenceId             String   @map("sentence_id") @db.Uuid
  sentence               Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  position               Int      @db.SmallInt
  translation            String
  explanation            String
  distractors            String[] @default([])
  translationDistractors String[] @default([]) @map("translation_distractors")
  model                  String
  promptVersion          String   @map("prompt_version")
  runId                  String   @map("run_id")
  generatedAt            DateTime @default(now()) @map("generated_at")
  createdAt              DateTime @default(now()) @map("created_at")

  @@id([lessonId, sentenceId])
  @@index([sentenceId])
  @@map("lesson_sentences")
}
