enum OnboardingDraftStatus {
  understanding
  understood
  failed
}

/// The same words typed again by the same learner reuse it for a day, since relative dates ("this
/// year") change. It's theirs alone: never another learner's, and deleted with them.
model GoalUnderstanding {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language         String   @db.VarChar(10)
  normalizedPrompt String   @map("normalized_prompt")
  result           Json
  model            String?
  promptVersion    String?  @map("prompt_version")
  runId            String?  @map("run_id")
  generatedAt      DateTime @default(now()) @map("generated_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, language, normalizedPrompt], name: "userLanguagePrompt")
  @@map("goal_understandings")
}

/// `normalizedInstrument` keeps one entry per instrument per learner.
model InstrumentWaitlistEntry {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument           String
  normalizedInstrument String   @map("normalized_instrument")
  language             String   @db.VarChar(10)
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([userId, normalizedInstrument], name: "userInstrument")
  @@index([normalizedInstrument])
  @@map("instrument_waitlist_entries")
}

/// Kept so a refresh shows the same screen. `understanding` is null while the run reads the words.
/// Goals created from it carry its id as `details.onboardingId`, which is how a draft finds them.
model OnboardingDraft {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt        String
  language      String                @db.VarChar(10)
  timeZone      String                @map("time_zone")
  status        OnboardingDraftStatus @default(understanding)
  understanding Json?
  runId         String?               @map("run_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("onboarding_drafts")
}
