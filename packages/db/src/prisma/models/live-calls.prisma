enum LiveCallState {
  reserved
  starting
  live
  ended
}

enum LiveCallEndReason {
  learner
  deadline
  reconnect
  takeover
  completion
  refused
  failed
}

/// `costMicros` is the reservation while open and the settled cost once ended. It lives here, not on
/// the learner's usage record, which cascades with their account; the provider's bill doesn't.
model LiveCallConnection {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String?            @map("user_id") @db.Uuid
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId    String             @map("conversation_id") @db.Uuid
  state             LiveCallState      @default(reserved)
  heldSeconds       Int                @map("held_seconds")
  costMicros        Int                @map("cost_micros")
  deadlineAt        DateTime           @map("deadline_at")
  providerSessionId String?            @unique @map("provider_session_id")
  /// When the creation request left, since the provider's clock starts there.
  startedAt         DateTime?          @map("started_at")
  /// The call's latest objective check: a session OpenAI ended on its own charges the learner up to here.
  lastActiveAt      DateTime?          @map("last_active_at")
  endedAt           DateTime?          @map("ended_at")
  /// Set while `starting` when an end was asked for before the session existed.
  endReason         LiveCallEndReason? @map("end_reason")
  /// Ended without OpenAI confirming its session was over, so `costMicros` is an estimate.
  endUnconfirmed    Boolean            @default(false) @map("end_unconfirmed")
  createdAt         DateTime           @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, state])
  @@index([conversationId, createdAt])
  @@index([state, deadlineAt])
  @@map("live_call_connections")
}
