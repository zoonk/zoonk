enum LiveCallAdmission {
  off
  staff
  all
}

enum LiveCallState {
  reserved
  starting
  live
  ended
}

enum LiveCallEndReason {
  learner
  deadline
  reconnect
  takeover
  completion
  refused
  failed
}

model LiveCallSetting {
  id                    String            @id
  admission             LiveCallAdmission @default(off)
  freeDailyBudgetMicros Int               @default(0) @map("free_daily_budget_micros")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")

  @@map("live_call_settings")
}

/// The running balance of free calls' posted cost per UTC day. Reservations and settlements stay on
/// the original day, even when a call ends after midnight.
model FreeCallSpendDay {
  day         DateTime @id @db.Date
  spentMicros Int      @default(0) @map("spent_micros")

  @@map("free_call_spend_days")
}

/// One provider session attempt of a live call. `costMicros` is the authoritative cost: the
/// reservation while open, the settled cost once ended. It lives here because the learner's usage
/// record cascades with their account, while the provider's bill and the shared free day don't.
model LiveCallConnection {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  conversationId    String             @map("conversation_id") @db.Uuid
  state             LiveCallState      @default(reserved)
  heldSeconds       Int                @map("held_seconds")
  costMicros        Int                @map("cost_micros")
  /// The UTC day whose free bucket this call took from; null when it wasn't on the free plan.
  freeSpendDay      DateTime?          @map("free_spend_day") @db.Date
  deadlineAt        DateTime           @map("deadline_at")
  providerSessionId String?            @unique @map("provider_session_id")
  /// When the creation request left: the provider's clock starts here.
  startedAt         DateTime?          @map("started_at")
  endedAt           DateTime?          @map("ended_at")
  /// Set while `starting` when an end was asked for before the session existed.
  endReason         LiveCallEndReason? @map("end_reason")
  createdAt         DateTime           @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, state])
  @@index([conversationId, createdAt])
  @@index([freeSpendDay, state])
  @@index([state, deadlineAt])
  @@map("live_call_connections")
}
