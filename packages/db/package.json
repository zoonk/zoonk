{
  "name": "@zoonk/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./anonymous-records": "./src/anonymous-records.ts",
    "./course-home": "./src/course-home.ts",
    "./enums": "./src/generated/prisma/enums.ts",
    "./learner-writes": "./src/learner-writes.ts",
    "./live-call-enums": "./src/live-call-enums.ts",
    "./local-database": "./src/local-database.ts",
    "./seed/emails": "./src/prisma/seed/emails.ts",
    "./seed": "./src/prisma/seed/index.ts",
    "./seed/localize": "./src/prisma/seed/_utils/localize.ts",
    "./seed/personas": "./src/prisma/seed/learners/seed-personas.ts",
    "./utils": "./src/utils.ts"
  },
  "scripts": {
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:reset:e2e": "node ../../scripts/run-test-env.mts e2e prisma migrate reset",
    "db:reset:test": "node ../../scripts/run-test-env.mts test prisma migrate reset",
    "db:sync-content": "tsx src/prisma/sync-content.ts",
    "db:seed": "prisma db seed",
    "db:seed:e2e": "node ../../scripts/run-test-env.mts e2e prisma db seed",
    "prisma:seed": "tsx src/prisma/seed.ts && pnpm --filter @zoonk/core seed",
    "db:setup:e2e": "node ../../scripts/run-test-env.mts e2e prisma migrate deploy",
    "db:setup:test": "node ../../scripts/run-test-env.mts test prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "3.10.5",
    "@zoonk/utils": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@zoonk/ai": "workspace:*",
    "@zoonk/tsconfig": "workspace:*",
    "dotenv": "18.0.9",
    "prisma": "7.10.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "server-only": "catalog:"
  }
}
