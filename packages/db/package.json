{
  "name": "@zoonk/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed/v2": "./src/prisma/seed/v2/index.ts",
    "./seed/v2/localize": "./src/prisma/seed/v2/_utils/localize.ts",
    "./seed/v2/personas": "./src/prisma/seed/v2/learners/seed-personas.ts",
    "./utils": "./src/utils.ts",
    "./test-environment": "./src/test-environment.ts"
  },
  "scripts": {
    "db:deploy": "tsx src/scripts/deploy-migrations.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:reset:e2e": "node ../../scripts/run-test-env.mts e2e prisma migrate reset",
    "db:reset:test": "node ../../scripts/run-test-env.mts test prisma migrate reset",
    "db:sync-content": "tsx src/prisma/sync-content.ts",
    "db:seed": "prisma db seed",
    "db:seed:e2e": "node ../../scripts/run-test-env.mts e2e prisma db seed",
    "db:setup:e2e": "node ../../scripts/run-test-env.mts e2e prisma migrate deploy",
    "db:setup:test": "node ../../scripts/run-test-env.mts test prisma migrate deploy",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "3.9.9",
    "@zoonk/utils": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "@zoonk/tsconfig": "workspace:*",
    "dotenv": "18.0.4",
    "prisma": "7.10.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "server-only": "catalog:"
  }
}
