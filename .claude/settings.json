{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.*.local)",
      "Read(**/.env.*.local)",
      "Read(.env.development)",
      "Read(**/.env.development)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(.env.staging)",
      "Read(**/.env.staging)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != true ] || bash \"$CLAUDE_PROJECT_DIR/scripts/cloud/start.sh\" > /tmp/zoonk-start.log 2>&1 || { echo 'Starting PostgreSQL or preparing the databases failed; the end of /tmp/zoonk-start.log:'; tail -n 20 /tmp/zoonk-start.log; }"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/worktree/claude-create.mts"]
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cache-components@nextjs": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "nextjs": { "source": { "repo": "vercel/next.js", "source": "github" } }
  }
}
